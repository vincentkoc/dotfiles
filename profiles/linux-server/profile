# Headless Linux login environment.
export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
export DOTFILES_FUNCTIONS_ROOT="${DOTFILES_FUNCTIONS_ROOT:-$DOTFILES_DIR/functions}"
export DOTFILES_BIN_ROOT="${DOTFILES_BIN_ROOT:-$HOME/.local/bin}"
export DOTFILES_GIT_SPARSE_ROOT="${DOTFILES_GIT_SPARSE_ROOT:-$DOTFILES_DIR/git-sparse}"
export DOTFILES_DISABLE_NODENV=1
export DOTFILES_DISABLE_MOSH=1
export DOTFILES_CD_SKIP_LISTING=1
export TT_TMUX_BIN="${TT_TMUX_BIN:-/usr/bin/tmux}"
export PNPM_HOME="${PNPM_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/pnpm}"
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
export LANG="${LANG:-en_US.UTF-8}"
export LC_CTYPE="${LC_CTYPE:-en_US.UTF-8}"
export EDITOR="${EDITOR:-$(command -v nvim || command -v vim || command -v vi)}"
export VISUAL="$EDITOR"
export PAGER=less
export LESS='-F -i -J -M -R -W -x4 -X -z-4'
export COLORTERM="${COLORTERM:-truecolor}"
export DISABLE_TELEMETRY=1
export DO_NOT_TRACK=1
export TOKENJUICE_STATS=off

# Keep cockpit scratch on disk without changing other login environments.
_cockpit_private_tmp() {
  [[ -d "$1" && ! -L "$1" && -O "$1" ]] || return 1
  if [[ -n "${ZSH_VERSION:-}" ]]; then
    local -A metadata
    zmodload -F zsh/stat b:zstat 2>/dev/null &&
      zstat -L -H metadata "$1" 2>/dev/null &&
      [[ "$(( ${metadata[mode]} & 511 ))" == 448 ]]
  else
    [[ "$(stat -c '%a' -- "$1" 2>/dev/null)" == 700 ]]
  fi
}
_cockpit_tmp="$HOME/.cache/cockpit-tmp"
if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] &&
   { { [[ "${TMPDIR:-}" == "$_cockpit_tmp" ]] && _cockpit_private_tmp "$_cockpit_tmp"; } ||
     { _cockpit_session=$("$TT_TMUX_BIN" display -pt "$TMUX_PANE" '#S' 2>/dev/null) &&
       [[ "$_cockpit_session" == cockpit ]]; }; }; then
  if [[ ! -e "$_cockpit_tmp" && ! -L "$_cockpit_tmp" ]]; then
    (umask 077; mkdir -p -- "$_cockpit_tmp") 2>/dev/null || true
  fi
  if _cockpit_private_tmp "$_cockpit_tmp" ||
     { [[ -d "$_cockpit_tmp" && ! -L "$_cockpit_tmp" && -O "$_cockpit_tmp" ]] &&
       chmod 0700 -- "$_cockpit_tmp" 2>/dev/null &&
       _cockpit_private_tmp "$_cockpit_tmp"; }; then
    export TMPDIR="$_cockpit_tmp"
  fi
fi
unset _cockpit_session _cockpit_tmp
unset -f _cockpit_private_tmp

path_prepend() {
  local target="$1"
  local remaining="${PATH:-}"
  local result=""
  local entry done=""
  while :; do
    case "$remaining" in
      *:*)
        entry="${remaining%%:*}"
        remaining="${remaining#*:}"
        ;;
      *)
        entry="$remaining"
        done=1
        ;;
    esac
    if [[ -n "$entry" && "$entry" != "$target" ]]; then
      result="${result:+$result:}$entry"
    fi
    [[ -z "$done" ]] || break
  done
  PATH="$target${result:+:$result}"
}

path_prepend "$PNPM_HOME"
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"
export PATH
unset -f path_prepend
