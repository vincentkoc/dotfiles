tmux_conf_24b_colour=true
tmux_conf_new_pane_retain_current_path=true
tmux_conf_new_pane_reconnect_ssh=false
tmux_conf_copy_to_os_clipboard=false

# Query the same global scope we append to, independent of session overrides.
if-shell '! tmux -N -S #{q:socket_path} show-options -gqv update-environment | grep -Fxq DISPLAY' 'set -ga update-environment DISPLAY'
if-shell '! tmux -N -S #{q:socket_path} show-options -gqv update-environment | grep -Fxq KRB5CCNAME' 'set -ga update-environment KRB5CCNAME'
if-shell '! tmux -N -S #{q:socket_path} show-options -gqv update-environment | grep -Fxq SSH_ASKPASS' 'set -ga update-environment SSH_ASKPASS'
if-shell '! tmux -N -S #{q:socket_path} show-options -gqv update-environment | grep -Fxq SSH_AUTH_SOCK' 'set -ga update-environment SSH_AUTH_SOCK'
if-shell '! tmux -N -S #{q:socket_path} show-options -gqv update-environment | grep -Fxq SSH_AGENT_PID' 'set -ga update-environment SSH_AGENT_PID'
if-shell '! tmux -N -S #{q:socket_path} show-options -gqv update-environment | grep -Fxq SSH_CONNECTION' 'set -ga update-environment SSH_CONNECTION'
if-shell '! tmux -N -S #{q:socket_path} show-options -gqv update-environment | grep -Fxq WINDOWID' 'set -ga update-environment WINDOWID'
if-shell '! tmux -N -S #{q:socket_path} show-options -gqv update-environment | grep -Fxq XAUTHORITY' 'set -ga update-environment XAUTHORITY'

set -g default-terminal "tmux-256color"
%if "#{==:#{m/r:(^| )xterm[*]:RGB:clipboard:ccolour:cstyle:extkeys:focus:title($| ),#{terminal-features}},0}"
set -ga terminal-features ",xterm*:RGB:clipboard:ccolour:cstyle:extkeys:focus:title"
%endif
%if "#{==:#{m/r:(^| )screen[*]:title($| ),#{terminal-features}},0}"
set -ga terminal-features ",screen*:title"
%endif
%if "#{==:#{m/r:(^| )rxvt[*]:ignorefkeys($| ),#{terminal-features}},0}"
set -ga terminal-features ",rxvt*:ignorefkeys"
%endif
%if "#{==:#{m/r:(^| )xterm-256color:RGB:hyperlinks($| ),#{terminal-features}},0}"
set -ga terminal-features ",xterm-256color:RGB:hyperlinks"
%endif
%if "#{==:#{m/r:(^| )tmux-256color:RGB:hyperlinks($| ),#{terminal-features}},0}"
set -ga terminal-features ",tmux-256color:RGB:hyperlinks"
%endif
%if "#{==:#{m/r:(^| )[*]:Tc($| ),#{terminal-overrides}},0}"
set -ga terminal-overrides ",*:Tc"
%endif
%if "#{==:#{m/r:(^| )linux[*]:AX@($| ),#{terminal-overrides}},0}"
set -ga terminal-overrides ",linux*:AX@"
%endif
set -g allow-passthrough on
set -g extended-keys on
set -g extended-keys-format csi-u
set -g mouse on
set -g mode-keys vi
set -g status-keys vi
set -g history-limit 100000
set -g set-clipboard on
set -g escape-time 0
set -g status-interval 10
set -g status-position top
set -g status-style "fg=#565f89,bg=#1a1b26,none"
setw -g window-style "fg=default,bg=#1a1b26"
setw -g window-active-style "fg=default,bg=#1a1b26"
set -g status-left-length 32
set -g status-left "#[fg=#15161e,bg=#ff9e64,bold] \u2750 #S #[fg=#ff9e64,bg=#1a1b26,none]\uE0B0 "
set -g status-right-length 120
set -g status-right "#[fg=#565f89,bg=#1a1b26]#{?client_prefix,\u2328 ,  }#{?mouse,\u2197 ,  }#{?session_many_attached,\u2687 ,}#{?pane_synchronized,\u268F ,}#[fg=#9ece6a,bg=#1a1b26,none]\uE0B2#[fg=#1a1b26,bg=#9ece6a,bold] CX SAVE #[fg=#f7768e,bg=#9ece6a,none]\uE0B2#[fg=#c0caf5,bg=#f7768e,bold] %R %d %b #{user}@#h "
setw -g window-status-separator ""
setw -g window-status-format "#[fg=#1a1b26,bg=#1a1b26,none]\uE0B0#[fg=#565f89,bg=#1a1b26,none] #I #W #[fg=#1a1b26,bg=#1a1b26,none]\uE0B0"
setw -g window-status-current-format "#[fg=#1a1b26,bg=#7aa2f7,none]\uE0B0#[fg=#1a1b26,bg=#7aa2f7,bold] #I #W #[fg=#7aa2f7,bg=#1a1b26,none]\uE0B0"
setw -g window-status-style "fg=#565f89,bg=#1a1b26,none"
setw -g window-status-current-style "fg=#1a1b26,bg=#7aa2f7,bold"
setw -g window-status-activity-style "fg=default,bg=default,underscore"
setw -g window-status-bell-style "fg=#ff9e64,bg=default,blink,bold"
setw -g window-status-last-style "fg=#7aa2f7,bg=#16161e,none"
set -g message-style "fg=#1a1b26,bg=#7aa2f7,bold"
set -g message-command-style "fg=#7aa2f7,bg=#1a1b26,bold"
setw -g mode-style "fg=#1a1b26,bg=#7aa2f7,bold"
set -g display-panes-colour "#7aa2f7"
set -g display-panes-active-colour "#7aa2f7"
setw -g clock-mode-colour "#7aa2f7"
setw -g clock-mode-style 24

# Reload only this local profile, including after editing it.
bind r source-file ~/.tmux.conf.local \; display '~/.tmux.conf.local sourced'
bind e new-window -n "~/.tmux.conf.local" sh -c '${EDITOR:-vim} "$HOME/.tmux.conf.local" && tmux source-file "$HOME/.tmux.conf.local" && tmux display "~/.tmux.conf.local sourced"'
unbind -n C-l
bind + resize-pane -Z
bind R run-shell -b 'python3 "$HOME/.dotfiles/bin/tmux-pane-repair" request #{pane_id} #{q:client_name}'
bind N display-popup -t "#{pane_id}" -T "note: #{session_name}:#{window_index}.#{pane_index}" -x "#{pane_left}" -y "#{pane_top}" -w 84 -h 24 -E "\"\$HOME/.local/bin/tt\" note edit #{pane_id}"
bind -T root MouseDown3Pane if-shell -F "#{||:#{==:#{pane_current_command},mosh-client},#{==:#{pane_current_command},ssh}}" "select-pane -t = \\; send-keys -M" "run-shell -b '\"\$HOME/.local/bin/tt\" pane-menu #{pane_id} #{mouse_x} #{mouse_y} #{client_name}'"
bind -T root MouseDown1StatusRight run-shell -b "\"\$HOME/.local/bin/tt\" codex-snapshot --quiet && /usr/bin/tmux display-message 'codex snapshot saved'"
bind -T root MouseDown3StatusRight display-menu -T "CX SAVE" -x M -y S \
    "Save now" s "run-shell -b '\"\$HOME/.local/bin/tt\" codex-snapshot --quiet && /usr/bin/tmux display-message \"codex snapshot saved\"'" \
    "Show snapshot" v "display-popup -w 95% -h 80% -E '\"\$HOME/.local/bin/tt\" popup snapshot'" \
    "Restore preview" p "display-popup -w 95% -h 80% -E '\"\$HOME/.local/bin/tt\" popup restore-preview'" \
    "Snapshot history" h "display-popup -w 95% -h 80% -E '\"\$HOME/.local/bin/tt\" popup snapshot-history'" \
    "Status" t "display-popup -w 95% -h 80% -E '\"\$HOME/.local/bin/tt\" popup status'" \
    "Doctor" d "display-popup -w 95% -h 80% -E '\"\$HOME/.local/bin/tt\" popup doctor'" \
    "Mobile pane picker" m "display-popup -w 95% -h 80% -E '\"\$HOME/.local/bin/tt\" mobile'" \
    "" "" "" \
    "Autosave on" o "run-shell -b '\"\$HOME/.local/bin/tt\" autosave on && /usr/bin/tmux display-message \"codex autosave on\"'" \
    "Autosave off" f "run-shell -b '\"\$HOME/.local/bin/tt\" autosave off && /usr/bin/tmux display-message \"codex autosave off\"'"
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
