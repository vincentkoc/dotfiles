#!/bin/bash
# shellcheck disable=SC2034,SC2088,SC2148
# Natilius personal daily-driver configuration
#
# Copy to ~/.natiliusrc before running natilius.
# Package defaults live here. Host-local credentials, stores and Git owners do not.

# ============================================================================
# CORE SETTINGS
# ============================================================================
COUNTRYCODE="us"
SKIP_UPDATE_CHECK=false
NATILIUS_INSTALL_OHMYZSH=true

# ============================================================================
# ENABLED MODULES (daily driver; language pins are explicit opt-ins)
# ============================================================================
ENABLED_MODULES=(
    "system/directories"
    "system/security"
    "preferences/mac_preferences"
    "preferences/system_preferences"
    "applications/homebrew"
    "applications/apps"
    "applications/espanso"
    "ide/ide_setup"
    "dotfiles"
)

# ============================================================================
# ENTERPRISE / MDM SETTINGS
# ============================================================================
ENTERPRISE_MODE=false
RESPECT_MDM_POLICIES=true
JAMF_RECON_ON_COMPLETE=false

# ============================================================================
# CLEANUP SETTINGS
# ============================================================================
USE_MOLE_CLEANUP=false

# ============================================================================
# LANGUAGE VERSIONS
# ============================================================================
JDKVER="20"
PYTHONVER="3.13.0"
RUBYVER="3.4.2"
NODEVER="24.13.0"
GOVER="1.20.0"
PHPVER="8.1.0"
FLUTTER_CHANNEL="stable"

# ============================================================================
# IDE CONFIGURATION
# ============================================================================
INSTALL_VSCODE=true
INSTALL_CURSOR=false
INSTALL_JETBRAINS=true
INSTALL_SUBLIME=true
INSTALL_ZED=true

# ============================================================================
# DIRECTORIES
# ============================================================================
DIRS=(
    "~/.mackup"
    "~/.config"
    "~/GIT"
    "~/Library/Mobile Documents/com~apple~CloudDocs/dotfiles"
)

# Backup policy is machine-local; setup must not change Time Machine exclusions.
DIRSTOEXCLUDEFROMTIMEMACHINE=()

# ============================================================================
# HOMEBREW TAPS
# ============================================================================
BREWTAPS=(
    "warrensbox/tap"
    "terraform-linters/tap"
    "supabase/tap"
    "vincentkoc/tap"
    "openclaw/tap"
    "brunoborges/tap"
)

