# Explicit owner enrollment only. Git 2.55 native scheduled maintenance.
# No downloads, object packing, expiration or worktree pruning.
[maintenance]
    strategy = incremental
    auto = false
[maintenance "commit-graph"]
    enabled = true
    schedule = daily
[maintenance "prefetch"]
    enabled = false
[maintenance "loose-objects"]
    enabled = false
[maintenance "incremental-repack"]
    enabled = false
[maintenance "geometric-repack"]
    enabled = false
[maintenance "gc"]
    enabled = false
[maintenance "pack-refs"]
    enabled = false
[maintenance "reflog-expire"]
    enabled = false
[maintenance "worktree-prune"]
    enabled = false
[maintenance "rerere-gc"]
    enabled = false
