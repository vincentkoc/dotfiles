#!/usr/bin/env bash
set -euo pipefail

mode="check"
if [[ "${1:-}" == "--apply" ]]; then
    mode="apply"
elif [[ -n "${1:-}" && "${1:-}" != "--check" ]]; then
    printf 'usage: terminal-sync [--check|--apply]\n' >&2
    exit 2
fi

repo="${TERMINAL_SYNC_DOTFILES_DIR:-$HOME/GIT/_Perso/dotfiles}"
ghostty_source="$repo/.config/ghostty"
ghostty_config="$ghostty_source/config.ghostty"
tmux_config="$repo/.tmux.conf"
tmux_local_config="$repo/.tmux.conf.local"
natilius_config="$repo/.natiliusrc"

failures=0

report() {
    printf '%-28s %s\n' "$1" "$2"
}

check_link() {
    local source="$1"
    local target="$2"

    if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
        report "$target" ready
        return
    fi

    report "$target" drift
    failures=$((failures + 1))
    [[ "$mode" == "apply" ]] || return 0

    mkdir -p "$(dirname "$target")"
    if [[ -e "$target" || -L "$target" ]]; then
        if [[ -e "$target" && ! -L "$target" ]] && cmp -s "$source" "$target"; then
            rm -rf "$target"
        else
            mv "$target" "$target.pre-terminal-sync.$(date +%Y%m%d%H%M%S).bak"
        fi
    fi
    ln -s "$source" "$target"
}

check_absent() {
    local target="$1"
    local legacy_source="${2:-}"

    if [[ ! -e "$target" && ! -L "$target" ]]; then
        report "$target" ready
        return
    fi

    report "$target" drift
    failures=$((failures + 1))
    [[ "$mode" == "apply" ]] || return 0

    if [[ -n "$legacy_source" && -L "$target" && "$(readlink "$target")" == "$legacy_source" ]]; then
        unlink "$target"
    else
        mv "$target" "$target.pre-terminal-sync.$(date +%Y%m%d%H%M%S).bak"
    fi
}

has_meslo_font_payload() {
    find "$HOME/Library/Fonts" /Library/Fonts -maxdepth 1 -type f \
        -iname 'MesloLGL*NerdFontMono-Regular.*' -print -quit 2>/dev/null | grep -q .
}

declared_font_casks() {
    awk '
        /^[[:space:]]*# Fonts[[:space:]]*$/ { in_fonts=1; next }
        in_fonts && /^[[:space:]]*\)/ { exit }
        in_fonts && match($0, /"font-[^"]+"/) {
            print substr($0, RSTART + 1, RLENGTH - 2)
        }
    ' "$natilius_config"
}

sync_font_pack() {
    local cask
    local installed
    local missing=()
    local total=0

    command -v brew >/dev/null 2>&1 || {
        report Homebrew missing
        failures=$((failures + 1))
        return
    }
    installed="$(brew list --cask 2>/dev/null || true)"
    while IFS= read -r cask; do
        [[ -n "$cask" ]] || continue
        total=$((total + 1))
        if ! grep -qxF "$cask" <<<"$installed"; then
            missing+=("$cask")
        fi
    done < <(declared_font_casks)

    if [[ "${#missing[@]}" -eq 0 ]]; then
        report "terminal font pack ($total)" ready
        return
    fi

    report "terminal font pack ($total)" "drift missing=${#missing[@]}"
    failures=$((failures + 1))
    [[ "$mode" == "apply" ]] || return 0
    brew install --cask "${missing[@]}"
}

repair_font() {
    if has_meslo_font_payload; then
        report "MesloLGL Nerd Font Mono" ready
        return
    fi

    report "MesloLGL Nerd Font Mono" drift
    failures=$((failures + 1))
    [[ "$mode" == "apply" ]] || return 0

    command -v brew >/dev/null 2>&1 || {
        report Homebrew missing
        return 1
    }
    if brew list --cask font-meslo-lg-nerd-font >/dev/null 2>&1; then
        brew reinstall --cask font-meslo-lg-nerd-font
    else
        brew install --cask font-meslo-lg-nerd-font
    fi
    has_meslo_font_payload
}

configure_terminal_font() {
    [[ "$mode" == "apply" ]] || return 0
    command -v osascript >/dev/null 2>&1 || return 0
    python3 - <<'PY' >/dev/null 2>&1 || true
import subprocess

try:
    subprocess.run(
        [
            "osascript",
            "-e", 'tell application "Terminal"',
            "-e", 'set font name of default settings to "MesloLGL Nerd Font Mono"',
            "-e", "set font size of default settings to 12",
            "-e", "end tell",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=8,
        check=False,
    )
except subprocess.TimeoutExpired:
    pass
PY
}

validate_ghostty() {
    local binary="/Applications/Ghostty.app/Contents/MacOS/ghostty"
    local effective_config
    local expected_stack
    local font_key
    local font_stack
    local fonts_ready=1
    if [[ ! -x "$binary" ]]; then
        report Ghostty missing
        failures=$((failures + 1))
        return
    fi
    effective_config="$($binary +show-config 2>/dev/null || true)"
    for font_key in font-family font-family-bold font-family-italic font-family-bold-italic; do
        font_stack="$(grep "^$font_key = " <<<"$effective_config" || true)"
        expected_stack="$font_key = Monaco"$'\n'"$font_key = MesloLGL Nerd Font Mono"
        [[ "$font_stack" == "$expected_stack" ]] || fonts_ready=0
    done
    if [[ "$fonts_ready" -eq 1 ]]; then
        report "Ghostty effective config" ready
    else
        report "Ghostty effective config" drift
        failures=$((failures + 1))
    fi
}

reload_tmux() {
    if ! command -v tmux >/dev/null 2>&1; then
        report tmux missing
        failures=$((failures + 1))
        return
    fi
    if tmux list-sessions >/dev/null 2>&1; then
        if [[ "$mode" == "apply" ]]; then
            tmux source-file "$HOME/.tmux.conf"
        fi
        report "tmux live config" ready
    else
        report "tmux live config" idle
    fi
}

[[ "$(uname -s)" == Darwin ]] || {
    printf 'terminal-sync currently supports macOS only\n' >&2
    exit 2
}
[[ -f "$ghostty_config" && -f "$tmux_config" && -f "$tmux_local_config" ]] || {
    printf 'dotfiles terminal sources are incomplete under %s\n' "$repo" >&2
    exit 2
}

check_absent "$HOME/.config/ghostty" "$ghostty_source"
check_link "$ghostty_config" "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
check_link "$tmux_config" "$HOME/.tmux.conf"
check_link "$tmux_local_config" "$HOME/.tmux.conf.local"
repair_font
sync_font_pack
configure_terminal_font
validate_ghostty
reload_tmux

if [[ "$mode" == "check" && "$failures" -gt 0 ]]; then
    printf '\nrun terminal-sync --apply to repair %d drift item(s)\n' "$failures" >&2
    exit 1
fi

if [[ "$mode" == "apply" ]]; then
    failures=0
    has_meslo_font_payload || failures=$((failures + 1))
    while IFS= read -r cask; do
        brew list --cask "$cask" >/dev/null 2>&1 || failures=$((failures + 1))
    done < <(declared_font_casks)
    [[ ! -e "$HOME/.config/ghostty" && ! -L "$HOME/.config/ghostty" ]] || failures=$((failures + 1))
    [[ -L "$HOME/.tmux.conf" && "$(readlink "$HOME/.tmux.conf")" == "$tmux_config" ]] || failures=$((failures + 1))
    [[ "$failures" -eq 0 ]] || exit 1
    printf '\nterminal parity applied; open a new Ghostty window if an existing window cached the old font\n'
fi
