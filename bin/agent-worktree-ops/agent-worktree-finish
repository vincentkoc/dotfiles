def process_one(db, row, args):
    if args.command == "recover-missing":
        return recover_missing(db, row, args)
    if args.command == "reconcile":
        if args.unstarted_removal:
            reconcile_unstarted(db, row, args)
            return summary(db, get_row(db, args.worktree))
        if args.external_removal:
            reconcile_external(db, row, args)
            return summary(db, row)
        reconcile(db, row, args)
        return summary(db, row, reason="target-removal-reconciled-original-proof-retained")
    if args.command == "remove":
        reason = remove_finalized(db, row, args)
        return summary(db, row, reason=reason)
    if args.command in ("finish", "release", "resume", "pin", "unpin"):
        storage_guard()
        ensure_owner_schema(db)
        item = retirement(db, row)
        if item is not None and item["state"] != "enrolled":
            raise Retain("removal-intent-requires-read-only-reconciliation")
    if args.command == "cancel":
        cancel(db, row, args)
    elif args.command == "finish":
        selected = acknowledged_owner_row(db, row, owner_id(args)) if args.acknowledge_device_renumbering else row
        finish(db, selected, args)
    elif args.command == "resume":
        who = owner_id(args)
        resumed = acknowledged_owner_row(db, row, who) if args.acknowledge_device_renumbering else row
        claim(db, resumed, who)
    elif args.command in ("pin", "unpin"):
        if not args.reason or len(args.reason) > 500:
            raise Retain("pin-reason-required")
        who = owner_id(args)
        if args.command == "pin":
            claim(db, row, who)
            with db:
                db.execute(
                    "INSERT OR IGNORE INTO pins VALUES (?, ?, ?)",
                    (row["id"], who, args.reason),
                )
        else:
            with db:
                changed = db.execute(
                    "DELETE FROM pins WHERE worktree_id = ? AND owner = ? AND reason = ?",
                    (row["id"], who, args.reason),
                ).rowcount
            if not changed:
                raise Retain("no-matching-owner-pin")
    elif args.command == "check":
        if cancellation_rows(db, row["id"]):
            try:
                snap = revalidate(row)
            except (Retain, OSError, ValueError) as error:
                reason = str(error) if isinstance(error, Retain) else "cancellation-check-unavailable"
                with db:
                    db.execute("UPDATE worktrees SET checked_at=? WHERE id=?",
                               (int(time.time()), row["id"]))
                return summary(db, row, reason=reason)
            with db:
                db.execute("DELETE FROM owner_cancellations WHERE worktree_id=? AND head!=?",
                           (row["id"], snap["head"]))
            if cancellation_rows(db, row["id"]):
                with db:
                    db.execute("UPDATE worktrees SET checked_at=? WHERE id=?",
                               (int(time.time()), row["id"]))
                return summary(db, row)
        if retirement(db, row) is None:
            check(db, row)
    current = db.execute(
        "SELECT * FROM worktrees WHERE id = ?", (row["id"],)
    ).fetchone()
    if args.command == "finish" and args.acknowledge_device_renumbering:
        # Completion is useful even when the historical device binding prevents
        # release. Preserve that binding and stop before every disposal path.
        return summary(db, current)
    if args.command == "release" or (args.command == "finish" and (
            args.release or retirement(db, current) is not None)):
        release(db, current, args)
        if args.policy is not None:
            capture_release_inventory(db, current, args)
    if args.command in ("finish", "release", "check") and retirement(db, current) is not None:
        reason = evaluate_release(db, current, args,
                                  apply=args.command in ("finish", "release") or args.apply)
        # Foreground closeout has priority and needs no automatic baseline.
        # Only a retained, still-enrolled owner release hands off to the worker.
        item = retirement(db, current)
        if (args.command in ("finish", "release") and args.policy is None
                and item["state"] == "enrolled"):
            capture_release_inventory(db, current, args)
        with db:
            db.execute("UPDATE worktrees SET reason=?, checked_at=? WHERE id=?",
                       (reason, int(time.time()), row["id"]))
        current = db.execute("SELECT * FROM worktrees WHERE id=?", (row["id"],)).fetchone()
    return summary(db, current)


@diagnostic_phase("dispatch")
def main(argv=None):
    args = parser().parse_args(argv)
    safety().DEADLINE = time.monotonic() + 238
    if args.removal_receipt and (args.command != "status" or not args.read_only or args.all):
        raise Retain("removal-receipt-requires-one-read-only-status")
    if args.unstarted_removal and (args.command != "reconcile" or args.external_removal):
        raise Retain("unstarted-removal-requires-exact-reconciliation")
    if args.preserve_ref and not (args.command == "remove" and args.finalized):
        raise Retain("preserve-ref-requires-manual-finalized-removal")
    if args.command == "recover-failed-creation":
        allowed = {"command", "worktree", "managed_root", "state_dir", "owner", "worktree_id",
                   "generation", "result_sha256", "expected_head", "creation_token",
                   "acknowledge_unrecorded_creation", "acknowledge_device_renumbering", "apply", "recovery_sha256"}
        if (any(value is not None and value is not False and value != []
                for name, value in vars(args).items() if name not in allowed)
                or not args.acknowledge_unrecorded_creation or not Path(args.worktree).is_absolute()
                or not args.worktree_id or str(uuid.UUID(args.worktree_id)) != args.worktree_id
                or not args.creation_token or str(uuid.UUID(args.creation_token)) != args.creation_token
                or args.generation is None or args.generation < 0
                or not args.result_sha256 or not re.fullmatch(r"[0-9a-f]{64}", args.result_sha256)
                or not args.expected_head or not SHA.fullmatch(args.expected_head)
                or (args.apply and not args.recovery_sha256)
                or (args.recovery_sha256 and not re.fullmatch(r"[0-9a-f]{64}", args.recovery_sha256))):
            raise Retain("failed-creation-needs-exact-audited-creation-and-prior-receipt")
        with (ledger(args.state_dir) if args.apply else read_only_ledger(args.state_dir)) as db:
            if db is None:
                raise Retain("not-enrolled")
            result = recover_failed_creation(db, get_row(db, args.worktree), args)
        print(json.dumps([result], sort_keys=True))
        return 1 if args.apply and result["checkout"] != "removed" else 0
    if args.command != "orphan-locks" and (args.orphan_path or args.missing_path_id
                                           or args.prior_identity_file is not None):
        raise Retain("orphan-options-require-orphan-locks")
    if (args.creation_token or args.acknowledge_unrecorded_creation) and args.command != "orphan-locks":
        raise Retain("creation-recovery-options-require-recover-failed-creation")
    if args.command == "orphan-locks":
        allowed = {"command", "worktree", "managed_root", "state_dir", "owner", "apply",
                   "orphan_path", "missing_path_id", "creation_token", "expected_head", "recovery_sha256",
                   "allow_device_renumbering", "prior_identity_file"}
        if not Path(args.worktree).is_absolute() or any(
                value is not None and value is not False and value != []
                for name, value in vars(args).items() if name not in allowed):
            raise Retain("orphan-locks-needs-one-owning-checkout")
        if args.orphan_path is not None:
            if len(args.orphan_path) != 1:
                raise Retain("orphan-needs-one-exact-path")
            args.orphan_path = args.orphan_path[0]
            if args.allow_device_renumbering != (args.prior_identity_file is not None):
                raise Retain("orphan-renumbering-needs-opt-in-and-prior-identity")
            if args.prior_identity_file is not None:
                if len(args.prior_identity_file) != 1 or not Path(args.prior_identity_file[0]).is_absolute():
                    raise Retain("orphan-needs-one-absolute-prior-identity-file")
                args.prior_identity_file = args.prior_identity_file[0]
            if (not Path(args.orphan_path).is_absolute()
                    or os.path.normpath(args.orphan_path) != args.orphan_path
                    or not args.creation_token or str(uuid.UUID(args.creation_token)) != args.creation_token
                    or not SHA.fullmatch(args.expected_head or "")
                    or not re.fullmatch(r"(0|[1-9][0-9]*):[1-9][0-9]*", args.missing_path_id or "")
                    or (args.apply and not args.recovery_sha256)
                    or (args.recovery_sha256 and not re.fullmatch(r"[0-9a-f]{64}", args.recovery_sha256))):
                raise Retain("orphan-needs-exact-path-token-head-inode-and-reviewed-plan")
        elif any((args.creation_token, args.expected_head, args.missing_path_id, args.recovery_sha256,
                  args.allow_device_renumbering, args.prior_identity_file is not None)):
            raise Retain("orphan-proof-requires-exact-path")
        # Absent lifecycle state cannot prove that a gwt lock is unrecorded.
        with (ledger(args.state_dir) if args.apply else read_only_ledger(args.state_dir)) as db:
            if db is None:
                raise Retain("orphan-locks-need-lifecycle-state")
            result = orphan_locks(db, args)
        print(json.dumps(result, sort_keys=True))
        return 1 if args.apply and any(item["disposition"] not in ("pruned", "retained")
                                       for item in result) else 0
    if args.command == "creation-check":
        allowed = {"command", "worktree", "managed_root", "state_dir", "owner"}
        if (not Path(args.worktree).is_absolute() or any(
                value is not None and value is not False and value != []
                for name, value in vars(args).items() if name not in allowed)):
            raise Retain("creation-check-needs-one-absolute-path")
        with read_only_ledger(args.state_dir) as db:
            if db is not None and db.execute("SELECT 1 FROM worktrees WHERE path=?",
                                             (str(Path(args.worktree).resolve()),)).fetchone():
                raise Retain("already-enrolled-or-path-reused")
        return 0
    # Acknowledgment permits identity selection only; new action options must
    # never silently inherit permission to mutate an existing enrollment.
    if args.acknowledge_device_renumbering:
        allowed = {"command", "worktree", "managed_root", "state_dir", "owner",
                   "acknowledge_device_renumbering"}
        if args.command == "finish":
            allowed.update({"pr", "target", "wait_for"})
        elif args.command == "cancel":
            allowed.update({"reason", "acknowledge_repository_rename"})
        elif args.command == "remove":
            allowed.update({"finalized", "discard_ignored", "preserve_ref", "sudo_holder_scan",
                            "acknowledge_repository_rename"})
        if args.command not in ("resume", "finish", "cancel", "remove") or any(
                value is not None and value is not False and value != []
                for name, value in vars(args).items() if name not in allowed):
            raise Retain("device-acknowledgement-requires-explicit-resume-or-retained-finish")
    if args.acknowledge_repository_rename is not None:
        allowed = {"command", "worktree", "managed_root", "state_dir", "owner",
                   "acknowledge_repository_rename", "acknowledge_device_renumbering"}
        allowed.update({"reason"} if args.command == "cancel" else
                       {"finalized", "discard_ignored", "preserve_ref", "sudo_holder_scan"})
        if (args.command not in ("cancel", "remove") or (args.command == "remove" and not args.finalized)
                or any(value is not None and value is not False and value != []
                       for name, value in vars(args).items() if name not in allowed)):
            raise Retain("repository-rename-acknowledgement-requires-missing-cancel-or-finalized-remove")
    if args.sudo_holder_scan and not (args.command == "remove" and args.finalized):
        raise Retain("sudo-holder-scan-requires-manual-finalized-removal")
    if args.sudo_holder_scan and sys.platform != "linux":
        raise Retain("sudo-holder-scan-requires-linux")
    reconciliation_options = (args.intent_id, args.generation, args.intent_sha256, args.result_sha256,
                              args.worktree_id)
    if args.command == "recover-missing":
        if (args.pr or args.target or args.wait_for or args.policy or args.all or args.release
                or args.new_token or args.if_enrolled or args.finalized or args.discard_ignored
                or args.external_removal or args.intent_sha256 or args.result_sha256 or args.reason
                or args.generation is None or args.generation < 0 or not args.worktree_id
                or str(uuid.UUID(args.worktree_id)) != args.worktree_id
                or not args.expected_head or not re.fullmatch(r"[0-9a-f]{40}", args.expected_head)
                or not args.index_sha256 or not re.fullmatch(r"[0-9a-f]{64}", args.index_sha256)
                or (args.apply and not args.recovery_sha256)
                or (args.continue_partial and (not args.intent_id or not args.recovery_sha256))
                or (args.recovery_sha256 and not re.fullmatch(r"[0-9a-f]{64}", args.recovery_sha256))
                or (args.intent_id and str(uuid.UUID(args.intent_id)) != args.intent_id)):
            raise Retain("recovery-needs-exact-record-head-index-generation")
    elif (args.expected_head or args.index_sha256 or args.recovery_sha256
          or args.allow_device_renumbering or args.continue_partial):
        raise Retain("recovery-options-require-recover-missing")
    elif args.command == "reconcile":
        if (args.pr or args.target or args.wait_for or args.policy or args.all or args.apply
                or args.release or args.new_token or args.if_enrolled or args.finalized or args.discard_ignored
                or args.generation is None or args.generation < 0):
            raise Retain("reconciliation-needs-one-exact-record-and-generation")
        if args.external_removal:
            if (args.intent_id or args.intent_sha256 or args.result_sha256
                    or not args.worktree_id or str(uuid.UUID(args.worktree_id)) != args.worktree_id
                    or not args.reason or not args.reason.strip() or len(args.reason) > 500):
                raise Retain("external-reconciliation-needs-record-id-and-bounded-reason")
        elif (args.worktree_id or args.reason
                or not args.intent_id or str(uuid.UUID(args.intent_id)) != args.intent_id
                or any(not value or not re.fullmatch(r"[0-9a-f]{64}", value)
                       for value in (args.intent_sha256, args.result_sha256))):
            raise Retain("reconciliation-needs-one-exact-intent-and-receipt-hashes")
    elif args.external_removal or any(value is not None for value in reconciliation_options):
        raise Retain("reconciliation-options-require-reconcile")
    if args.command == "cancel":
        if (args.pr or args.target or args.wait_for or args.all or args.apply
                or args.release or args.policy or args.new_token or args.if_enrolled):
            raise Retain("cancellation-does-not-accept-completion-or-removal-options")
        if not args.reason or not args.reason.strip() or len(args.reason) > 500:
            raise Retain("bounded-cancellation-reason-required")
    if args.command == "creation-token":
        print(uuid.uuid4())
        return 0
    if args.command == "remove":
        if not args.finalized:
            raise Retain("use-explicit-owner-release")
        if (args.pr or args.target or args.wait_for or args.all or args.apply
                or args.release or args.policy or args.new_token or args.if_enrolled):
            raise Retain("finalized-removal-is-one-explicit-worktree")
    elif args.finalized:
        raise Retain("finalized-options-require-remove")
    if args.discard_ignored:
        if args.command not in ("finish", "release", "remove"):
            raise Retain("discard-ignored-requires-owner-finish-release-or-finalized-remove")
        if len(args.discard_ignored) != len(set(args.discard_ignored)) or any(
                not value or value.startswith("/") or any(
                    part in ("", ".", "..", ".git") for part in value.split("/"))
                for value in args.discard_ignored):
            raise Retain("discard-ignored-needs-literal-relative-roots")
    if args.apply and args.command not in ("check", "recover-missing"):
        raise Retain("apply-is-only-valid-for-check")
    if args.policy and args.command not in ("finish", "release", "check"):
        raise Retain("policy-is-only-valid-for-finish-release-or-check")
    if args.policy and args.command == "check" and not args.all:
        raise Retain("report-policy-requires-check-all")
    if args.release and args.command != "finish":
        raise Retain("release-flag-is-only-valid-for-finish")
    if args.new_token and (args.command != "enroll" or str(uuid.UUID(args.new_token)) != args.new_token):
        raise Retain("new-enrollment-token-invalid")
    if args.all and args.command not in ("status", "check", "guard"):
        raise Retain("all-is-only-valid-for-status-check-or-guard")
    if args.read_only and args.command != "status":
        raise Retain("read-only-is-only-valid-for-status")
    if args.command == "finish" and (not args.pr or len(args.wait_for) > 16):
        raise Retain("finish-requires-primary-pr-and-at-most-16-dependencies")
    if args.command == "holder-qualification":
        print(json.dumps(holder_qualification(), sort_keys=True))
        return 0

    allowed = None
    if args.command == "check" and args.policy:
        policy = report_policy(args.policy, apply=args.apply)
        allowed = policy[0] if args.apply else policy
    if args.all and args.apply and not args.policy:
        raise Retain("batch-apply-requires-explicit-release-policy")
    if args.command == "guard":
        with diagnostic_phase("state-session"), ledger(args.state_dir) as db:
            guard(db, args.worktree, owner=args.all)
        return 0
    if args.read_only:
        with diagnostic_phase("state-session"), read_only_ledger(args.state_dir) as db:
            if db is None:
                if not args.all:
                    raise Retain("not-enrolled")
                output = []
            elif args.all:
                output = [summary(db, row) for row in db.execute(
                    "SELECT * FROM worktrees ORDER BY path")]
            else:
                output = [summary(db, get_row(db, args.worktree))]
                if args.removal_receipt:
                    output[0]["removal_receipt"] = removal_receipt(db, get_row(db, args.worktree))
        print(json.dumps(output, sort_keys=True))
        return 0
    if args.all:
        with diagnostic_phase("state-session"), ledger(args.state_dir) as db:
            if db is None:
                print("[]")
                return 0
            if args.command == "status":
                print(json.dumps([
                    summary(db, row)
                    for row in db.execute("SELECT * FROM worktrees ORDER BY path")
                ], sort_keys=True))
                return 0
            rows = db.execute(
                "SELECT * FROM worktrees ORDER BY COALESCE(checked_at, 0), path"
            )
            paths = [
                row["path"] for row in rows
                if allowed is None or policy_allows(row, allowed)
            ][:16]
        output = []
        for path in paths:
            with diagnostic_phase("state-session"), ledger(args.state_dir) as db:
                row = get_row(db, path)
                result = process_one(db, row, args)
                output.append(result)
                if (result["checkout"] == "unknown"
                        and result.get("current_disposition") != "reconciled-target-removed"):
                    break
        print(json.dumps(output, sort_keys=True))
        return 0

    # A new private checkout is already locked in Git. Give its original
    # enrollment a chance to finish before leaving it without a lifecycle row.
    with diagnostic_phase("state-session"), ledger(
        args.state_dir, create=args.command == "enroll", wait_seconds=10 if args.new_token else 0
    ) as db:
        if args.command == "enroll":
            storage_guard()
            lock_reason = "gwt-finish.v2:" + args.new_token if args.new_token else None
            snap = snapshot(args.worktree, args.managed_root, lock_reason)
            if args.new_token:
                # The wrapper creates ONLY this new checkout/admin with umask
                # 077. Never chmod an existing owner or adopt a legacy row.
                for key in ("path", "gitdir"):
                    details = Path(snap[key]).lstat()
                    if details.st_mode & 0o077:
                        raise Retain("new-checkout-and-admin-must-be-private")
            if db.execute(
                "SELECT 1 FROM worktrees WHERE path = ?", (snap["path"],)
            ).fetchone():
                raise Retain("already-enrolled-or-path-reused")
            worktree_id = str(uuid.uuid4())
            who = owner_id(args)
            ensure_owner_schema(db)
            with db:
                db.execute(
                    "INSERT INTO worktrees(id, path, identity, created_at, state, reason) "
                    "VALUES (?, ?, ?, ?, 'active', 'owner-active')",
                    (
                        worktree_id,
                        snap["path"],
                        json.dumps(immutable(snap), sort_keys=True),
                        int(time.time()),
                    ),
                )
                db.execute(
                    "INSERT INTO owners(worktree_id, owner, completed) VALUES (?, ?, 0)",
                    (worktree_id, who),
                )
                if args.new_token:
                    db.execute("INSERT INTO retirement(worktree_id, holder_contract) VALUES (?, ?)",
                               (worktree_id, safety().HOLDER_COVERAGE))
        try:
            row = get_row(db, args.worktree)
        except Retain:
            if args.if_enrolled and args.command == "resume":
                return 0
            raise
        result = process_one(db, row, args)
        print(json.dumps([result], sort_keys=True))
        return 1 if args.command == "remove" and result["checkout"] != "removed" else 0


def cli(argv=None):
    try:
        return main(argv)
    except (Retain, OSError, sqlite3.Error, ValueError) as error:
        reason = str(error) if isinstance(error, Retain) else "state-or-proof-unavailable"
        diagnostic = (" " + failure_diagnostic(error)
                      if not isinstance(error, Retain) or hasattr(error, "_gwt_child_diagnostic") else "")
        if reason in ("missing-closeout-identity-changed", "missing-closeout-boundary-changed"):
            diagnostic += ("; if only device numbers changed (same inodes), the recorded owner can "
                           "pass --acknowledge-device-renumbering to gwt cancel or gwt rm --finalized "
                           "for this missing checkout")
        if reason == "missing-closeout-owner-binding-changed":
            diagnostic += ("; if the GitHub repository was renamed, the recorded owner can pass "
                           "--acknowledge-repository-rename <old-owner/old-name>=<new-owner/new-name> "
                           "to gwt cancel or gwt rm --finalized for this missing checkout")
        if reason == "worktree-identity-changed":
            diagnostic += ("; inspect recorded/current identities first; device-only renumbering "
                           "can be acknowledged by the recorded owner with gwt resume "
                           "--acknowledge-device-renumbering --worktree <path> (resume only)")
        print(f"gwt finish: stopped; inspect finish-status for checkout outcome ({reason}){diagnostic}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(cli())
