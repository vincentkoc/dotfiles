HOLDER_SCHEMA = "gwt-finish-holder-qualification.v1"
POLICY_SCHEMA = "gwt-finish-policy.v1"
APPLY_POLICY_SCHEMA = "gwt-finish-policy.v2"
PR_URL = re.compile(r"https://github\.com/([\w.-]+/[\w.-]+)/pull/([1-9][0-9]*)/?\Z")
SHA = re.compile(r"[0-9a-f]{40}(?:[0-9a-f]{24})?\Z")
NATIVE_GIT = None


class Retain(RuntimeError):
    pass


# State sessions span ledger setup, command execution, and teardown.
FAILURE_PHASES = frozenset({
    "dispatch", "state-session", "owner-schema", "retirement-schema",
    "worktree-identity", "github-pr-proof", "github-target-proof", "completion",
})


@contextlib.contextmanager
def diagnostic_phase(phase):
    try:
        yield
    except (OSError, sqlite3.Error, ValueError) as error:
        current = getattr(error, "_gwt_failure_phase", None)
        if not isinstance(current, str) or current not in FAILURE_PHASES:
            error._gwt_failure_phase = phase
        raise


def failure_diagnostic(error):
    # Never render exception text, class names, paths, SQL or traceback data.
    # Optional numeric attributes also work on Python versions before 3.11.
    if isinstance(error, Retain):
        source = getattr(error, "_gwt_child_diagnostic", {})
        details = {"category": "child-error"}
        codes = {"deadline", "input-limit", "output-limit", "descriptor-limit",
                 "cleanup-incomplete", "os-error", "supervisor-error", "exit-status"}
        cause = source.get("cause")
        details["cause"] = cause if isinstance(cause, str) and cause in codes else "supervisor-error"
        for key in ("returncode", "errno", "stdout_bytes", "stderr_bytes"):
            if type(source.get(key)) is int:
                details[key] = source[key]
        for key in ("started", "reaped", "group_absent"):
            if type(source.get(key)) is bool or source.get(key) is None:
                details[key] = source.get(key)
        return json.dumps(details, sort_keys=True)
    if isinstance(error, OSError):
        category, attributes = "os-error", ("errno", "winerror")
    elif isinstance(error, sqlite3.Error):
        category, attributes = "sqlite-error", ("sqlite_errorcode",)
    else:
        category, attributes = "value-error", ()
    phase = getattr(error, "_gwt_failure_phase", None)
    if not isinstance(phase, str) or phase not in FAILURE_PHASES:
        phase = "dispatch"
    details = {"category": category, "phase": phase}
    for attribute in attributes:
        value = getattr(error, attribute, None)
        if type(value) is int:
            details[attribute] = value
    return json.dumps(details, sort_keys=True)


@functools.lru_cache(maxsize=1)
def safety():
    # The installed sibling is part of this owner, not a PATH-selected backend.
    path = Path(__file__).resolve().with_name("gwt_finish_safety.py")
    source = path.read_bytes()
    module = types.ModuleType("gwt_finish_safety")
    module.__file__ = str(path)
    exec(compile(source, str(path), "exec"), module.__dict__)
    module.source_sha256 = hashlib.sha256(source).hexdigest()
    module.Retain = Retain
    return module


def run(command, *, cwd=None, allowed=(0,), limit=1024 * 1024, input_data=None, deadline=None,
        stdout_sink=None, attribute_objects=None):
    env = {key: value for key, value in os.environ.items()
           if not key.startswith(("DYLD_", "LD_"))}
    if Path(command[0]).name == "git":
        env = {key: value for key, value in env.items() if not key.startswith("GIT_")}
        env.update(GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1",
                   GIT_ALLOW_PROTOCOL="")
        if attribute_objects is not None:
            env.update(GIT_OBJECT_DIRECTORY=str(attribute_objects), GIT_ATTR_NOSYSTEM="1")
    env.update(GIT_OPTIONAL_LOCKS="0", GIT_NO_LAZY_FETCH="1",
               GIT_TERMINAL_PROMPT="0", GH_PROMPT_DISABLED="1", LC_ALL="C")
    result = safety().supervise(command, cwd=cwd, env=env, limit=limit, input_data=input_data,
                                deadline=deadline, stdout_sink=stdout_sink)
    if result.failure or result.returncode not in allowed:
        error = Retain(f"{Path(command[0]).name}-failed")
        proof = result.proof
        error._gwt_child_diagnostic = {
            "cause": result.failure_code if result.failure else "exit-status",
            "returncode": result.returncode, "errno": result.failure_errno,
            "stdout_bytes": getattr(result, "stdout_bytes", len(result.stdout)),
            "stderr_bytes": getattr(result, "stderr_bytes", len(result.stderr)),
            "started": proof.get("pid") is not None,
            "reaped": proof.get("reaped"), "group_absent": proof.get("group_absent")}
        raise error
    return result


def git(path, *args, input_data=None, raw=False, strict=False, deadline=None, capture_limit=None,
        stdout_sink=None, attribute_objects=None):
    result = run([
        NATIVE_GIT or "git",
        "-c", "core.hooksPath=/dev/null",
        "-c", "core.fsmonitor=false",
        "-c", "core.untrackedCache=false",
        "-c", "gc.auto=0",
        "-c", "maintenance.auto=false",
        "-c", "protocol.allow=never",
        "-C", str(path),
        *args,
    ], limit=(capture_limit if capture_limit is not None else
              32 * 1024 * 1024 if args and args[0] == "ls-tree" else
              safety().LEAF_LIMIT if args and args[0] in ("show", "stripspace") else 1024 * 1024),
        input_data=input_data, deadline=deadline, stdout_sink=stdout_sink,
        attribute_objects=attribute_objects)
    if strict and result.stderr:
        raise Retain("git-diagnostic")
    return result.stdout if raw else result.stdout.decode(errors="surrogateescape").rstrip("\n")


def physical(path):
    return str(Path(path).expanduser().resolve(strict=True))


def inside(child, parent):
    return child == parent or child.startswith(parent.rstrip("/") + "/")


def identity(path):
    details = os.lstat(path)
    if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid():
        raise Retain("directory-identity-unsafe")
    return [details.st_dev, details.st_ino]


def records(owner):
    fields = git(owner, "worktree", "list", "--porcelain", "-z").split("\0")
    result, item = [], {}
    for field in fields:
        if not field:
            if item:
                result.append(item)
                item = {}
            continue
        key, _, value = field.partition(" ")
        item[key] = value
    if item:
        result.append(item)
    return result


def repository(origin):
    match = re.fullmatch(
        r"(?:https://github\.com/|ssh://git@github\.com/|git@github\.com:)"
        r"([\w.-]+/[\w.-]+?)(?:\.git)?/?",
        origin,
    )
    if not match:
        raise Retain("origin-is-not-an-unambiguous-github-repository")
    return match[1].lower()


@diagnostic_phase("worktree-identity")
def snapshot(path, managed_root, lock_reason=None):
    path = physical(path)
    managed_root = physical(managed_root)
    if not inside(path, managed_root) or path == managed_root:
        raise Retain("outside-managed-root")
    if not (Path(path) / ".git").is_file() or (Path(path) / ".git").is_symlink():
        raise Retain("not-a-linked-worktree")

    common = physical(git(path, "rev-parse", "--path-format=absolute", "--git-common-dir"))
    gitdir = physical(git(path, "rev-parse", "--absolute-git-dir"))
    listed = records(path)
    if not listed:
        raise Retain("registration-missing")
    owner = physical(listed[0]["worktree"])
    if owner == path or inside(owner, managed_root):
        raise Retain("canonical-owner-required")
    matching = [row for row in listed if row.get("worktree") == path]
    if (len(matching) != 1 or "prunable" in matching[0]
            or matching[0].get("locked") != lock_reason):
        raise Retain("registration-missing-or-locked")
    branch = matching[0].get("branch", "")
    if not branch.startswith("refs/heads/"):
        raise Retain("named-local-branch-required")
    head = git(path, "rev-parse", "HEAD")
    if not SHA.fullmatch(head):
        raise Retain("invalid-head")
    if git(owner, "rev-parse", "--path-format=absolute", "--git-common-dir") != common:
        raise Retain("owner-common-directory-changed")
    result = {
        "path": path,
        "root": managed_root,
        "owner": owner,
        "common": common,
        "gitdir": gitdir,
        "path_id": identity(path),
        "gitdir_id": identity(gitdir),
        "common_id": identity(common),
        "owner_id": identity(owner),
        "branch": branch,
        "repo": repository(git(owner, "remote", "get-url", "origin")),
        "head": head,
    }
    if lock_reason is not None:
        result["lock_reason"] = lock_reason
    return result


def immutable(snap):
    return {key: value for key, value in snap.items() if key != "head"}


def device_renumbering(recorded, current, keys):
    devices = {}
    for key in keys:
        old, new = recorded[key], current[key]
        if old[1] != new[1] or devices.setdefault(old[0], new[0]) != new[0]:
            raise Retain("worktree-identity-changed")
    if len(set(devices.values())) != len(devices):
        raise Retain("worktree-identity-changed")
    return devices


@diagnostic_phase("worktree-identity")
def revalidate(row, *, allow_device_renumbering=False, allow_branch_change=False):
    recorded = json.loads(row["identity"])
    current = snapshot(row["path"], recorded["root"], recorded.get("lock_reason"))
    if allow_branch_change:
        recorded["branch"] = current["branch"]
    if allow_device_renumbering:
        keys = ("path_id", "gitdir_id", "common_id", "owner_id")
        device_renumbering(recorded, current, keys)
        for key in keys:
            recorded[key] = current[key]
    if immutable(current) != recorded:
        raise Retain("worktree-identity-changed")
    return current


def private_file(path):
    details = os.lstat(path)
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or details.st_nlink != 1 or details.st_mode & 0o077):
        raise Retain("private-file-permissions-required")
    return details


def host_key():
    if sys.platform != "darwin":
        return socket.gethostname()
    value = run(["scutil", "--get", "LocalHostName"]).stdout.decode().strip()
    if not re.fullmatch(r"[A-Za-z0-9-]{1,63}", value):
        raise Retain("stable-host-identity-unavailable")
    return value


def report_policy(path, *, apply=False):
    path = Path(path)
    if not path.is_absolute() or path.resolve(strict=True) != path:
        raise Retain("report-policy-path-must-be-absolute-and-canonical")
    before = path.lstat()
    if (not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid()
            or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_size > 1024 * 1024):
        raise Retain("private-report-policy-required")
    # Shared nonblocking admission also protects a regular-to-FIFO race;
    # every chunk observes the operation deadline while the ledger is held.
    data, held = safety().read_file(path, time.monotonic() + 10, 1024 * 1024)
    if safety().file_identity(before) != held:
        raise Retain("report-policy-changed-while-reading")
    value = json.loads(data)
    keys = {"schema", "host", "mode", "repositories"}
    if apply:
        keys.add("qualification")
    if (not isinstance(value, dict)
            or set(value) != keys
            or value.get("schema") != (APPLY_POLICY_SCHEMA if apply else POLICY_SCHEMA)
            or value.get("host") != host_key()
            or value.get("mode") != ("explicit-release" if apply else "report-only")
            or not isinstance(value.get("repositories"), list)
            or not 1 <= len(value["repositories"]) <= 8):
        raise Retain("invalid-report-policy")
    allowed = set()
    for item in value["repositories"]:
        if (not isinstance(item, dict)
                or set(item) != {"owner", "root", "common_id"}
                or not isinstance(item.get("owner"), str)
                or not isinstance(item.get("root"), str)
                or not isinstance(item.get("common_id"), list)
                or len(item["common_id"]) != 2
                or any(type(part) is not int or part < 0 for part in item["common_id"])):
            raise Retain("invalid-report-policy")
        allowed.add((
            item["owner"],
            item["root"],
            tuple(item["common_id"]),
        ))
    if len(allowed) != len(value["repositories"]):
        raise Retain("invalid-report-policy")
    return (allowed, value["qualification"]) if apply else allowed


def policy_allows(row, allowed):
    recorded = json.loads(row["identity"])
    return (
        recorded.get("owner"),
        recorded.get("root"),
        tuple(recorded.get("common_id", [])),
    ) in allowed


@contextlib.contextmanager
def ledger(state_dir, *, create=False, wait_seconds=0):
    root = Path(state_dir).expanduser()
    if not os.path.lexists(root):
        if not create:
            yield None
            return
    if not root.is_absolute() or str(root.resolve()) != str(root):
        raise Retain("state-directory-must-be-canonical")
    if not os.path.lexists(root):
        root.mkdir(mode=0o700, parents=True)
    details = root.lstat()
    if (not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid()
            or details.st_mode & 0o077):
        raise Retain("private-state-directory-required")
    if not create and not os.path.lexists(root / "lifecycle.sqlite"):
        yield None
        return

    lock_path = root / "lifecycle.lock"
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    db = None
    try:
        private_file(lock_path)
        deadline = time.monotonic() + wait_seconds if wait_seconds else None
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError as error:
                remaining = deadline - time.monotonic() if deadline is not None else 0
                if remaining <= 0:
                    raise Retain("lifecycle-busy") from error
                time.sleep(min(0.1, remaining))
        if wait_seconds and not os.path.samestat(os.fstat(fd), lock_path.lstat()):
            raise Retain("lifecycle-lock-changed")
        database = root / "lifecycle.sqlite"
        for suffix in ("", "-journal", "-wal", "-shm"):
            candidate = root / ("lifecycle.sqlite" + suffix)
            if os.path.lexists(candidate):
                private_file(candidate)
        if database.exists():
            private_file(database)
        elif not create:
            yield None
            return
        else:
            fresh = os.open(
                database, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600
            )
            os.close(fresh)
        db = sqlite3.connect(database, timeout=1)
        db.row_factory = sqlite3.Row
        db.execute("PRAGMA foreign_keys = ON")
        db.execute("PRAGMA synchronous = FULL")
        db.execute("PRAGMA fullfsync = ON")
        if create:
            db.executescript("""
                CREATE TABLE IF NOT EXISTS worktrees (
                    id TEXT PRIMARY KEY, path TEXT UNIQUE NOT NULL, identity TEXT NOT NULL,
                    created_at INTEGER NOT NULL, observed_at INTEGER, checked_at INTEGER,
                    finish_head TEXT, primary_pr TEXT, target TEXT, dependencies TEXT,
                    state TEXT NOT NULL, reason TEXT NOT NULL);
                CREATE TABLE IF NOT EXISTS owners (
                    worktree_id TEXT NOT NULL REFERENCES worktrees(id), owner TEXT NOT NULL,
                    completed INTEGER NOT NULL DEFAULT 0,
                    PRIMARY KEY (worktree_id, owner));
                CREATE TABLE IF NOT EXISTS pins (
                    worktree_id TEXT NOT NULL REFERENCES worktrees(id), owner TEXT NOT NULL,
                    reason TEXT NOT NULL, PRIMARY KEY (worktree_id, owner, reason));
            """)
            ensure_owner_schema(db)
            ensure_retirement_schema(db)
        yield db
    finally:
        if db is not None:
            db.close()
        os.close(fd)


@contextlib.contextmanager
def read_only_ledger(state_dir):
    root = Path(state_dir).expanduser()
    if not os.path.lexists(root):
        yield None
        return
    if not root.is_absolute() or str(root.resolve()) != str(root):
        raise Retain("state-directory-must-be-canonical")
    details = root.lstat()
    if (not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid()
            or details.st_mode & 0o077):
        raise Retain("private-state-directory-required")
    database = root / "lifecycle.sqlite"
    if not os.path.lexists(database):
        if any(os.path.lexists(root / ("lifecycle.sqlite" + suffix))
               for suffix in ("-journal", "-wal", "-shm")):
            raise Retain("lifecycle-sidecar-requires-recovery")
        yield None
        return
    lock_path = root / "lifecycle.lock"
    if not os.path.lexists(lock_path):
        raise Retain("lifecycle-lock-required-for-read-only-status")
    private_file(lock_path)
    fd = os.open(lock_path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    db = None
    try:
        held = os.fstat(fd)
        current = lock_path.lstat()
        if (not stat.S_ISREG(held.st_mode) or held.st_uid != os.getuid()
                or held.st_nlink != 1 or held.st_mode & 0o077
                or (held.st_dev, held.st_ino) != (current.st_dev, current.st_ino)):
            raise Retain("lifecycle-lock-changed")
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise Retain("lifecycle-busy") from error
        # SQLite immutable reads skip its own locks, so the GWT lock must
        # serialize writers; a journal or WAL requires recovery before audit.
        for suffix in ("-journal", "-wal", "-shm"):
            if os.path.lexists(root / ("lifecycle.sqlite" + suffix)):
                raise Retain("lifecycle-sidecar-requires-recovery")
        before = private_file(database)
        db = sqlite3.connect(database.as_uri() + "?mode=ro&immutable=1", uri=True, timeout=1)
        db.row_factory = sqlite3.Row
        yield db
        after = database.lstat()
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns,
                before.st_ctime_ns) != (after.st_dev, after.st_ino, after.st_size,
                                        after.st_mtime_ns, after.st_ctime_ns):
            raise Retain("lifecycle-changed-during-read-only-status")
        current = lock_path.lstat()
        if (held.st_dev, held.st_ino) != (current.st_dev, current.st_ino):
            raise Retain("lifecycle-lock-changed")
        for suffix in ("-journal", "-wal", "-shm"):
            if os.path.lexists(root / ("lifecycle.sqlite" + suffix)):
                raise Retain("lifecycle-sidecar-requires-recovery")
    finally:
        if db is not None:
            db.close()
        os.close(fd)


@diagnostic_phase("owner-schema")
def ensure_owner_schema(db):
    columns = {row["name"] for row in db.execute("PRAGMA table_info(owners)")}
    if "completed" not in columns:
        with db:
            db.execute("ALTER TABLE owners ADD COLUMN completed INTEGER NOT NULL DEFAULT 0")


@diagnostic_phase("retirement-schema")
def ensure_retirement_schema(db):
    db.executescript("""
        CREATE TABLE IF NOT EXISTS retirement (
            worktree_id TEXT PRIMARY KEY REFERENCES worktrees(id),
            generation INTEGER NOT NULL DEFAULT 0,
            state TEXT NOT NULL DEFAULT 'enrolled', inventory TEXT,
            intent TEXT, result TEXT, holder_contract TEXT);
        CREATE TABLE IF NOT EXISTS owner_releases (
            worktree_id TEXT NOT NULL REFERENCES retirement(worktree_id),
            owner TEXT NOT NULL, generation INTEGER NOT NULL,
            PRIMARY KEY(worktree_id, owner));
    """)
    if "holder_contract" not in {row[1] for row in db.execute("PRAGMA table_info(retirement)")}:
        # Enrollment alone owns this migration. Existing rows stay NULL; neither
        # resuming nor releasing can adopt them into a new deletion contract.
        db.execute("ALTER TABLE retirement ADD COLUMN holder_contract TEXT")
    # These fire for the old client's SQL too. Clearing and later restoring an
    # identical proof must not resurrect a release granted before that resume.
    for table, key, changes in (
        ("owners", "worktree_id", "NEW.completed = 0 OR OLD.owner IS NOT NEW.owner"),
        ("worktrees", "id", "OLD.identity IS NOT NEW.identity OR OLD.path IS NOT NEW.path "
         "OR OLD.finish_head IS NOT NEW.finish_head OR OLD.primary_pr IS NOT NEW.primary_pr "
         "OR OLD.target IS NOT NEW.target OR OLD.dependencies IS NOT NEW.dependencies "
         "OR (NEW.state = 'active' AND OLD.state != 'active')"),
        ("pins", "worktree_id", "1"),
    ):
        for action in ("INSERT", "UPDATE", "DELETE"):
            if table == "worktrees" and action == "INSERT":
                continue
            prefix = "OLD" if action == "DELETE" else "NEW"
            condition = changes if action == "UPDATE" else "1"
            db.executescript(f"""
                CREATE TRIGGER IF NOT EXISTS retirement_{table}_{action.lower()}
                BEFORE {action} ON {table} WHEN {condition}
                BEGIN
                  SELECT CASE WHEN EXISTS (
                    SELECT 1 FROM retirement WHERE worktree_id = {prefix}.{key}
                      AND state != 'enrolled')
                    THEN RAISE(ABORT, 'removal-intent-holds-worktree') END;
                  UPDATE retirement SET generation = generation + 1, inventory = NULL
                    WHERE worktree_id = {prefix}.{key};
                  DELETE FROM owner_releases WHERE worktree_id = {prefix}.{key};
                END;
            """)


def retirement(db, row):
    if db is None or not db.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='retirement'").fetchone():
        return None
    return db.execute("SELECT * FROM retirement WHERE worktree_id=?", (row["id"],)).fetchone()


def automatic_holder_contract(item):
    return (item is not None and "holder_contract" in item.keys()
            and item["holder_contract"] == safety().HOLDER_COVERAGE)


def require_open_retirement(db, row):
    item = retirement(db, row)
    if item is None:
        raise Retain("legacy-enrollment-report-only")
    if item["state"] != "enrolled":
        raise Retain("removal-intent-requires-read-only-reconciliation")
    return item


def owner_id(args):
    runtime_owner = os.environ.get("CODEX_THREAD_ID")
    if runtime_owner and args.owner and args.owner != runtime_owner:
        raise Retain("owner-conflicts-with-live-thread")
    value = runtime_owner or args.owner or os.environ.get("GWT_OWNER_ID")
    if not value or len(value) > 200 or any(ord(char) < 32 for char in value):
        raise Retain("set-GWT_OWNER_ID-or-pass-owner")
    return value


def cancellation_rows(db, worktree_id):
    if not db.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='owner_cancellations'").fetchone():
        return []
    return [dict(item) for item in db.execute(
        "SELECT owner, head, reason, recorded_at FROM owner_cancellations "
        "WHERE worktree_id=? ORDER BY owner", (worktree_id,))]


def ensure_cancellation_schema(db):
    db.executescript("""
        CREATE TABLE IF NOT EXISTS owner_cancellations (
            worktree_id TEXT NOT NULL, owner TEXT NOT NULL, head TEXT NOT NULL,
            reason TEXT NOT NULL, recorded_at INTEGER NOT NULL,
            PRIMARY KEY(worktree_id, owner),
            FOREIGN KEY(worktree_id, owner) REFERENCES owners(worktree_id, owner)
                ON DELETE CASCADE);
        CREATE TRIGGER IF NOT EXISTS cancellation_owner_update
        AFTER UPDATE ON owners BEGIN
            DELETE FROM owner_cancellations
              WHERE worktree_id=OLD.worktree_id AND owner=OLD.owner;
        END;
        CREATE TRIGGER IF NOT EXISTS cancellation_proof_update
        AFTER UPDATE ON worktrees
        WHEN OLD.identity IS NOT NEW.identity OR OLD.path IS NOT NEW.path
          OR OLD.finish_head IS NOT NEW.finish_head OR OLD.primary_pr IS NOT NEW.primary_pr
          OR OLD.target IS NOT NEW.target OR OLD.dependencies IS NOT NEW.dependencies
        BEGIN
            DELETE FROM owner_cancellations WHERE worktree_id=OLD.id;
        END;
    """)


def remote_preserved(snap, head, until):
    """Require every commit of an unauditable checkout to exist on a remote-tracking ref."""
    if not SHA.fullmatch(head or "") or git(
            snap["owner"], "--no-replace-objects", "rev-list", "--max-count=1", head,
            "--not", "--remotes", "--", raw=True, strict=True, deadline=until):
        raise Retain("missing-cancellation-head-not-on-remote")


def acknowledged_missing_identity(row):
    """Rebind a missing checkout's recorded devices after an attested renumbering.

    Surviving owner, common and admin directories must keep their exact inodes
    under one consistent, injective device mapping. The absent checkout's device
    must map with them, and the managed root must sit on that new device. The
    durable enrollment is never rewritten; callers use the rebound copy only.
    """
    recorded = json.loads(row["identity"])
    keys = ("owner_id", "common_id", "gitdir_id")
    current = {}
    for key in keys:
        path = recorded[key[:-3]]
        if physical(path) != path:
            raise Retain("missing-closeout-identity-changed")
        current[key] = identity(path)
    devices = device_renumbering(recorded, current, keys)
    device = devices.get(recorded["path_id"][0])
    if device is None:
        raise Retain("device-renumbering-checkout-device-unmapped")
    if physical(recorded["root"]) != recorded["root"] or identity(recorded["root"])[0] != device:
        raise Retain("device-renumbering-root-device-changed")
    recorded.update(current, path_id=[device, recorded["path_id"][1]])
    return {**dict(row), "identity": json.dumps(recorded, sort_keys=True)}


def acknowledged_repository_rename(row, value):
    """Rebind a missing checkout's recorded GitHub slug after an attested rename.

    The operator names both slugs; the old one must equal the enrollment and the
    new one must be what the unchanged owner's origin resolves to now. The
    durable enrollment is never rewritten; callers use the rebound copy only.
    """
    recorded = json.loads(row["identity"])
    old, separator, new = (value or "").partition("=")
    slug = r"[\w.-]+/[\w.-]+"
    if not separator or not re.fullmatch(slug, old) or not re.fullmatch(slug, new):
        raise Retain("repository-rename-needs-old-and-new-slug")
    old, new = old.lower(), new.lower()
    if old != recorded["repo"]:
        raise Retain("repository-rename-old-slug-mismatch")
    owner = recorded["owner"]
    if (physical(owner) != owner or physical(recorded["common"]) != recorded["common"]
            or git(owner, "rev-parse", "--path-format=absolute", "--git-common-dir") != recorded["common"]):
        raise Retain("missing-closeout-owner-binding-changed")
    if old == new or repository(git(owner, "remote", "get-url", "origin")) != new:
        raise Retain("repository-rename-new-slug-mismatch")
    recorded["repo"] = new
    return {**dict(row), "identity": json.dumps(recorded, sort_keys=True)}


def missing_identity_source(row, args):
    """Apply only the acknowledgments the recorded owner passed explicitly."""
    if args.acknowledge_device_renumbering:
        row = acknowledged_missing_identity(row)
    if args.acknowledge_repository_rename is not None:
        row = acknowledged_repository_rename(row, args.acknowledge_repository_rename)
    return row


def missing_cancellation_snapshot(row, until):
    """Bind a vanished checkout's surviving registration to its current branch tip."""
    recorded = json.loads(row["identity"])
    lock_reason = recorded.get("lock_reason")
    if not isinstance(lock_reason, str) or not lock_reason.startswith("gwt-finish.v2:"):
        raise Retain("missing-cancellation-needs-native-enrollment")
    for key in ("owner", "common"):
        if physical(recorded[key]) != recorded[key] or identity(recorded[key]) != recorded[key + "_id"]:
            raise Retain("missing-closeout-identity-changed")
    selected = [entry for entry in records(recorded["owner"]) if entry.get("worktree") == recorded["path"]]
    if len(selected) != 1 or not SHA.fullmatch(selected[0].get("HEAD", "")):
        raise Retain("missing-closeout-registration-changed")
    head = selected[0]["HEAD"]
    # The shared helper rebinds owner, admin, registration, lock and HEAD
    # identities to the enrollment record before this tip can be cancelled.
    snap = missing_finalized_snapshot({"identity": row["identity"], "finish_head": head},
                                      until, lock_reason)
    if git(snap["owner"], "rev-parse", snap["branch"]) != head:
        raise Retain("missing-closeout-head-changed")
    remote_preserved(snap, head, until)
    return snap


def terminal_cancellation_head(db, row):
    """Return the single cancelled head once every owner is completed or cancelled."""
    cancellations = cancellation_rows(db, row["id"])
    if not cancellations:
        return None
    cancelled = {entry["owner"] for entry in cancellations}
    if not all(owner["completed"] or owner["owner"] in cancelled
               for owner in owner_rows(db, row["id"])):
        raise Retain("awaiting-owner-completion")
    heads = {entry["head"] for entry in cancellations}
    current = db.execute("SELECT finish_head FROM worktrees WHERE id=?", (row["id"],)).fetchone()
    if len(heads) != 1 or (current["finish_head"] is not None and {current["finish_head"]} != heads):
        raise Retain("missing-cancellation-head-changed")
    return heads.pop()


def cancel(db, row, args):
    who = owner_id(args)
    ensure_owner_schema(db)
    if not db.execute("SELECT 1 FROM owners WHERE worktree_id=? AND owner=?",
                      (row["id"], who)).fetchone():
        raise Retain("known-owner-required-for-cancellation")
    item = retirement(db, row)
    if item is not None and item["state"] != "enrolled":
        raise Retain("removal-intent-requires-read-only-reconciliation")
    try:
        os.lstat(row["path"])
    except FileNotFoundError:
        # Only ENOENT selects this route. The recorded owner cancels the
        # registered tip once it is on a remote; working files stay unaudited.
        if item is None:
            raise Retain("missing-cancellation-needs-native-enrollment")
        snap = missing_cancellation_snapshot(missing_identity_source(row, args), time.monotonic() + 60)
    else:
        if args.acknowledge_device_renumbering:
            raise Retain("device-acknowledgement-requires-missing-checkout")
        if args.acknowledge_repository_rename is not None:
            raise Retain("repository-rename-acknowledgement-requires-missing-checkout")
        snap = revalidate(row)
    for prior in cancellation_rows(db, row["id"]):
        if prior["owner"] == who and prior["head"] == snap["head"] and prior["reason"] == args.reason:
            return
    ensure_cancellation_schema(db)
    with db:
        # Old consumers must also refuse removal. Existing retirement triggers
        # invalidate release generations before the new terminal record appears.
        db.execute("UPDATE owners SET completed=0 WHERE worktree_id=? AND owner=?",
                   (row["id"], who))
        db.execute("UPDATE worktrees SET state='active', reason='owner-active' WHERE id=?",
                   (row["id"],))
        db.execute("INSERT INTO owner_cancellations VALUES (?, ?, ?, ?, ?)",
                   (row["id"], who, snap["head"], args.reason, int(time.time())))


def get_row(db, worktree):
    if db is None:
        raise Retain("not-enrolled")
    path = os.path.abspath(Path(worktree).expanduser())
    row = db.execute("SELECT * FROM worktrees WHERE path = ?", (path,)).fetchone()
    if row is None:
        row = db.execute(
            "SELECT * FROM worktrees WHERE path = ?", (str(Path(path).resolve()),)
        ).fetchone()
    if row is None:
        raise Retain("not-enrolled")
    return row


def guard(db, path, *, owner=False):
    if db is None:
        return
    path = str(Path(path).expanduser().resolve())
    for row in db.execute("SELECT identity FROM worktrees"):
        snap = json.loads(row["identity"])
        if ((owner and path == snap["owner"]) or (not owner and any(
                inside(path, snap[key]) or inside(snap[key], path)
                for key in ("path", "gitdir")))):
            raise Retain("enrolled-worktree-owned-by-finish-lifecycle")


def claim(db, row, owner):
    revalidate(row)
    ensure_owner_schema(db)
    with db:
        db.execute(
            "INSERT INTO owners(worktree_id, owner, completed) VALUES (?, ?, 0) "
            "ON CONFLICT(worktree_id, owner) DO UPDATE SET completed = 0",
            (row["id"], owner),
        )
        db.execute(
            "UPDATE worktrees SET state = 'active', finish_head = NULL, primary_pr = NULL, "
            "target = NULL, dependencies = NULL, reason = 'owner-resumed' WHERE id = ?",
            (row["id"],),
        )


def acknowledged_owner_row(db, row, owner):
    require_open_retirement(db, row)
    if not db.execute("SELECT 1 FROM owners WHERE worktree_id=? AND owner=?",
                      (row["id"], owner)).fetchone():
        raise Retain("device-acknowledgement-requires-recorded-owner")
    if not json.loads(row["identity"]).get("lock_reason", "").startswith("gwt-finish.v2:"):
        raise Retain("device-acknowledgement-requires-native-enrollment")
    current = revalidate(row, allow_device_renumbering=True)
    # Acknowledgment selects a transient identity, not historical volume continuity.
    # The caller rechecks it under the lifecycle lock. Never rewrite enrollment
    # or use this selection to grant release/removal authority.
    return {**row, "identity": json.dumps(immutable(current), sort_keys=True)}


@diagnostic_phase("github-pr-proof")
def pr(url):
    match = PR_URL.fullmatch(url)
    if not match:
        raise Retain("full-github-pr-url-required")
    repo, number = match[1].lower(), int(match[2])
    data = json.loads(
        run(["ghx", "--no-cache", "api", f"repos/{repo}/pulls/{number}"]).stdout
    )
    if (not isinstance(data, dict) or data.get("number") != number
            or not isinstance(data.get("base"), dict)
            or not isinstance(data["base"].get("repo"), dict)
            or str(data["base"]["repo"].get("full_name", "")).lower() != repo
            or not isinstance(data.get("head"), dict)):
        raise Retain("github-pr-identity-mismatch")
    head = data.get("head", {}).get("sha", "")
    target = data.get("base", {}).get("ref", "")
    if (not isinstance(head, str) or not SHA.fullmatch(head)
            or not isinstance(target, str) or not target
            or type(data.get("merged")) is not bool):
        raise Retain("github-pr-proof-incomplete")
    head_repo = data["head"].get("repo")
    head_repo = head_repo.get("full_name") if isinstance(head_repo, dict) else None
    # Deleted or malformed head repositories cannot attest a fork checkout.
    # Same-repository completion keeps its existing base-repository proof.
    head_repo = (head_repo.lower() if isinstance(head_repo, str)
                 and re.fullmatch(r"[\w.-]+/[\w.-]+", head_repo) else None)
    merged = data["merged"] and bool(data.get("merged_at"))
    return {
        "url": f"https://github.com/{repo}/pull/{number}",
        "repo": repo,
        "head_repo": head_repo,
        "head": head,
        "target": target,
        "merged": merged,
        "state": data.get("state"),
        "merge": data.get("merge_commit_sha"),
    }


def primary_matches_checkout(primary, repo, head):
    return primary["head"] == head and (
        primary["repo"] == repo or primary.get("head_repo") == repo)


@diagnostic_phase("github-target-proof")
def default_target(repo):
    data = json.loads(run(["ghx", "--no-cache", "api", f"repos/{repo}"]).stdout)
    if (not isinstance(data, dict)
            or str(data.get("full_name", "")).lower() != repo
            or not isinstance(data.get("default_branch"), str)):
        raise Retain("github-repository-proof-incomplete")
    return data["default_branch"]


@diagnostic_phase("completion")
def finish(db, row, args):
    snap = revalidate(row)
    who = owner_id(args)
    ensure_owner_schema(db)
    known = db.execute(
        "SELECT 1 FROM owners WHERE worktree_id = ? AND owner = ?",
        (row["id"], who),
    ).fetchone()
    if known is None:
        raise Retain("resume-before-finishing")

    primary = pr(args.pr)
    if not primary_matches_checkout(primary, snap["repo"], snap["head"]):
        raise Retain("primary-pr-repository-or-head-mismatch")
    target = args.target or default_target(primary["repo"])
    if primary["target"] != target:
        raise Retain("primary-pr-not-targeting-final-branch")
    dependencies = []
    for url in dict.fromkeys(args.wait_for):
        dependency = pr(url)
        if dependency["repo"] != primary["repo"] or dependency["url"] == primary["url"]:
            raise Retain("invalid-stack-dependency")
        if dependency["target"] != target:
            raise Retain("stack-pr-not-targeting-final-branch")
        dependencies.append({
            "url": dependency["url"],
            "head": dependency["head"],
            "target": target,
        })
    if revalidate(row)["head"] != snap["head"]:
        raise Retain("head-changed-during-finish")

    encoded_dependencies = json.dumps(dependencies, sort_keys=True)
    same_proof = (
        row["finish_head"] == snap["head"]
        and row["primary_pr"] == primary["url"]
        and row["target"] == target
        and row["dependencies"] == encoded_dependencies
    )
    with db:
        if not same_proof:
            db.execute(
                "UPDATE owners SET completed = 0 WHERE worktree_id = ?", (row["id"],)
            )
        db.execute(
            "UPDATE owners SET completed = 1 WHERE worktree_id = ? AND owner = ?",
            (row["id"], who),
        )
        incomplete = db.execute(
            "SELECT 1 FROM owners WHERE worktree_id = ? AND completed = 0",
            (row["id"],),
        ).fetchone()
        state = "active" if incomplete else "finished"
        reason = "awaiting-owner-completion" if incomplete else "completion-recorded-checkout-retained"
        db.execute(
            "UPDATE worktrees SET finish_head = ?, primary_pr = ?, target = ?, "
            "dependencies = ?, state = ?, reason = ? WHERE id = ?",
            (snap["head"], primary["url"], target, encoded_dependencies,
             state, reason, row["id"]),
        )


class QualificationFetchLease:
    # The qualification producer keeps this empty flock carrier after release.
    # Hold its existing inode through removal; unlinking or probing then closing
    # would let a fetch race the shared-ref preservation checks.
    name = "openclaw-main-qualification-fetch.lock"

    def __init__(self, snap):
        self.common = snap["common"]
        self.common_id = snap["common_id"]
        self.directory = self.descriptor = None
        self.carrier = None

    def __enter__(self):
        try:
            self.directory = os.open(self.common, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            self.validate_common()
            try:
                self.descriptor = os.open(self.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                                          dir_fd=self.directory)
            except FileNotFoundError:
                pass
            if self.descriptor is not None:
                details = os.fstat(self.descriptor)
                if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                        or stat.S_IMODE(details.st_mode) != 0o600
                        or details.st_nlink != 1 or details.st_size != 0):
                    raise Retain("qualification-fetch-carrier-unsafe")
                self.carrier = safety().file_identity(details)
                try:
                    fcntl.flock(self.descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError as error:
                    raise Retain("qualification-fetch-lease-busy") from error
            self.validate()
            return self
        except BaseException:
            self.__exit__(None, None, None)
            raise

    def validate_common(self):
        details = os.fstat(self.directory)
        if ([details.st_dev, details.st_ino] != self.common_id
                or details.st_uid != os.getuid() or identity(self.common) != self.common_id):
            raise Retain("qualification-fetch-common-changed")

    def validate(self):
        self.validate_common()
        try:
            details = os.stat(self.name, dir_fd=self.directory, follow_symlinks=False)
        except FileNotFoundError:
            if self.carrier is None:
                return
            raise Retain("qualification-fetch-carrier-changed") from None
        if (self.carrier is None or safety().file_identity(details) != self.carrier
                or safety().file_identity(os.fstat(self.descriptor)) != self.carrier):
            raise Retain("qualification-fetch-carrier-changed")

    def admits(self, path, snap):
        if (Path(path) != Path(self.common) / self.name
                or snap["common"] != self.common or snap["common_id"] != self.common_id):
            return False
        self.validate()
        return self.carrier is not None

    def __exit__(self, *_):
        for attribute in ("descriptor", "directory"):
            descriptor = getattr(self, attribute)
            if descriptor is not None:
                os.close(descriptor)
                setattr(self, attribute, None)


def local_checks(row):
    snap = revalidate(row)
    with QualificationFetchLease(snap) as fetch_lease:
        if not row["finish_head"] or snap["head"] != row["finish_head"]:
            raise Retain("unfinished-or-head-changed")
        if "lock_reason" in snap:
            # Raw index and complete working bytes own the new-format proof.
            # Status may invoke user filters and excludes ignored recovery content.
            safety().inventory(snap, git, time.monotonic() + 30)
        for directory in (Path(snap["gitdir"]), Path(snap["common"])):
            if any(not fetch_lease.admits(path, snap) for path in directory.glob("*.lock")):
                raise Retain("git-lock-present")
            for marker in (
                "MERGE_HEAD",
                "CHERRY_PICK_HEAD",
                "REVERT_HEAD",
                "BISECT_LOG",
                "rebase-merge",
                "rebase-apply",
                "sequencer",
            ):
                if (directory / marker).exists():
                    raise Retain("git-operation-in-progress")
        if "lock_reason" not in snap and git(
            snap["path"],
            "status",
            "--porcelain=v1",
            "-z",
            "--untracked-files=all",
            "--ignore-submodules=none",
        ):
            raise Retain("dirty-or-untracked-worktree")
        fetch_lease.validate()
        return snap


def completion_pr_proofs(row):
    primary = pr(row["primary_pr"])
    snap = json.loads(row["identity"])
    if (not primary_matches_checkout(primary, snap["repo"], row["finish_head"])
            or primary["target"] != row["target"]):
        raise Retain("primary-pr-proof-changed")
    proofs = [primary]
    for expected in json.loads(row["dependencies"]):
        current = pr(expected["url"])
        if (current["repo"] != primary["repo"]
                or current["head"] != expected["head"]
                or current["target"] != expected["target"]
                or current["target"] != row["target"]):
            raise Retain("stack-proof-changed-repeat-finish")
        proofs.append(current)
    return proofs


def merged_checks(row):
    for proof in completion_pr_proofs(row):
        if not proof["merged"] or not SHA.fullmatch(proof["merge"] or ""):
            raise Retain(
                "pr-closed-unmerged" if proof["state"] == "closed" else "pr-not-merged"
            )


def completion_checks(db, row, *, local=True):
    if row["state"] != "finished":
        raise Retain(row["reason"] or row["state"])
    ensure_owner_schema(db)
    if db.execute(
        "SELECT 1 FROM owners WHERE worktree_id = ? AND completed = 0", (row["id"],)
    ).fetchone():
        raise Retain("awaiting-owner-completion")
    if db.execute(
        "SELECT 1 FROM pins WHERE worktree_id = ?", (row["id"],)
    ).fetchone():
        raise Retain("recovery-pin-present")
    if local:
        local_checks(row)
    merged_checks(row)
    if local:
        local_checks(row)


def check(db, row):
    reason = "completion-confirmed-checkout-retained"
    try:
        completion_checks(db, row)
    except (Retain, OSError, ValueError) as error:
        reason = str(error) if isinstance(error, Retain) else "proof-unavailable"
    with db:
        db.execute(
            "UPDATE worktrees SET reason = ?, observed_at = COALESCE(observed_at, ?), "
            "checked_at = ? WHERE id = ?",
            (reason, int(time.time()), int(time.time()), row["id"]),
        )
    return reason


RELEASE_BASELINE_SCHEMA = "gwt-release-baseline.v1"


def semantic_inventory(contents, admin):
    """Compare release semantics; native effect admission keeps the full snapshots."""
    def metadata(value, *, replaceable=False):
        # Git replaces its index while refreshing cached state.
        result = list(value[:6])
        if replaceable:
            result[1] = None
        return [*result, None if stat.S_ISDIR(value[2]) or replaceable else value[6], *value[9:]]

    working = {key: value for key, value in contents.items() if key not in ("index", "index_sha256")}
    working["entries"] = {name: metadata(value) for name, value in contents["entries"].items()}
    # Explicitly discarded content has no tracked-blob proof. Its compact hash
    # and inode evidence remain exact, including timestamps and population.
    administrative = {
        name: ([metadata(value[0], replaceable=True), None] if name == "index" else
               [metadata(value[0]), *value[1:]])
        for name, value in admin.items() if name != "FETCH_HEAD"
    }
    return {"working": working, "admin": administrative}


def release_refs(snap, target, until, *, branches=()):
    branches = {snap["branch"], *branches}
    if target:
        target_ref = "refs/remotes/origin/" + target
        if target_ref in git(snap["owner"], "for-each-ref", "--format=%(refname)", target_ref).splitlines():
            branches.add(target_ref)
    refs = preserved_refs(snap, branches, until)
    roots = {proof["head"] for proof in refs.values()}
    for proof in refs.values():
        if proof["reflog"] is not None:
            roots.update(proof["reflog"]["oids"])
    return refs, roots


def release_inventory(snap, target, until, discarded):
    module = safety()
    refs, roots = release_refs(snap, target, until)
    ignored = {name.rstrip("/") for name in git(
        snap["path"], "ls-files", "--others", "--ignored", "--exclude-standard", "--directory", "-z").split("\0") if name}
    dependency = ignored == {"node_modules"} and (Path(snap["path"]) / "node_modules").is_symlink()
    if set(discarded) != ignored and not (not discarded and dependency):
        raise Retain("ignored-roots-require-explicit-disposal")
    contents = module.inventory(snap, git, until, discard_ignored=discarded,
                                compact_discarded=True, preserved_oids=roots, logical_index=True)
    admin = module.admin_inventory(snap, git, until, preserved_oids=roots)
    recovery = sorted({oid for value in admin.values() if len(value) == 3 for oid in value[2]})
    preserve_release_recovery(snap, recovery, roots, until)
    if preserved_refs(snap, refs, until) != refs:
        raise Retain("preserved-refs-changed")
    return contents, admin, refs, roots, recovery


def preserve_release_recovery(snap, recovery, roots, until):
    if len(recovery) > 128:
        raise Retain("recovery-proof-limit")
    for oid in recovery:
        if not SHA.fullmatch(oid):
            raise Retain("recovery-reference-invalid")
        if oid not in roots and git(
                snap["owner"], "--no-replace-objects", "rev-list", "--max-count=1", oid,
                "--not", *sorted(roots), "--", raw=True, strict=True, deadline=until):
            raise Retain("admin-recovery-not-preserved")


def capture_release_inventory(db, row, args):
    item = require_open_retirement(db, row)
    # Only an authenticated releasing owner can establish the baseline. A
    # failed capture is durable too; resume/release is required to replace it.
    if item["inventory"] is not None:
        return
    baseline = {"schema": RELEASE_BASELINE_SCHEMA, "discard_ignored": sorted(args.discard_ignored),
                "baseline": None, "blocker": None}
    try:
        snap = revalidate(row)
        if snap["head"] != row["finish_head"]:
            raise Retain("head-changed-repeat-finish")
        contents, admin, _, _, recovery = release_inventory(
            snap, row["target"], time.monotonic() + 45, args.discard_ignored)
        baseline.update(baseline=semantic_inventory(contents, admin), recovery_oids=recovery)
    except (Retain, OSError, ValueError) as error:
        baseline["blocker"] = str(error) if isinstance(error, Retain) else "release-inventory-unavailable"
    with db:
        db.execute("UPDATE retirement SET inventory=? WHERE worktree_id=? AND inventory IS NULL",
                   (json.dumps(baseline, sort_keys=True), row["id"]))


def release(db, row, args):
    item = require_open_retirement(db, row)
    who = owner_id(args)
    if not db.execute("SELECT 1 FROM owners WHERE worktree_id=? AND owner=? AND completed=1",
                      (row["id"], who)).fetchone():
        raise Retain("complete-current-owner-before-release")
    snap = revalidate(row)
    if snap["head"] != row["finish_head"]:
        raise Retain("head-changed-repeat-finish")
    with db:
        db.execute("INSERT INTO owner_releases VALUES (?, ?, ?) "
                   "ON CONFLICT(worktree_id,owner) DO UPDATE SET generation=excluded.generation",
                   (row["id"], who, item["generation"]))


def qualified_policy(args, row):
    path = args.policy or str(Path.home() / ".config/gwt-finish/policy.json")
    if not os.path.lexists(path):
        raise Retain("explicit-release-policy-not-installed")
    allowed, qualification = report_policy(path, apply=True)
    if not policy_allows(row, allowed):
        raise Retain("outside-explicit-release-policy")
    if (not isinstance(qualification, dict)
            or set(qualification) != {"platform", "git", "sources", "activation_receipt", "known_processes"}
            or qualification["platform"] != safety().platform_key()):
        raise Retain("native-platform-qualification-mismatch")
    if not isinstance(qualification["known_processes"], list) or len(qualification["known_processes"]) > 64:
        raise Retain("invalid-known-process-qualification")
    for item in qualification["known_processes"]:
        if (not isinstance(item, list) or len(item) != 5
                or any(type(n) is not int or n < 0 for n in item) or item[0] == 0):
            raise Retain("invalid-known-process-qualification")
    until = time.monotonic() + 10
    sources = qualification["sources"]
    directory = Path(__file__).resolve().parent
    required = {"agent-worktree-finish", "gwt_finish_safety.py", "agent-worktree-clean",
                "agent-worktree-maintain", "agent-worktree-purge", "worktree-storage-guard"}
    if not isinstance(sources, dict) or set(sources) != required:
        raise Retain("qualified-source-set-mismatch")
    for name in required:
        raw, identity = safety().read_file(directory / name, until)
        if identity[2] & 0o022 or hashlib.sha256(raw).hexdigest() != sources[name]:
            raise Retain("qualified-source-changed")
    if sources["gwt_finish_safety.py"] != safety().source_sha256:
        raise Retain("loaded-native-source-changed")
    native = qualification["git"]
    if (not isinstance(native, dict) or set(native) != {"path", "sha256", "version"}
            or native["version"] != "git version 2.55.0"
            or physical(native["path"]) != native["path"]):
        raise Retain("native-git-qualification-mismatch")
    raw, identity = safety().read_file(native["path"], until)
    if identity[2] & 0o022 or hashlib.sha256(raw).hexdigest() != native["sha256"]:
        raise Retain("qualified-git-changed")
    if run([native["path"], "--version"]).stdout.decode().strip() != native["version"]:
        raise Retain("qualified-git-version-changed")
    receipt = qualification["activation_receipt"]
    if not isinstance(receipt, dict) or set(receipt) != {"path", "sha256"}:
        raise Retain("configured-consumer-qualification-required")
    private_file(receipt["path"])
    raw, _ = safety().read_file(receipt["path"], until, 1024 * 1024)
    if hashlib.sha256(raw).hexdigest() != receipt["sha256"]:
        raise Retain("activation-receipt-changed")
    activation = json.loads(raw)
    if (activation.get("schema") != "gwt-finish-activation.v2"
            or activation.get("host") != host_key()
            or activation.get("sources") != sources
            or activation.get("platform") != qualification["platform"]
            or activation.get("configured_consumers_reviewed") is not True
            or activation.get("old_loaded_consumers") != []
            or activation.get("native_control_passed") is not True):
        raise Retain("configured-consumer-or-native-control-unqualified")
    return qualification


def all_released(db, row, item):
    if db.execute("SELECT 1 FROM owners AS o LEFT JOIN owner_releases AS r "
                  "ON r.worktree_id=o.worktree_id AND r.owner=o.owner "
                  "WHERE o.worktree_id=? AND (o.completed!=1 OR r.generation IS NULL "
                  "OR r.generation!=?)", (row["id"], item["generation"])).fetchone():
        raise Retain("awaiting-owner-release")


def preserved_branch_reflog(snap, until):
    path = Path(snap["common"]) / "logs" / snap["branch"]
    if not os.path.lexists(path):
        return None
    parents = {}
    for parent in path.parents:
        safety().tick(until)
        details = parent.lstat()
        if (not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid()
                or details.st_mode & 0o022):
            raise Retain("branch-reflog-parent-unqualified")
        parents[str(parent)] = [details.st_dev, details.st_ino, details.st_mode, details.st_uid]
        if str(parent) == snap["common"]:
            break
    data, identity = safety().read_file(path, until)
    oids = set()
    for line in data.splitlines(keepends=True):
        safety().tick(until)
        # Match Git files-backend's complete record envelope, including its
        # old-tip boundary. Merely finding two OIDs in corrupt text is no proof.
        entry = re.fullmatch(rb"([0-9a-f]{40}) ([0-9a-f]{40}) [^>\n]*> [1-9][0-9]* [+-][0-9]{4}(?:\t[^\n]*)?\n", line)
        if entry is None:
            raise Retain("branch-reflog-proof-invalid")
        oids.update(os.fsdecode(oid) for oid in entry.groups() if oid != b"0" * 40)
    for name, expected in parents.items():
        current = os.lstat(name)
        if [current.st_dev, current.st_ino, current.st_mode, current.st_uid] != expected:
            raise Retain("branch-reflog-parent-changed")
    return {"identity": list(identity), "sha256": hashlib.sha256(data).hexdigest(),
            "oids": sorted(oids), "parents": parents}


def preserved_refs(snap, branches, until):
    result = {}
    for branch in sorted(set(branches)):
        if os.path.lexists(Path(snap["common"]) / (branch + ".lock")):
            raise Retain("preserved-branch-lock-present")
        result[branch] = {
            "head": git(snap["owner"], "rev-parse", "--verify", branch),
            "reflog": preserved_branch_reflog({**snap, "branch": branch}, until),
        }
    return result


def manual_preserved_branches(snap, branches, until):
    """Admit only exact, existing local commit branches selected for this removal."""
    result = sorted(set(branches))
    for branch in result:
        if not branch.startswith("refs/heads/"):
            raise Retain("preserve-ref-needs-literal-local-branch")
        try:
            git(snap["owner"], "check-ref-format", branch, strict=True, deadline=until)
        except Retain:
            raise Retain("preserve-ref-needs-literal-local-branch") from None
        value = git(snap["owner"], "for-each-ref", "--format=%(refname)%00%(objecttype)%00%(symref)",
                    branch, strict=True, deadline=until)
        if value != branch + "\0commit\0":
            raise Retain("preserve-ref-needs-existing-direct-commit-branch")
    return result


def deletion_admission(row, item, qualification, until, fetch_lease=None):
    if not automatic_holder_contract(item):
        raise Retain("automatic-holder-contract-not-enrolled")
    module = safety()
    snap = revalidate(row)
    if snap["head"] != row["finish_head"]:
        raise Retain("unfinished-or-head-changed")
    boundaries = [module.access_boundary(snap[key], until) for key in ("path", "gitdir")]
    if item["inventory"] is None:
        raise Retain("automatic-release-inventory-required")
    released = json.loads(item["inventory"])
    semantic = released.get("schema") == RELEASE_BASELINE_SCHEMA
    if "schema" in released and not semantic:
        raise Retain("release-inventory-schema-unsupported-resume-first")
    refs = None
    if semantic:
        if released["baseline"] is None:
            raise Retain(released["blocker"] or "automatic-release-baseline-unavailable-resume-first")
        contents, admin, refs, roots, _ = release_inventory(
            snap, row["target"], until, released["discard_ignored"])
        preserve_release_recovery(snap, released["recovery_oids"], roots, until)
        current = semantic_inventory(contents, admin)
        if current["working"] != released["baseline"]["working"]:
            raise Retain("released-worktree-changed")
        if current["admin"] != released["baseline"]["admin"]:
            raise Retain("released-admin-changed-resume-first")
    else:
        # Shipped full inventories retain their exact comparison contract.
        contents = module.inventory(snap, git, until)
        if contents != released["working"]:
            raise Retain("released-worktree-changed")
    # Native remove runs status, whose index refresh can execute clean/process
    # filters. Do not dispatch unqualified external programs during removal.
    keys = git(snap["path"], "config", "--includes", "--null", "--name-only", "--list")
    if any(key.lower().startswith("filter.") for key in keys.split("\0")):
        raise Retain("git-conversion-filter-unqualified")
    if not semantic:
        admin = module.admin_inventory(snap, git, until)
        if admin != released["admin"]:
            raise Retain("released-admin-changed-resume-first")
    for directory in (Path(snap["common"]), Path(snap["common"]) / "refs"):
        stack = [directory]
        visited = 0
        while stack:
            current = stack.pop()
            module.tick(until)
            with os.scandir(current) as scan:
                for entry in scan:
                    visited += 1
                    if (visited > module.ENTRY_LIMIT or (entry.name.endswith(".lock")
                            and (fetch_lease is None or not fetch_lease.admits(entry.path, snap)))):
                        raise Retain("git-lock-or-ref-population-unknown")
                    if current != Path(snap["common"]) and entry.is_dir(follow_symlinks=False):
                        stack.append(Path(entry.path))
    for marker in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_LOG",
                   "rebase-merge", "rebase-apply", "sequencer"):
        if any(os.path.lexists(Path(snap[key]) / marker) for key in ("common", "gitdir")):
            raise Retain("git-operation-in-progress")
    recovery = set() if semantic else {oid for value in admin.values() if len(value) == 3 for oid in value[2]}
    reflog = preserved_branch_reflog(snap, until)
    if len(recovery) > 128:
        raise Retain("recovery-proof-limit")
    for oid in recovery:
        if not SHA.fullmatch(oid):
            raise Retain("recovery-reference-invalid")
        # Rebase deliberately rewrites ancestry. Its original tip remains in
        # the common branch reflog, outside native worktree removal's domain.
        if reflog is None or oid not in reflog["oids"]:
            try:
                git(snap["owner"], "merge-base", "--is-ancestor", oid, row["finish_head"])
            except Retain as error:
                raise Retain("admin-recovery-not-preserved") from error
    inodes = {tuple(snap[key]) for key in ("path_id", "gitdir_id")}
    inodes.update(tuple(value[:2]) for value in contents["entries"].values())
    inodes.update(tuple(value) for value in contents.get("discarded_inodes", []))
    inodes.update(tuple(value[0][:2]) for value in admin.values())
    observed = module.Darwin(until).observe(
        [snap["path"], snap["gitdir"]], inodes, qualification["known_processes"])
    if observed["holders"]:
        raise Retain("pending-departure")
    # External policy cannot replace the selected native observation contract.
    if observed.get("mapping_coverage") != module.HOLDER_COVERAGE:
        raise Retain("holder-mapping-coverage-unqualified")
    result = {"snapshot": snap, "boundaries": boundaries, "contents": contents,
              "admin": admin, "holders": observed, "branch_reflog": reflog}
    if refs is not None:
        result["preserved_refs"] = refs
    return result


def holder_qualification():
    try:
        safety().check_holder_platform()
        qualified, reason = True, "bounded-native-observation-requires-host-qualification"
    except Retain as error:
        qualified, reason = False, str(error)
    return {
        "schema": HOLDER_SCHEMA,
        "backend": "darwin-libproc-bounded.v1",
        "qualified": qualified,
        "reason": reason,
        "mapping_coverage": safety().HOLDER_COVERAGE if qualified else "unqualified",
        "platform": safety().platform_key(),
    }


def trusted_holder_binary(name):
    selected = shutil.which(name)
    if not selected or not os.path.isabs(selected):
        raise Retain("sudo-holder-scan-needs-trusted-binaries")
    current, pending, links = Path("/"), list(Path(selected).parts[1:]), 0
    try:
        root = current.lstat()
        if root.st_uid != 0 or not stat.S_ISDIR(root.st_mode) or root.st_mode & 0o022:
            raise Retain("sudo-holder-scan-untrusted-path")
        # Check symlinks and their traversal, not only the resolved destination.
        while pending:
            part = pending.pop(0)
            if part == "..":
                current = current.parent
                continue
            candidate = current / part
            details = candidate.lstat()
            if details.st_uid != 0:
                raise Retain("sudo-holder-scan-untrusted-path")
            if stat.S_ISLNK(details.st_mode):
                links += 1
                if links > 40:
                    raise Retain("sudo-holder-scan-untrusted-path")
                target = Path(os.readlink(candidate))
                if target.is_absolute():
                    current = Path("/")
                    pending = list(target.parts[1:]) + pending
                else:
                    pending = list(target.parts) + pending
                continue
            if details.st_mode & 0o022 or (pending and not stat.S_ISDIR(details.st_mode)):
                raise Retain("sudo-holder-scan-untrusted-path")
            current = candidate
        details = current.lstat()
        if (details.st_uid != 0 or details.st_mode & 0o022
                or not stat.S_ISREG(details.st_mode) or not details.st_mode & 0o111):
            raise Retain("sudo-holder-scan-untrusted-path")
    except OSError as error:
        raise Retain("sudo-holder-scan-untrusted-path") from error
    return str(current)


def sudo_holder_scan(until):
    if sys.platform != "linux":
        raise Retain("sudo-holder-scan-requires-linux")
    safety().tick(until)
    command = [trusted_holder_binary("sudo"), "-n", "-u", "#0", "--",
               trusted_holder_binary("lsof"), "-nP", "+w", "-F0pfnDi"]
    observed = safety().supervise(
        command, cwd="/", env={"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "LC_ALL": "C"},
        limit=32 * 1024 * 1024, sudo_monitor=True, deadline=until)
    if observed.failure:
        if observed.proof.get("pid") is not None:
            raise Retain("sudo-holder-scan-termination-unknown")
        raise Retain("sudo-holder-scan-failed")
    if observed.returncode != 0:
        raise Retain("sudo-holder-scan-failed")
    return observed


def manual_holders(snap, contents, admin, until, *, sudo_holder_scan_enabled=False):
    paths, inodes = set(), {tuple(item) for item in contents.get("discarded_inodes", ())}
    for key, entries in (("path", contents["entries"]), ("gitdir", admin)):
        for name, entry in entries.items():
            identity = entry if key == "path" else entry[0]
            # Unlinking a symlink does not delete the external target held by
            # another process. Never traverse it for this checkout's scan.
            if not stat.S_ISLNK(identity[2]):
                paths.add(os.fsencode(Path(snap[key]) / name))
                inodes.add(tuple(identity[:2]))
    roots = tuple(os.fsencode(snap[key]) for key in ("path", "gitdir"))
    safety().tick(until)
    # One native scan avoids repeating libproc's entire process walk for each
    # filename batch. Inode matching also catches holders through hardlink aliases.
    if sudo_holder_scan_enabled:
        observed = sudo_holder_scan(until)
    else:
        executable = shutil.which("lsof")
        if executable is None:
            raise Retain("manual-closeout-needs-lsof")
        observed = run([executable, "-nP", "+w", "-F0pfnDi"], limit=32 * 1024 * 1024)
    if observed.stderr or not observed.stdout.endswith(b"\0\n"):
        raise Retain("manual-holder-visibility-unknown")
    processes = files = 0
    held = False
    # lsof -F0 terminates fields with NUL, then each process/file set with LF.
    # Split sets first so embedded newlines in names remain ordinary filename bytes.
    for record in observed.stdout[:-2].split(b"\0\n"):
        safety().tick(until)
        fields = {}
        for field in record.split(b"\0"):
            key, value = field[:1], field[1:]
            if (key not in (b"p", b"f", b"D", b"i", b"n") or key in fields
                    or (not value and key != b"n")):
                raise Retain("manual-holder-visibility-unknown")
            fields[key] = value
        if record.startswith(b"p"):
            if set(fields) != {b"p"} or not re.fullmatch(rb"[1-9][0-9]*", fields[b"p"]):
                raise Retain("manual-holder-visibility-unknown")
            pid = fields[b"p"]
            processes += 1
            continue
        if not processes or not record.startswith(b"f") or b"p" in fields:
            raise Retain("manual-holder-visibility-unknown")
        files += 1
        device, inode, name = fields.get(b"D"), fields.get(b"i"), fields.get(b"n", b"")
        if ((device is not None and not re.fullmatch(rb"0x[0-9a-fA-F]+", device))
                or (inode is not None and not re.fullmatch(rb"[0-9]+", inode))):
            raise Retain("manual-holder-visibility-unknown")
        descriptor = fields[b"f"]
        # Linux lsof omits the ENOENT annotation for a root-owned missing exe.
        # Only this txt record is absent; every sibling still needs validation.
        if (sys.platform == "linux" and sudo_holder_scan_enabled
                and fields == {b"f": b"txt", b"n": b"/proc/" + pid + b"/exe"}):
            continue
        # Linux lsof reports a procfs FD lookup ENOENT with this exact shape.
        # Exempt only that record; sibling references still need validation.
        if (sys.platform == "linux" and sudo_holder_scan_enabled
                and set(fields) == {b"f", b"n"} and re.fullmatch(rb"0|[1-9][0-9]*", descriptor)
                and re.fullmatch(rb"/proc/" + pid + rb"(?:/task/[1-9][0-9]*)?/fd/"
                                 + descriptor + rb" \(readlink: No such file or directory\)", name)):
            continue
        ordinary = re.fullmatch(rb"[0-9]+|\*[0-9]{3}|fp\.", descriptor)
        if not ordinary and (
                not re.fullmatch(rb"cwd|rtd|pd|tr|txt|ltx|mem|DEL|twd|ctty|jld|v86|m86|mmap"
                                 rb"|L[0-9]+|M[0-9a-fA-F]+|R[0-9]+", descriptor)
                or device is None or inode is None):
            raise Retain("manual-holder-visibility-unknown")
        # Linux lsof recovers mapping device/inode from maps when stat fails.
        # Keep that identity and match the pathname without its one ENOENT suffix.
        missing_mapping = b" (stat: No such file or directory)"
        if (sys.platform == "linux" and descriptor == b"mem"
                and name.endswith(missing_mapping) and len(name) > len(missing_mapping)):
            name = name[:-len(missing_mapping)]
        # lsof can report visibility failures in NAME with exit 0 and no stderr.
        if re.search(rb"(?:^| )\((?:opendir|readlink|stat|lstat|fstat|fopen):", name):
            raise Retain("manual-holder-visibility-unknown")
        # Non-files (sockets, pipes, etc.) may legitimately omit device/inode.
        held |= (device is not None and inode is not None
                 and (int(device, 16), int(inode)) in inodes)
        held |= name in paths or any(name == root or name.startswith(root + b"/") for root in roots)
    if not processes or not files:
        raise Retain("manual-holder-visibility-unknown")
    if held:
        raise Retain("pending-departure")


def missing_finalized_snapshot(row, until, lock_reason):
    """Bind surviving administration without recreating already absent source."""
    snap = {**json.loads(row["identity"]), "head": row["finish_head"]}
    if (not snap["head"] or not SHA.fullmatch(snap["head"])
            or physical(snap["root"]) != snap["root"]
            or not inside(snap["path"], snap["root"]) or snap["path"] == snap["root"]
            or identity(snap["root"])[0] != snap["path_id"][0]):
        raise Retain("missing-closeout-boundary-changed")
    for key in ("owner", "common", "gitdir"):
        if physical(snap[key]) != snap[key] or identity(snap[key]) != snap[key + "_id"]:
            raise Retain("missing-closeout-identity-changed")
    if (git(snap["owner"], "rev-parse", "--path-format=absolute", "--git-common-dir") != snap["common"]
            or repository(git(snap["owner"], "remote", "get-url", "origin")) != snap["repo"]):
        raise Retain("missing-closeout-owner-binding-changed")
    selected = [entry for entry in records(snap["owner"]) if entry.get("worktree") == snap["path"]]
    if (len(selected) != 1 or selected[0].get("HEAD") != snap["head"]
            or selected[0].get("branch") != snap["branch"]
            or selected[0].get("locked") != lock_reason):
        raise Retain("missing-closeout-registration-changed")
    observed = sibling_identity(snap, snap["path"], until)
    if (observed["path_id"] is not None or observed["gitdir"] != snap["gitdir"]
            or observed["gitdir_id"] != snap["gitdir_id"]):
        raise Retain("missing-closeout-target-changed")
    raw, _ = safety().read_file(Path(snap["gitdir"]) / "HEAD", until)
    if raw != os.fsencode("ref: " + snap["branch"] + "\n"):
        raise Retain("missing-closeout-head-changed")
    # The absent root's old inode remains a holder domain. Its working bytes
    # cannot be audited; only the surviving index/admin data can be retired.
    snap["path_absence"] = observed["path_absence"]
    snap.pop("lock_reason", None)
    if lock_reason is not None:
        snap["lock_reason"] = lock_reason
    return snap


def finalized_admission(db, row, args, until, *, completed=False, fetch_lease=None):
    missing = row.get("missing_worktree", False)
    snap = (missing_finalized_snapshot(row, until, json.loads(row["identity"])["lock_reason"])
            if missing else revalidate(row))
    if snap["head"] != row["finish_head"]:
        raise Retain("finalized-head-changed")
    if db.execute("SELECT 1 FROM pins WHERE worktree_id=?", (row["id"],)).fetchone():
        raise Retain("recovery-pin-present")
    if os.path.lexists(Path(snap["common"]) / (snap["branch"] + ".lock")):
        raise Retain("preserved-branch-lock-present")
    for key in ("common", "gitdir"):
        directory = Path(snap[key])
        if any(fetch_lease is None or not fetch_lease.admits(path, snap)
               for path in directory.glob("*.lock")):
            raise Retain("git-lock-present")
        if any((directory / name).exists() for name in (
                "MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_LOG",
                "rebase-merge", "rebase-apply", "sequencer")):
            raise Retain("git-operation-in-progress")
    if missing:
        if row.get("missing_cancellation"):
            # Cancellation has no PR or release proof; every owner must still be
            # terminal at this head, and that head must remain on a remote.
            if terminal_cancellation_head(db, row) != snap["head"]:
                raise Retain("missing-cancellation-head-changed")
            remote_preserved(snap, snap["head"], until)
        else:
            completion_checks(db, row, local=False)
            all_released(db, row, retirement(db, row))
        if owner_id(args) not in {owner["owner"] for owner in owner_rows(db, row["id"])}:
            raise Retain("missing-closeout-requires-recorded-owner")
        recovery = missing_recovery_record(db, row)
        if recovery is not None and not recovery["result"]:
            raise Retain("missing-recovery-intent-present")
        attempt = failed_creation_record(db, row)
        if attempt is not None:
            raise Retain("failed-creation-recovery-present")
        ignored = set()
    else:
        keys = git(snap["path"], "config", "--includes", "--null", "--name-only", "--list")
        if any(key.lower().startswith("filter.") for key in keys.split("\0")):
            raise Retain("git-conversion-filter-unqualified")
        if git(snap["path"], "status", "--porcelain=v1", "-z",
               "--untracked-files=all", "--ignore-submodules=none"):
            raise Retain("dirty-or-untracked-worktree")
        ignored = {name.rstrip("/") for name in git(
            snap["path"], "ls-files", "--others", "--ignored", "--exclude-standard",
            "--directory", "-z").split("\0") if name}
    disposable = set(args.discard_ignored)
    dependency_link = completed and ignored == {"node_modules"} and (Path(snap["path"]) / "node_modules").is_symlink()
    if disposable != ignored and not dependency_link:
        raise Retain("ignored-content-needs-exact-disposable-roots")
    module = safety()
    preserved_oids = {proof["head"] for proof in row["finalized_refs"].values()}
    for proof in row["finalized_refs"].values():
        if proof["reflog"] is not None:
            preserved_oids.update(proof["reflog"]["oids"])
    if missing:
        proof, _, _ = module.index_inventory({**snap, "path": snap["owner"]}, git, until,
                                             preserved_oids=preserved_oids, revision=snap["head"])
        contents = {**proof, "entries": {}, "dependency": None, "missing_worktree": True,
                    "discarded_inodes": [snap["path_id"]]}
    else:
        contents = module.inventory(snap, git, until, discard_ignored=disposable, compact_discarded=True,
                                    allow_empty_gitlinks=True, preserved_oids=preserved_oids,
                                    allow_committed_crlf=True)
    admin = module.admin_inventory({**snap, "path": snap["owner"]} if missing else snap,
                                   git, until, preserved_oids=preserved_oids)
    if missing:
        preserve_release_recovery({**snap, "path": snap["owner"]}, sorted({oid for value in admin.values()
                                               if len(value) == 3 for oid in value[2]}),
                                  preserved_oids, until)
    holder_options = {"sudo_holder_scan_enabled": True} if args.sudo_holder_scan else {}
    manual_holders(snap, contents, admin, until, **holder_options)
    manual_preserved_branches(snap, args.preserve_ref, until)
    refs = preserved_refs(snap, row["finalized_refs"], until)
    if refs != row["finalized_refs"]:
        raise Retain("preserved-refs-changed")
    # Holder and ref probes can outlive the empty-directory observation.
    for name, proof in contents.get("gitlinks", {}).items():
        if module.empty_gitlink(snap, name, until) != proof:
            raise Retain("gitlink-state-changed")
    boundaries = ([module.access_boundary(snap["path_absence"]["parent"], until),
                   module.access_boundary(snap["gitdir"], until)] if missing else [])
    return {"snapshot": snap, "boundaries": boundaries, "contents": contents, "admin": admin,
            "branch_reflog": refs[snap["branch"]]["reflog"], "preserved_refs": refs}


def remove_finalized(db, row, args, *, completed=False):
    item = require_open_retirement(db, row)
    enrolled_branch = json.loads(row["identity"])["branch"]
    missing = not os.path.lexists(row["path"])
    until = time.monotonic() + 120
    # A cancelled checkout has no finish proof; its owners' cancelled head
    # stands in for it, and admission adds the remote-preservation check.
    cancelled_head = terminal_cancellation_head(db, row) if missing and not completed else None
    source = {**dict(row), "finish_head": cancelled_head} if cancelled_head else row
    if getattr(args, "acknowledge_device_renumbering", False):
        # Present checkouts already rebind device-only identity here.
        if not missing or completed:
            raise Retain("device-acknowledgement-requires-missing-checkout")
    if getattr(args, "acknowledge_repository_rename", None) is not None and (not missing or completed):
        raise Retain("repository-rename-acknowledgement-requires-missing-checkout")
    if missing and not completed:
        source = missing_identity_source(source, args)
    snap = (missing_finalized_snapshot(source, until, json.loads(row["identity"]).get("lock_reason"))
            if missing else revalidate(row, allow_device_renumbering=not completed,
                                       allow_branch_change=not completed))
    if "lock_reason" not in snap:
        raise Retain("manual-closeout-needs-native-enrollment")
    # Manual closeout may rebind identity; completion keeps its recorded identity.
    # Keep the durable enrollment and automatic lifecycle qualification unchanged.
    row = {**dict(row), "identity": json.dumps(immutable(snap), sort_keys=True),
           "finish_head": snap["head"], "missing_worktree": missing,
           "missing_cancellation": cancelled_head is not None}
    storage_guard()
    module = safety()
    until = time.monotonic() + 120
    with module.maintainer_lock(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))), \
            QualificationFetchLease(snap) as fetch_lease:
        # A fetched target may retain history absent from either task branch.
        # Reuse release roots so manual closeout binds that ref to the same drift checks.
        selected = manual_preserved_branches(snap, args.preserve_ref, until)
        row["finalized_refs"], _ = release_refs(snap, row["target"], until,
                                               branches=(enrolled_branch, *selected))
        def admit():
            if completed:
                current = get_row(db, snap["path"])
                if any(current[key] != row[key] for key in (
                        "finish_head", "primary_pr", "target", "dependencies")):
                    raise Retain("completion-proof-changed")
                completion_checks(db, current, local=False)
                all_released(db, current, item)
            options = {"completed": True} if completed else {}
            return finalized_admission(db, row, args, until, fetch_lease=fetch_lease, **options)

        before = admit()
        def observe(path, root, lock_reason=None):
            return missing_finalized_snapshot(row, until, lock_reason)
        return remove_with_intent(
            db, row, item, before,
            admit,
            {"mode": "explicit-finalized-task", "operator": owner_id(args),
             "discard_ignored": sorted(args.discard_ignored),
             **({"preserve_ref": selected} if selected else {})},
            restore_lock=True, fetch_lease=fetch_lease,
            snapshotter=observe if missing else snapshot)


def failed_creation_history(db, row):
    # The old incarnation remains authoritative history. Never repurpose its
    # retirement row or its owners to enroll the replacement checkout.
    result = {"worktree": dict(row)}
    for table in ("retirement", "owners", "pins", "owner_releases", "owner_cancellations"):
        if not db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (table,)).fetchone():
            result[table] = None
            continue
        result[table] = sorted((dict(item) for item in db.execute(
            f"SELECT * FROM {table} WHERE worktree_id=?", (row["id"],))),
            key=lambda value: json.dumps(value, sort_keys=True))
    return result


def failed_creation_record(db, row, token=None):
    if not db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='failed_creations'").fetchone():
        return None
    if token is None:
        return db.execute("SELECT * FROM failed_creations WHERE worktree_id=? LIMIT 1", (row["id"],)).fetchone()
    return db.execute("SELECT * FROM failed_creations WHERE worktree_id=? AND creation_token=?",
                      (row["id"], token)).fetchone()


def recover_failed_creation(db, row, args):
    who = owner_id(args)
    if row["id"] != args.worktree_id or row["path"] != args.worktree:
        raise Retain("failed-creation-record-mismatch")
    history = failed_creation_history(db, row)
    item = retirement(db, row)
    if (item is None or item["state"] != "removed" or item["generation"] != args.generation
            or item["intent"] is not None or not item["result"]
            or hashlib.sha256(item["result"].encode()).hexdigest() != args.result_sha256):
        raise Retain("failed-creation-needs-prior-removed-receipt")
    prior = json.loads(item["result"])
    child = prior.get("child") or {}
    if (prior.get("checkout") != "removed" or child.get("returncode") != 0
            or child.get("reaped") is not True or child.get("group_absent") is not True
            or any(prior.get(key) is not True for key in (
                "path_absent", "admin_absent", "registration_absent", "siblings_preserved",
                "branch_preserved", "branch_reflog_preserved", "dependency_preserved",
                "discarded_link_targets_preserved"))):
        raise Retain("failed-creation-prior-removal-unverified")
    if ([owner["owner"] for owner in history["owners"]] != [who] or history["pins"]):
        raise Retain("failed-creation-requires-sole-recorded-owner-without-pins")
    if failed_creation_record(db, row) is not None:
        raise Retain("failed-creation-attempt-already-recorded-no-retry")
    old = json.loads(row["identity"])
    lock = "gwt-finish.v2:" + args.creation_token
    snap = snapshot(args.worktree, old["root"], lock)
    devices = {}
    compared = old
    if args.acknowledge_device_renumbering:
        # Stable repository inodes attest the device mapping. New task inodes
        # must still differ; a remount alone is never a failed recreation.
        devices = device_renumbering(old, snap, ("common_id", "owner_id"))
        if any(old[key][0] not in devices for key in ("path_id", "gitdir_id")):
            raise Retain("failed-creation-device-mapping-changed")
        compared = dict(old)
        for key in ("path_id", "gitdir_id", "common_id", "owner_id"):
            compared[key] = [devices[old[key][0]], old[key][1]]
        if any(compared[key][0] != snap[key][0] for key in ("path_id", "gitdir_id")):
            raise Retain("failed-creation-device-mapping-changed")
    if (snap["head"] != args.expected_head or lock == old.get("lock_reason")
            or any(snap[key] != compared[key] for key in (
                "path", "root", "owner", "common", "gitdir", "common_id", "owner_id", "branch", "repo"))
            or snap["path_id"][1] == compared["path_id"][1]
            or snap["gitdir_id"][1] == compared["gitdir_id"][1]):
        raise Retain("failed-creation-incarnation-mismatch")
    if any(json.loads(other["identity"]).get("lock_reason") == lock
           for other in db.execute("SELECT identity FROM worktrees")):
        raise Retain("failed-creation-token-already-enrolled")
    current = {**dict(row), "identity": json.dumps(immutable(snap), sort_keys=True),
               "finish_head": snap["head"]}
    storage_guard()
    until = time.monotonic() + 120
    with safety().maintainer_lock(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))), \
            QualificationFetchLease(snap) as fetch_lease:
        current["finalized_refs"], _ = release_refs(snap, row["target"], until, branches=(old["branch"],))
        def admit():
            latest = get_row(db, args.worktree)
            if failed_creation_history(db, latest) != history:
                raise Retain("failed-creation-history-changed")
            return finalized_admission(db, current, args, until, fetch_lease=fetch_lease)
        before = admit()
        preimage = {"history": history, "admission": before, "operator": who,
                    "creation_token": args.creation_token, "acknowledged_unrecorded_creation": True,
                    "acknowledged_device_renumbering": args.acknowledge_device_renumbering,
                    "device_renumbering": sorted(devices.items())}
        digest = recovery_digest(preimage)
        output = {"checkout": "retained", "reason": "failed-creation-recovery-planned",
                  "worktree": args.worktree, "recovery_sha256": digest,
                  "device_renumbering": sorted(devices.items())}
        if not args.apply:
            return output
        if digest != args.recovery_sha256:
            raise Retain("failed-creation-preimage-changed")
        encoded = json.dumps(preimage, sort_keys=True)
        def record_intent(intent):
            with db:
                db.execute("CREATE TABLE IF NOT EXISTS failed_creations ("
                           "worktree_id TEXT NOT NULL REFERENCES worktrees(id), creation_token TEXT NOT NULL, "
                           "preimage TEXT NOT NULL, intent TEXT NOT NULL, result TEXT, "
                           "PRIMARY KEY(worktree_id, creation_token))")
                db.execute("CREATE TRIGGER IF NOT EXISTS failed_creations_immutable "
                           "BEFORE UPDATE ON failed_creations WHEN OLD.result IS NOT NULL "
                           "OR NEW.worktree_id != OLD.worktree_id OR NEW.creation_token != OLD.creation_token "
                           "OR NEW.preimage != OLD.preimage OR NEW.intent != OLD.intent "
                           "BEGIN SELECT RAISE(ABORT, 'failed-creation-record-is-immutable'); END")
                db.execute("CREATE TRIGGER IF NOT EXISTS failed_creations_no_delete "
                           "BEFORE DELETE ON failed_creations "
                           "BEGIN SELECT RAISE(ABORT, 'failed-creation-record-is-immutable'); END")
                db.execute("INSERT INTO failed_creations VALUES (?, ?, ?, ?, NULL)",
                           (row["id"], args.creation_token, encoded, json.dumps(intent, sort_keys=True)))
        def record_outcome(outcome):
            with db:
                changed = db.execute("UPDATE failed_creations SET result=? "
                                     "WHERE worktree_id=? AND creation_token=? AND preimage=? AND result IS NULL",
                                     (json.dumps(outcome, sort_keys=True), row["id"], args.creation_token, encoded)).rowcount
                if changed != 1:
                    raise Retain("failed-creation-result-conflict")
        remove_with_intent(db, current, item, before, admit,
                          {"mode": "audited-failed-creation", "operator": who},
                          restore_lock=True, fetch_lease=fetch_lease,
                          record_intent=record_intent, record_outcome=record_outcome)
        record = failed_creation_record(db, row, args.creation_token)
        outcome = json.loads(record["result"])
        return {**output, "checkout": outcome["checkout"], "reason": outcome["reason"]}


def remove_released(db, row, item, qualification, args):
    if not automatic_holder_contract(item):
        raise Retain("automatic-holder-contract-not-enrolled")
    capability = holder_qualification()
    if capability["qualified"] is not True or capability["mapping_coverage"] != safety().HOLDER_COVERAGE:
        raise Retain("holder-mapping-coverage-unqualified")
    global NATIVE_GIT
    prior_git = NATIVE_GIT
    NATIVE_GIT = qualification["git"]["path"]
    until = time.monotonic() + 120
    module = safety()
    try:
        with module.maintainer_lock(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))), \
                QualificationFetchLease(revalidate(row)) as fetch_lease:
            # Apply owns full initial/final inventory below. Do not repeat
            # those large reads through report-only completion projections.
            completion_checks(db, row, local=False)
            all_released(db, row, item)
            before = deletion_admission(row, item, qualification, until, fetch_lease)

            def recheck():
                if qualified_policy(args, row) != qualification:
                    raise Retain("activation-proof-changed")
                merged_checks(row)
                return deletion_admission(row, item, qualification, until, fetch_lease)

            return remove_with_intent(db, row, item, before, recheck, qualification,
                                      fetch_lease=fetch_lease)
    finally:
        NATIVE_GIT = prior_git


def sibling_rows(rows):
    result = {}
    for row in rows:
        path = row.get("worktree")
        if not path or path in result:
            raise Retain("sibling-registration-ambiguous")
        result[path] = row
    return result


def sibling_absence(path, until):
    """Bind observed ENOENT to a canonical owned or system ancestor."""
    module = safety()
    def parent_metadata(details):
        if (not stat.S_ISDIR(details.st_mode) or
                (details.st_uid != os.getuid() and
                 (details.st_uid != 0 or
                  (details.st_mode & 0o022 and not details.st_mode & stat.S_ISVTX)))):
            raise Retain("directory-identity-unsafe")
        # Shared directory entries may change independently. Only the ancestor's
        # identity and access metadata bind this read-only absence observation.
        return [details.st_dev, details.st_ino, details.st_uid, details.st_gid,
                details.st_mode, getattr(details, "st_flags", 0)]

    module.tick(until)
    try:
        os.lstat(path)
    except FileNotFoundError:
        pass
    else:
        raise Retain("sibling-absence-changed")
    if str(Path(path).resolve(strict=False)) != str(path):
        raise Retain("sibling-path-rebound")
    parent = Path(path).parent
    while True:
        module.tick(until)
        try:
            metadata = parent_metadata(parent.lstat())
            break
        except FileNotFoundError:
            parent = parent.parent
    fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        missing = Path(path).relative_to(parent).parts[0]
        for _ in range(2):
            module.tick(until)
            # A sticky parent still permits new names. Check the first missing
            # component through the pinned directory, without following links.
            try:
                os.stat(missing, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                pass
            else:
                raise Retain("sibling-absence-changed")
            if (parent_metadata(os.fstat(fd)) != metadata or
                    parent_metadata(parent.lstat()) != metadata or physical(parent) != str(parent)):
                raise Retain("sibling-parent-rebound")
        result = {"state": "absent", "errno": 2, "parent": str(parent), "parent_id": metadata[:2]}
        # Older same-user observations participate in receipt reconciliation.
        # Only the newly admitted system-parent case adds its access metadata.
        if metadata[2] != os.getuid():
            result["parent_metadata"] = metadata[2:]
        return result
    finally:
        os.close(fd)


def sibling_admin_index(snap, until):
    """Resolve absent pointers once per pass, never guess an admin basename."""
    module, result = safety(), {}
    root = Path(snap["common"]) / "worktrees"
    root_id = identity(root)
    if physical(root) != str(root):
        raise Retain("sibling-admin-root-rebound")
    with os.scandir(root) as entries:
        for number, entry in enumerate(entries):
            module.tick(until)
            if number >= module.ENTRY_LIMIT:
                raise Retain("sibling-admin-entry-limit")
            if not entry.is_dir(follow_symlinks=False):
                continue
            admin = Path(entry.path)
            admin_id = identity(admin)
            raw, details = module.read_file(admin / "gitdir", until, 4096)
            if not raw.endswith(b"\n") or b"\0" in raw or b"\n" in raw[:-1]:
                raise Retain("sibling-registration-backlink-invalid")
            pointer = os.path.normpath(admin / os.fsdecode(raw[:-1]))
            if pointer in result:
                raise Retain("sibling-registration-ambiguous")
            result[pointer] = (str(admin), admin_id, list(details), hashlib.sha256(raw).hexdigest())
    if identity(root) != root_id:
        raise Retain("sibling-admin-root-changed")
    return result


def sibling_identity(snap, path, until, admin_index=None):
    """Bind the registration, not mutable HEAD/index/checkout directory times."""
    module = safety()
    module.tick(until)
    absent = {}
    try:
        root_id = identity(path)
        if physical(path) != path:
            raise Retain("sibling-path-rebound")
    except FileNotFoundError:
        root_id = None
        absent["path_absence"] = sibling_absence(path, until)
    common = Path(snap["common"])
    if physical(common) != str(common) or identity(common) != snap["common_id"]:
        raise Retain("sibling-common-directory-changed")
    if path == snap["owner"]:
        if root_id is None or Path(path) / ".git" != common:
            raise Retain("sibling-owner-rebound")
        return {"path_id": root_id, "gitdir": str(common), "gitdir_id": identity(common)}
    pointer = Path(path) / ".git"
    mapped = None
    try:
        raw, pointer_id = module.read_file(pointer, until, 4096)
        if not raw.startswith(b"gitdir: ") or not raw.endswith(b"\n"):
            raise Retain("sibling-pointer-invalid")
        admin = Path(physical(Path(path) / os.fsdecode(raw[8:-1])))
        pointer_value = [list(pointer_id), hashlib.sha256(raw).hexdigest()]
    except FileNotFoundError:
        pointer_value = None
        absent["pointer_absence"] = sibling_absence(pointer, until)
        if admin_index is None:
            admin_index = {}
        if "entries" not in admin_index:
            admin_index["entries"] = sibling_admin_index(snap, until)
        mapped = admin_index["entries"].get(str(pointer))
        if mapped is None:
            raise Retain("sibling-native-admin-unavailable")
        admin = Path(mapped[0])
    if admin.parent != common / "worktrees":
        raise Retain("sibling-common-directory-changed")
    admin_id = identity(admin)
    links = {}
    for name, expected in (("commondir", common), ("gitdir", pointer)):
        data, details = module.read_file(admin / name, until, 4096)
        linked = admin / os.fsdecode(data[:-1])
        resolved = (str(linked.resolve(strict=False)) if name == "gitdir" and absent
                    else physical(linked))
        if not data.endswith(b"\n") or resolved != str(expected):
            raise Retain("sibling-registration-backlink-changed")
        links[name] = [list(details), hashlib.sha256(data).hexdigest()]
    if mapped is not None and (admin_id != mapped[1] or links["gitdir"] != list(mapped[2:])):
        raise Retain("sibling-registration-changed-during-read")
    try:
        lock, lock_id = module.read_file(admin / "locked", until, 4096)
        lock_value = [list(lock_id), hashlib.sha256(lock).hexdigest()]
    except FileNotFoundError:
        lock_value = None
    if (identity(admin) != admin_id or identity(common) != snap["common_id"]
            or (root_id is not None and identity(path) != root_id)
            or (pointer_value is not None and module.file_identity(pointer.lstat()) != pointer_id)
            or any(sibling_absence(path if key == "path_absence" else pointer, until) != value
                   for key, value in absent.items())):
        raise Retain("sibling-registration-changed-during-read")
    return {"path_id": root_id, "gitdir": str(admin), "gitdir_id": admin_id,
            "pointer": pointer_value, "links": links, "lock": lock_value, **absent}


def sibling_identities(snap, rows, until):
    admin_index = {}
    return {path: sibling_identity(snap, path, until, admin_index) for path in sorted(sibling_rows(rows))}


def sibling_comparison(before, after, before_ids=None, after_ids=None):
    old, new = sibling_rows(before), sibling_rows(after)
    changes, preserved = [], True
    for path in sorted(old.keys() | new.keys()):
        if path not in old or path not in new:
            changes.append({"path": path, "kind": "added" if path in new else "missing"})
            preserved &= path in new
            continue
        delta = {key: [old[path].get(key), new[path].get(key)]
                 for key in sorted(old[path].keys() | new[path].keys())
                 if old[path].get(key) != new[path].get(key)}
        # Another owner may commit, detach or switch branches. Only these fields
        # are operational; lost registrations, locks and physical rebinding fail.
        if delta:
            operational = set(delta) <= {"HEAD", "branch", "detached"}
            changes.append({"path": path, "kind": "operational" if operational else "registration",
                            "fields": delta})
            preserved &= operational
        if before_ids is not None and (after_ids is None or path not in before_ids
                                      or before_ids[path] != after_ids.get(path)):
            changes.append({"path": path, "kind": "identity"})
            preserved = False
    return {"preserved": preserved, "changes": changes}


def siblings_preserved(before, after):
    try:
        return sibling_comparison(before, after)["preserved"]
    except Retain:
        return False


def remove_with_intent(db, row, item, before, recheck, qualification, *, restore_lock=False,
                       fetch_lease=None, record_intent=None, record_outcome=None, snapshotter=None,
                       restored_snapshotter=None):
    if (record_intent is None) != (record_outcome is None):
        raise Retain("removal-persistence-callbacks-must-be-paired")
    module, snap = safety(), before["snapshot"]
    snapshotter = snapshotter or snapshot
    native_git = NATIVE_GIT or shutil.which("git")
    if native_git is None or any(
            inside(physical(path), snap["path"]) or inside(physical(path), snap["gitdir"])
            for path in (__file__, module.__file__, native_git)):
        raise Retain("cleanup-executable-inside-deletion-domain")
    siblings = [r for r in records(snap["owner"]) if r.get("worktree") != snap["path"]]
    sibling_ids = sibling_identities(snap, siblings, module.DEADLINE)
    if git(snap["owner"], "rev-parse", snap["branch"]) != snap["head"]:
        raise Retain("preserved-branch-changed")
    intent = {"id": str(uuid.uuid4()), "generation": item["generation"],
              "head": snap["head"], "branch": snap["branch"], "before": before,
              "siblings": siblings, "sibling_identities": sibling_ids, "qualification": qualification}
    # Prepare the enrollment receipt before admission so a large encoding cannot
    # hide new files until after the intent has already been committed.
    encoded = json.dumps(intent, sort_keys=True) if record_intent is None else None

    def check_admission():
        final = recheck()
        if any(final[key] != before[key] for key in (
                "snapshot", "boundaries", "contents", "admin", "branch_reflog")) or (
                final.get("preserved_refs") != before.get("preserved_refs")):
            raise Retain("removal-preimage-changed")
        # Leave time for child reap and readback before committing or unlocking.
        if time.monotonic() >= module.DEADLINE - 32:
            raise Retain("removal-budget-exhausted")
        if fetch_lease is not None:
            fetch_lease.validate()

    check_admission()
    # Keep ownership durable before unlocking. A partial native result must
    # never become a retryable ordinary checkout, even for older consumers.
    if record_intent is not None:
        record_intent(intent)
    else:
        with db:
            changed = db.execute("UPDATE retirement SET state='intent', intent=? "
                                 "WHERE worktree_id=? AND generation=? AND state='enrolled'",
                                 (encoded, row["id"], item["generation"])).rowcount
            if changed != 1:
                raise Retain("release-generation-changed")
    outcome = {"checkout": "unknown", "reason": "removal-incomplete", "child": None,
               "native_attempted": False}
    if before["contents"].get("missing_worktree"):
        outcome["working_tree"] = "already-absent-not-audited"
    if "resolve_undo" in before["contents"]:
        outcome["resolve_undo"] = before["contents"]["resolve_undo"]
    try:
        # SQLite commit can outlast the observation. Keep the native unlock
        # behind fresh holder, filesystem and lease checks even with a receipt.
        check_admission()
        removal_until = min(time.monotonic() + 180, module.DEADLINE - 32)
        # Include unlock in this fact: a returned preparation failure must not
        # masquerade as an attempt that never touched native lifecycle state.
        outcome["native_attempted"] = True
        git(snap["owner"], "worktree", "unlock", "--", snap["path"])
        command = [native_git, "-c", "core.hooksPath=/dev/null", "-c", "gc.auto=0",
                   "-c", "maintenance.auto=false", "-c", "core.fsmonitor=false",
                   "-C", snap["owner"], "worktree", "remove", "--", snap["path"]]
        env = {k: v for k, v in os.environ.items() if not k.startswith(("GIT_", "DYLD_", "LD_"))}
        env.update(GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1",
                   GIT_ALLOW_PROTOCOL="", GIT_OPTIONAL_LOCKS="0", GIT_NO_LAZY_FETCH="1",
                   GIT_TERMINAL_PROMPT="0", LC_ALL="C")
        remaining = removal_until - time.monotonic()
        if remaining <= 0:
            raise Retain("removal-budget-exhausted")
        # Keep the flock alive if this owner dies while native removal continues.
        # Closing our descriptor later must not explicitly unlock the child's copy.
        pass_fds = ((fetch_lease.descriptor,) if fetch_lease is not None
                    and fetch_lease.descriptor is not None else ())
        result = module.supervise(command, cwd=snap["owner"], env=env, timeout=remaining,
                                  pass_fds=pass_fds)
        outcome["child"] = result.proof
        after = records(snap["owner"])
        outcome.update(path_absent=not os.path.lexists(snap["path"]),
                       admin_absent=not os.path.lexists(snap["gitdir"]),
                       registration_absent=not any(r.get("worktree") == snap["path"] for r in after))
        # Persist the actual after rows even if physical readback then fails.
        outcome["siblings_after"] = after
        outcome["sibling_comparison"] = sibling_comparison(siblings, after)
        after_ids = sibling_identities(snap, [r for r in after if r.get("worktree") in sibling_ids],
                                       module.DEADLINE)
        outcome["sibling_identities_after"] = after_ids
        outcome["sibling_comparison"] = sibling_comparison(siblings, after, sibling_ids, after_ids)
        outcome.update(siblings_preserved=outcome["sibling_comparison"]["preserved"],
                       branch_preserved=git(snap["owner"], "rev-parse", snap["branch"]) == snap["head"],
                       branch_reflog_preserved=preserved_branch_reflog(snap, module.DEADLINE) == before["branch_reflog"])
        if "preserved_refs" in before:
            manual_preserved_branches(snap, qualification.get("preserve_ref", ()), module.DEADLINE)
            refs = preserved_refs(snap, before["preserved_refs"], module.DEADLINE)
            outcome["preserved_refs_after"] = refs
            outcome["branch_preserved"] &= all(
                refs[branch]["head"] == proof["head"] for branch, proof in before["preserved_refs"].items())
            outcome["branch_reflog_preserved"] &= all(
                refs[branch]["reflog"] == proof["reflog"] for branch, proof in before["preserved_refs"].items())
        dependency = before["contents"]["dependency"]
        outcome["dependency_preserved"] = dependency is None or identity(
            dependency["destination"]) == dependency["identity"]
        outcome["discarded_link_targets_preserved"] = all(
            (list(module.file_identity(os.stat(path))[:2]) if os.path.exists(path) else None) == expected
            for path, expected in before["contents"].get("discarded_links", {}).items())
        if fetch_lease is not None:
            fetch_lease.validate()
        if not result.failure and result.returncode == 0 and all(
                outcome[key] for key in ("path_absent", "admin_absent", "registration_absent",
                "siblings_preserved", "branch_preserved", "branch_reflog_preserved",
                "dependency_preserved", "discarded_link_targets_preserved")):
            outcome.update(checkout="removed", reason=("finalized-task-worktree-removed" if restore_lock
                                                       else "released-merged-worktree-removed"))
    except (Retain, OSError, ValueError) as error:
        outcome["reason"] = str(error) if isinstance(error, Retain) else "removal-readback-unknown"
    if restore_lock and outcome["checkout"] != "removed":
        try:
            outcome["native_lock_preserved"] = snapshotter(
                snap["path"], snap["root"], snap["lock_reason"]) == snap
        except (Retain, OSError, ValueError):
            outcome["native_lock_preserved"] = False
            try:
                current = snapshotter(snap["path"], snap["root"])
                if {**current, "lock_reason": snap["lock_reason"]} == snap:
                    git(snap["owner"], "worktree", "lock", "--reason", snap["lock_reason"], "--", snap["path"])
                    outcome["native_lock_preserved"] = (restored_snapshotter or snapshotter)(
                        snap["path"], snap["root"], snap["lock_reason"]) == snap
            except (Retain, OSError, ValueError):
                pass
    if record_outcome is not None:
        record_outcome(outcome)
    else:
        with db:
            db.execute("UPDATE retirement SET state=?, result=? WHERE worktree_id=?",
                       ("removed" if outcome["checkout"] == "removed" else "incomplete",
                        json.dumps(outcome, sort_keys=True), row["id"]))
            if restore_lock and outcome["checkout"] == "removed":
                # Once manual closeout is verified, only the terminal tombstone is
                # needed. Retain detailed admission data solely for incomplete work.
                db.execute("UPDATE retirement SET intent=NULL, inventory=NULL WHERE worktree_id=?", (row["id"],))
    return outcome["reason"]


def evaluate_release(db, row, args, *, apply):
    try:
        item = require_open_retirement(db, row)
        all_released(db, row, item)
        if not apply:
            completion_checks(db, row)
            return "released-completion-confirmed-checkout-retained"
        if args.command in ("finish", "release") and args.policy is None:
            return remove_finalized(db, row, args, completed=True)
        storage_guard()
        qualification = qualified_policy(args, row)
        return remove_released(db, row, item, qualification, args)
    except (Retain, OSError, ValueError) as error:
        return str(error) if isinstance(error, Retain) else "removal-proof-unavailable"


def reconciliation(db, row):
    if not db.execute("SELECT 1 FROM sqlite_master WHERE type='table' "
                      "AND name='removal_reconciliations'").fetchone():
        return None
    record = db.execute("SELECT fact FROM removal_reconciliations WHERE worktree_id=?",
                        (row["id"],)).fetchone()
    return json.loads(record[0]) if record else None


def reconcile_external(db, row, args):
    """Record a completed owner's external removal without inventing native proof."""
    item = retirement(db, row)
    who = owner_id(args)
    if (args.worktree != row["path"] or args.worktree_id != row["id"] or item is None
            or item["generation"] != args.generation):
        raise Retain("external-reconciliation-needs-exact-record-and-generation")
    owners = owner_rows(db, row["id"])
    if who not in {owner["owner"] for owner in owners}:
        raise Retain("reconciliation-requires-recorded-owner")
    if row["state"] != "finished" or not all(owner["completed"] for owner in owners):
        raise Retain("external-reconciliation-requires-finished-owners")
    if db.execute("SELECT 1 FROM pins WHERE worktree_id=?", (row["id"],)).fetchone():
        raise Retain("recovery-pin-present")
    previous = json.loads(item["result"]) if item["result"] else None
    repeated = (item["state"] == "removed" and previous is not None
                and previous.get("reason") == "external-removal-reconciled"
                and previous.get("operator") == who
                and previous.get("operator_reason") == args.reason)
    if item["intent"] or (not repeated and (item["state"] != "enrolled" or previous is not None)):
        raise Retain("external-reconciliation-cannot-replace-native-removal-proof")
    snap = json.loads(row["identity"])

    def observe():
        for key in ("owner", "common"):
            if physical(snap[key]) != snap[key] or identity(snap[key]) != snap[key + "_id"]:
                raise Retain("reconciliation-owner-identity-changed")
        if (git(snap["owner"], "rev-parse", "--path-format=absolute", "--git-common-dir") != snap["common"]
                or repository(git(snap["owner"], "remote", "get-url", "origin")) != snap["repo"]):
            raise Retain("reconciliation-owner-binding-changed")
        # Only ENOENT proves absence: denied access and dangling links must not qualify.
        for key in ("path", "gitdir"):
            try:
                os.lstat(snap[key])
            except FileNotFoundError:
                if str(Path(snap[key]).resolve()) != snap[key]:
                    raise Retain("reconciliation-target-path-changed")
                continue
            raise Retain("reconciliation-target-or-admin-present")
        if any(record["worktree"] == snap["path"] for record in records(snap["owner"])):
            raise Retain("reconciliation-target-registered")
        if (os.path.lexists(Path(snap["common"]) / (snap["branch"] + ".lock"))
                or git(snap["owner"], "rev-parse", snap["branch"]) != row["finish_head"]):
            raise Retain("reconciliation-preserved-ref-changed")

    observe()
    if repeated:
        return
    outcome = {"checkout": "removed", "reason": "external-removal-reconciled",
               "native_attempted": False, "operator": who, "operator_reason": args.reason,
               "observed_at": int(time.time()), "generation": args.generation,
               "path_absent": True, "admin_absent": True, "registration_absent": True,
               "branch_preserved": True, "head": row["finish_head"]}
    with db:
        # Existing result fields keep older readers accurate without deleting history.
        changed = db.execute(
            "UPDATE retirement SET state='removed', result=? WHERE worktree_id=? "
            "AND generation=? AND state='enrolled' AND intent IS NULL AND result IS NULL",
            (json.dumps(outcome, sort_keys=True), row["id"], args.generation)).rowcount
        if changed != 1:
            raise Retain("external-reconciliation-record-changed")
        observe()
        db.execute("UPDATE worktrees SET reason=?, checked_at=? WHERE id=?",
                   (outcome["reason"], outcome["observed_at"], row["id"]))


def incomplete_removal(db, row, args):
    """Bind recovery to the original stored bytes, not a reserialized receipt."""
    item = retirement(db, row)
    if (args.worktree != row["path"] or item is None or item["state"] != "incomplete"
            or item["generation"] != args.generation or not item["intent"] or not item["result"]):
        raise Retain("reconciliation-needs-exact-incomplete-intent")
    hashes = {name: hashlib.sha256(item[name].encode()).hexdigest() for name in ("intent", "result")}
    if hashes != {"intent": args.intent_sha256, "result": args.result_sha256}:
        raise Retain("reconciliation-receipt-hash-mismatch")
    intent, outcome = json.loads(item["intent"]), json.loads(item["result"])
    if intent["id"] != args.intent_id or intent["generation"] != args.generation:
        raise Retain("reconciliation-intent-or-generation-mismatch")
    if not db.execute("SELECT 1 FROM owners WHERE worktree_id=? AND owner=?",
                      (row["id"], owner_id(args))).fetchone():
        raise Retain("reconciliation-requires-recorded-owner")
    return item, intent, outcome, hashes


def removal_receipt(db, row):
    item = retirement(db, row)
    archived = False
    if item is None:
        raise Retain("removal-receipt-needs-native-enrollment")
    if not item["intent"] and db.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='unstarted_removal_recoveries'").fetchone():
        prior = db.execute("SELECT * FROM unstarted_removal_recoveries WHERE worktree_id=? "
                           "ORDER BY generation DESC LIMIT 1", (row["id"],)).fetchone()
        if prior is not None:
            item, archived = prior, True
    if not item["intent"] or not item["result"]:
        return None
    intent, outcome = (json.loads(item[key]) for key in ("intent", "result"))
    child = outcome.get("child")
    if isinstance(child, dict):
        child = {key: child[key] for key in ("pid", "returncode", "reaped", "group_absent") if key in child}
    elif child is not None:
        child = {"invalid_type": type(child).__name__}
    # Inventory bodies can cover an entire checkout. Expose binding hashes and
    # bounded producer facts; raw historical bytes remain in the owner database.
    return {"worktree_id": row["id"], "generation": item["generation"],
            "intent_id": intent["id"], "reconciled": archived,
            **{key + "_sha256": hashlib.sha256(item[key].encode()).hexdigest()
               for key in ("intent", "result")},
            "qualification": {key: intent["qualification"].get(key) for key in ("mode", "operator")},
            "result": {**{key: outcome[key] for key in (
                "checkout", "reason", "native_attempted", "native_lock_preserved") if key in outcome},
                **({"child": child} if "child" in outcome else {})}}


def reconcile_unstarted(db, row, args):
    item, intent, outcome, hashes = incomplete_removal(db, row, args)
    qualification = intent["qualification"]
    before = intent["before"]
    expected = {"checkout", "reason", "child", "native_attempted", "native_lock_preserved", "resolve_undo"}
    # Historical receipts predate native_attempted. Only this exact pre-dispatch
    # shape and deadline reason are known to precede unlock in that producer;
    # git preparation failures were wrapped as git-failed, not admission-deadline.
    if (outcome.get("checkout") != "unknown" or outcome.get("reason") != "admission-deadline"
            or "child" not in outcome or outcome["child"] is not None
            or not set(outcome) <= expected
            or ("native_attempted" in outcome and outcome["native_attempted"] is not False)
            or ("native_lock_preserved" in outcome and type(outcome["native_lock_preserved"]) is not bool)
            or ("resolve_undo" in outcome and outcome["resolve_undo"] != before["contents"].get("resolve_undo"))
            or qualification.get("mode") != "explicit-finalized-task"
            or qualification.get("operator") != owner_id(args)
            or before["contents"].get("missing_worktree")
            or cancellation_rows(db, row["id"])):
        raise Retain("reconciliation-removal-was-not-proven-unstarted")
    completion_checks(db, row, local=False)
    all_released(db, row, item)
    snap, module = before["snapshot"], safety()
    if not snap.get("lock_reason", "").startswith("gwt-finish.v2:"):
        raise Retain("reconciliation-needs-native-enrollment")
    source = {**dict(row), "finalized_refs": before["preserved_refs"]}
    disposal = types.SimpleNamespace(discard_ignored=qualification["discard_ignored"],
                                     preserve_ref=qualification.get("preserve_ref", []), sudo_holder_scan=False)
    until = min(time.monotonic() + 120, module.DEADLINE)
    with module.maintainer_lock(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))), \
            QualificationFetchLease(snap) as fetch_lease:
        observed = finalized_admission(db, source, disposal, until, completed=True, fetch_lease=fetch_lease)
        if json.dumps(observed, sort_keys=True) != json.dumps(before, sort_keys=True):
            raise Retain("reconciliation-unstarted-preimage-changed")
        # Metadata recovery needs one fresh inventory; a second full scan could
        # repeat the admission timeout. Actual removal still admits twice.
        if revalidate(source) != snap or preserved_refs(snap, before["preserved_refs"], until) != before["preserved_refs"]:
            raise Retain("reconciliation-unstarted-preimage-changed")
        fetch_lease.validate()
        # A distinct archive cannot be read as the existing target-removed fact.
        # Reset release authority, never source or history; removal is a separate
        # explicit operation with new admission and its own sibling census.
        with db:
            db.execute("CREATE TABLE IF NOT EXISTS unstarted_removal_recoveries ("
                       "worktree_id TEXT NOT NULL REFERENCES worktrees(id), generation INTEGER NOT NULL, "
                       "intent TEXT NOT NULL, result TEXT NOT NULL, fact TEXT NOT NULL, "
                       "PRIMARY KEY(worktree_id, generation))")
            fact = {"operator": owner_id(args), "observed_at": int(time.time()),
                    "intent_id": args.intent_id, "receipt_sha256": hashes,
                    "successor_generation": item["generation"] + 1}
            db.execute("INSERT INTO unstarted_removal_recoveries VALUES (?, ?, ?, ?, ?)",
                       (row["id"], item["generation"], item["intent"], item["result"], json.dumps(fact, sort_keys=True)))
            changed = db.execute("UPDATE retirement SET state='enrolled', generation=generation+1, "
                                 "intent=NULL, result=NULL, inventory=NULL WHERE worktree_id=? "
                                 "AND generation=? AND state='incomplete' AND intent=? AND result=?",
                                 (row["id"], item["generation"], item["intent"], item["result"])).rowcount
            if changed != 1:
                raise Retain("reconciliation-attempt-changed")
            db.execute("DELETE FROM owner_releases WHERE worktree_id=?", (row["id"],))
            db.execute("UPDATE worktrees SET reason='unstarted-removal-reconciled', checked_at=? WHERE id=?",
                       (int(time.time()), row["id"]))


def reconcile(db, row, args):
    """Append current preservation evidence; never retry removal or rewrite history."""
    item, intent, outcome, hashes = incomplete_removal(db, row, args)
    child = outcome.get("child") or {}
    required = ("path_absent", "admin_absent", "registration_absent", "branch_preserved",
                "branch_reflog_preserved", "dependency_preserved", "discarded_link_targets_preserved")
    # Current receipts use siblings_preserved; older retained receipts used
    # siblings_unchanged. Admit only sibling failure with a proven target removal.
    if (outcome.get("checkout") != "unknown" or outcome.get("reason") != "removal-incomplete"
            or outcome.get("siblings_preserved", outcome.get("siblings_unchanged")) is not False
            or any(outcome.get(key) is not True for key in required)
            or type(child.get("returncode")) is not int or child["returncode"] != 0
            or child.get("reaped") is not True
            or child.get("group_absent") is not True
            or type(child.get("pid")) is not int or child["pid"] <= 0):
        raise Retain("reconciliation-original-removal-not-qualified")
    for probe in (os.kill, os.killpg):
        try:
            probe(child["pid"], 0)
        except ProcessLookupError:
            continue
        raise Retain("reconciliation-child-or-group-present")
    before = intent["before"]
    snap, module = before["snapshot"], safety()
    until = min(time.monotonic() + 120, module.DEADLINE)

    def observe():
        module.tick(until)
        for key in ("owner", "common"):
            if physical(snap[key]) != snap[key] or identity(snap[key]) != snap[key + "_id"]:
                raise Retain("reconciliation-owner-identity-changed")
        if (git(snap["owner"], "rev-parse", "--path-format=absolute", "--git-common-dir") != snap["common"]
                or repository(git(snap["owner"], "remote", "get-url", "origin")) != snap["repo"]):
            raise Retain("reconciliation-owner-binding-changed")
        # lexists also hides permission and I/O failures; only ENOENT proves absence.
        for key in ("path", "gitdir"):
            try:
                os.lstat(snap[key])
            except FileNotFoundError:
                continue
            raise Retain("reconciliation-target-or-admin-present")
        after = records(snap["owner"])
        if snap["path"] in sibling_rows(after):
            raise Retain("reconciliation-target-registered")
        old = sibling_rows(intent["siblings"])
        comparison = sibling_comparison(intent["siblings"], after)
        identities, errors, admin_index = {}, [], {}
        for path in sorted(old.keys() & sibling_rows(after).keys()):
            try:
                identities[path] = sibling_identity(snap, path, until, admin_index)
            except (Retain, OSError, ValueError) as error:
                if isinstance(error, Retain) and str(error) == "admission-deadline":
                    raise
                errors.append({"path": path, "kind": "identity-unavailable",
                               "reason": str(error) if isinstance(error, Retain) else "identity-read-failed"})
                if isinstance(error, OSError):
                    errors[-1]["errno"] = error.errno
        if "sibling_identities" in intent:
            comparison = sibling_comparison(intent["siblings"], after, intent["sibling_identities"], identities)
        comparison["changes"].extend(errors)
        if errors:
            comparison["preserved"] = False
        if (os.path.lexists(Path(snap["common"]) / (snap["branch"] + ".lock"))
                or git(snap["owner"], "rev-parse", snap["branch"]) != intent["head"]
                or preserved_branch_reflog(snap, until) != before["branch_reflog"]):
            raise Retain("reconciliation-preserved-ref-changed")
        dependency = before["contents"]["dependency"]
        if dependency is not None and identity(dependency["destination"]) != dependency["identity"]:
            raise Retain("reconciliation-dependency-changed")
        for path, expected in before["contents"].get("discarded_links", {}).items():
            current = list(module.file_identity(os.stat(path))[:2]) if os.path.exists(path) else None
            if current != expected:
                raise Retain("reconciliation-external-link-target-changed")
        return after, identities, comparison

    after, identities, comparison = observe()
    manual_holders(snap, before["contents"], before["admin"], until)
    final, final_ids, final_comparison = observe()
    stability = sibling_comparison([r for r in after if r["worktree"] in identities],
                                   final, identities, final_ids)
    # A later sibling closeout or unreadable identity cannot erase independently
    # proven target removal. Retain the gap as an alert, never preserved=true.
    final_comparison["during_observation"] = stability
    if not comparison["preserved"] or not stability["preserved"]:
        final_comparison["preserved"] = False
        final_comparison["initial_observation"] = comparison
    existing = reconciliation(db, row)
    if existing:
        if existing["intent_id"] != args.intent_id or existing["receipt_sha256"] != hashes:
            raise Retain("reconciliation-record-conflict")
        if existing["sibling_comparison"] != final_comparison:
            raise Retain("reconciliation-recorded-sibling-observation-changed")
        return
    fact = {"checkout": "removed", "observed_at": int(time.time()), "operator": owner_id(args),
            "intent_id": args.intent_id, "generation": args.generation, "receipt_sha256": hashes,
            "original_checkout": outcome["checkout"], "historical_sibling_preservation": "unresolved",
            "historical_sibling_identities": "recorded" if "sibling_identities" in intent else "unavailable",
            "historical_after_snapshot": "recorded" if "siblings_after" in outcome else "unavailable",
            "siblings_after": final, "sibling_identities": final_ids, "sibling_comparison": final_comparison}
    # A distinct, append-only fact leaves old clients fail-closed on the original
    # incomplete intent. Fresh absence is not historical siblings_unchanged proof.
    with db:
        db.execute("CREATE TABLE IF NOT EXISTS removal_reconciliations ("
                   "worktree_id TEXT PRIMARY KEY REFERENCES worktrees(id), fact TEXT NOT NULL)")
        db.execute("INSERT INTO removal_reconciliations VALUES (?, ?)",
                   (row["id"], json.dumps(fact, sort_keys=True)))


def owner_rows(db, worktree_id):
    columns = {row["name"] for row in db.execute("PRAGMA table_info(owners)")}
    if "completed" in columns:
        query = (
            "SELECT owner, completed FROM owners "
            "WHERE worktree_id = ? ORDER BY owner"
        )
    else:
        query = (
            "SELECT owner, 0 AS completed FROM owners "
            "WHERE worktree_id = ? ORDER BY owner"
        )
    return [dict(item) for item in db.execute(query, (worktree_id,))]


def recovery_digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()


RECOVERY_CONTRACT = "gwt-missing-recovery.v2"
RECOVERY_CONTAINER_CONTRACT = "gwt-missing-recovery.v3"


def missing_recovery_fact(db, row):
    if not db.execute("SELECT 1 FROM sqlite_master WHERE type='table' "
                      "AND name='missing_recoveries'").fetchone():
        return None
    result = db.execute("SELECT fact FROM missing_recoveries WHERE worktree_id=?",
                        (row["id"],)).fetchone()
    return result[0] if result else None


def missing_recovery_record(db, row):
    fact = missing_recovery_fact(db, row)
    return json.loads(fact) if fact is not None else None


def completed_recovery_successor(record, row):
    try:
        before, result, intent = record["preimage"], record["result"], record["intent"]
        stage = record["stage_id"]
        valid = (result["checkout"] == "restored"
                 and result["intent_id"] == intent["id"] == record["id"]
                 and result["recovery_sha256"] == intent["digest"] == record["digest"] == recovery_digest(before)
                 and result["head"] == before["head"]
                 and type(before["generation"]) is int and type(result["generation"]) is int
                 and result["generation"] == before["generation"] + 1
                 and isinstance(stage, list) and len(stage) == 2
                 and all(type(value) is int and value >= 0 for value in stage)
                 and json.loads(row["identity"]) == {**before["observed_identity"], "path_id": stage})
    except (KeyError, TypeError, ValueError):
        valid = False
    if not valid:
        raise Retain("recovery-completed-receipt-invalid")


def missing_recovery_history(db, row, predecessor=None):
    history = []
    if db.execute("SELECT 1 FROM sqlite_master WHERE type='table' "
                  "AND name='missing_recovery_history'").fetchone():
        for item in db.execute("SELECT intent_id, fact FROM missing_recovery_history "
                               "WHERE worktree_id=? ORDER BY intent_id", (row["id"],)):
            record = json.loads(item["fact"])
            if record["id"] != item["intent_id"] or not record.get("result"):
                raise Retain("recovery-history-invalid")
            history.append({"id": item["intent_id"],
                            "sha256": hashlib.sha256(item["fact"].encode()).hexdigest()})
    if predecessor is not None:
        record = json.loads(predecessor)
        if any(item["id"] == record["id"] for item in history):
            raise Retain("recovery-history-collision")
        if record["preimage"].get("recovery_history", []) != history:
            raise Retain("recovery-history-drift")
        history.append({"id": record["id"], "sha256": hashlib.sha256(predecessor.encode()).hexdigest()})
    return sorted(history, key=lambda item: item["id"])


def recovery_release_evidence(db, row, item, owners, head):
    releases = [dict(value) for value in db.execute(
        "SELECT owner, generation FROM owner_releases WHERE worktree_id=? ORDER BY owner", (row["id"],))]
    proof = {key: row[key] for key in ("finish_head", "primary_pr", "target", "dependencies")}
    proof["inventory"] = item["inventory"]
    if releases:
        repo = json.loads(row["identity"])["repo"]
        primary = PR_URL.fullmatch(proof["primary_pr"]) if isinstance(proof["primary_pr"], str) else None
        base_repo = primary[1].lower() if primary is not None else None
        def local_pr(url):
            match = PR_URL.fullmatch(url) if isinstance(url, str) else None
            return match is not None and url == f"https://github.com/{base_repo}/pull/{match[2]}"

        completed = {owner["owner"] for owner in owners if owner["completed"] == 1}
        if (any(release["owner"] not in completed or type(release["generation"]) is not int
                or release["generation"] != item["generation"] for release in releases)
                or proof["finish_head"] != head
                or not local_pr(proof["primary_pr"])
                or not isinstance(proof["target"], str) or not proof["target"]):
            raise Retain("recovery-release-proof-invalid")
        try:
            dependencies = json.loads(proof["dependencies"])
            inventory = json.loads(proof["inventory"])
            if (not isinstance(dependencies, list) or len(dependencies) > 16
                    or any(not isinstance(value, dict) or set(value) != {"url", "head", "target"}
                           or not local_pr(value["url"]) or value["url"] == proof["primary_pr"]
                           or not isinstance(value["head"], str) or not SHA.fullmatch(value["head"])
                           or value["target"] != proof["target"] for value in dependencies)):
                raise Retain("recovery-release-proof-invalid")
            valid = (isinstance(inventory, dict)
                     and inventory["schema"] == RELEASE_BASELINE_SCHEMA
                     and isinstance(inventory["discard_ignored"], list)
                     and all(isinstance(value, str) for value in inventory["discard_ignored"])
                     and ((isinstance(inventory["baseline"], dict) and inventory["blocker"] is None)
                          or (inventory["baseline"] is None and isinstance(inventory["blocker"], str)
                              and bool(inventory["blocker"]))))
        except (TypeError, ValueError, KeyError):
            valid = False
        if not valid:
            raise Retain("recovery-release-inventory-invalid")
        if base_repo != repo:
            # Existing receipts do not persist fork identity. Recheck it before
            # consuming cross-repository releases; same-repository recovery stays offline.
            completion_pr_proofs(row)
    return {"releases": releases, "completion_proof": proof}


def missing_recovery_preimage(db, row, args, until, *, published=False, legacy=False, predecessor=None,
                             container=None, record=None):
    module = safety()
    snap = json.loads(row["identity"])
    original_identity = json.loads(row["identity"])
    devices = {}
    path = Path(snap["path"])
    if row["id"] != args.worktree_id or row["path"] != str(path):
        raise Retain("recovery-record-mismatch")
    boundary = Path(snap["root"]) if container else path.parent
    if (physical(boundary) != str(boundary) or not inside(str(path), snap["root"])
            or str(path) == snap["root"]):
        raise Retain("recovery-path-boundary-changed")
    if container:
        container.observe(record, published)
    if not published and os.path.lexists(path):
        raise Retain("recovery-target-present")
    for key in ("owner", "common", "gitdir"):
        current_id = identity(snap[key])
        recorded_id = snap[key + "_id"]
        if physical(snap[key]) != snap[key]:
            raise Retain("recovery-admin-owner-identity-changed")
        if args.allow_device_renumbering:
            if (recorded_id[1] != current_id[1]
                    or devices.setdefault(recorded_id[0], current_id[0]) != current_id[0]):
                raise Retain("recovery-device-or-inode-changed")
            snap[key + "_id"] = current_id
        elif current_id != recorded_id:
            raise Retain("recovery-admin-owner-identity-changed")
    if args.allow_device_renumbering:
        if len(set(devices.values())) != len(devices):
            raise Retain("recovery-device-map-not-bijective")
        original_device, original_inode = snap["path_id"]
        if (original_device not in devices
                or devices[original_device] != identity(boundary)[0]):
            raise Retain("recovery-parent-volume-unmapped-or-changed")
        snap["path_id"] = [devices[original_device], original_inode]
    observed_identity = dict(snap)
    if (git(snap["owner"], "rev-parse", "--path-format=absolute", "--git-common-dir") != snap["common"]
            or repository(git(snap["owner"], "remote", "get-url", "origin")) != snap["repo"]):
        raise Retain("recovery-owner-binding-changed")
    selected = [entry for entry in records(snap["owner"]) if entry.get("worktree") == str(path)]
    if (len(selected) != 1 or selected[0].get("HEAD") != args.expected_head
            or selected[0].get("branch") != snap["branch"]
            or selected[0].get("locked") != snap.get("lock_reason")):
        raise Retain("recovery-registration-changed")
    for marker in ("index.lock", "HEAD.lock", "config.lock", "packed-refs.lock", "MERGE_HEAD",
                   "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_LOG", "rebase-merge", "rebase-apply", "sequencer"):
        if any(os.path.lexists(Path(snap[key]) / marker) for key in ("common", "gitdir")):
            raise Retain("recovery-git-operation-present")
    snap = {**snap, "head": args.expected_head}
    admin_path = Path(snap["gitdir"])
    raw, index_identity = module.read_file(admin_path / "index", until, module.INDEX_LIMIT)
    if hashlib.sha256(raw).hexdigest() != args.index_sha256:
        raise Retain("recovery-index-changed")
    entries, resolve_undo = module.index_entries(raw, allow_resolve_undo=not legacy)
    if any(entry[2] for entry in entries.values()):
        raise Retain("recovery-sparse-index")
    if resolve_undo is not None:
        module.retained_resolve_undo(snap["owner"], git, until, resolve_undo)
    tree = module.tree_entries(git(snap["owner"], "--no-replace-objects", "ls-tree", "-rz",
                                   args.expected_head, deadline=until, capture_limit=32 * 1024 * 1024))
    if {name: entry[:2] for name, entry in entries.items()} != tree:
        raise Retain("recovery-index-not-head")
    for name, expected in (("HEAD", "ref: " + snap["branch"] + "\n"),
                           ("gitdir", str(path / ".git") + "\n")):
        data, _ = module.read_file(admin_path / name, until)
        if data != os.fsencode(expected):
            raise Retain("recovery-admin-binding-changed")
    data, _ = module.read_file(admin_path / "commondir", until)
    if str((admin_path / os.fsdecode(data).rstrip("\n")).resolve(strict=True)) != snap["common"]:
        raise Retain("recovery-common-binding-changed")
    # Checks that need a Git cwd use the unchanged canonical owner while all
    # inventoried admin paths still belong to this exact missing checkout.
    admin = module.recovery_admin_inventory({**snap, "path": snap["owner"]}, git, until)
    if (admin["index"][0][:-1] != list(index_identity)
            or admin["index"][1] != args.index_sha256):
        raise Retain("recovery-index-changed")
    refs = preserved_refs(snap, [snap["branch"]], until)
    if refs[snap["branch"]]["head"] != args.expected_head:
        raise Retain("recovery-branch-changed")
    item = retirement(db, row)
    if item is None or item["generation"] != args.generation:
        raise Retain("recovery-generation-changed")
    owners = owner_rows(db, row["id"])
    if not owners or row["state"] != "active":
        raise Retain("recovery-needs-existing-active-owners")
    if not legacy and (not any(owner["completed"] == 0 for owner in owners)
                       or any(type(owner["completed"]) is not int or owner["completed"] not in (0, 1)
                              for owner in owners)):
        raise Retain("recovery-needs-unfinished-owner")
    if cancellation_rows(db, row["id"]):
        raise Retain("recovery-cancellation-present")
    if db.execute("SELECT 1 FROM pins WHERE worktree_id=?", (row["id"],)).fetchone():
        raise Retain("recovery-pin-present")
    if legacy and db.execute("SELECT 1 FROM owner_releases WHERE worktree_id=?", (row["id"],)).fetchone():
        raise Retain("recovery-release-present")
    evidence = {} if legacy else {
        "recovery_contract": RECOVERY_CONTAINER_CONTRACT if container else RECOVERY_CONTRACT,
        "resolve_undo": resolve_undo,
        "recovery_history": missing_recovery_history(db, row, predecessor),
        **recovery_release_evidence(db, row, item, owners, args.expected_head)}
    if container:
        evidence["container_layout"] = container.fact
    boundaries = [module.access_boundary(str(boundary), until),
                  module.access_boundary(snap["gitdir"], until)]
    manual_holders(snap, {"entries": {}, "discarded_inodes": [snap["path_id"]]}, admin, until)
    return {"identity": original_identity, "observed_identity": observed_identity,
            "allow_device_renumbering": args.allow_device_renumbering,
            "device_mapping": sorted([old, new] for old, new in devices.items()),
            "head": args.expected_head,
            "index_sha256": args.index_sha256, "registration": selected[0], "admin": admin,
            "refs": refs, "boundaries": boundaries, "owners": owners,
            "generation": item["generation"], "state": row["state"], **evidence}, tree


RECOVERY_BLOB_LIMIT = 16 * 1024 * 1024
RECOVERY_BATCH_ENTRIES = 1024


def recovery_blob_metadata(owner, entries, until, byte_budget):
    pending = iter(entries)
    while group := list(itertools.islice(pending, RECOVERY_BATCH_ENTRIES)):
        safety().tick(until)
        request = b"".join(oid.encode() + b"\n" for _, (_, oid) in group)
        metadata = git(owner, "--no-replace-objects", "cat-file", "--batch-check",
                       input_data=request, raw=True, strict=True, deadline=until,
                       capture_limit=RECOVERY_BATCH_ENTRIES * 64)
        lines = metadata.split(b"\n")
        if len(lines) != len(group) + 1 or lines[-1] != b"":
            raise Retain("recovery-batch-metadata-invalid")
        sized = []
        for (name, (mode, oid)), line in zip(group, lines):
            fields = line.split(b" ")
            if (len(fields) != 3 or fields[:2] != [oid.encode(), b"blob"]
                    or not re.fullmatch(rb"0|[1-9][0-9]{0,8}", fields[2])):
                raise Retain("recovery-batch-metadata-invalid")
            size = int(fields[2])
            if mode == 0o120000 and size > RECOVERY_BLOB_LIMIT:
                raise Retain("recovery-blob-size-limit")
            if size > byte_budget:
                raise Retain("recovery-source-byte-limit")
            byte_budget -= size
            sized.append((name, mode, oid, size, line + b"\n"))
        yield sized


def recovery_blob_chunks(blob, until):
    stream, offset, size = blob
    stream.seek(offset)
    while size:
        safety().tick(until)
        data = stream.read(min(65536, size))
        if not data:
            raise Retain("recovery-batch-content-invalid")
        size -= len(data)
        yield data


def recovery_blobs(owner, entries, until, byte_budget):
    for sized in recovery_blob_metadata(owner, entries, until, byte_budget):
        while sized:
            count = total = 0
            for entry in sized:
                if count and total + entry[3] > RECOVERY_BLOB_LIMIT:
                    break
                count += 1
                total += entry[3]
            batch, sized = sized[:count], sized[count:]
            # One large regular blob gets its own batch. The anonymous spool
            # keeps memory bounded and no destination sees an unverified frame.
            with tempfile.TemporaryFile() as stream:
                git(owner, "--no-replace-objects", "cat-file", "--batch",
                    input_data=b"".join(entry[2].encode() + b"\n" for entry in batch),
                    raw=True, strict=True, deadline=until, stdout_sink=stream,
                    capture_limit=total + sum(len(entry[4]) + 1 for entry in batch))
                stream.seek(0)
                verified = []
                for name, mode, oid, size, header in batch:
                    safety().tick(until)
                    if stream.read(len(header)) != header:
                        raise Retain("recovery-batch-content-invalid")
                    blob = (stream, stream.tell(), size)
                    digest = hashlib.sha1(b"blob " + str(size).encode() + b"\0")
                    for chunk in recovery_blob_chunks(blob, until):
                        digest.update(chunk)
                    if stream.read(1) != b"\n":
                        raise Retain("recovery-batch-content-invalid")
                    if digest.hexdigest() != oid:
                        raise Retain("recovery-blob-identity-mismatch")
                    verified.append((name, mode, blob))
                if stream.read(1):
                    raise Retain("recovery-batch-content-invalid")
                # Ranges stay valid only while this generator owns the spool.
                yield from verified


def recovery_tree(root, entries, gitdir, until, *, write=False, owner=None, allow_partial=False,
                  expected_id=None):
    module = safety()
    root = Path(root)
    root_id = identity(root)
    # Materialization must use the durably recorded stage, not a replacement
    # that appeared between creation/partial validation and opening its root.
    if expected_id is not None and root_id != expected_id:
        raise Retain("recovery-staging-rebound")
    if root.lstat().st_mode & 0o077:
        raise Retain("recovery-private-staging-required")
    expected = {**entries, ".git": (0o100600, None)}
    directories = {""}
    for name in expected:
        directories.update(str(p) for p in Path(name).parents if str(p) != ".")
    present = set()
    present_bytes = 0
    if write and allow_partial:
        verified_id, present, present_bytes = recovery_tree(
            root, entries, gitdir, until, allow_partial=True, expected_id=root_id)
        if verified_id != root_id:
            raise Retain("recovery-staging-rebound")
    if write:
        root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            if list(module.file_identity(os.fstat(root_fd))[:2]) != root_id:
                raise Retain("recovery-staging-rebound")
            for name in sorted(directories - {""}, key=lambda p: (p.count("/"), p)):
                if name in present:
                    continue
                with recovery_parent(root_fd, name) as (parent_fd, leaf):
                    os.mkdir(leaf, mode=0o700, dir_fd=parent_fd)
            pointer = os.fsencode("gitdir: " + gitdir + "\n")
            pointer_bytes = 0 if ".git" in present else len(pointer)
            if present_bytes + pointer_bytes > module.SOURCE_LIMIT:
                raise Retain("recovery-source-byte-limit")
            with contextlib.closing(recovery_blobs(
                    owner, ((name, value) for name, value in entries.items() if name not in present),
                    until, module.SOURCE_LIMIT - present_bytes - pointer_bytes)) as blobs:
                source = itertools.chain(blobs, [] if ".git" in present else [(".git", 0o100600, pointer)])
                for name, mode, data in source:
                    module.tick(until)
                    with recovery_parent(root_fd, name) as (parent_fd, leaf):
                        if mode == 0o120000:
                            target = b"".join(recovery_blob_chunks(data, until))
                            os.symlink(os.fsdecode(target), leaf, dir_fd=parent_fd)
                        else:
                            fd = os.open(leaf, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                                         mode & 0o777, dir_fd=parent_fd)
                            with os.fdopen(fd, "wb") as stream:
                                chunks = (data,) if isinstance(data, bytes) else recovery_blob_chunks(data, until)
                                for chunk in chunks:
                                    stream.write(chunk)
                                stream.flush()
                                os.fchmod(stream.fileno(), mode & 0o777)
                                os.fsync(stream.fileno())
        finally:
            os.close(root_fd)
    observed = set()
    total = 0
    for directory, dirs, files in os.walk(root, followlinks=False):
        module.tick(until)
        for name in dirs + files:
            path = Path(directory) / name
            relative = str(path.relative_to(root))
            if relative in observed:
                raise Retain("recovery-tree-duplicate")
            observed.add(relative)
            details = path.lstat()
            if relative in directories:
                if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid() or details.st_mode & 0o077:
                    raise Retain("recovery-directory-changed")
                continue
            if relative not in expected or details.st_uid != os.getuid():
                raise Retain("recovery-tree-unexpected-entry")
            mode, oid = expected[relative]
            if mode == 0o120000:
                if not stat.S_ISLNK(details.st_mode):
                    raise Retain("recovery-link-changed")
                data = os.fsencode(os.readlink(path))
                size = len(data)
                matched = hashlib.sha1(b"blob " + str(size).encode() + b"\0" + data).hexdigest() == oid
            else:
                if not stat.S_ISREG(details.st_mode) or stat.S_IMODE(details.st_mode) != mode & 0o777:
                    raise Retain("recovery-file-mode-changed")
                if details.st_size > module.SOURCE_LIMIT - total:
                    raise Retain("recovery-source-byte-limit")
                if oid is None:
                    data, _ = module.read_file(path, until, RECOVERY_BLOB_LIMIT)
                    size = len(data)
                    matched = data == os.fsencode("gitdir: " + gitdir + "\n")
                else:
                    digest, size = module.tracked_blob(path, until, module.file_identity(details),
                                                       module.SOURCE_LIMIT - total)
                    matched = digest == oid
            total += size
            if total > module.SOURCE_LIMIT:
                raise Retain("recovery-source-byte-limit")
            if not matched:
                raise Retain("recovery-file-content-changed")
    if ((not (allow_partial and not write) and observed != set(expected) | (directories - {""}))
            or identity(root) != root_id):
        raise Retain("recovery-tree-incomplete-or-rebound")
    if write:
        for name in sorted(directories, reverse=True):
            fd = os.open(root / name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
    return (root_id, observed, total) if allow_partial and not write else root_id


@contextlib.contextmanager
def recovery_parent(root_fd, name):
    with contextlib.ExitStack() as close:
        parent_fd = root_fd
        parts = Path(name).parts
        for part in parts[:-1]:
            parent_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
            close.callback(os.close, parent_fd)
        yield parent_fd, parts[-1]


def recovery_publish(source, target):
    lib = ctypes.CDLL(None, use_errno=True)
    if sys.platform == "darwin":
        function = lib.renamex_np
        function.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
        args = (os.fsencode(source), os.fsencode(target), 4)  # RENAME_EXCL
    elif sys.platform == "linux" and hasattr(lib, "renameat2"):
        function = lib.renameat2
        function.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
        args = (-100, os.fsencode(source), -100, os.fsencode(target), 1)  # RENAME_NOREPLACE
    else:
        raise Retain("recovery-no-replace-unavailable")
    function.restype = ctypes.c_int
    if function(*args) != 0:
        raise Retain("recovery-no-replace-refused")
    fd = os.open(Path(target).parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def recovery_publish_at(root_fd, source, target):
    """Publish direct children through the held root, never an absolute pathname."""
    if any(not name or Path(name).name != name or name in (".", "..") for name in (source, target)):
        raise Retain("recovery-container-name-invalid")
    lib = ctypes.CDLL(None, use_errno=True)
    if sys.platform == "darwin" and hasattr(lib, "renameatx_np"):
        function, flags = lib.renameatx_np, 4  # SDK sys/stdio.h: RENAME_EXCL
    elif sys.platform == "linux" and hasattr(lib, "renameat2"):
        function, flags = lib.renameat2, 1  # linux/fs.h: RENAME_NOREPLACE
    else:
        raise Retain("recovery-no-replace-unavailable")
    function.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    function.restype = ctypes.c_int
    if function(root_fd, os.fsencode(source), root_fd, os.fsencode(target), flags) != 0:
        raise Retain("recovery-no-replace-refused")
    os.fsync(root_fd)


class RecoveryContainer:
    """One missing repo container; its existing managed root owns all mutations."""

    def __init__(self, snap, until):
        self.until = until
        self.root = Path(snap["root"])
        path = Path(snap["path"])
        if path.parent.parent != self.root or physical(self.root) != str(self.root):
            raise Retain("recovery-container-layout-unsupported")
        self.fact = {"root": str(self.root), "root_id": identity(self.root),
                     "boundary": safety().access_boundary(str(self.root), until),
                     "container": path.parent.name, "checkout": path.name}
        self.fd = os.open(self.root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            self.check_root()
        except BaseException:
            self.close()
            raise

    def close(self):
        os.close(self.fd)

    def check_root(self):
        safety().tick(self.until)
        if (list(safety().file_identity(os.fstat(self.fd))[:2]) != self.fact["root_id"]
                or identity(self.root) != self.fact["root_id"]
                or safety().access_boundary(str(self.root), self.until) != self.fact["boundary"]):
            raise Retain("recovery-container-root-changed")

    def absent(self, name):
        try:
            os.stat(name, dir_fd=self.fd, follow_symlinks=False)
        except FileNotFoundError:
            return
        raise Retain("recovery-container-appeared")

    def stage_name(self, record):
        identifier = record["id"]
        if str(uuid.UUID(identifier)) != identifier:
            raise Retain("recovery-container-intent-invalid")
        name = ".gwt-recover-" + identifier
        if record["stage"] != str(self.root / name / self.fact["checkout"]):
            raise Retain("recovery-container-stage-binding-changed")
        return name

    def observe(self, record, published):
        self.check_root()
        if record is not None and record["preimage"]["container_layout"] != self.fact:
            raise Retain("recovery-container-root-changed")
        if published:
            self.verify(record, published=True)
            self.absent(self.stage_name(record))
        else:
            self.absent(self.fact["container"])

    def verify(self, record, *, published=False):
        self.check_root()
        name = self.fact["container"] if published else self.stage_name(record)
        expected = record.get("container_id")
        if expected is None or record["stage_id"] is None:
            raise Retain("recovery-container-inode-unknown")
        with self.directory(name, self.fd, expected) as fd:
            # Only a private stage belongs wholly to this intent. After publication
            # the shared repo container may acquire independently owned siblings.
            if not published:
                with os.scandir(fd) as children:
                    observed = [entry.name for _, entry in zip(range(2), children)]
                if observed != [self.fact["checkout"]]:
                    raise Retain("recovery-container-unexpected-entry")
            with self.directory(self.fact["checkout"], fd, record["stage_id"]):
                pass

    @contextlib.contextmanager
    def directory(self, name, parent_fd, expected=None):
        named = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        if (not stat.S_ISDIR(named.st_mode) or named.st_uid != os.getuid()
                or stat.S_IMODE(named.st_mode) != 0o700 or named.st_dev != self.fact["root_id"][0]):
            raise Retain("recovery-container-directory-unsafe")
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
        try:
            held = safety().file_identity(os.fstat(fd))
            if held != safety().file_identity(named) or (expected is not None and list(held[:2]) != expected):
                raise Retain("recovery-container-directory-changed")
            acl = safety().non_granting_acl(fd, self.until)
            yield fd
            after = safety().file_identity(os.fstat(fd))
            named = safety().file_identity(os.stat(name, dir_fd=parent_fd, follow_symlinks=False))
            # Child creation changes times and link counts, but not ownership,
            # permissions, flags or ACLs. Keep those boundaries throughout.
            if (after != named or after[:5] != held[:5] or after[-1] != held[-1]
                    or safety().non_granting_acl(fd, self.until) != acl):
                raise Retain("recovery-container-directory-changed")
        finally:
            os.close(fd)

    def create(self, record, persist):
        self.check_root()
        name = self.stage_name(record)
        os.mkdir(name, mode=0o700, dir_fd=self.fd)
        os.fsync(self.fd)
        with self.directory(name, self.fd) as fd:
            os.fsync(fd)
            record["container_id"] = list(safety().file_identity(os.fstat(fd))[:2])
            persist()
            os.mkdir(self.fact["checkout"], mode=0o700, dir_fd=fd)
            os.fsync(fd)
            with self.directory(self.fact["checkout"], fd) as child:
                os.fsync(child)
                record["stage_id"] = list(safety().file_identity(os.fstat(child))[:2])
                persist()
        # A crash before either inode receipt is durable stays UNKNOWN. Continuation
        # must never infer ownership from an appeared name, even an empty directory.
        self.verify(record)

    def admit_holders(self, record, snap, admin, inodes=()):
        self.verify(record)
        # The container itself is renamed too. Scan its unpublished scope with
        # temporary stage FDs closed; the held managed-root FD is outside it.
        manual_holders({**snap, "path": str(self.root / self.stage_name(record))},
                       {"entries": {}, "discarded_inodes": [
                           record["container_id"], record["stage_id"], *inodes]}, admin, self.until)
        self.verify(record)

    def publish(self, record, snap, admin):
        self.observe(record, False)
        self.admit_holders(record, snap, admin)
        with self.directory(self.stage_name(record), self.fd, record["container_id"]) as fd:
            os.fsync(fd)
        recovery_publish_at(self.fd, self.stage_name(record), self.fact["container"])
        self.observe(record, True)


def recover_missing(db, row, args):
    until = safety().DEADLINE
    who = owner_id(args)
    with safety().maintainer_lock(Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))), \
            contextlib.ExitStack() as scope:
        receipt = missing_recovery_fact(db, row)
        record = json.loads(receipt) if receipt is not None else None
        predecessor = None
        # Receipts without a contract use the original no-release preimage.
        # Never silently recalculate an outstanding operator-approved digest.
        legacy = record is not None and "contract" not in record
        if record is not None and not legacy and record["contract"] not in (
                RECOVERY_CONTRACT, RECOVERY_CONTAINER_CONTRACT):
            raise Retain("recovery-receipt-contract-unsupported")
        if args.continue_partial and (record is None or record.get("result")):
            raise Retain("recovery-partial-needs-pending-intent")
        if record is not None and record.get("result") and not args.intent_id:
            completed_recovery_successor(record, row)
            if args.generation < record["result"]["generation"]:
                raise Retain("recovery-generation-changed")
            predecessor, record, legacy = receipt, None, False

        container = None
        if ((record is not None and record.get("contract") == RECOVERY_CONTAINER_CONTRACT)
                or (record is None and not os.path.lexists(Path(row["path"]).parent))):
            container = RecoveryContainer(json.loads(row["identity"]), until)
            scope.callback(container.close)

        def observe(observed_row=row, observed_args=args, *, published=False):
            if missing_recovery_fact(db, row) != receipt:
                raise Retain("recovery-receipt-drift")
            return missing_recovery_preimage(db, observed_row, observed_args, until, published=published,
                                             legacy=legacy, predecessor=predecessor,
                                             container=container, record=record)

        def persist_container():
            nonlocal receipt
            encoded = json.dumps(record, sort_keys=True)
            with db:
                if db.execute("UPDATE missing_recoveries SET fact=? WHERE worktree_id=? AND fact=?",
                              (encoded, row["id"], receipt)).rowcount != 1:
                    raise Retain("recovery-receipt-cas-failed")
            receipt = encoded

        if record is not None:
            if (not args.intent_id or record["id"] != args.intent_id
                    or record["digest"] != args.recovery_sha256
                    or record["preimage"]["generation"] != args.generation
                    or record["preimage"]["head"] != args.expected_head
                    or record["preimage"]["index_sha256"] != args.index_sha256
                    or record["preimage"]["allow_device_renumbering"] != args.allow_device_renumbering):
                raise Retain("recovery-exact-intent-required")
            if record.get("result"):
                current = revalidate(row)
                if (current["head"] != args.expected_head
                        or current["path_id"] != record["stage_id"]
                        or retirement(db, row)["generation"] != args.generation + 1
                        or owner_rows(db, row["id"]) != record["preimage"]["owners"]):
                    raise Retain("recovery-successor-changed")
                successor_args = types.SimpleNamespace(**{**vars(args), "generation": args.generation + 1})
                original_row = {**dict(row), "identity": json.dumps(record["preimage"]["identity"])}
                observed, entries = observe(original_row, successor_args, published=True)
                if not legacy:
                    # Identity publication invalidates deletion authority through
                    # the normal trigger. The receipt retains the prior evidence.
                    if observed["releases"] or observed["completion_proof"]["inventory"] is not None:
                        raise Retain("recovery-successor-release-changed")
                    observed["releases"] = record["preimage"]["releases"]
                    observed["completion_proof"]["inventory"] = record["preimage"]["completion_proof"]["inventory"]
                observed.update(generation=args.generation, registration=record["preimage"]["registration"])
                if recovery_digest(observed) != record["digest"]:
                    raise Retain("recovery-successor-admin-changed")
                recovery_tree(row["path"], entries, current["gitdir"], until)
                return record["result"]
        elif args.intent_id:
            raise Retain("recovery-intent-not-found")
        item = retirement(db, row)
        if item is None or (record is None and (item["state"] != "enrolled" or item["intent"] or item["result"])):
            raise Retain("recovery-pending-lifecycle-action")
        if record and (item["state"] != "recovery-pending" or json.loads(item["intent"]) != record["intent"]):
            raise Retain("recovery-intent-state-changed")
        published = record is not None and os.path.lexists(row["path"])
        preimage, entries = observe(published=published)
        if record is not None:
            # Only the target's presence changes when the same staged inode was published.
            preimage["registration"] = record["preimage"]["registration"]
        digest = recovery_digest(preimage)
        if record and digest != record["digest"]:
            raise Retain("recovery-preimage-drift")
        # Admit all source paths before intent using the checkout budget, separate
        # from admin reads; legacy continuations keep their original digest.
        pointer_bytes = len(os.fsencode("gitdir: " + preimage["identity"]["gitdir"] + "\n"))
        if pointer_bytes > safety().SOURCE_LIMIT:
            raise Retain("recovery-source-byte-limit")
        for _ in recovery_blob_metadata(preimage["identity"]["owner"], entries.items(), until,
                                         safety().SOURCE_LIMIT - pointer_bytes):
            pass
        if args.continue_partial:
            if container:
                container.verify(record)
            if (published or record["stage_id"] is None
                    or identity(record["stage"]) != record["stage_id"]):
                raise Retain("recovery-partial-stage-changed")
            recovery_tree(record["stage"], entries, preimage["identity"]["gitdir"], until,
                          allow_partial=True)
            inodes = [record["stage_id"]]
            for directory, dirs, files in os.walk(record["stage"], followlinks=False):
                for name in dirs + files:
                    safety().tick(until)
                    details = (Path(directory) / name).lstat()
                    if not stat.S_ISLNK(details.st_mode):
                        inodes.append([details.st_dev, details.st_ino])
            if container:
                container.admit_holders(record, preimage["observed_identity"], preimage["admin"], inodes)
            else:
                manual_holders({**preimage["observed_identity"], "path": record["stage"]},
                               {"entries": {}, "discarded_inodes": inodes}, preimage["admin"], until)
        if not args.apply:
            result = {"checkout": "unknown" if record else "missing", "recovery_sha256": digest, "entries": len(entries),
                    "worktree_id": row["id"], "generation": args.generation,
                    "head": args.expected_head, "index_sha256": args.index_sha256,
                    "allow_device_renumbering": args.allow_device_renumbering,
                    "device_mapping": preimage["device_mapping"],
                    "partial_continuation": args.continue_partial,
                    "stage_id": record["stage_id"] if record else None,
                    "untracked_unstaged": "unavailable", "checkout_mutation": False}
            if container:
                result["container_layout"] = container.fact
            return result
        if args.recovery_sha256 != digest:
            raise Retain("recovery-reviewed-preimage-required")
        if record is None:
            identifier = str(uuid.uuid4())
            staging = str(Path(row["path"]).parent / (".gwt-recover-" + identifier))
            if container:
                staging = str(container.root / (".gwt-recover-" + identifier) / container.fact["checkout"])
            intent = {"kind": "recover-missing", "id": identifier, "digest": digest,
                      "operator": who, "stage": staging}
            record = {"contract": RECOVERY_CONTAINER_CONTRACT if container else RECOVERY_CONTRACT, "id": identifier,
                      "intent": intent, "digest": digest, "preimage": preimage,
                      "stage": staging, "stage_id": None, "result": None}
            if container:
                record["container_id"] = None
            with db:
                db.execute("BEGIN IMMEDIATE")
                db.execute("CREATE TABLE IF NOT EXISTS missing_recoveries ("
                           "worktree_id TEXT PRIMARY KEY REFERENCES worktrees(id), fact TEXT NOT NULL)")
                if missing_recovery_fact(db, row) != receipt:
                    raise Retain("recovery-receipt-drift")
                if missing_recovery_history(db, row, predecessor) != preimage["recovery_history"]:
                    raise Retain("recovery-history-drift")
                if predecessor is not None:
                    # Archive exact prior receipt bytes, replacement and lifecycle
                    # CAS atomically. Pending receipts never enter this branch.
                    db.execute("CREATE TABLE IF NOT EXISTS missing_recovery_history ("
                               "worktree_id TEXT NOT NULL REFERENCES worktrees(id), intent_id TEXT NOT NULL, "
                               "fact TEXT NOT NULL, PRIMARY KEY(worktree_id, intent_id))")
                    for action in ("UPDATE", "DELETE"):
                        db.execute(f"CREATE TRIGGER IF NOT EXISTS missing_recovery_history_{action.lower()} "
                                   f"BEFORE {action} ON missing_recovery_history BEGIN "
                                   "SELECT RAISE(ABORT, 'recovery-history-is-immutable'); END")
                    previous = json.loads(predecessor)
                    db.execute("INSERT INTO missing_recovery_history VALUES (?, ?, ?)",
                               (row["id"], previous["id"], predecessor))
                changed = db.execute("UPDATE retirement SET state='recovery-pending', intent=? "
                                     "WHERE worktree_id=? AND generation=? AND state='enrolled' "
                                     "AND intent IS NULL AND result IS NULL",
                                     (json.dumps(intent, sort_keys=True), row["id"], args.generation)).rowcount
                if changed != 1:
                    raise Retain("recovery-generation-cas-failed")
                encoded = json.dumps(record, sort_keys=True)
                if predecessor is None:
                    db.execute("INSERT INTO missing_recoveries VALUES (?, ?)", (row["id"], encoded))
                elif db.execute("UPDATE missing_recoveries SET fact=? WHERE worktree_id=? AND fact=?",
                                (encoded, row["id"], predecessor)).rowcount != 1:
                    raise Retain("recovery-receipt-cas-failed")
            receipt, predecessor = encoded, None
            if container:
                container.create(record, persist_container)
            else:
                Path(staging).mkdir(mode=0o700)
                record["stage_id"] = identity(staging)
                encoded = json.dumps(record, sort_keys=True)
                with db:
                    if db.execute("UPDATE missing_recoveries SET fact=? WHERE worktree_id=? AND fact=?",
                                  (encoded, row["id"], receipt)).rowcount != 1:
                        raise Retain("recovery-receipt-cas-failed")
                receipt = encoded
            recovery_tree(staging, entries, preimage["identity"]["gitdir"], until,
                          write=True, owner=preimage["identity"]["owner"], expected_id=record["stage_id"])
        elif args.continue_partial:
            recovery_tree(record["stage"], entries, preimage["identity"]["gitdir"], until,
                          write=True, owner=preimage["identity"]["owner"], allow_partial=True,
                          expected_id=record["stage_id"])
        source = row["path"] if published else record["stage"]
        if container:
            container.verify(record, published=published)
        if (record["stage_id"] is None or identity(source) != record["stage_id"]
                or (published and os.path.lexists(record["stage"]))):
            raise Retain("recovery-staged-inode-unknown")
        recovery_tree(source, entries, preimage["identity"]["gitdir"], until)
        final, _ = observe(published=published)
        final["registration"] = preimage["registration"]
        if recovery_digest(final) != digest:
            raise Retain("recovery-pre-publication-drift")
        if not published:
            if container:
                container.publish(record, preimage["observed_identity"], preimage["admin"])
            else:
                recovery_publish(source, row["path"])
        current = snapshot(row["path"], preimage["identity"]["root"], preimage["identity"].get("lock_reason"))
        if immutable(current) != {**preimage["observed_identity"], "path_id": record["stage_id"]}:
            raise Retain("recovery-published-identity-changed")
        recovery_tree(row["path"], entries, preimage["identity"]["gitdir"], until)
        final, _ = observe(published=True)
        final["registration"] = preimage["registration"]
        if recovery_digest(final) != digest:
            raise Retain("recovery-post-publication-drift")
        result = {"checkout": "restored", "intent_id": record["id"], "recovery_sha256": digest,
                  "generation": args.generation + 1, "head": args.expected_head,
                  "entries": len(entries), "operator": who, "owners_preserved": True,
                  "untracked_unstaged": "unavailable", "source": "committed-index-equal"}
        record["result"] = result
        with db:
            changed = db.execute("UPDATE retirement SET state='enrolled', intent=NULL "
                                 "WHERE worktree_id=? AND generation=? AND state='recovery-pending' AND intent=?",
                                 (row["id"], args.generation, json.dumps(record["intent"], sort_keys=True))).rowcount
            if changed != 1:
                raise Retain("recovery-final-cas-failed")
            db.execute("UPDATE worktrees SET identity=? WHERE id=? AND identity=?",
                       (json.dumps(immutable(current), sort_keys=True), row["id"], row["identity"]))
            if retirement(db, row)["generation"] != args.generation + 1:
                raise Retain("recovery-successor-generation-invalid")
            if db.execute("UPDATE missing_recoveries SET fact=? WHERE worktree_id=? AND fact=?",
                          (json.dumps(record, sort_keys=True), row["id"], receipt)).rowcount != 1:
                raise Retain("recovery-receipt-cas-failed")
        return result


def summary(db, row, reason=None):
    item = retirement(db, row)
    outcome = json.loads(item["result"]) if item is not None and item["result"] else None
    # A completed removal owns its status reason; an older retention reason
    # must not imply that the checkout still needs policy or owner action.
    if not reason and outcome and outcome["checkout"] == "removed":
        reason = outcome["reason"]
    owners = owner_rows(db, row["id"])
    cancellations = cancellation_rows(db, row["id"])
    cancelled = {entry["owner"] for entry in cancellations}
    terminal = bool(cancelled) and all(owner["completed"] or owner["owner"] in cancelled for owner in owners)
    result = {
        "id": row["id"],
        "worktree": row["path"],
        "state": "cancelled" if terminal else ("active" if cancelled else row["state"]),
        "reason": reason or ("owner-cancelled-checkout-retained" if terminal else row["reason"]),
        "pr": row["primary_pr"],
        "owners": owners,
        "pins": [
            dict(item)
            for item in db.execute(
                "SELECT owner, reason FROM pins WHERE worktree_id = ? "
                "ORDER BY owner, reason",
                (row["id"],),
            )
        ],
        "checkout": outcome["checkout"] if outcome else ("unknown" if item is not None and item["intent"] else "retained"),
        "release_available": not cancelled and item is not None and item["state"] == "enrolled",
        # Status does not perform native admission. Capability is separate from
        # a fresh, one-shot removal decision made only by the evaluator.
        "removal_available": False,
        "automatic_removal_supported": automatic_holder_contract(item),
        "retirement_state": item["state"] if item is not None else "report-only",
        "generation": item["generation"] if item is not None else None,
        "released_owners": [] if item is None else [r[0] for r in db.execute(
            "SELECT owner FROM owner_releases WHERE worktree_id=? AND generation=? ORDER BY owner",
            (row["id"], item["generation"]))],
    }
    if cancellations:
        result["cancelled_owners"] = cancellations
    if db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='failed_creations'").fetchone():
        attempts = db.execute("SELECT creation_token, intent, result FROM failed_creations "
                              "WHERE worktree_id=? ORDER BY rowid DESC LIMIT 8", (row["id"],))
        result["failed_creation_recoveries"] = [
            {"creation_token": attempt["creation_token"],
             "intent_id": json.loads(attempt["intent"])["id"],
             **({"checkout": "unknown", "reason": "removal-incomplete"} if attempt["result"] is None
                else {key: json.loads(attempt["result"])[key] for key in ("checkout", "reason")})}
            for attempt in attempts]
    if item is not None and item["state"] == "enrolled":
        baseline = json.loads(item["inventory"]) if item["inventory"] else None
        semantic = baseline is not None and baseline.get("schema") == RELEASE_BASELINE_SCHEMA
        result["automatic_handoff"] = {
            "baseline": ("unavailable" if baseline is None or (semantic and baseline["baseline"] is None)
                         else "ready"),
            "blocker": baseline.get("blocker") if semantic else (
                "automatic-release-inventory-required" if baseline is None else None),
            "native_qualification": holder_qualification(),
            # A release receipt does not attest installation or scheduling.
            "consumer_eligibility": "not-attested",
            "scheduled_retry": "not-attested",
            "owner_retry": ("resume-then-finish-from-owning-checkout" if baseline is None or (
                semantic and baseline["baseline"] is None) else "repeat-finish-from-owning-checkout"),
        }
        if not automatic_holder_contract(item):
            result["automatic_handoff"].update(
                blocker="automatic-holder-contract-not-enrolled",
                owner_retry="manual-finalized-closeout-from-owning-checkout")
    recovery = missing_recovery_record(db, row)
    if recovery is not None:
        result["missing_recovery"] = {
            "intent_id": recovery["id"], "recovery_sha256": recovery["digest"],
            "status": "complete" if recovery["result"] else "pending",
            "operator": recovery["intent"]["operator"], "result": recovery["result"],
        }
    if outcome and outcome.get("reason") == "external-removal-reconciled":
        result["reason"] = outcome["reason"]
        result["external_removal"] = outcome
    fact = reconciliation(db, row)
    if fact:
        result["current_disposition"] = "reconciled-target-removed"
        result["reason"] = "target-removal-reconciled-original-proof-retained"
        if not fact["sibling_comparison"]["preserved"]:
            result["sibling_alert"] = "current-sibling-preservation-unresolved"
            result["reason"] = "target-removal-reconciled-sibling-preservation-unresolved"
        result["reconciliation"] = {key: value for key, value in fact.items()
                                    if key not in ("siblings_after", "sibling_identities")}
    return result


ORPHAN_LOCK = re.compile(r"gwt-finish\.v2:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\Z")


def orphan_known(db, path, admin, lock_reason, attempt=None):
    """Any lifecycle trace of this registration keeps it out of orphan pruning."""
    for row in db.execute("SELECT path, identity FROM worktrees"):
        recorded = json.loads(row["identity"])
        if (row["path"] == path or recorded.get("path") == path or recorded.get("gitdir") == admin
                or recorded.get("lock_reason") == lock_reason):
            return True
    if db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='failed_creations'").fetchone():
        token = ORPHAN_LOCK.fullmatch(lock_reason)[1]
        if db.execute("SELECT 1 FROM failed_creations WHERE creation_token=?", (token,)).fetchone():
            return True
    if db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='orphan_removals'").fetchone():
        for recorded in db.execute(
                "SELECT id, result FROM orphan_removals WHERE path=? OR admin=? OR lock_reason=?",
                (path, admin, lock_reason)):
            if recorded["id"] != attempt or recorded["result"] is not None:
                return True
    return False


def orphan_prior_identity(args, snap, path_id, until, *, locked, admitted):
    if not args.prior_identity_file:
        if path_id[0] != identity(snap["root"])[0]:
            raise Retain("orphan-prior-device-changed")
        return path_id, None
    source = Path(args.prior_identity_file)
    if (not source.is_absolute() or physical(source) != str(source)
            or any(inside(str(source), snap[key]) for key in ("path", "gitdir"))):
        raise Retain("orphan-prior-identity-source-unsafe")
    source_before = safety().file_identity(private_file(source))
    raw, source_id = safety().read_file(source, until, 16384)
    if source_id != source_before or safety().file_identity(private_file(source)) != source_id:
        raise Retain("orphan-prior-identity-source-changed")

    def unique(pairs):
        value = dict(pairs)
        if len(value) != len(pairs):
            raise ValueError("duplicate identity field")
        return value

    try:
        recorded = json.loads(raw, object_pairs_hook=unique)
    except (ValueError, UnicodeError):
        raise Retain("orphan-prior-identity-invalid") from None
    paths = ("path", "root", "owner", "common", "gitdir")
    ids = ("path_id", "owner_id", "common_id", "gitdir_id", "lock_id")
    if (not isinstance(recorded, dict)
            or set(recorded) != {"schema", "uid", "lock_reason", *paths, *ids}
            or recorded["schema"] != "gwt-orphan-prior-identity.v1"
            or type(recorded["uid"]) is not int or recorded["uid"] != os.getuid()
            or any(recorded[key] != snap[key] for key in paths)
            or recorded["lock_reason"] != "gwt-finish.v2:" + args.creation_token
            or any(not isinstance(recorded[key], list) or len(recorded[key]) != 2
                   or any(type(value) is not int for value in recorded[key])
                   or not 0 <= recorded[key][0] < 2**64 or not 0 < recorded[key][1] < 2**64
                   for key in ids)
            or recorded["path_id"] != path_id):
        raise Retain("orphan-prior-identity-invalid")
    observed = {key: snap[key] for key in ids if key not in ("path_id", "lock_id")}
    if locked:
        details = private_file(Path(snap["gitdir"]) / "locked")
        observed["lock_id"] = [details.st_dev, details.st_ino]
    else:
        # Only native removal/rollback reaches unlocked or successor-lock reads.
        observed["lock_id"] = admitted["observed_identity"]["lock_id"]
    devices = device_renumbering(recorded, observed, tuple(observed))
    if (path_id[0] not in devices
            or devices[path_id[0]] != identity(snap["root"])[0]
            or devices[path_id[0]] != identity(snap["path_absence"]["parent"])[0]):
        raise Retain("orphan-prior-parent-volume-unmapped-or-changed")
    observed["path_id"] = [devices[path_id[0]], path_id[1]]
    return observed["path_id"], {
        "original_identity": recorded, "observed_identity": observed,
        "allow_device_renumbering": args.allow_device_renumbering,
        "device_map": [[old, devices[old]] for old in sorted(devices)],
        "input": {"path": str(source), "identity": list(source_id),
                  "sha256": hashlib.sha256(raw).hexdigest()},
    }


def orphan_candidate(db, snap, entry, admin_index, until, *, attempt=None, preserved_oids=None):
    """Admit a missing unrecorded registration with remote HEAD and preserved recovery history."""
    path, lock_reason = entry["worktree"], entry.get("locked", "")
    if not ORPHAN_LOCK.fullmatch(lock_reason):
        return None
    if not inside(path, snap["root"]) or path == snap["root"]:
        raise Retain("orphan-outside-managed-root")
    try:
        os.lstat(path)
    except FileNotFoundError:
        pass
    else:
        raise Retain("orphan-directory-present")
    # ENOENT under an unmounted volume is not a vanished checkout. The nearest
    # surviving ancestor must share the managed root's device.
    ancestor = Path(path).parent
    while True:
        try:
            device = os.lstat(ancestor).st_dev
            break
        except FileNotFoundError:
            ancestor = ancestor.parent
    if device != os.lstat(snap["root"]).st_dev:
        raise Retain("orphan-ancestor-device-changed")
    mapped = admin_index.get(os.path.join(path, ".git"))
    if mapped is None:
        raise Retain("orphan-admin-unavailable")
    admin = mapped[0]
    if orphan_known(db, path, admin, lock_reason, attempt):
        raise Retain("orphan-has-lifecycle-record")
    branch, head = entry.get("branch", ""), entry.get("HEAD", "")
    if not branch.startswith("refs/heads/") or not SHA.fullmatch(head):
        raise Retain("orphan-needs-named-branch")
    if git(snap["owner"], "rev-parse", branch) != head:
        raise Retain("orphan-branch-changed")
    lock, _ = safety().read_file(Path(admin) / "locked", until, 4096)
    if lock.rstrip(b"\n") != os.fsencode(lock_reason):
        raise Retain("orphan-lock-changed")
    # Reuse closeout's admin classification: unknown files, drafts, locks and
    # in-progress operations refuse. Staged-only index bytes refuse as well.
    target = {**snap, "path": snap["owner"], "gitdir": admin, "gitdir_id": mapped[1], "head": head}
    roots = {head} if preserved_oids is None else preserved_oids
    admin_rows = safety().admin_inventory(target, git, until, preserved_oids=roots)
    if "index" in admin_rows:
        safety().index_inventory(target, git, until, revision=head)
    oids = {head} | {oid for value in admin_rows.values() if len(value) == 3 for oid in value[2]}
    if len(oids) > 128:
        raise Retain("recovery-proof-limit")
    remote_preserved(snap, head, until)
    if preserved_oids is None:
        for oid in sorted(oids - {head}):
            remote_preserved(snap, oid, until)
    else:
        for oid in sorted(oids):
            if not SHA.fullmatch(oid):
                raise Retain("recovery-reference-invalid")
            if git(snap["owner"], "--no-replace-objects", "cat-file", "-t", oid,
                   deadline=until) != "commit":
                raise Retain("orphan-recovery-not-a-commit")
            if oid != head:
                try:
                    remote_preserved(snap, oid, until)
                except Retain as error:
                    if str(error) != "missing-cancellation-head-not-on-remote":
                        raise
                    preserve_release_recovery(snap, [oid], roots, until)
    return {"worktree": path, "admin": admin, "admin_id": mapped[1], "branch": branch,
            "head": head, "lock_reason": lock_reason}


def recover_orphan(db, args, owner_snapshot):
    """Retire one audited missing registration without inventing enrollment."""
    module, until = safety(), safety().DEADLINE
    path_id = [int(part) for part in args.missing_path_id.split(":")]
    lock_reason = "gwt-finish.v2:" + args.creation_token
    attempt = None
    snap = None
    identity_proof = None
    restored_lock = None
    if (not inside(args.orphan_path, owner_snapshot["root"])
            or args.orphan_path == owner_snapshot["root"]):
        raise Retain("orphan-outside-managed-root")

    def observe(lock=lock_reason, *, restored=False):
        current = records(owner_snapshot["owner"])
        sibling_rows(current)
        selected = [entry for entry in current if entry["worktree"] == args.orphan_path]
        if (len(selected) != 1 or selected[0].get("locked") != lock
                or selected[0].get("HEAD") != args.expected_head):
            raise Retain("orphan-selection-changed")
        observed = sibling_identity(owner_snapshot, args.orphan_path, until)
        if observed["path_id"] is not None:
            raise Retain("orphan-directory-present")
        current_snap = {**owner_snapshot, "path": args.orphan_path, "path_id": path_id,
                        "gitdir": observed["gitdir"], "gitdir_id": observed["gitdir_id"],
                        "branch": selected[0].get("branch"), "head": args.expected_head,
                        "path_absence": observed["path_absence"]}
        if lock is not None:
            current_snap["lock_reason"] = lock
        current_snap["path_id"], prior = orphan_prior_identity(
            args, current_snap, path_id, until, locked=lock is not None and not restored,
            admitted=identity_proof)
        if snap is not None and any(current_snap[key] != snap[key] for key in (
                "owner", "owner_id", "common", "common_id", "root", "path", "path_id",
                "gitdir", "gitdir_id", "branch", "head", "path_absence")):
            raise Retain("orphan-identity-changed")
        for key in ("owner", "common", "gitdir"):
            if (physical(current_snap[key]) != current_snap[key]
                    or identity(current_snap[key]) != current_snap[key + "_id"]):
                raise Retain("orphan-identity-changed")
        return current_snap, current, prior

    def admit():
        current_snap, rows, prior = observe()
        refs, roots = release_refs(current_snap, None, until)
        entry = next(entry for entry in rows if entry["worktree"] == args.orphan_path)
        if orphan_candidate(db, current_snap, entry, sibling_admin_index(current_snap, until),
                            until, attempt=attempt, preserved_oids=roots) is None:
            raise Retain("orphan-lock-changed")
        for key in ("common", "gitdir"):
            directory = Path(current_snap[key])
            if any(not lease.admits(marker, current_snap) for marker in directory.glob("*.lock")):
                raise Retain("git-lock-present")
            if any(os.path.lexists(directory / name) for name in (
                    "MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_LOG",
                    "rebase-merge", "rebase-apply", "sequencer")):
                raise Retain("git-operation-in-progress")
        target = {**current_snap, "path": current_snap["owner"]}
        proof, _, _ = module.index_inventory(target, git, until, revision=current_snap["head"],
                                              preserved_oids=roots)
        admin = module.admin_inventory(target, git, until, preserved_oids=roots)
        contents = {**proof, "entries": {}, "dependency": None, "missing_worktree": True,
                    "discarded_inodes": [current_snap["path_id"]]}
        manual_holders(current_snap, contents, admin, until)
        final_snap, _, final_prior = observe()
        if final_snap != current_snap or final_prior != prior:
            raise Retain("orphan-identity-changed")
        if preserved_refs(current_snap, refs, until) != refs:
            raise Retain("preserved-refs-changed")
        # Sibling progress is independent; registration fields and identities
        # remain bound. Native removal separately records the full current rows.
        siblings = [{key: value for key, value in entry.items()
                     if key not in {"HEAD", "branch", "detached"}}
                    for entry in rows if entry["worktree"] != args.orphan_path]
        return {"snapshot": current_snap, "admin": admin, "contents": contents,
                "boundaries": [module.access_boundary(current_snap["path_absence"]["parent"], until),
                               module.access_boundary(current_snap["gitdir"], until)],
                "branch_reflog": refs[current_snap["branch"]]["reflog"], "preserved_refs": refs,
                "siblings": siblings, "sibling_identities": sibling_identities(current_snap, siblings, until),
                **({"orphan_identity": prior} if prior is not None else {})}

    owner_snapshot = {**owner_snapshot, "owner_id": identity(owner_snapshot["owner"])}
    storage_guard()
    with module.maintainer_lock(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))):
        snap, _, identity_proof = observe()
        with QualificationFetchLease(snap) as lease:
            before = admit()
            digest = recovery_digest(before)
            output = {"worktree": args.orphan_path, "disposition": "candidate",
                      "recovery_sha256": digest, "working_tree": "already-absent-not-audited"}
            if not args.apply:
                return output
            if digest != args.recovery_sha256:
                raise Retain("orphan-preimage-changed")

            def persist_intent(intent):
                nonlocal attempt
                # This receipt owns only registration retirement. No worktree or
                # owner row is fabricated, and an interrupted attempt stays blocked.
                with db:
                    db.execute("CREATE TABLE IF NOT EXISTS orphan_removals ("
                               "id TEXT PRIMARY KEY, path TEXT NOT NULL, admin TEXT NOT NULL, "
                               "lock_reason TEXT NOT NULL, intent TEXT NOT NULL, result TEXT)")
                    db.execute("INSERT INTO orphan_removals VALUES (?, ?, ?, ?, ?, NULL)",
                               (intent["id"], args.orphan_path, snap["gitdir"], lock_reason,
                                json.dumps(intent, sort_keys=True)))
                attempt = intent["id"]

            def recheck():
                latest = admit()
                if latest != before:
                    raise Retain("orphan-preimage-changed")
                return latest

            def persist_outcome(outcome):
                if restored_lock is not None:
                    outcome["restored_lock"] = restored_lock
                with db:
                    changed = db.execute("UPDATE orphan_removals SET result=? "
                                         "WHERE id=? AND result IS NULL",
                                         (json.dumps(outcome, sort_keys=True), attempt)).rowcount
                    if changed != 1:
                        raise Retain("orphan-result-conflict")

            def restored_snapshot(_path, _root, lock):
                nonlocal restored_lock
                # Called only after this attempt successfully recreates its lock.
                # Its successor inode is rollback evidence, never new admission.
                marker = Path(snap["gitdir"]) / "locked"
                raw, details = module.read_file(marker, until, 4096)
                if (raw != os.fsencode(lock + "\n") or details[3] != os.getuid()
                        or details[5] != 1 or details[2] & 0o022
                        or details[0] != snap["gitdir_id"][0]):
                    raise Retain("orphan-restored-lock-unqualified")
                current = observe(lock, restored=True)[0]
                if module.read_file(marker, until, 4096) != (raw, details):
                    raise Retain("orphan-restored-lock-changed")
                if current == snap:
                    restored_lock = {"identity": list(details), "sha256": hashlib.sha256(raw).hexdigest()}
                return current

            remove_with_intent(
                db, {}, {"generation": 0}, before, recheck,
                {"mode": "exact-orphan-registration", "operator": owner_id(args)},
                restore_lock=True, fetch_lease=lease,
                record_intent=persist_intent, record_outcome=persist_outcome,
                snapshotter=lambda _path, _root, lock=None: observe(lock)[0],
                restored_snapshotter=restored_snapshot)
            outcome = json.loads(db.execute(
                "SELECT result FROM orphan_removals WHERE id=?", (attempt,)).fetchone()["result"])
            return {**output, "disposition": "pruned" if outcome["checkout"] == "removed" else "unknown",
                    "result": outcome}


def orphan_locks(db, args):
    owner = physical(args.worktree)
    listed = records(owner)
    if not listed or physical(listed[0]["worktree"]) != owner:
        raise Retain("orphan-locks-needs-owning-checkout")
    common = physical(git(owner, "rev-parse", "--path-format=absolute", "--git-common-dir"))
    snap = {"owner": owner, "common": common, "common_id": identity(common),
            "root": physical(args.managed_root)}
    if args.orphan_path is not None:
        return [recover_orphan(db, args, snap)]
    until = time.monotonic() + 60

    def survey():
        index = sibling_admin_index(snap, until)
        result = []
        for entry in records(owner)[1:]:
            try:
                candidate = orphan_candidate(db, snap, entry, index, until)
            except Retain as error:
                if ORPHAN_LOCK.fullmatch(entry.get("locked", "")):
                    result.append({"worktree": entry["worktree"], "disposition": "retained",
                                   "reason": str(error)})
                continue
            if candidate is not None:
                result.append({**candidate, "disposition": "candidate"})
        return result

    before = survey()
    if not args.apply:
        return before
    storage_guard()
    with safety().maintainer_lock(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))):
        for item in before:
            if item["disposition"] != "candidate":
                continue
            # Recheck this registration alone under the maintainer lock.
            current = next((entry for entry in survey() if entry["worktree"] == item["worktree"]), None)
            if current != item:
                item.update(disposition="retained", reason="orphan-changed-before-prune")
                continue
            try:
                git(owner, "worktree", "unlock", "--", item["worktree"])
                git(owner, "worktree", "remove", "--", item["worktree"])
            except Retain:
                # Restore only this registration's own lock; never retry removal.
                item.update(disposition="unknown", reason="orphan-native-removal-failed",
                            native_lock_preserved=False)
                try:
                    current = [entry for entry in records(owner) if entry["worktree"] == item["worktree"]]
                    if current and "locked" not in current[0]:
                        git(owner, "worktree", "lock", "--reason", item["lock_reason"],
                            "--", item["worktree"])
                        current = [entry for entry in records(owner)
                                   if entry["worktree"] == item["worktree"]]
                    item["native_lock_preserved"] = bool(current) and current[0].get(
                        "locked") == item["lock_reason"]
                except (Retain, OSError):
                    pass
                continue
            absent = (not any(entry["worktree"] == item["worktree"] for entry in records(owner))
                      and not os.path.lexists(item["admin"]))
            preserved = git(owner, "rev-parse", item["branch"]) == item["head"]
            item.update(disposition="pruned" if absent and preserved else "unknown",
                        registration_absent=absent, branch_preserved=preserved)
    return before


def storage_guard():
    run([str(Path(__file__).resolve().with_name("worktree-storage-guard"))])


