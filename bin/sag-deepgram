#!/bin/sh
set -eu
backend="$HOME/.local/lib/sag/voice-834bc54/sag"
case "${1:-}" in
  help|completion|-h|--help|-V|--version) exec "$backend" "$@" ;;
  speak|voices) sag_subcommand="$1"; shift ;;
  *) sag_subcommand=speak ;;
esac
exec fleet-credentials run foundation --env DEEPGRAM_API_KEY=op://nfpveecxnlmlka74d4f4dssr2a/sgpmhum5sm3qy27wjaka2v7yy4/openclaw_deepgram_api_key -- "$backend" "$sag_subcommand" --provider deepgram "$@"
