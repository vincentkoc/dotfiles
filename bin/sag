#!/bin/sh
# OpenAI-enabled SAG from https://github.com/steipete/sag/pull/39.
set -eu

backend="$HOME/.local/lib/sag/openai-bd6012a/sag"
if [ ! -x "$backend" ]; then
    printf '%s\n' 'sag: install the pinned OpenAI-enabled build first.' >&2
    exit 1
fi

case "${1-}" in
    -h|--help|help|-V|--version|completion|prompting|prompt|guide|tips)
        exec "$backend" "$@"
        ;;
    speak|voices)
        subcommand="$1"
        shift
        ;;
    *) subcommand=speak ;;
esac

# Resolve the key only for this invocation; never export it into the shell.
exec fleet-credentials run foundation --key OPENAI_API_KEY -- \
    "$backend" "$subcommand" --provider openai "$@"
