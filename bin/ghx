#!/usr/bin/env bash
# ghx-shim: keep this marker in the first 512 bytes for ghx backend discovery.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

wrapper_dir="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=gh-support/route.sh
source "$wrapper_dir/gh-support/route.sh"
gh_route "$@"
