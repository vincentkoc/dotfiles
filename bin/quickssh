#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: quickssh [-m] [-s] [-t] [-l local_port] [-d destination_port] [host]

Options:
  -m  use mosh
  -s  run screen -xRR after connecting
  -t  attach or create tmux after connecting
  -l  local port for SSH forwarding
  -d  remote destination port for SSH forwarding

Run without a host to choose one interactively.
Plain SSH config hosts are supported directly; legacy .extra aliases remain available.
EOF
}

extras_path() {
  printf '%s\n' "${EXTRASPATH:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/dotfiles/.extra}"
}

load_legacy_hosts() {
  local hosts_file

  hosts_file="$(extras_path)/quickssh_hosts.sh"
  [[ -f "$hosts_file" ]] || return 1
  # shellcheck source=/dev/null
  source "$hosts_file"
}

copy_password() {
  local password="$1"

  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$password" | pbcopy
    return 0
  fi
  if command -v xclip >/dev/null 2>&1; then
    printf '%s' "$password" | xclip -selection clipboard
    return 0
  fi
  if command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$password" | wl-copy
    return 0
  fi

  return 1
}

password_from_onepassword() {
  local alias="$1"
  local account_arg=()

  [[ -n "${QUICKSSH_OP_ACCOUNT:-}" ]] && account_arg=(--account "$QUICKSSH_OP_ACCOUNT")
  op item get "ssh_$alias" "${account_arg[@]}" --fields password | tr -d '\n'
}

resolve_legacy_host() {
  local alias="$1" alias_key
  local host_info_var host_info user host port password

  load_legacy_hosts || return 1
  alias_key="${alias//-/_}"
  [[ -n "$alias_key" && "$alias_key" != *[!a-zA-Z0-9_]* ]] || return 1
  host_info_var="quickssh_hosts_${alias_key}"
  host_info="${!host_info_var:-}"
  [[ -n "$host_info" ]] || return 1

  IFS=: read -r user host port password _ <<< "$host_info"
  [[ -n "$host" ]] || return 1
  port="${port:-22}"

  if [[ "$password" == "\$1password" ]]; then
    password="$(password_from_onepassword "$alias")"
  fi

  if [[ -n "${password:-}" ]]; then
    if copy_password "$password"; then
      printf 'quickssh: copied password for legacy alias %s; clipboard is not tracked by ssh\n' "$alias" >&2
    else
      printf 'quickssh: legacy alias %s has a password, but no clipboard command is available\n' "$alias" >&2
    fi
  fi

  if [[ -n "$user" ]]; then
    printf '%s\t%s\t%s\n' "$user@$host" "$port" "$alias"
  else
    printf '%s\t%s\t%s\n' "$host" "$port" "$alias"
  fi
}

list_hosts() {
  local hosts_file key

  printf 'SSH config hosts are supported directly, e.g. quickssh m1\n'

  hosts_file="$(extras_path)/quickssh_hosts.sh"
  [[ -f "$hosts_file" ]] || return 0

  # shellcheck disable=SC2154 # Sourced from the private legacy hosts file.
  if load_legacy_hosts && declare -p quickssh_hosts >/dev/null 2>&1; then
    printf '\nLegacy quickssh aliases:\n'
    for key in "${quickssh_hosts[@]}"; do
      printf '  %s\n' "$key"
    done
  fi
}

list_legacy_aliases() {
  local key

  # shellcheck disable=SC2154 # Sourced from the private legacy hosts file.
  if load_legacy_hosts && declare -p quickssh_hosts >/dev/null 2>&1; then
    for key in "${quickssh_hosts[@]}"; do
      printf '%s\n' "$key"
    done
  fi
}

legacy_host_description() {
  local alias="$1" alias_key info_var description_var info
  local user host port _

  load_legacy_hosts || return 1
  alias_key="${alias//-/_}"
  [[ -n "$alias_key" && "$alias_key" != *[!a-zA-Z0-9_]* ]] || return 1
  description_var="quickssh_descriptions_${alias_key}"
  if [[ -n "${!description_var:-}" ]]; then
    printf '%s\n' "${!description_var}"
    return 0
  fi

  info_var="quickssh_hosts_${alias_key}"
  info="${!info_var:-}"
  [[ -n "$info" ]] || return 1
  IFS=: read -r user host port _ <<< "$info"
  [[ -n "$host" ]] || return 1
  printf 'ssh · %s%s%s\n' "${user:+$user@}" "$host" "${port:+:$port}"
}

legacy_host_prefers_mosh() {
  local alias="$1" key

  # shellcheck disable=SC2154 # Sourced from the private legacy hosts file.
  if load_legacy_hosts && declare -p quickssh_mosh_hosts >/dev/null 2>&1; then
    for key in "${quickssh_mosh_hosts[@]}"; do
      [[ "$key" == "$alias" ]] && return 0
    done
  fi

  return 1
}

service_account_target() {
  local alias_key="${1//-/_}" target_var

  [[ -n "$alias_key" && "$alias_key" != *[!a-zA-Z0-9_]* ]] || return 1
  load_legacy_hosts || return 1
  target_var="quickssh_service_targets_${alias_key}"
  [[ -n "${!target_var:-}" ]] || return 1
  printf '%s\n' "${!target_var}"
}

legacy_host_mosh_ports() {
  local alias_key="${1//-/_}" ports_var

  mosh_ports=""
  [[ -n "$alias_key" && "$alias_key" != *[!a-zA-Z0-9_]* ]] || return 0
  load_legacy_hosts || return 0
  ports_var="quickssh_mosh_ports_${alias_key}"
  # Mosh's numeric validator accepts a trailing newline; reject non-port
  # characters here so malformed config cannot reach SSH.
  mosh_ports="${!ports_var:-}"
  if [[ "$mosh_ports" == *[!0-9:]* ]]; then
    printf 'quickssh: invalid Mosh UDP port or range for %s\n' "$1" >&2
    exit 2
  fi
}

set_tmux_connection_title() {
  local title="$1" window_id pane_count tmux_title

  [[ -n "${TMUX_PANE:-}" ]] || return 0
  command -v tmux >/dev/null 2>&1 || return 0

  # tmux expands formats in titles, but connection aliases must remain literal.
  tmux_title="${title//#/##}"
  tmux set-option -pt "$TMUX_PANE" @tt_base_title "$title" 2>/dev/null || true
  tmux select-pane -t "$TMUX_PANE" -T "$tmux_title" 2>/dev/null || true

  window_id="$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null || true)"
  [[ -n "$window_id" ]] || return 0
  pane_count="$(tmux display-message -p -t "$window_id" '#{window_panes}' 2>/dev/null || true)"
  [[ "$pane_count" == "1" ]] || return 0

  tmux set-window-option -t "$window_id" automatic-rename off 2>/dev/null || true
  tmux rename-window -t "$window_id" "$tmux_title" 2>/dev/null || true
}

set_connection_title() {
  local title

  title="$(printf '%s' "$1" | LC_ALL=C tr -d '[:cntrl:]')"
  if [[ -n "${TMUX_PANE:-}" ]]; then
    set_tmux_connection_title "$title"
  elif [[ -t 1 && -n "${TERM:-}" && "$TERM" != "dumb" ]]; then
    # Name the connection before the remote shell or tmux takes over its title.
    printf '\033]2;%s\007' "$title"
  fi
}

ssh_config_files() {
  local file file_dir line key pattern expanded i
  local -a files=("$HOME/.ssh/config")

  for ((i = 0; i < ${#files[@]}; i++)); do
    file="${files[$i]}"
    [[ -f "$file" ]] || continue
    printf '%s\n' "$file"
    file_dir="$(dirname "$file")"

    while IFS= read -r line; do
      line="${line%%#*}"
      # shellcheck disable=SC2086 # Split OpenSSH Include arguments like ssh_config does.
      set -- $line
      [[ $# -gt 1 ]] || continue

      key="$1"
      case "$key" in
        [Ii][Nn][Cc][Ll][Uu][Dd][Ee]) ;;
        *) continue ;;
      esac
      shift

      for pattern in "$@"; do
        pattern="${pattern/#\~/$HOME}"
        [[ "$pattern" = /* ]] || pattern="$file_dir/$pattern"
        for expanded in $pattern; do
          [[ -f "$expanded" ]] && files+=("$expanded")
        done
      done
    done < "$file"
  done
}

list_ssh_config_hosts() {
  local file

  while IFS= read -r file; do
    awk '
      /^[[:space:]]*(#|$)/ { next }
      tolower($1) == "host" {
        for (i = 2; i <= NF; i++) {
          if ($i !~ /[*?!%]/) {
            print $i
          }
        }
      }
    ' "$file"
  done < <(ssh_config_files) | sort -fu
}

choose_with_fzf() {
  command -v fzf >/dev/null 2>&1 || return 1
  printf '%s\n' "$@" | fzf --prompt='quickssh > ' --height=40% --layout=reverse --border
}

choose_with_select() {
  local options=("$@")
  local choice
  PS3="quickssh> "

  select choice in "${options[@]}"; do
    [[ -n "${choice:-}" ]] || continue
    printf '%s\n' "$choice"
    return 0
  done
}

choose_option() {
  local options=("$@")
  local selected

  if selected="$(choose_with_fzf "${options[@]}")"; then
    printf '%s\n' "$selected"
    return 0
  fi

  choose_with_select "${options[@]}"
}

choose_host() {
  local host row selection description
  local -a options=()

  while IFS= read -r host; do
    [[ -n "$host" ]] || continue
    description="$(legacy_host_description "$host" || printf 'ssh alias')"
    options+=("$(printf '%-28s %s' "$host" "$description")")
  done < <(list_legacy_aliases | awk 'NF && !seen[$0]++')

  if [[ ${#options[@]} -eq 0 ]]; then
    usage >&2
    printf '\nquickssh: no hosts found to choose from\n' >&2
    exit 2
  fi

  selection="$(choose_option "${options[@]}")"
  row="${selection%%[[:space:]]*}"
  [[ -n "$row" ]] || return 130
  printf '%s\n' "$row"
}

use_mosh=false
mosh_requested=false
use_screen=false
use_tmux=false
local_port=""
destination_port=""

while getopts ":mstl:d:h" option; do
  case "$option" in
    m)
      use_mosh=true
      mosh_requested=true
      ;;
    s) use_screen=true ;;
    t) use_tmux=true ;;
    l) local_port="$OPTARG" ;;
    d) destination_port="$OPTARG" ;;
    h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -eq 0 ]]; then
  input="$(choose_host)"
elif [[ $# -eq 1 ]]; then
  input="$1"
else
  usage >&2
  printf '\n' >&2
  list_hosts >&2
  exit 2
fi

target="$input"
port=""
service_target=""

if service_target="$(service_account_target "$input")"; then
  # Resolve opted-in aliases before the desktop password/clipboard path.
  # The private helper owns credentials and routing; failures never fall back.
  if legacy_host_prefers_mosh "$input"; then
    use_mosh=true
  fi
elif resolved="$(resolve_legacy_host "$input")"; then
  IFS=$'\t' read -r target port _ <<< "$resolved"
  if legacy_host_prefers_mosh "$input"; then
    use_mosh=true
  fi
fi

remote_command=()
has_remote_command=false
if [[ "$use_tmux" == "true" ]]; then
  "$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/tt" \
    topology-authorize remote-create "$target"
  remote_command=(sh -lc 'tmux attach || tmux new-session')
  has_remote_command=true
elif [[ "$use_screen" == "true" ]]; then
  remote_command=(screen -xRR)
  has_remote_command=true
fi

ssh_args=(-o ServerAliveInterval=15 -o ServerAliveCountMax=3)
[[ -n "$port" ]] && ssh_args+=(-p "$port")

if [[ -n "$local_port" || -n "$destination_port" ]]; then
  if [[ -z "$local_port" || -z "$destination_port" ]]; then
    printf 'quickssh: both -l and -d are required for forwarding\n' >&2
    exit 2
  fi
  if [[ "$use_mosh" == "true" ]]; then
    if [[ "$mosh_requested" == "true" ]]; then
      printf 'quickssh: port forwarding is not supported with mosh\n' >&2
      exit 2
    fi
    use_mosh=false
  fi
  ssh_args+=(-L "$local_port:localhost:$destination_port")
fi

set_connection_title "$input"

terminal_state=""
if [[ -t 0 ]]; then
  terminal_state="$(stty -g 2>/dev/null || true)"
fi

restore_terminal() {
  local status=$?

  # A lost transport cannot undo remote terminal modes. Restore the caller's
  # tty settings and stop mouse reports before they reach the local prompt.
  [[ -z "$terminal_state" ]] || stty "$terminal_state" 2>/dev/null || true
  if [[ -t 1 && -n "${TERM:-}" && "$TERM" != "dumb" ]]; then
    printf '\033[?9;1000;1001;1002;1003;1004;1005;1006;1015;1016;2004l' || true
  fi
  return "$status"
}

trap restore_terminal EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -n "$service_target" ]]; then
  transport=(fleet-credentials ssh "$service_target")
  [[ -z "$local_port" ]] || transport+=(--local-forward "$local_port:$destination_port")
  if [[ "$use_mosh" == "true" ]]; then
    transport+=(--mosh)
    legacy_host_mosh_ports "$input"
    [[ -z "$mosh_ports" ]] || transport+=(--mosh-ports "$mosh_ports")
  elif [[ "$has_remote_command" == "true" ]]; then
    transport+=(--tty)
  fi
  transport+=(--)
  if [[ "$has_remote_command" == "true" ]]; then
    transport+=("${remote_command[@]}")
  fi
  # The helper owns terminal restoration and suspension for this route. Exec
  # keeps the shell's original job PID instead of leaving a waiting Bash parent.
  exec "${transport[@]}"
elif [[ "$use_mosh" == "true" ]]; then
  mosh_ssh=(ssh "${ssh_args[@]}")
  transport=(mosh -4 -a --bind-server=any --ssh="${mosh_ssh[*]}")
  legacy_host_mosh_ports "$input"
  [[ -z "$mosh_ports" ]] || transport+=(--port="$mosh_ports")
  transport+=(-- "$target")
  if [[ "$has_remote_command" == "true" ]]; then
    transport+=("${remote_command[@]}")
  fi
else
  transport=(ssh "${ssh_args[@]}" "$target")
  if [[ "$has_remote_command" == "true" ]]; then
    transport+=("${remote_command[@]}")
  fi
fi
"${transport[@]}"
