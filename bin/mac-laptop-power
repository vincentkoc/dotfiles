#!/usr/bin/env python3
"""Keep macOS laptops awake on AC while preserving display and battery settings."""

import argparse
import json
import re
import subprocess
import sys


PMSET = "/usr/bin/pmset"


def read_pmset(option):
    return subprocess.run([PMSET, "-g", option], check=True, capture_output=True,
                          text=True, timeout=10).stdout


def internal_battery(output):
    if not re.match(r"^Now drawing from '(AC Power|Battery Power|UPS Power)'\s*$",
                    output.splitlines()[0] if output.splitlines() else ""):
        raise ValueError("could not identify the native power source")
    present = bool(re.search(r"^\s*-InternalBattery-\d+\s", output, re.MULTILINE))
    if "'Battery Power'" in output.splitlines()[0] and not present:
        raise ValueError("battery power reported without an internal battery")
    return present


def settings(output):
    result = {}
    current = None
    for line in output.splitlines():
        if not line.strip():
            continue
        if line in ("AC Power:", "Battery Power:", "UPS Power:"):
            current = line[:-1]
            if current in result:
                raise ValueError("duplicate power source")
            result[current] = {}
            continue
        match = re.fullmatch(r"\s+(.+?)\s+(\S+)\s*", line)
        if current is None or not match or match[1] in result[current]:
            raise ValueError("could not parse native power settings")
        result[current][match[1]] = match[2]
    if not result.get("AC Power", {}).get("sleep", "").isdigit():
        raise ValueError("AC sleep setting is missing or invalid")
    return result


def reconcile(apply, report):
    if sys.platform != "darwin":
        report.update(status="not-applicable", reason="requires macOS")
        return 0
    if not internal_battery(read_pmset("batt")):
        report.update(status="not-applicable", reason="no internal battery")
        return 0
    before = settings(read_pmset("custom"))
    report["ac_sleep"] = int(before["AC Power"]["sleep"])
    if report["ac_sleep"] == 0:
        report["status"] = "match"
        return 0
    if not apply:
        report["status"] = "drift"
        return 1

    # Elevate only the native command, never this user-owned helper.
    report.update(change_attempted=True, changed=None)
    subprocess.run(["/usr/bin/sudo", PMSET, "-c", "sleep", "0"], check=True)
    after = settings(read_pmset("custom"))
    report["changed"] = after != before
    report["ac_sleep"] = int(after["AC Power"]["sleep"])
    expected = {source: values.copy() for source, values in before.items()}
    expected["AC Power"]["sleep"] = "0"
    if after != expected:
        raise ValueError("power settings readback differs from the AC-only change")
    report["status"] = "applied"
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="read-only check (default)")
    mode.add_argument("--apply", action="store_true", help="disable idle system sleep on AC")
    parser.add_argument("--json", action="store_true", help="print a structured result")
    args = parser.parse_args(argv)
    report = {"mode": "apply" if args.apply else "check", "changed": False,
              "change_attempted": False}
    try:
        code = reconcile(args.apply, report)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        report.update(status="error", error=str(error))
        code = 2
    if args.json:
        print(json.dumps(report, sort_keys=True))
    else:
        print("mac-laptop-power: " + report["status"] +
              (": " + report["error"] if "error" in report else ""))
    return code


if __name__ == "__main__":
    sys.exit(main())
