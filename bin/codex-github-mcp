#!/usr/bin/env bash

set -euo pipefail

export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

github_mcp_server="$(command -v github-mcp-server || true)"
if [[ -z "$github_mcp_server" ]]; then
  echo "codex-github-mcp: install github-mcp-server with Homebrew" >&2
  exit 127
fi

github_token="${GITHUB_PERSONAL_ACCESS_TOKEN:-${GITHUB_PAT_TOKEN:-}}"
if [[ -z "$github_token" ]]; then
  wrapper_dir="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  lookup_path=""
  path_remaining="${PATH:-}"
  path_done=""
  while :; do
    case "$path_remaining" in
      *:*)
        path_entry="${path_remaining%%:*}"
        path_remaining="${path_remaining#*:}"
        ;;
      *)
        path_entry="$path_remaining"
        path_done=1
        ;;
    esac
    path_entry="${path_entry:-.}"
    if [[ ! -d "$path_entry" || ! "$path_entry" -ef "$wrapper_dir" ]]; then
      lookup_path+="${lookup_path:+:}$path_entry"
    fi
    [[ -z "${path_done:-}" ]] || break
  done
  unset path_done path_entry path_remaining

  gh_bin="$(PATH="$lookup_path" command -v gh || true)"
  if [[ -n "$gh_bin" && -x "$gh_bin" ]]; then
    command -v python3 >/dev/null || {
      echo "codex-github-mcp: python3 is required for bounded native credential lookup" >&2
      exit 127
    }
    exec python3 -c '
import os
import signal
import subprocess
import sys
import time

interrupted = 0
process = None

def record_signal(signum, frame):
    global interrupted
    if not interrupted:
        interrupted = signum

for signum in (signal.SIGINT, signal.SIGTERM):
    signal.signal(signum, record_signal)

status = 1
output = b""
try:
    if not interrupted:
        process = subprocess.Popen(
            [sys.argv[1], "auth", "token", "--hostname", "github.com"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env={**os.environ, "GH_PROMPT_DISABLED": "1"},
            start_new_session=True,
        )
        deadline = time.monotonic() + 5
        while not interrupted:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                status = 124
                break
            try:
                output, _ = process.communicate(timeout=min(remaining, 0.1))
                status = process.returncode
                break
            except subprocess.TimeoutExpired:
                pass
except OSError:
    status = 1
finally:
    if process is not None and process.returncode is None:
        # The unreaped lookup owns this new group, including any pipe holders.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.stdout.close()
        process.wait()

if interrupted or status in (-signal.SIGINT, -signal.SIGTERM):
    print("codex-github-mcp: native GitHub credential lookup canceled", file=sys.stderr)
    sys.exit(128 + (interrupted or -status))
if status == 124:
    print("codex-github-mcp: native GitHub credential lookup timed out; check local gh/Keychain availability", file=sys.stderr)
    sys.exit(124)
token = output.decode().rstrip("\n") if status == 0 else ""
if not token:
    print("codex-github-mcp: set GITHUB_PERSONAL_ACCESS_TOKEN or GITHUB_PAT_TOKEN, or authenticate the native GitHub CLI", file=sys.stderr)
    sys.exit(1)
for name in ("GITHUB_PERSONAL_ACCESS_TOKEN", "GITHUB_PAT_TOKEN"):
    os.environ[name] = os.environ.get(name) or token
os.execv(sys.argv[2], [sys.argv[2], "stdio", *sys.argv[3:]])
' "$gh_bin" "$github_mcp_server" "$@"
  fi
fi
if [[ -z "$github_token" ]]; then
  echo "codex-github-mcp: set GITHUB_PERSONAL_ACCESS_TOKEN or GITHUB_PAT_TOKEN, or authenticate the native GitHub CLI" >&2
  exit 1
fi

export GITHUB_PERSONAL_ACCESS_TOKEN="${GITHUB_PERSONAL_ACCESS_TOKEN:-$github_token}"
export GITHUB_PAT_TOKEN="${GITHUB_PAT_TOKEN:-$github_token}"
unset gh_bin github_token

exec "$github_mcp_server" stdio "$@"
