#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  local directory
  while [[ -L "$source" ]]; do
    directory="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" == /* ]] || source="$directory/$source"
  done
  directory="$(cd -P "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$directory" "$(basename "$source")"
}

TMUX_BIN="${TT_TMUX_BIN:-/opt/homebrew/bin/tmux}"
if [[ ! -x "$TMUX_BIN" && -z "${TT_TMUX_BIN:-}" ]]; then
  TMUX_BIN="/usr/local/bin/tmux"
fi
if [[ ! -x "$TMUX_BIN" && -z "${TT_TMUX_BIN:-}" ]]; then
  TMUX_BIN="/usr/bin/tmux"
fi
if [[ ! -x "$TMUX_BIN" ]]; then
  echo "tmux not found at common paths" >&2
  exit 1
fi

SCRIPT_PATH="$(resolve_script_path)"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
TT_WSL_BRIDGE_READY=0
TT_WSL_BRIDGE_PENDING=0
TT_WSL_BRIDGE_PENDING_PID=""
TT_WSL_BRIDGE_PENDING_STARTTIME=""
TT_WSL_BRIDGE_PENDING_NS=""
TT_WSL_BRIDGE_PENDING_EXE=""

wsl_bridge_is_wsl() {
  [[ -n "${WSL_DISTRO_NAME:-}" ]] &&
    [[ "$(uname -r 2>/dev/null || true)" =~ [Mm]icrosoft|WSL ]]
}

wsl_bridge_valid_socket() {
  local socket="$1"

  [[ "$socket" =~ ^/run/WSL/[0-9]+_interop$ ]] && [[ -S "$socket" ]]
}

wsl_bridge_proc_starttime() {
  local pid="$1"
  local stat_line stat_fields
  local -a fields

  stat_line="$(<"/proc/$pid/stat")" || return 1
  stat_fields="${stat_line#*) }"
  read -r -a fields <<<"$stat_fields"
  [[ "${#fields[@]}" -ge 20 ]] || return 1
  printf '%s\n' "${fields[19]}"
}

wsl_bridge_current_identity() {
  local pid="$$"
  local starttime namespace exe

  starttime="$(wsl_bridge_proc_starttime "$pid")" || return 1
  namespace="$(readlink "/proc/$pid/ns/mnt")" || return 1
  exe="$(readlink "/proc/$pid/exe")" || return 1
  [[ "$namespace" =~ ^mnt:\[[0-9]+\]$ ]] || return 1
  printf '%s|%s|%s|%s\n' "$pid" "$starttime" "$namespace" "$exe"
}

wsl_bridge_server_identity() {
  local pid starttime namespace exe expected_exe owner socket_path

  pid="$("$TMUX_BIN" display-message -p '#{pid}' 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$(<"/proc/$pid/comm")" == "tmux: server" ]] || return 1
  owner="$(stat -c %u "/proc/$pid")" || return 1
  [[ "$owner" == "$(id -u)" ]] || return 1
  starttime="$(wsl_bridge_proc_starttime "$pid")" || return 1
  namespace="$(readlink "/proc/$pid/ns/mnt")" || return 1
  [[ "$namespace" =~ ^mnt:\[[0-9]+\]$ ]] || return 1
  exe="$(readlink "/proc/$pid/exe")" || return 1
  expected_exe="$(readlink -f "$TMUX_BIN")" || return 1
  [[ "$exe" == "$expected_exe" ]] || return 1

  socket_path="$("$TMUX_BIN" display-message -p '#{socket_path}' 2>/dev/null || true)"
  [[ -S "$socket_path" ]] || return 1
  [[ "$(stat -c %u "$socket_path")" == "$owner" ]] || return 1

  printf '%s|%s|%s|%s|%s\n' "$pid" "$starttime" "$namespace" "$exe" "$socket_path"
}

wsl_bridge_server_snapshot() {
  local identity pid starttime namespace exe socket_path owner
  local pane_id pane pane_dead pane_namespace pane_entries
  local -a pane_rows

  identity="$(wsl_bridge_server_identity)" || return 1
  IFS='|' read -r pid starttime namespace exe socket_path <<<"$identity"
  owner="$(id -u)"

  while IFS= read -r row; do
    pane_rows+=("$row")
  done < <("$TMUX_BIN" list-panes -a -F '#{pane_id}|#{pane_pid}|#{pane_dead}' 2>/dev/null | sort)
  [[ "${#pane_rows[@]}" -gt 0 ]] || return 1
  pane_entries=""
  for row in "${pane_rows[@]}"; do
    IFS='|' read -r pane_id pane pane_dead <<<"$row"
    [[ "$pane_id" =~ ^%[0-9]+$ && "$pane" =~ ^[0-9]+$ && "$pane_dead" =~ ^[01]$ ]] || return 1
    if [[ "$pane_dead" == "1" ]]; then
      [[ ! -e "/proc/$pane" ]] || return 1
    else
      [[ "$(stat -c %u "/proc/$pane")" == "$owner" ]] || return 1
      pane_namespace="$(readlink "/proc/$pane/ns/mnt")" || return 1
      [[ "$pane_namespace" == "$namespace" ]] || return 1
    fi
    pane_entries+="${pane_entries:+,}$pane_id:$pane:$pane_dead"
  done

  printf '%s|%s|%s|%s|%s|%s\n' \
    "$pid" "$starttime" "$namespace" "$exe" "$socket_path" "$pane_entries"
}

wsl_bridge_root_action() {
  local action="$1"
  local target_kind="$2"
  local target_pid="$3"
  local target_starttime="$4"
  local target_namespace="$5"
  local target_exe="$6"
  local socket_path="$7"
  local pane_entries="$8"
  local current_pid="$9"
  local current_starttime="${10}"
  local current_namespace="${11}"
  local current_exe="${12}"
  local uid gid

  uid="$(id -u)"
  gid="$(id -g)"
  [[ "$uid" =~ ^[0-9]+$ && "$gid" =~ ^[0-9]+$ ]] || {
    echo "tt: could not determine numeric uid/gid for drvfs mount" >&2
    return 2
  }

  sudo -n /usr/bin/flock -x /run/lock/tt-wsl-bridge.lock /usr/bin/bash -c '
    set -euo pipefail
    action="$1"
    target_kind="$2"
    target_pid="$3"
    target_starttime="$4"
    target_namespace="$5"
    target_exe="$6"
    socket_path="$7"
    pane_entries="$8"
    current_pid="$9"
    current_starttime="${10}"
    current_namespace="${11}"
    current_exe="${12}"
    uid="${13}"
    gid="${14}"
    marker_dir=/run/tt-wsl-bridge
    marker="$marker_dir/mount-$uid"
    pending="$marker_dir/pending-$uid"

    proc_starttime() {
      local pid="$1"
      local stat_line stat_fields
      local -a fields
      stat_line="$(<"/proc/$pid/stat")" || return 1
      stat_fields="${stat_line#*) }"
      read -r -a fields <<<"$stat_fields"
      [[ "${#fields[@]}" -ge 20 ]] || return 1
      printf "%s\n" "${fields[19]}"
    }

    validate_process() {
      local pid="$1"
      local expected_starttime="$2"
      local expected_namespace="$3"
      local expected_exe="$4"
      local expected_comm="${5:-}"
      [[ "$pid" =~ ^[0-9]+$ && -d "/proc/$pid" ]] || return 1
      [[ "$(/usr/bin/stat -c %u "/proc/$pid")" == "$uid" ]] || return 1
      [[ "$(proc_starttime "$pid")" == "$expected_starttime" ]] || return 1
      [[ "$(/usr/bin/readlink "/proc/$pid/ns/mnt")" == "$expected_namespace" ]] || return 1
      [[ "$(/usr/bin/readlink "/proc/$pid/exe")" == "$expected_exe" ]] || return 1
      if [[ -n "$expected_comm" ]]; then
        [[ "$(<"/proc/$pid/comm")" == "$expected_comm" ]] || return 1
      fi
    }

    validate_process "$current_pid" "$current_starttime" "$current_namespace" "$current_exe"
    if [[ "$target_kind" == "server" ]]; then
      validate_process "$target_pid" "$target_starttime" "$target_namespace" "$target_exe" "tmux: server"
      [[ -S "$socket_path" && "$(/usr/bin/stat -c %u "$socket_path")" == "$uid" ]] || {
        echo "tt: tmux socket identity mismatch" >&2
        exit 2
      }
      [[ "$(/usr/bin/setpriv --reuid "$uid" --regid "$gid" --clear-groups "$target_exe" -S "$socket_path" display-message -p "#{pid}")" == "$target_pid" ]] || {
        echo "tt: tmux socket points to a different server" >&2
        exit 2
      }
      if [[ "$action" == "ensure" ]]; then
        locked_panes="$(
          /usr/bin/setpriv --reuid "$uid" --regid "$gid" --clear-groups \
            "$target_exe" -S "$socket_path" list-panes -a -F "#{pane_id}|#{pane_pid}|#{pane_dead}" |
            /usr/bin/sort |
            /usr/bin/awk -F "|" '\''{printf "%s%s:%s:%s", sep, $1, $2, $3; sep=","} END {print ""}'\''
        )"
        [[ -n "$pane_entries" && "$locked_panes" == "$pane_entries" ]] || {
          echo "tt: tmux pane set changed before bridge lock validation" >&2
          exit 2
        }
        IFS=, read -r -a panes <<<"$pane_entries"
        for pane_entry in "${panes[@]}"; do
          IFS=: read -r pane_id pane pane_dead <<<"$pane_entry"
          [[ "$pane_id" =~ ^%[0-9]+$ && "$pane" =~ ^[0-9]+$ && "$pane_dead" =~ ^[01]$ ]] || {
            echo "tt: invalid tmux pane identity" >&2
            exit 2
          }
          if [[ "$pane_dead" == "1" ]]; then
            [[ ! -e "/proc/$pane" ]] || {
              echo "tt: dead tmux pane PID was reused during bridge setup" >&2
              exit 2
            }
            continue
          fi
          [[ -d "/proc/$pane" ]] || {
            echo "tt: active tmux pane PID changed during bridge setup" >&2
            exit 2
          }
          [[ "$(/usr/bin/stat -c %u "/proc/$pane")" == "$uid" ]] || {
            echo "tt: tmux pane ownership mismatch" >&2
            exit 2
          }
          [[ "$(/usr/bin/readlink "/proc/$pane/ns/mnt")" == "$target_namespace" ]] || {
            echo "tt: tmux pane mount namespace mismatch" >&2
            exit 2
          }
        done
      fi
    else
      [[ "$target_kind" == "current" ]] || exit 2
      target_pid="$current_pid"
      target_starttime="$current_starttime"
      target_namespace="$current_namespace"
      target_exe="$current_exe"
    fi

    nsrun() {
      /usr/bin/nsenter -t "$target_pid" -m -- "$@"
    }

    mount_record() {
      local record
      record="$(nsrun /usr/bin/findmnt -rn -M /mnt/c -o SOURCE,FSTYPE,OPTIONS 2>/dev/null || true)"
      [[ -n "$record" ]] || return 1
      [[ "$record" != *$'\''\n'\''* ]] || return 1
      printf "%s\n" "$record"
    }

    mount_valid() {
      local record source fstype options extra
      record="$(mount_record)" || return 1
      read -r source fstype options extra <<<"$record"
      [[ -z "${extra:-}" && "$source" == "C:" ]] || return 1
      case "$fstype" in
        drvfs)
          ;;
        9p)
          [[ ",$options," == *",aname=drvfs"* ]] || return 1
          ;;
        *)
          return 1
          ;;
      esac
      [[ ",$options," == *,ro,* && ",$options," != *,rw,* ]]
    }

    mode_not_writable_by_group_or_world() {
      local mode="$1"
      [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
      (( (8#$mode & 8#022) == 0 ))
    }

    validate_marker_dir() {
      local owner mode
      if [[ ! -e "$marker_dir" && ! -L "$marker_dir" ]]; then
        /usr/bin/mkdir -m 0700 "$marker_dir"
      fi
      [[ -d "$marker_dir" && ! -L "$marker_dir" ]] || {
        echo "tt: refusing unsafe WSL bridge marker directory" >&2
        return 2
      }
      owner="$(/usr/bin/stat -c %u "$marker_dir")"
      mode="$(/usr/bin/stat -c %a "$marker_dir")"
      [[ "$owner" == "0" ]] && mode_not_writable_by_group_or_world "$mode" || {
        echo "tt: WSL bridge marker directory must be root-owned and not group/world-writable" >&2
        return 2
      }
    }

    parse_record() {
      local value="$1"
      [[ "$value" =~ ^([0-9]+)\|([0-9]+)\|mnt:\[([0-9]+)\]$ ]] || return 1
      RECORD_PID="${BASH_REMATCH[1]}"
      RECORD_STARTTIME="${BASH_REMATCH[2]}"
      RECORD_NAMESPACE="mnt:[${BASH_REMATCH[3]}]"
    }

    load_record() {
      local path="$1"
      local label="$2"
      local owner mode size lines value
      if [[ ! -e "$path" && ! -L "$path" ]]; then
        return 1
      fi
      [[ -f "$path" && ! -L "$path" ]] || {
        echo "tt: refusing unsafe $label record" >&2
        return 2
      }
      owner="$(/usr/bin/stat -c %u "$path")"
      mode="$(/usr/bin/stat -c %a "$path")"
      size="$(/usr/bin/stat -c %s "$path")"
      lines="$(/usr/bin/wc -l <"$path")"
      lines="${lines//[[:space:]]/}"
      [[ "$owner" == "0" ]] &&
        mode_not_writable_by_group_or_world "$mode" &&
        [[ "$size" =~ ^[0-9]+$ && "$size" -gt 0 && "$size" -le 128 && "$lines" == "1" ]] || {
        echo "tt: $label record must be root-owned, bounded, and not group/world-writable" >&2
        return 2
      }
      value="$(<"$path")"
      parse_record "$value" || {
        echo "tt: refusing malformed $label record" >&2
        return 2
      }
      printf "%s\n" "$value"
    }

    atomic_write_record() {
      local path="$1"
      local value="$2"
      local temp
      parse_record "$value" || {
        echo "tt: refusing to write malformed WSL bridge record" >&2
        return 2
      }
      temp="$(/usr/bin/mktemp "$marker_dir/.record.XXXXXX")"
      if ! /usr/bin/chmod 0600 "$temp"; then
        echo "tt: failed to secure temporary WSL bridge record" >&2
        /usr/bin/rm -f "$temp"
        return 2
      fi
      if ! printf "%s\n" "$value" >"$temp"; then
        echo "tt: failed to write temporary WSL bridge record" >&2
        /usr/bin/rm -f "$temp"
        return 2
      fi
      if ! /usr/bin/mv -fT "$temp" "$path"; then
        echo "tt: failed to atomically publish WSL bridge record" >&2
        /usr/bin/rm -f "$temp"
        return 2
      fi
      load_record "$path" "WSL bridge" >/dev/null || return 2
    }

    record_is_exact_live() {
      local value="$1"
      local actual_starttime actual_namespace
      parse_record "$value" || return 2
      [[ -d "/proc/$RECORD_PID" ]] || return 1
      actual_starttime="$(proc_starttime "$RECORD_PID")" || return 2
      actual_namespace="$(/usr/bin/readlink "/proc/$RECORD_PID/ns/mnt")" || return 2
      [[ "$actual_starttime" == "$RECORD_STARTTIME" && "$actual_namespace" == "$RECORD_NAMESPACE" ]]
    }

    namespace_unreferenced() {
      local namespace="$1"
      local proc_dir actual_namespace
      local -a proc_dirs
      [[ "$namespace" =~ ^mnt:\[[0-9]+\]$ ]] || return 2
      shopt -s nullglob
      proc_dirs=(/proc/[0-9]*)
      shopt -u nullglob
      [[ "${#proc_dirs[@]}" -gt 0 ]] || return 2
      for proc_dir in "${proc_dirs[@]}"; do
        [[ -d "$proc_dir" ]] || return 2
        actual_namespace="$(/usr/bin/readlink "$proc_dir/ns/mnt")" || return 2
        [[ "$actual_namespace" != "$namespace" ]] || return 1
      done
      return 0
    }

    remove_stale_record() {
      local path="$1"
      local label="$2"
      local value="$3"
      local target_ns="$4"
      local live_status scan_status
      parse_record "$value" || return 2
      if record_is_exact_live "$value"; then
        echo "tt: refusing to remove $label record for an exact live process" >&2
        return 2
      else
        live_status=$?
        [[ "$live_status" == "1" ]] || {
          echo "tt: refusing ambiguous $label process identity" >&2
          return 2
        }
      fi
      if [[ "$RECORD_NAMESPACE" != "$target_ns" ]]; then
        if namespace_unreferenced "$RECORD_NAMESPACE"; then
          :
        else
          scan_status=$?
          if [[ "$scan_status" == "1" ]]; then
            echo "tt: refusing $label cleanup; recorded mount namespace is still referenced" >&2
          else
            echo "tt: refusing $label cleanup; mount namespace scan was ambiguous" >&2
          fi
          return 2
        fi
      fi
      if ! /usr/bin/rm -- "$path"; then
        echo "tt: failed to remove stale $label record" >&2
        return 2
      fi
    }

    propagation="$(nsrun /usr/bin/findmnt -rn -M / -o PROPAGATION)"
    [[ "$propagation" != shared* ]] || {
      echo "tt: refusing bridge in a shared root mount namespace" >&2
      exit 2
    }

    validate_marker_dir || exit 2
    marker_value="$target_pid|$target_starttime|$target_namespace"
    current_value="$current_pid|$current_starttime|$current_namespace"
    marker_present=0
    pending_present=0
    if marker_record="$(load_record "$marker" "WSL bridge mount")"; then
      marker_present=1
    else
      record_status=$?
      [[ "$record_status" == "1" ]] || exit 2
      marker_record=""
    fi
    if pending_record="$(load_record "$pending" "WSL bridge pending")"; then
      pending_present=1
    else
      record_status=$?
      [[ "$record_status" == "1" ]] || exit 2
      pending_record=""
    fi

    case "$action" in
      ensure)
        if nsrun /usr/bin/findmnt -rn -M /mnt/c >/dev/null 2>&1; then
          mount_valid || {
            echo "tt: refusing unexpected /mnt/c mount; expected read-only C: drvfs" >&2
            exit 2
          }
          [[ "$marker_present" != "1" || "$pending_present" != "1" ]] || {
            echo "tt: refusing simultaneous mount and pending WSL bridge records" >&2
            exit 2
          }
          if [[ "$target_kind" == "server" && "$marker_present" == "1" ]]; then
            parse_record "$marker_record" || exit 2
            [[ "$RECORD_NAMESPACE" == "$target_namespace" ]] || {
              echo "tt: valid /mnt/c mount record belongs to a different namespace; refusing adoption" >&2
              exit 2
            }
            if [[ "$marker_record" != "$marker_value" ]]; then
              if record_is_exact_live "$marker_record"; then
                echo "tt: refusing adoption from an exact live mount owner" >&2
                exit 2
              else
                live_status=$?
                [[ "$live_status" == "1" ]] || {
                  echo "tt: refusing ambiguous stale mount owner during adoption" >&2
                  exit 2
                }
              fi
              atomic_write_record "$marker" "$marker_value" || exit 2
              printf "adopted\n"
            else
              printf "existing\n"
            fi
            exit 0
          fi
          if [[ "$target_kind" == "server" && "$pending_present" == "1" ]]; then
            parse_record "$pending_record" || exit 2
            [[ "$RECORD_NAMESPACE" == "$target_namespace" ]] || {
              echo "tt: valid /mnt/c pending record belongs to a different namespace; refusing adoption" >&2
              exit 2
            }
            if [[ "$pending_record" != "$current_value" ]]; then
              if record_is_exact_live "$pending_record"; then
                echo "tt: refusing adoption from an exact live pending owner" >&2
                exit 2
              else
                live_status=$?
                [[ "$live_status" == "1" ]] || {
                  echo "tt: refusing ambiguous stale pending owner during adoption" >&2
                  exit 2
                }
              fi
            fi
            [[ "$current_namespace" == "$target_namespace" ]] || {
              echo "tt: current process namespace cannot promote the pending mount" >&2
              exit 2
            }
            atomic_write_record "$marker" "$marker_value" || exit 2
            if ! /usr/bin/rm -- "$pending"; then
              echo "tt: failed to remove promoted pending record" >&2
              exit 2
            fi
            printf "promoted\n"
            exit 0
          fi
          if [[ "$target_kind" == "current" && "$pending_present" == "1" && "$pending_record" == "$current_value" ]]; then
            printf "existing\n"
            exit 0
          fi
          echo "tt: valid /mnt/c mount has no matching bridge record; refusing adoption" >&2
          exit 2
        fi

        if [[ "$marker_present" == "1" ]]; then
          remove_stale_record "$marker" "mount" "$marker_record" "$target_namespace" || exit 2
          marker_present=0
        fi
        if [[ "$pending_present" == "1" ]]; then
          remove_stale_record "$pending" "pending" "$pending_record" "$target_namespace" || exit 2
          pending_present=0
        fi
        if [[ -L /mnt/c || ( -e /mnt/c && ! -d /mnt/c ) ]]; then
          echo "tt: refusing non-directory /mnt/c mountpoint" >&2
          exit 2
        fi
        if [[ -d /mnt/c ]] && [[ -n "$(nsrun /usr/bin/find /mnt/c -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
          echo "tt: refusing nonempty unmounted /mnt/c" >&2
          exit 2
        fi

        nsrun /usr/bin/mkdir -p /mnt/c
        nsrun /usr/bin/mount -t drvfs -o "ro,uid=$uid,gid=$gid,umask=022,fmask=011" C: /mnt/c
        if ! mount_valid; then
          echo "tt: /mnt/c failed post-mount validation; attempting normal cleanup" >&2
          if ! nsrun /usr/bin/umount /mnt/c; then
            echo "tt: WSL bridge cleanup failed after post-mount validation" >&2
            exit 2
          fi
          if nsrun /usr/bin/findmnt -rn -M /mnt/c >/dev/null 2>&1; then
            echo "tt: WSL bridge cleanup left /mnt/c mounted" >&2
            exit 2
          fi
          exit 2
        fi
        if [[ "$target_kind" == "server" ]]; then
          atomic_write_record "$marker" "$marker_value" || exit 2
          printf "created\n"
        else
          atomic_write_record "$pending" "$current_value" || exit 2
          printf "prepared\n"
        fi
        ;;
      rollback-server)
        [[ "$target_kind" == "server" && "$marker_present" == "1" && "$marker_record" == "$marker_value" && "$pending_present" == "0" ]] || {
          echo "tt: refusing rollback without exact server mount marker" >&2
          exit 2
        }
        mount_valid || {
          echo "tt: refusing rollback of an unvalidated mount" >&2
          exit 2
        }
        if ! nsrun /usr/bin/umount /mnt/c; then
          echo "tt: normal server mount rollback failed" >&2
          exit 2
        fi
        if nsrun /usr/bin/findmnt -rn -M /mnt/c >/dev/null 2>&1; then
          echo "tt: server mount remains after rollback" >&2
          exit 2
        fi
        if ! /usr/bin/rm -- "$marker"; then
          echo "tt: failed to remove rolled-back server marker" >&2
          exit 2
        fi
        printf "rolled-back\n"
        ;;
      release-server)
        [[ "$target_kind" == "server" ]] || exit 2
        if nsrun /usr/bin/findmnt -rn -M /mnt/c >/dev/null 2>&1; then
          [[ "$marker_present" == "1" && "$marker_record" == "$marker_value" && "$pending_present" == "0" ]] || {
            echo "tt: refusing server release without exact mount ownership" >&2
            exit 2
          }
          mount_valid || {
            echo "tt: refusing server release of an unvalidated mount" >&2
            exit 2
          }
          if ! nsrun /usr/bin/umount /mnt/c; then
            echo "tt: normal server release unmount failed" >&2
            exit 2
          fi
          if nsrun /usr/bin/findmnt -rn -M /mnt/c >/dev/null 2>&1; then
            echo "tt: server mount remains after release" >&2
            exit 2
          fi
          if ! /usr/bin/rm -- "$marker"; then
            echo "tt: failed to remove released server marker" >&2
            exit 2
          fi
          printf "released\n"
        elif [[ "$marker_present" == "0" && "$pending_present" == "0" ]]; then
          printf "absent\n"
        else
          echo "tt: refusing server release with records but no mount" >&2
          exit 2
        fi
        ;;
      rollback-current)
        [[ "$target_kind" == "current" && "$pending_present" == "1" && "$pending_record" == "$current_value" && "$marker_present" == "0" ]] || {
          echo "tt: refusing rollback without exact pending mount marker" >&2
          exit 2
        }
        mount_valid || {
          echo "tt: refusing rollback of an unvalidated pending mount" >&2
          exit 2
        }
        if ! nsrun /usr/bin/umount /mnt/c; then
          echo "tt: normal pending mount rollback failed" >&2
          exit 2
        fi
        if nsrun /usr/bin/findmnt -rn -M /mnt/c >/dev/null 2>&1; then
          echo "tt: pending mount remains after rollback" >&2
          exit 2
        fi
        if ! /usr/bin/rm -- "$pending"; then
          echo "tt: failed to remove rolled-back pending marker" >&2
          exit 2
        fi
        printf "rolled-back\n"
        ;;
      *)
        exit 2
        ;;
    esac
  ' tt-wsl-bridge "$action" "$target_kind" "$target_pid" "$target_starttime" \
    "$target_namespace" "$target_exe" "$socket_path" "$pane_entries" "$current_pid" \
    "$current_starttime" "$current_namespace" "$current_exe" "$uid" "$gid"
}

wsl_bridge_cleanup_server_mount() {
  local context="$1"
  shift
  local output

  if ! output="$(wsl_bridge_root_action rollback-server "$@" 2>&1)"; then
    echo "tt: WSL bridge cleanup failed after $context: ${output:-unknown rollback failure}" >&2
    return 1
  fi
}

wsl_bridge_cleanup_pending() {
  local output

  [[ "$TT_WSL_BRIDGE_PENDING" == "1" ]] || return 0
  if ! output="$(
    wsl_bridge_root_action rollback-current current \
      "$TT_WSL_BRIDGE_PENDING_PID" "$TT_WSL_BRIDGE_PENDING_STARTTIME" \
      "$TT_WSL_BRIDGE_PENDING_NS" "$TT_WSL_BRIDGE_PENDING_EXE" "" "" \
      "$TT_WSL_BRIDGE_PENDING_PID" "$TT_WSL_BRIDGE_PENDING_STARTTIME" \
      "$TT_WSL_BRIDGE_PENDING_NS" "$TT_WSL_BRIDGE_PENDING_EXE" 2>&1
  )"; then
    echo "tt: WSL bridge pending cleanup failed: ${output:-unknown rollback failure}" >&2
  fi
  TT_WSL_BRIDGE_PENDING=0
}

wsl_bridge_release_server_mount() {
  local server_identity current_identity output
  local server_pid server_starttime server_namespace server_exe socket_path
  local current_pid current_starttime current_namespace current_exe

  wsl_bridge_is_wsl || return 0
  if ! server_identity="$(wsl_bridge_server_identity)"; then
    if tmux_server_running; then
      echo "tt: refusing tmux reset because the live server identity could not be validated" >&2
      return 2
    fi
    return 0
  fi
  current_identity="$(wsl_bridge_current_identity)" || {
    echo "tt: could not validate current process before tmux bridge release" >&2
    return 2
  }
  IFS='|' read -r server_pid server_starttime server_namespace server_exe socket_path <<<"$server_identity"
  IFS='|' read -r current_pid current_starttime current_namespace current_exe <<<"$current_identity"
  if ! output="$(
    wsl_bridge_root_action release-server server \
      "$server_pid" "$server_starttime" "$server_namespace" "$server_exe" "$socket_path" "" \
      "$current_pid" "$current_starttime" "$current_namespace" "$current_exe" 2>&1
  )"; then
    echo "tt: refusing tmux reset because WSL bridge release failed: ${output:-unknown release failure}" >&2
    return 2
  fi
  "$TMUX_BIN" set-option -gu @tt_wsl_interop 2>/dev/null || {
    echo "tt: failed to clear released WSL bridge socket option" >&2
    return 2
  }
  TT_WSL_BRIDGE_READY=0
}

wsl_bridge_ensure() {
  local mode="${1:-explicit}"
  local socket current_snapshot server_snapshot
  local current_pid current_starttime current_namespace current_exe
  local server_pid server_starttime server_namespace server_exe socket_path pane_entries
  local result after_snapshot

  wsl_bridge_is_wsl || {
    echo "tt: wsl-bridge is available only inside WSL" >&2
    return 2
  }

  socket="${WSL_INTEROP:-}"
  [[ -n "$socket" ]] || {
    echo "tt: wsl-bridge requires WSL_INTEROP from a native wsl.exe launch" >&2
    return 2
  }
  wsl_bridge_valid_socket "$socket" || {
    echo "tt: refusing invalid or dead WSL_INTEROP socket: $socket" >&2
    return 2
  }

  current_snapshot="$(wsl_bridge_current_identity)" || {
    echo "tt: could not validate the current WSL process identity" >&2
    return 2
  }
  IFS='|' read -r current_pid current_starttime current_namespace current_exe <<<"$current_snapshot"

  if server_snapshot="$(wsl_bridge_server_snapshot)"; then
    IFS='|' read -r server_pid server_starttime server_namespace server_exe socket_path pane_entries <<<"$server_snapshot"
    result="$(wsl_bridge_root_action ensure server \
      "$server_pid" "$server_starttime" "$server_namespace" "$server_exe" "$socket_path" "$pane_entries" \
      "$current_pid" "$current_starttime" "$current_namespace" "$current_exe")" || return
    after_snapshot="$(wsl_bridge_server_snapshot)" || {
      if [[ "$result" == "created" || "$result" == "promoted" ]]; then
        if ! wsl_bridge_cleanup_server_mount "tmux server identity change" server \
          "$server_pid" "$server_starttime" "$server_namespace" "$server_exe" "$socket_path" "$pane_entries" \
          "$current_pid" "$current_starttime" "$current_namespace" "$current_exe"; then
          :
        fi
      fi
      echo "tt: tmux server identity changed during bridge setup" >&2
      return 2
    }
    if [[ "$after_snapshot" != "$server_snapshot" ]]; then
      if [[ "$result" == "created" || "$result" == "promoted" ]]; then
        if ! wsl_bridge_cleanup_server_mount "tmux pane churn" server \
          "$server_pid" "$server_starttime" "$server_namespace" "$server_exe" "$socket_path" "$pane_entries" \
          "$current_pid" "$current_starttime" "$current_namespace" "$current_exe"; then
          :
        fi
      fi
      echo "tt: tmux pane set changed during bridge setup" >&2
      return 2
    fi
    if ! "$TMUX_BIN" set-option -gq @tt_wsl_interop "$socket"; then
      if [[ "$result" == "created" || "$result" == "promoted" ]]; then
        if ! wsl_bridge_cleanup_server_mount "tmux socket option update" server \
          "$server_pid" "$server_starttime" "$server_namespace" "$server_exe" "$socket_path" "$pane_entries" \
          "$current_pid" "$current_starttime" "$current_namespace" "$current_exe"; then
          :
        fi
      fi
      return 2
    fi
    TT_WSL_BRIDGE_PENDING=0
    trap - EXIT
  else
    [[ "$mode" == "entry" ]] || {
      echo "tt: wsl-bridge requires an existing tmux server; use a tt create/attach command" >&2
      return 2
    }
    result="$(wsl_bridge_root_action ensure current \
      "$current_pid" "$current_starttime" "$current_namespace" "$current_exe" "" "" \
      "$current_pid" "$current_starttime" "$current_namespace" "$current_exe")" || return
    [[ "$result" == "prepared" || "$result" == "existing" ]] || return 2
    TT_WSL_BRIDGE_PENDING=1
    TT_WSL_BRIDGE_PENDING_PID="$current_pid"
    TT_WSL_BRIDGE_PENDING_STARTTIME="$current_starttime"
    TT_WSL_BRIDGE_PENDING_NS="$current_namespace"
    TT_WSL_BRIDGE_PENDING_EXE="$current_exe"
    trap wsl_bridge_cleanup_pending EXIT
    return 0
  fi

  TT_WSL_BRIDGE_READY=1
}

wsl_bridge_ensure_for_entry() {
  [[ "$TT_WSL_BRIDGE_READY" == "1" ]] && return 0
  if wsl_bridge_is_wsl && [[ -n "${WSL_INTEROP:-}" ]]; then
    wsl_bridge_ensure entry
  fi
}

attach_or_switch() {
  local session="$1"

  wsl_bridge_ensure_for_entry

  if [[ -n "${TMUX:-}" ]]; then
    exec "$TMUX_BIN" switch-client -t "$session"
  fi

  exec "$TMUX_BIN" attach -t "$session"
}

mobile_group_session_name() {
  local source_session="$1"
  local sanitized
  sanitized="${source_session//[^A-Za-z0-9._-]/-}"
  printf 'ttm-%s\n' "$sanitized"
}

set_profile_metadata() {
  local session="$1"
  local profile="$2"
  "$TMUX_BIN" set-option -t "$session" -q @tt_profile "$profile"
}

send_literal_command() {
  local target="$1"
  local command="$2"

  "$TMUX_BIN" send-keys -t "$target" -l "$command"
  "$TMUX_BIN" send-keys -t "$target" Enter
}

shell_quote() {
  printf '%q' "$1"
}

default_login_shell() {
  local shell_path="${TT_LOGIN_SHELL:-}"

  if [[ -z "$shell_path" ]] && command -v dscl >/dev/null 2>&1 && [[ -n "${USER:-}" ]]; then
    shell_path="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2; exit}')"
  fi

  if [[ -z "$shell_path" && -n "${SHELL:-}" ]]; then
    shell_path="$SHELL"
  fi

  if [[ -z "$shell_path" || ! -x "$shell_path" ]]; then
    shell_path="/bin/zsh"
  fi

  printf '%s\n' "$shell_path"
}

default_login_shell_command() {
  local shell_path

  shell_path="$(default_login_shell)"
  printf '%s -il\n' "$(shell_quote "$shell_path")"
}

ensure_tmux_default_shell() {
  local shell_path

  shell_path="$(default_login_shell)"
  "$TMUX_BIN" set-option -gq default-shell "$shell_path" 2>/dev/null || true
  "$TMUX_BIN" set-option -gq -u default-command 2>/dev/null || true
}

agent_color_prefix() {
  printf 'env -u NO_COLOR -u TERMINFO CLICOLOR=1 CLICOLOR_FORCE=1 FORCE_COLOR=3 COLORTERM=truecolor TERMINFO_DIRS=$HOME/.terminfo:/usr/share/terminfo'
}

agent_shell_fallback_suffix() {
  printf '; exec %s' "$(default_login_shell_command)"
}

command_with_shell_fallback() {
  local command="$1"

  printf '%s%s\n' "$command" "$(agent_shell_fallback_suffix)"
}

agent_pane_command() {
  local command="$1"

  command_with_shell_fallback "$(agent_color_prefix) $command"
}

agent_kind_for_command() {
  local command="$1"

  case "$command" in
    *claude*)
      printf 'CLAUDE'
      ;;
    *codex*)
      printf 'CODEX'
      ;;
    *)
      printf 'SHELL'
      ;;
  esac
}

agent_label_format() {
  printf '#{?#{==:#{@tt_agent_kind},CLAUDE},CC,#{?#{==:#{@tt_agent_kind},CODEX},CX,TM}}'
}

agent_ready_format() {
  printf '#{?#{&&:#{||:#{==:#{@tt_agent_kind},CODEX},#{==:#{@tt_agent_kind},CLAUDE}},#{?#{m/r:^[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏⠂],#{pane_title}},0,1}},1,0}'
}

set_agent_window_status_formats() {
  "$TMUX_BIN" set -g status-position top
  "$TMUX_BIN" set -g status-left-length 32
  "$TMUX_BIN" set -g status-left "#[fg=#15161e,bg=#ff9e64,bold] ❐ #S #[fg=#ff9e64,bg=#1a1b26,none] "
  "$TMUX_BIN" set -g window-status-format "#[fg=#1a1b26,bg=#1a1b26,none]#[fg=#565f89,bg=#1a1b26,none] #I #W #[fg=#1a1b26,bg=#1a1b26,none]"
  "$TMUX_BIN" set -g window-status-current-format "#[fg=#1a1b26,bg=#7aa2f7,none]#[fg=#1a1b26,bg=#7aa2f7,bold] #I #W #[fg=#7aa2f7,bg=#1a1b26,none]"
  "$TMUX_BIN" set -g window-status-style "fg=#565f89,bg=#1a1b26,none"
  "$TMUX_BIN" set -g window-status-current-style "fg=#1a1b26,bg=#7aa2f7,bold"
}

git_pane_label() {
  local dir="$1"
  local branch

  [[ -d "$dir" ]] || return 0
  git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

  branch="$(git -C "$dir" branch --show-current 2>/dev/null || true)"
  if [[ -z "$branch" ]]; then
    branch="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || true)"
  fi
  [[ -n "$branch" ]] || return 0

  printf ' %s\n' "$branch"
}

set_pane_git_label() {
  local target="$1"
  local dir="$2"
  local git_label

  git_label="$(git_pane_label "$dir")"
  if [[ -n "$git_label" ]]; then
    "$TMUX_BIN" set-option -pt "$target" @tt_git_label "$git_label" 2>/dev/null || true
  else
    "$TMUX_BIN" set-option -pt "$target" -u @tt_git_label 2>/dev/null || true
  fi
}

clean_agent_command() {
  local command="$1"
  local prefix suffix

  command="${command#\"}"
  command="${command%\"}"
  suffix="$(agent_shell_fallback_suffix)"
  if [[ "$command" == *"$suffix" ]]; then
    command="${command%"$suffix"}"
  fi
  prefix="$(agent_color_prefix) "
  if [[ "$command" == "$prefix"* ]]; then
    command="${command#"$prefix"}"
  fi
  if [[ "$command" == env\ -u\ NO_COLOR\ CLICOLOR=1\ CLICOLOR_FORCE=1\ FORCE_COLOR=* ]]; then
    command="${command#env -u NO_COLOR CLICOLOR=1 CLICOLOR_FORCE=1 FORCE_COLOR=}"
    command="${command#* COLORTERM=truecolor }"
  fi
  if [[ "$command" == "zsh" || "$command" == "-" ]]; then
    command=""
  fi

  printf '%s\n' "$command"
}

apply_recovery_theme() {
  local ready
  ready="$(agent_ready_format)"

  ensure_tmux_rgb_terminfo

  "$TMUX_BIN" set -g base-index 1
  "$TMUX_BIN" set -g pane-base-index 1
  "$TMUX_BIN" set -g default-terminal "tmux-256color"
  "$TMUX_BIN" set -g terminal-features "xterm*:clipboard:ccolour:cstyle:extkeys:focus:title,screen*:title,rxvt*:ignorefkeys,xterm-256color:RGB:hyperlinks,tmux-256color:RGB:hyperlinks"
  "$TMUX_BIN" set -ga terminal-overrides ",*:Tc"
  "$TMUX_BIN" set -g allow-passthrough on
  "$TMUX_BIN" set -g set-clipboard on
  "$TMUX_BIN" set -g extended-keys on
  "$TMUX_BIN" set -g extended-keys-format csi-u
  "$TMUX_BIN" set-environment -gu NO_COLOR 2>/dev/null || true
  "$TMUX_BIN" set-environment -g CLICOLOR 1
  "$TMUX_BIN" set-environment -g CLICOLOR_FORCE 1
  "$TMUX_BIN" set-environment -gu FORCE_COLOR 2>/dev/null || true
  "$TMUX_BIN" set-environment -g COLORTERM truecolor
  "$TMUX_BIN" set-environment -gu TERMINFO 2>/dev/null || true
  "$TMUX_BIN" set-environment -g TERMINFO_DIRS "$HOME/.terminfo:/usr/share/terminfo"
  "$TMUX_BIN" set-environment -g TERM_PROGRAM "${TERM_PROGRAM:-ghostty}"
  "$TMUX_BIN" set-environment -g ITERM2_DISABLE_SHELL_INTEGRATION 1
  "$TMUX_BIN" set-environment -g ITERM_DISABLE_PROMPT_MARK 1
  "$TMUX_BIN" set -g mouse on
  "$TMUX_BIN" set -g history-limit 50000
  "$TMUX_BIN" set -g status on
  "$TMUX_BIN" set -g status-position top
  "$TMUX_BIN" set -g status-left-length 32
  "$TMUX_BIN" set -g status-style "fg=#565f89,bg=#1a1b26,none"
  "$TMUX_BIN" set -g window-style "fg=default,bg=#1a1b26"
  "$TMUX_BIN" set -g window-active-style "fg=default,bg=#1a1b26"
  "$TMUX_BIN" set -g window-status-style "fg=#565f89,bg=#1a1b26,none"
  "$TMUX_BIN" set -g window-status-current-style "fg=#1a1b26,bg=#7aa2f7,bold"
  "$TMUX_BIN" set -g message-style "fg=#1a1b26,bg=#7aa2f7,bold"
  "$TMUX_BIN" set -g mode-style "fg=#1a1b26,bg=#7aa2f7,bold"
  "$TMUX_BIN" set -g pane-border-style "fg=#{?$ready,#ff9e64,#292e42},bg=default"
  "$TMUX_BIN" set -g pane-active-border-style "fg=#{?$ready,#ff9e64,#7aa2f7},bg=default"
  "$TMUX_BIN" set -g status-left "#[fg=#15161e,bg=#ff9e64,bold] ❐ #S #[fg=#ff9e64,bg=#1a1b26,none] "
  "$TMUX_BIN" set -g status-right "#[fg=#565f89,bg=#1a1b26]#{?client_prefix,⌨ ,  }#{?mouse,↗ ,  }#{?session_many_attached,⚇ ,}#{?pane_synchronized,⚏ ,}#[fg=#9ece6a,bg=#1a1b26,none]#[fg=#1a1b26,bg=#9ece6a,bold] CX SAVE #[fg=#f7768e,bg=#9ece6a,none]#[fg=#c0caf5,bg=#f7768e,bold] %R %d %b vincentkoc@#h "
  set_agent_window_status_formats
  "$TMUX_BIN" set -g pane-border-status off
  "$TMUX_BIN" set -g prefix C-b
  "$TMUX_BIN" set -g prefix2 C-a
  "$TMUX_BIN" bind-key C-a send-prefix -2
  "$TMUX_BIN" bind-key s choose-tree -Zs
  "$TMUX_BIN" bind-key R send-keys -l "printf '\\033[?1000l\\033[?1002l\\033[?1003l\\033[?1006l\\033[?1015l\\033[?2004l'; stty sane; reset" \; send-keys Enter
  "$TMUX_BIN" refresh-client -S 2>/dev/null || true
}

ensure_tmux_rgb_terminfo() {
  local tmp

  if TERMINFO="$HOME/.terminfo" infocmp -x tmux-256color 2>/dev/null | grep -q 'setrgbf='; then
    return 0
  fi
  command -v infocmp >/dev/null 2>&1 || return 0
  command -v tic >/dev/null 2>&1 || return 0

  mkdir -p "$HOME/.terminfo"
  tmp="$(mktemp "${TMPDIR:-/tmp}/tmux-256color-rgb.XXXXXX")"
  if ! TERMINFO= infocmp -x tmux-256color >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    return 0
  fi

  {
    printf '\tRGB,\n'
    printf '\tTc,\n'
    printf '\tsetrgbf=\\E[38;2;%%p1%%d;%%p2%%d;%%p3%%dm,\n'
    printf '\tsetrgbb=\\E[48;2;%%p1%%d;%%p2%%d;%%p3%%dm,\n'
  } >>"$tmp"
  tic -x -o "$HOME/.terminfo" "$tmp" >/dev/null 2>&1 || true
  rm -f "$tmp"
}

apply_studio_pane_titles() {
  local target="${1:-}"
  local agent_label
  local pane_commands pane_count
  agent_label="$(agent_label_format)"

  if [[ -z "$target" ]]; then
    while IFS= read -r target; do
      [[ -n "$target" ]] || continue
      apply_studio_pane_titles "$target"
    done < <("$TMUX_BIN" list-windows -a -F '#{window_id}' 2>/dev/null || true)
    return 0
  fi

  pane_commands="$("$TMUX_BIN" list-panes -t "$target" -F '#{pane_current_command}' 2>/dev/null || true)"
  pane_count="$(printf '%s\n' "$pane_commands" | awk 'NF {n++} END {print n+0}')"
  if [[ "$pane_count" == "1" ]] && printf '%s\n' "$pane_commands" | grep -Eq '^(mosh-client|ssh)$'; then
    "$TMUX_BIN" set-window-option -t "$target" -q pane-border-status off
    return 0
  fi

  "$TMUX_BIN" set-window-option -t "$target" -q pane-border-status top
  "$TMUX_BIN" set-window-option -t "$target" -q pane-border-format " #{pane_index} #{?@tt_note,#[fg=#e0af68]● #[default],}#[fg=#{?#{==:#{@tt_agent_kind},CLAUDE},#bb9af7,#{?#{==:#{@tt_agent_kind},CODEX},#7dcfff,#9ece6a}},bold]$agent_label#[default] #{?@tt_base_title,#{@tt_base_title},#{pane_title}} "
  "$TMUX_BIN" set-window-option -t "$target" -q pane-border-style "fg=#292e42,bg=default"
  "$TMUX_BIN" set-window-option -t "$target" -q pane-active-border-style "fg=#7aa2f7,bg=default"
}

clear_studio_pane_titles() {
  local target="${1:-}"

  if [[ -z "$target" ]]; then
    while IFS= read -r target; do
      [[ -n "$target" ]] || continue
      clear_studio_pane_titles "$target"
    done < <("$TMUX_BIN" list-windows -a -F '#{window_id}' 2>/dev/null || true)
    return 0
  fi

  "$TMUX_BIN" set-window-option -t "$target" -q pane-border-status off
}

set_agent_pane_title() {
  local target="${1:-}"
  shift || true
  local title="$*" path

  if [[ -z "$title" ]]; then
    title="$target"
    target="${TMUX_PANE:-}"
  fi
  [[ -n "$target" && -n "$title" ]] || { echo "usage: tt title [target] <short title>" >&2; exit 2; }

  "$TMUX_BIN" set-option -pt "$target" @tt_base_title "$title" 2>/dev/null || true
  path="$("$TMUX_BIN" display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null || true)"
  set_pane_git_label "$target" "$path"
  "$TMUX_BIN" select-pane -t "$target" -T "$title" 2>/dev/null || true
  write_agent_cockpit_state "$(agent_cockpit_state_file)" --quiet
}

sync_agent_pane_context() {
  local target="${1:-${TMUX_PANE:-}}"
  local path

  [[ -n "$target" ]] || { echo "usage: tt sync [target|all]" >&2; exit 2; }

  if [[ "$target" == "all" ]]; then
    while IFS= read -r target; do
      [[ -n "$target" ]] || continue
      sync_agent_pane_context "$target"
    done < <("$TMUX_BIN" list-panes -a -F '#{pane_id}' 2>/dev/null || true)
    return 0
  fi

  path="$("$TMUX_BIN" display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null || true)"
  set_pane_git_label "$target" "$path"
}

confirm_action() {
  local prompt="$1"
  local answer

  printf '%s [y/N]: ' "$prompt" >&2
  read -r answer
  case "$answer" in
    y|Y|yes|YES)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

kill_server() {
  local force="${1:-}"

  if [[ "$force" != "force" ]]; then
    confirm_action "kill tmux server and all sessions?" || exit 1
  fi

  "$TMUX_BIN" kill-server 2>/dev/null || true
}

create_plain() {
  local session="$1"

  wsl_bridge_ensure_for_entry
  ensure_tmux_default_shell

  if "$TMUX_BIN" has-session -t "$session" 2>/dev/null; then
    attach_or_switch "$session"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    "$TMUX_BIN" new-session -d -s "$session"
    set_profile_metadata "$session" plain
    wsl_bridge_ensure_for_entry
    exec "$TMUX_BIN" switch-client -t "$session"
  fi

  "$TMUX_BIN" new-session -d -s "$session"
  set_profile_metadata "$session" plain
  wsl_bridge_ensure_for_entry
  exec "$TMUX_BIN" attach -t "$session"
}

first_window_id() {
  local session="$1"

  "$TMUX_BIN" list-windows -t "$session" -F '#{window_id}' 2>/dev/null | head -n 1
}

build_studio_layout() {
  local target="$1"
  local pane_command="${2:-}"
  local pane1 pane2 pane3

  if [[ -n "$pane_command" ]]; then
    pane1="$("$TMUX_BIN" list-panes -t "$target" -F '#{pane_id}' | head -n 1)"
    pane2="$("$TMUX_BIN" split-window -d -h -P -F '#{pane_id}' -t "$pane1" "$pane_command")"
    pane3="$("$TMUX_BIN" split-window -d -h -P -F '#{pane_id}' -t "$pane2" "$pane_command")"
    "$TMUX_BIN" select-layout -t "$target" even-horizontal
    "$TMUX_BIN" split-window -d -v -t "$pane1" "$pane_command"
    "$TMUX_BIN" split-window -d -v -t "$pane2" "$pane_command"
    "$TMUX_BIN" split-window -d -v -t "$pane3" "$pane_command"
    return
  else
    "$TMUX_BIN" split-window -h -t "$target"
    "$TMUX_BIN" split-window -h -t "$target"
  fi
  "$TMUX_BIN" select-layout -t "$target" even-horizontal

  while IFS= read -r pane; do
    if [[ -n "$pane_command" ]]; then
      "$TMUX_BIN" split-window -d -v -t "$pane" "$pane_command"
    else
      "$TMUX_BIN" split-window -v -t "$pane"
    fi
  done < <("$TMUX_BIN" list-panes -t "$target" -F '#{pane_id}')
}

label_grid_window() {
  local target="$1"
  local label="$2"
  local pane index
  local -a commands

  apply_studio_pane_titles "$target"

  index=1
  while IFS= read -r pane; do
    [[ -n "$pane" ]] || continue
    commands+=(select-pane -t "$pane" -T "$label.$index" \;)
    index=$((index + 1))
  done < <("$TMUX_BIN" list-panes -t "$target" -F '#{pane_id}')

  if (( ${#commands[@]} )); then
    "$TMUX_BIN" "${commands[@]}" 2>/dev/null || true
  fi
}

cockpit_window_names() {
  printf '%s\n' ops L1 L2 L3 L4
}

cockpit_topology_label() {
  cockpit_window_names | paste -sd/ -
}

is_cockpit_window_name() {
  local candidate="$1"
  local expected

  while IFS= read -r expected; do
    [[ "$candidate" == "$expected" ]] && return 0
  done < <(cockpit_window_names)
  return 1
}

refresh_ops_labels() {
  local session="$1"
  local window_id window_name

  while IFS=$'\t' read -r window_id window_name; do
    [[ -n "$window_id" && -n "$window_name" ]] || continue
    if is_cockpit_window_name "$window_name"; then
      label_grid_window "$window_id" "$window_name"
    fi
  done < <("$TMUX_BIN" list-windows -t "$session" -F '#{window_id}	#W' 2>/dev/null)
}

upgrade_ops_shells() {
  local session="$1"
  local current_command cwd pane shell_command window_id

  ensure_tmux_default_shell
  shell_command="$(default_login_shell_command)"

  while IFS= read -r window_id; do
    [[ -n "$window_id" ]] || continue
    while IFS=$'\t' read -r pane current_command cwd; do
      [[ -n "$pane" ]] || continue
      case "$current_command" in
        zsh|bash|fish|sh)
          "$TMUX_BIN" respawn-pane -k -t "$pane" -c "$cwd" "$shell_command" 2>/dev/null || true
          ;;
      esac
    done < <("$TMUX_BIN" list-panes -t "$window_id" -F '#{pane_id}	#{pane_current_command}	#{pane_current_path}')
  done < <("$TMUX_BIN" list-windows -t "$session" -F '#{window_id}')
}

schedule_ops_shell_upgrade() {
  local session="$1"
  local self

  self="$(tt_self_command)"
  "$TMUX_BIN" run-shell -b "$self upgrade-ops-shells $(shell_quote "$session")" 2>/dev/null || true
}

ops_session_valid() {
  local session="$1"
  local expected_names expected_count window_count bad_count window_id window_name

  expected_names="$(cockpit_window_names | paste -sd' ' -)"
  expected_count="$(cockpit_window_names | wc -l | tr -d ' ')"
  window_count="$("$TMUX_BIN" list-windows -t "$session" -F '#W' 2>/dev/null | wc -l | tr -d ' ')"
  [[ "$window_count" == "$expected_count" ]] || return 1

  bad_count="$("$TMUX_BIN" list-windows -t "$session" -F '#W #{window_panes}' 2>/dev/null | awk -v expected="$expected_names" '
    BEGIN {
      count = split(expected, names, " ")
      for (i = 1; i <= count; i++) allowed[names[i]] = 1
    }
    !($1 in allowed) || $2 != 6 { bad++ }
    { seen[$1]++ }
    END {
      for (name in allowed) {
        if (seen[name] != 1) bad++
      }
      print bad + 0
    }')"
  [[ "$bad_count" == "0" ]] || return 1

  while IFS=$'\t' read -r window_id window_name; do
    [[ -n "$window_id" && -n "$window_name" ]] || return 1
    "$TMUX_BIN" list-panes -t "$window_id" -F '#{pane_left} #{pane_top}' 2>/dev/null | awk '
      { count++; left[$1]=1; top[$2]=1 }
      END {
        for (x in left) left_count++
        for (y in top) top_count++
        exit !(count == 6 && left_count == 3 && top_count == 2)
      }' || return 1
  done < <("$TMUX_BIN" list-windows -t "$session" -F '#{window_id}	#W' 2>/dev/null)
}

ops_session_idle() {
  local session="$1"

  "$TMUX_BIN" list-panes -t "$session" -F '#{pane_current_command}' 2>/dev/null |
    awk 'BEGIN { ok=1 } $0 !~ /^(zsh|bash|fish|sh)$/ { ok=0 } END { exit ok ? 0 : 1 }'
}

create_ops() {
  local session="${1:-cockpit}"
  local start_dir="${2:-$PWD}"

  wsl_bridge_ensure_for_entry
  create_ops_detached "$session" "$start_dir"
  attach_or_switch "$session"
}

create_ops_detached() {
  local session="${1:-cockpit}"
  local start_dir="${2:-$PWD}"
  local skip_shell_upgrade="${3:-}"
  local preserve_server="${4:-}"
  local recovery_session="${5:-}"
  local window window_id bootstrap_command width height

  case "$session" in
    ""|--)
      session="cockpit"
      ;;
    -*)
      echo "tt: invalid ops session name '$session'" >&2
      exit 2
      ;;
  esac

  if [[ "$preserve_server" != "--preserve-server" ]]; then
    ensure_tmux_default_shell
  fi
  bootstrap_command="$(default_login_shell_command)"
  width="${TT_OPS_WIDTH:-240}"
  height="${TT_OPS_HEIGHT:-80}"

  if [[ "$session" == "cockpit" ]] &&
    "$TMUX_BIN" has-session -t ops 2>/dev/null &&
    ! "$TMUX_BIN" has-session -t cockpit 2>/dev/null; then
    if ops_session_idle ops; then
      "$TMUX_BIN" kill-session -t ops 2>/dev/null || true
    else
      echo "tt: old session 'ops' is active; not replacing it with 'cockpit'" >&2
      echo "tt: finish or rename that session, then run 'tt cockpit' again" >&2
      exit 2
    fi
  fi

  if "$TMUX_BIN" has-session -t "$session" 2>/dev/null; then
    if ops_session_valid "$session"; then
      refresh_ops_labels "$session"
      schedule_ops_shell_upgrade "$session"
      attach_or_switch "$session"
    fi
    if ops_session_idle "$session"; then
      "$TMUX_BIN" kill-session -t "$session" 2>/dev/null || true
    else
      echo "tt: session '$session' has a non-ops layout and active commands; not rebuilding it" >&2
      echo "tt: kill or rename that session, then run 'tt ops' again" >&2
      exit 2
    fi
  fi

  if "$TMUX_BIN" has-session -t "$session" 2>/dev/null; then
    attach_or_switch "$session"
  fi

  window_id="$("$TMUX_BIN" new-session -d -x "$width" -y "$height" -P -F '#{window_id}' -s "$session" -n ops -c "$start_dir" "$bootstrap_command")"
  if [[ "$recovery_session" == "--recovery-session" ]]; then
    set_recovery_session_indices "$session" "$window_id"
  fi
  set_profile_metadata "$session" ops
  build_studio_layout "$window_id" "$bootstrap_command"
  label_grid_window "$window_id" ops

  while IFS= read -r window; do
    [[ "$window" == "ops" ]] && continue
    "$TMUX_BIN" new-window -d -t "$session:" -n "$window" -c "$start_dir" "$bootstrap_command"
    window_id="$session:$window"
    build_studio_layout "$window_id" "$bootstrap_command"
    label_grid_window "$window_id" "$window"
  done < <(cockpit_window_names)

  if [[ "$skip_shell_upgrade" != "--no-shell-upgrade" ]]; then
    schedule_ops_shell_upgrade "$session"
  fi
  "$TMUX_BIN" select-window -t "$window_id"
}

ensure_studio_layout() {
  local session="$1"
  local start_dir="${2:-}"
  local preserve_server="${3:-}"
  local recovery_session="${4:-}"
  local window_id pane_count shell_command

  if [[ "$preserve_server" != "--preserve-server" ]]; then
    ensure_tmux_default_shell
  fi
  shell_command="$(default_login_shell_command)"

  if ! "$TMUX_BIN" has-session -t "$session" 2>/dev/null; then
    if [[ -n "$start_dir" ]]; then
      window_id="$("$TMUX_BIN" new-session -d -P -F '#{window_id}' -s "$session" -n main -c "$start_dir" "$shell_command")"
    else
      window_id="$("$TMUX_BIN" new-session -d -P -F '#{window_id}' -s "$session" -n main "$shell_command")"
    fi
    if [[ "$recovery_session" == "--recovery-session" ]]; then
      set_recovery_session_indices "$session" "$window_id"
    fi
  fi

  set_profile_metadata "$session" studio

  window_id="$(first_window_id "$session")"
  [[ -n "$window_id" ]] || return 1
  pane_count="$("$TMUX_BIN" list-panes -t "$window_id" 2>/dev/null | wc -l | tr -d ' ')"

  case "$pane_count" in
    1)
      build_studio_layout "$window_id" "$shell_command"
      apply_studio_pane_titles "$window_id"
      ;;
    6)
      apply_studio_pane_titles "$window_id"
      ;;
    *)
      echo "tt: session '$session' has $pane_count panes; refusing to reshape non-empty layout" >&2
      echo "tt: use 'tt reset ai $session' if you want to replace it" >&2
      ;;
  esac
}

create_studio() {
  local session="$1"

  wsl_bridge_ensure_for_entry
  ensure_studio_layout "$session"
  install_agent_autosave_hooks
  write_agent_cockpit_state "$(agent_cockpit_state_file)" --quiet

  attach_or_switch "$session"
}

create_studio_detached() {
  local session="$1"
  local start_dir="${2:-$HOME}"
  local skip_autosave="${3:-}"
  local preserve_server="${4:-}"
  local recovery_session="${5:-}"

  ensure_studio_layout "$session" "$start_dir" "$preserve_server" "$recovery_session"
  if [[ "$skip_autosave" != "--no-autosave" ]]; then
    install_agent_autosave_hooks
  fi
}

create_mobile() {
  local session="$1"

  wsl_bridge_ensure_for_entry
  if "$TMUX_BIN" has-session -t "$session" 2>/dev/null; then
    attach_or_switch "$session"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    "$TMUX_BIN" new-session -d -s "$session"
    set_profile_metadata "$session" mobile
    "$TMUX_BIN" set-option -t "$session" -q status off
    wsl_bridge_ensure_for_entry
    exec "$TMUX_BIN" switch-client -t "$session"
  fi

  "$TMUX_BIN" new -d -s "$session"
  set_profile_metadata "$session" mobile
  "$TMUX_BIN" set-option -t "$session" -q status off
  wsl_bridge_ensure_for_entry
  exec "$TMUX_BIN" attach -t "$session"
}

mobile_target_label() {
  local target="$1"
  local session="$2"
  local window="$3"
  local pane="$4"
  local active="$5"
  local command="$6"
  local title="$7"
  local path="$8"
  local window_name="$9"
  local active_mark detail_label path_label

  active_mark=" "
  [[ "$active" == "*" ]] && active_mark="*"

  detail_label="$title"
  if [[ -z "$detail_label" || "$detail_label" == "$path" ]]; then
    detail_label="$window_name"
  fi
  if [[ -z "$detail_label" ]]; then
    detail_label="$command"
  fi

  path_label="${path/#$HOME/~}"
  if [[ "$path_label" == "$HOME" || "$path_label" == "~" ]]; then
    path_label="~"
  elif [[ "$path_label" == ~/*/*/* ]]; then
    path_label=".../${path_label##*/}"
  fi

  printf '%s\x1f%s [%s] %s.%s  %s  %s\n' \
    "$target" \
    "$active_mark" \
    "$session" \
    "$window" \
    "$pane" \
    "$detail_label" \
    "$path_label"
}

choose_mobile_option() {
  local selection sep
  local -a options=()
  sep=$'\x1f'

  options=("$@")

  if command -v fzf >/dev/null 2>&1; then
    selection="$(printf '%s\n' "${options[@]}" | fzf \
      --prompt='mtt > ' \
      --height=55% \
      --layout=reverse \
      --border \
      --delimiter="$sep" \
      --with-nth=2 \
      --header='pick a pane')"
    [[ -n "$selection" ]] || return 130
    printf '%s\n' "$selection"
    return 0
  fi

  local choice
  local -a labels=()
  for choice in "${options[@]}"; do
    labels+=("${choice#*"$sep"}")
  done

  PS3="mtt> "
  select choice in "${labels[@]}"; do
    [[ -n "${choice:-}" ]] || continue
    printf '%s\n' "${options[REPLY-1]}"
    return 0
  done
}

mobile_choose_pane_target() {
  local selection sep pane_format
  local -a options=()
  sep=$'\x1f'
  pane_format="#{session_name}${sep}#{@tt_profile}${sep}#{window_index}${sep}#{pane_index}${sep}#{?pane_active,*, }${sep}#{pane_current_command}${sep}#{pane_title}${sep}#{pane_current_path}${sep}#{window_name}"

  while IFS="$sep" read -r session profile window pane active command title path window_name; do
    [[ -n "$session" ]] || continue
    [[ "$profile" == "mobile" ]] && continue
    options+=("$(mobile_target_label "$session:$window.$pane" "$session" "$window" "$pane" "$active" "$command" "$title" "$path" "$window_name")")
  done < <("$TMUX_BIN" list-panes -a -F "$pane_format" 2>/dev/null || true)

  if [[ ${#options[@]} -eq 0 ]]; then
    return 1
  fi

  if ! selection="$(choose_mobile_option "${options[@]}")"; then
    return 130
  fi

  printf '%s\n' "${selection%%"$sep"*}"
}

ensure_mobile_group_session() {
  local source_session="$1"
  local mobile_session

  mobile_session="$(mobile_group_session_name "$source_session")"
  if ! "$TMUX_BIN" has-session -t "$mobile_session" 2>/dev/null; then
    "$TMUX_BIN" new-session -d -t "$source_session" -s "$mobile_session"
  fi

  set_profile_metadata "$mobile_session" mobile
  "$TMUX_BIN" set-option -t "$mobile_session" -q status off
  printf '%s\n' "$mobile_session"
}

attach_mobile_target() {
  local target="$1"
  local source_session target_suffix

  wsl_bridge_ensure_for_entry
  source_session="${target%%:*}"
  target_suffix="${target#*:}"

  if [[ -n "${TMUX:-}" ]]; then
    "$TMUX_BIN" refresh-client -f active-pane,ignore-size 2>/dev/null || true
    "$TMUX_BIN" switch-client -t "$source_session"
    "$TMUX_BIN" select-window -t "$source_session:${target_suffix%.*}"
    exec "$TMUX_BIN" select-pane -t "$source_session:$target_suffix"
  fi

  exec "$TMUX_BIN" attach -f active-pane,ignore-size -t "$source_session" \; \
    select-window -t "$source_session:${target_suffix%.*}" \; \
    select-pane -t "$source_session:$target_suffix"
}

restore_windows() {
  local target="${1:-}"
  local window_id
  local -a target_args=()

  [[ -n "$target" ]] && target_args=(-t "$target")

  while IFS= read -r window_id; do
    [[ -n "$window_id" ]] || continue
    "$TMUX_BIN" resize-pane -Z -t "$window_id"
  done < <("$TMUX_BIN" list-windows "${target_args[@]}" -F '#{?window_zoomed_flag,#{window_id},}' 2>/dev/null | sort -u || true)
}

restore_studio_layout() {
  local target="${1:-}"
  local mode="${2:-}"
  local manifest
  local window_id pane_count
  local -a target_args=()

  [[ -n "$target" ]] && target_args=(-t "$target")

  if [[ "$mode" != "--preserve-server" ]]; then
    manifest="$(agent_cockpit_manifest)"
    apply_agent_manifest_metadata "$manifest"
  fi
  restore_windows "$target"

  while IFS= read -r window_id; do
    [[ -n "$window_id" ]] || continue
    pane_count="$("$TMUX_BIN" list-panes -t "$window_id" 2>/dev/null | wc -l | tr -d ' ')"
    if [[ "$pane_count" == "6" ]]; then
      apply_studio_pane_titles "$window_id"
    fi
  done < <("$TMUX_BIN" list-windows "${target_args[@]}" -F '#{window_id}' 2>/dev/null | sort -u || true)

  if [[ "$mode" != "--preserve-server" ]]; then
    install_agent_autosave_hooks
    write_agent_cockpit_state "$(agent_cockpit_state_file)" --quiet
  fi
}

agent_cockpit_manifest() {
  local home_manifest="${XDG_CONFIG_HOME:-$HOME/.config}/tt/agent-cockpit.tsv"
  local dotfiles_manifest="$DOTFILES_DIR/.config/tt/agent-cockpit.tsv"
  local state_manifest
  state_manifest="$(agent_cockpit_state_file)"

  if [[ -n "${TT_AGENT_COCKPIT_MANIFEST:-}" ]]; then
    printf '%s\n' "$TT_AGENT_COCKPIT_MANIFEST"
  elif manifest_has_entries "$state_manifest"; then
    printf '%s\n' "$state_manifest"
  elif manifest_has_entries "$home_manifest"; then
    printf '%s\n' "$home_manifest"
  else
    printf '%s\n' "$dotfiles_manifest"
  fi
}

agent_cockpit_seed_manifest() {
  local home_manifest="${XDG_CONFIG_HOME:-$HOME/.config}/tt/agent-cockpit.tsv"
  local dotfiles_manifest="$DOTFILES_DIR/.config/tt/agent-cockpit.tsv"

  if [[ -n "${TT_AGENT_COCKPIT_MANIFEST:-}" && -f "$TT_AGENT_COCKPIT_MANIFEST" ]]; then
    printf '%s\n' "$TT_AGENT_COCKPIT_MANIFEST"
  elif manifest_has_entries "$home_manifest"; then
    printf '%s\n' "$home_manifest"
  else
    printf '%s\n' "$dotfiles_manifest"
  fi
}

manifest_has_entries() {
  local manifest="$1"

  [[ -f "$manifest" ]] || return 1
  awk -F '\t' '$1 != "" && $1 !~ /^#/ { found=1 } END { exit found ? 0 : 1 }' "$manifest"
}

agent_cockpit_state_file() {
  local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  printf '%s\n' "$state_home/tt/agent-cockpit.tsv"
}

codex_cockpit_snapshot_file() {
  local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  printf '%s\n' "$state_home/tt/codex-cockpit.tsv"
}

codex_cockpit_timer_pid_file() {
  local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  printf '%s\n' "$state_home/tt/codex-cockpit.timer.pid"
}

codex_cockpit_timer_lock_dir() {
  printf '%s.control.lock\n' "$(codex_cockpit_timer_pid_file)"
}

codex_cockpit_timer_log_file() {
  local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  printf '%s\n' "$state_home/tt/codex-cockpit.timer.log"
}

pane_notes_dir() {
  local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  printf '%s\n' "$state_home/tt/pane-notes"
}

pane_markers_dir() {
  local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  printf '%s\n' "$state_home/tt/pane-markers"
}

sanitize_filename_component() {
  tr -cs 'A-Za-z0-9._-' '-' | sed 's/^-//; s/-$//; s/--*/-/g'
}

pane_note_metadata() {
  local target="${1:-${TMUX_PANE:-}}"
  local session window pane cwd base_title pane_title title key hash slug dir file

  [[ -n "$target" ]] || { echo "pane target required" >&2; return 2; }
  IFS=$'\t' read -r session window pane cwd base_title pane_title < <(
    "$TMUX_BIN" display-message -p -t "$target" '#{session_name}	#{window_index}	#{pane_index}	#{pane_current_path}	#{@tt_base_title}	#{pane_title}' 2>/dev/null || true
  )
  [[ -n "$session" && -n "$window" && -n "$pane" ]] || { echo "pane not found: $target" >&2; return 1; }

  title="${base_title:-$pane_title}"
  title="${title//$'\t'/ }"
  title="${title//$'\n'/ }"
  cwd="${cwd//$'\t'/ }"
  cwd="${cwd//$'\n'/ }"
  key="${session}"$'\t'"${window}"$'\t'"${pane}"
  hash="$(printf '%s' "$key" | shasum -a 256 | awk '{print substr($1, 1, 16)}')"
  slug="$(printf '%s-w%s-p%s' "$session" "$window" "$pane" | sanitize_filename_component | cut -c 1-80)"
  [[ -n "$slug" ]] || slug="pane"
  dir="$(pane_notes_dir)"
  file="$dir/$slug-$hash.md"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$session" "$window" "$pane" "$cwd" "$title" "$hash" "$file"
}

pane_marker_metadata() {
  local target="${1:-${TMUX_PANE:-}}"
  local session window pane cwd title hash note_file slug dir file
  IFS=$'\t' read -r session window pane cwd title hash note_file < <(pane_note_metadata "$target")
  [[ -n "${hash:-}" ]] || return 1
  slug="$(printf '%s-w%s-p%s' "$session" "$window" "$pane" | sanitize_filename_component | cut -c 1-80)"
  [[ -n "$slug" ]] || slug="pane"
  dir="$(pane_markers_dir)"
  file="$dir/$slug-$hash.md"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$session" "$window" "$pane" "$cwd" "$title" "$hash" "$file"
}

pane_note_frontmatter_matches() {
  local file="$1" session="$2" window="$3" pane="$4"
  [[ -f "$file" ]] || return 1
  grep -qx "session: \"$session\"" "$file" 2>/dev/null &&
    grep -qx "window: \"$window\"" "$file" 2>/dev/null &&
    grep -qx "pane: \"$pane\"" "$file" 2>/dev/null
}

resolve_pane_note_file() {
  local target="$1" expected="$2" session="$3" window="$4" pane="$5"
  local current dir candidate

  [[ -n "$expected" ]] || return 1
  if [[ -f "$expected" ]]; then
    printf '%s\n' "$expected"
    return 0
  fi

  current="$("$TMUX_BIN" show-option -pt "$target" -qv @tt_note_file 2>/dev/null || true)"
  if [[ -n "$current" && -f "$current" && "$current" != "$expected" ]]; then
    mkdir -p "$(dirname "$expected")"
    mv "$current" "$expected" 2>/dev/null || cp "$current" "$expected"
    printf '%s\n' "$expected"
    return 0
  fi

  dir="$(pane_notes_dir)"
  if [[ -d "$dir" ]]; then
    while IFS= read -r candidate; do
      [[ -n "$candidate" && "$candidate" != "$expected" ]] || continue
      if pane_note_frontmatter_matches "$candidate" "$session" "$window" "$pane"; then
        mkdir -p "$(dirname "$expected")"
        mv "$candidate" "$expected" 2>/dev/null || cp "$candidate" "$expected"
        printf '%s\n' "$expected"
        return 0
      fi
    done < <(find "$dir" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort)
  fi

  printf '%s\n' "$expected"
}

resolve_pane_marker_file() {
  local target="$1" expected="$2" session="$3" window="$4" pane="$5"
  local current dir candidate

  [[ -n "$expected" ]] || return 1
  if [[ -f "$expected" ]]; then
    printf '%s\n' "$expected"
    return 0
  fi

  current="$("$TMUX_BIN" show-option -pt "$target" -qv @tt_marker_file 2>/dev/null || true)"
  if [[ -n "$current" && -f "$current" && "$current" != "$expected" ]]; then
    mkdir -p "$(dirname "$expected")"
    mv "$current" "$expected" 2>/dev/null || cp "$current" "$expected"
    printf '%s\n' "$expected"
    return 0
  fi

  dir="$(pane_markers_dir)"
  if [[ -d "$dir" ]]; then
    while IFS= read -r candidate; do
      [[ -n "$candidate" && "$candidate" != "$expected" ]] || continue
      if pane_note_frontmatter_matches "$candidate" "$session" "$window" "$pane"; then
        mkdir -p "$(dirname "$expected")"
        mv "$candidate" "$expected" 2>/dev/null || cp "$candidate" "$expected"
        printf '%s\n' "$expected"
        return 0
      fi
    done < <(find "$dir" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort)
  fi

  printf '%s\n' "$expected"
}

write_pane_note_file() {
  local file="$1" session="$2" window="$3" pane="$4" cwd="$5" title="$6" hash="$7" body="${8:-}"
  local updated
  updated="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$(dirname "$file")"
  {
    printf -- '---\n'
    printf 'session: "%s"\n' "$session"
    printf 'window: "%s"\n' "$window"
    printf 'pane: "%s"\n' "$pane"
    printf 'cwd: "%s"\n' "$cwd"
    printf 'title: "%s"\n' "$title"
    printf 'key_hash: "%s"\n' "$hash"
    printf 'updated: "%s"\n' "$updated"
    printf -- '---\n\n'
    if [[ -n "$body" ]]; then
      printf '%s\n' "$body"
    fi
  } > "$file"
}

pane_marker_color() {
  case "${1:-}" in
    amber) printf '#e0af68\n' ;;
    green) printf '#9ece6a\n' ;;
    blue) printf '#7aa2f7\n' ;;
    dim) printf '#565f89\n' ;;
    *) printf '#565f89\n' ;;
  esac
}

pane_marker_window_style() {
  case "${1:-}" in
    amber) printf 'fg=default,bg=#211d17\n' ;;
    green) printf 'fg=default,bg=#182318\n' ;;
    blue) printf 'fg=default,bg=#171f2b\n' ;;
    dim) printf 'fg=#565f89,bg=#11121a\n' ;;
    *) printf '\n' ;;
  esac
}

pane_marker_active_style() {
  case "${1:-}" in
    amber) printf 'fg=default,bg=#292218\n' ;;
    green) printf 'fg=default,bg=#1f2a1f\n' ;;
    blue) printf 'fg=default,bg=#1d2736\n' ;;
    dim) printf 'fg=#565f89,bg=#11121a\n' ;;
    *) printf '\n' ;;
  esac
}

apply_pane_marker_style() {
  local target="${1:-${TMUX_PANE:-}}"
  local marker="${2:-default}"
  local color style active_style

  case "$marker" in
    default|clear|none|'')
      "$TMUX_BIN" set-option -pt "$target" -qu @tt_marker 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" -qu @tt_marker_color 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" -qu @tt_marker_file 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" -qu window-style 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" -qu window-active-style 2>/dev/null || true
      return 0
      ;;
    amber|green|blue|dim)
      ;;
    *)
      echo "unknown pane marker: $marker" >&2
      return 2
      ;;
  esac

  color="$(pane_marker_color "$marker")"
  style="$(pane_marker_window_style "$marker")"
  active_style="$(pane_marker_active_style "$marker")"
  "$TMUX_BIN" set-option -pt "$target" @tt_marker "$marker" 2>/dev/null || true
  "$TMUX_BIN" set-option -pt "$target" @tt_marker_color "$color" 2>/dev/null || true
  "$TMUX_BIN" set-option -pt "$target" window-style "$style" 2>/dev/null || true
  "$TMUX_BIN" set-option -pt "$target" window-active-style "$active_style" 2>/dev/null || true
}

write_pane_marker_file() {
  local file="$1" session="$2" window="$3" pane="$4" cwd="$5" title="$6" hash="$7" marker="$8"
  local updated color
  updated="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  color="$(pane_marker_color "$marker")"
  mkdir -p "$(dirname "$file")"
  {
    printf -- '---\n'
    printf 'session: "%s"\n' "$session"
    printf 'window: "%s"\n' "$window"
    printf 'pane: "%s"\n' "$pane"
    printf 'cwd: "%s"\n' "$cwd"
    printf 'title: "%s"\n' "$title"
    printf 'key_hash: "%s"\n' "$hash"
    printf 'marker: "%s"\n' "$marker"
    printf 'color: "%s"\n' "$color"
    printf 'updated: "%s"\n' "$updated"
    printf -- '---\n\n'
    printf '%s\n' "$marker"
  } > "$file"
}

pane_marker_from_file() {
  local file="$1"
  awk -F '"' '/^marker: "/ { print $2; exit }' "$file"
}

set_pane_marker() {
  local target="${1:-${TMUX_PANE:-}}"
  local marker="${2:-default}"
  local session window pane cwd title hash file

  IFS=$'\t' read -r session window pane cwd title hash file < <(pane_marker_metadata "$target")
  [[ -n "${file:-}" ]] || return 1
  file="$(resolve_pane_marker_file "$target" "$file" "$session" "$window" "$pane")"

  case "$marker" in
    default|clear|none|'')
      rm -f "$file"
      apply_pane_marker_style "$target" default
      ;;
    amber|green|blue|dim)
      write_pane_marker_file "$file" "$session" "$window" "$pane" "$cwd" "$title" "$hash" "$marker"
      apply_pane_marker_style "$target" "$marker"
      "$TMUX_BIN" set-option -pt "$target" @tt_marker_file "$file" 2>/dev/null || true
      ;;
    *)
      echo "usage: tt marker set <pane> [default|amber|green|blue|dim]" >&2
      return 2
      ;;
  esac

  apply_studio_pane_titles "$("$TMUX_BIN" display-message -p -t "$target" '#{window_id}' 2>/dev/null || true)"
}

sync_pane_marker() {
  local target="${1:-${TMUX_PANE:-}}"
  local session window pane cwd title hash file marker current

  IFS=$'\t' read -r session window pane cwd title hash file < <(pane_marker_metadata "$target")
  [[ -n "${file:-}" ]] || return 1
  file="$(resolve_pane_marker_file "$target" "$file" "$session" "$window" "$pane")"
  if [[ -f "$file" ]]; then
    marker="$(pane_marker_from_file "$file")"
    apply_pane_marker_style "$target" "$marker"
    "$TMUX_BIN" set-option -pt "$target" @tt_marker_file "$file" 2>/dev/null || true
  else
    current="$("$TMUX_BIN" show-option -pt "$target" -qv @tt_marker 2>/dev/null || true)"
    [[ -z "$current" ]] || apply_pane_marker_style "$target" default
  fi
}

sync_pane_markers() {
  local target="${1:-all}"
  if [[ "$target" == "all" ]]; then
    while IFS= read -r target; do
      [[ -n "$target" ]] || continue
      sync_pane_marker "$target" || true
    done < <("$TMUX_BIN" list-panes -a -F '#{pane_id}' 2>/dev/null || true)
    apply_studio_pane_titles
    return 0
  fi
  sync_pane_marker "$target"
}

list_pane_markers() {
  local dir file
  dir="$(pane_markers_dir)"
  if [[ ! -d "$dir" ]]; then
    echo "no pane markers: $dir" >&2
    return 1
  fi
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    printf '%s\t%s\n' "$file" "$(pane_marker_from_file "$file")"
  done < <(find "$dir" -maxdepth 1 -type f -name '*.md' | sort)
}

note_summary_from_file() {
  local file="$1"
  awk '
    NR == 1 && /^---[[:space:]]*$/ { front = 1; next }
    front == 1 && /^---[[:space:]]*$/ { front = 2; next }
    front == 1 { next }
    front == 0 || front >= 2 {
      if (!NF || $0 ~ /^<!--/ || $0 ~ /^```/) next
      line = $0
      sub(/^#[[:space:]]*/, "", line)
      if (length(line) > 60) line = substr(line, 1, 57) "..."
      print line
      exit
    }
  ' "$file"
}

sync_pane_note() {
  local target="${1:-${TMUX_PANE:-}}"
  local session window pane cwd title hash file summary
  IFS=$'\t' read -r session window pane cwd title hash file < <(pane_note_metadata "$target")
  [[ -n "${file:-}" ]] || return 1
  file="$(resolve_pane_note_file "$target" "$file" "$session" "$window" "$pane")"

  summary="$([[ -s "$file" ]] && note_summary_from_file "$file" || true)"
  if [[ -n "$summary" ]]; then
    "$TMUX_BIN" set-option -pt "$target" @tt_note "$summary" 2>/dev/null || true
    "$TMUX_BIN" set-option -pt "$target" @tt_note_file "$file" 2>/dev/null || true
  else
    "$TMUX_BIN" set-option -pt "$target" -u @tt_note 2>/dev/null || true
    "$TMUX_BIN" set-option -pt "$target" -u @tt_note_file 2>/dev/null || true
  fi
}

sync_pane_notes() {
  local target="${1:-all}"
  if [[ "$target" == "all" ]]; then
    while IFS= read -r target; do
      [[ -n "$target" ]] || continue
      sync_pane_note "$target" || true
    done < <("$TMUX_BIN" list-panes -a -F '#{pane_id}' 2>/dev/null || true)
    return 0
  fi
  sync_pane_note "$target"
}

set_pane_note() {
  local target="${1:-${TMUX_PANE:-}}"
  shift || true
  local note="$*"
  local session window pane cwd title hash file

  [[ -n "$target" ]] || { echo "usage: tt note set <pane> <note>" >&2; return 2; }
  IFS=$'\t' read -r session window pane cwd title hash file < <(pane_note_metadata "$target")
  [[ -n "${file:-}" ]] || return 1
  file="$(resolve_pane_note_file "$target" "$file" "$session" "$window" "$pane")"

  if [[ -z "$note" ]]; then
    clear_pane_note "$target"
    return
  fi

  write_pane_note_file "$file" "$session" "$window" "$pane" "$cwd" "$title" "$hash" "$note"
  sync_pane_note "$target"
  apply_studio_pane_titles "$("$TMUX_BIN" display-message -p -t "$target" '#{window_id}' 2>/dev/null || true)"
}

clear_pane_note() {
  local target="${1:-${TMUX_PANE:-}}"
  local session window pane cwd title hash file
  IFS=$'\t' read -r session window pane cwd title hash file < <(pane_note_metadata "$target")
  [[ -n "${file:-}" ]] || return 1
  file="$(resolve_pane_note_file "$target" "$file" "$session" "$window" "$pane")"
  rm -f "$file"
  "$TMUX_BIN" set-option -pt "$target" -u @tt_note 2>/dev/null || true
  "$TMUX_BIN" set-option -pt "$target" -u @tt_note_file 2>/dev/null || true
  apply_studio_pane_titles "$("$TMUX_BIN" display-message -p -t "$target" '#{window_id}' 2>/dev/null || true)"
}

show_pane_note() {
  local target="${1:-${TMUX_PANE:-}}"
  local session window pane cwd title hash file
  IFS=$'\t' read -r session window pane cwd title hash file < <(pane_note_metadata "$target")
  [[ -n "${file:-}" ]] || return 1
  file="$(resolve_pane_note_file "$target" "$file" "$session" "$window" "$pane")"
  if [[ -f "$file" ]]; then
    printf '%s:%s.%s  %s\n\n' "$session" "$window" "$pane" "$title"
    awk '
      NR == 1 && /^---[[:space:]]*$/ { front = 1; next }
      front == 1 && /^---[[:space:]]*$/ { front = 2; next }
      front == 1 { next }
      { print; seen = 1 }
      END {
        if (!seen) print "(empty note)"
      }
    ' "$file"
  else
    printf 'no note for %s:%s.%s %s\n' "$session" "$window" "$pane" "$title"
  fi
}

edit_pane_note() {
  local target="${1:-${TMUX_PANE:-}}"
  local session window pane cwd title hash file editor
  IFS=$'\t' read -r session window pane cwd title hash file < <(pane_note_metadata "$target")
  [[ -n "${file:-}" ]] || return 1
  file="$(resolve_pane_note_file "$target" "$file" "$session" "$window" "$pane")"
  if [[ ! -f "$file" ]]; then
    write_pane_note_file "$file" "$session" "$window" "$pane" "$cwd" "$title" "$hash"
  fi
  editor="${VISUAL:-${EDITOR:-nano}}"
  "$editor" "$file"
  sync_pane_note "$target"
  apply_studio_pane_titles "$("$TMUX_BIN" display-message -p -t "$target" '#{window_id}' 2>/dev/null || true)"
}

prompt_pane_note() {
  local target="${1:-${TMUX_PANE:-}}"
  local current note session window pane cwd title hash file
  IFS=$'\t' read -r session window pane cwd title hash file < <(pane_note_metadata "$target")
  current="$("$TMUX_BIN" show-option -pt "$target" -qv @tt_note 2>/dev/null || true)"
  printf 'pane note: %s:%s.%s  %s\n' "$session" "$window" "$pane" "$title"
  [[ -n "$current" ]] && printf 'current: %s\n' "$current"
  printf 'blank clears. note> '
  IFS= read -r note
  if [[ -z "$note" ]]; then
    clear_pane_note "$target"
  else
    set_pane_note "$target" "$note"
  fi
}

list_pane_notes() {
  local dir file
  dir="$(pane_notes_dir)"
  if [[ ! -d "$dir" ]]; then
    echo "no pane notes: $dir" >&2
    return 1
  fi
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    printf '%s\t%s\n' "$file" "$(note_summary_from_file "$file")"
  done < <(find "$dir" -maxdepth 1 -type f -name '*.md' | sort)
}

snapshot_history_dir() {
  local label="$1"
  local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  printf '%s\n' "$state_home/tt/history/$label"
}

record_snapshot_history() {
  local source="$1"
  local label="$2"
  local max="${TT_SNAPSHOT_HISTORY_MAX:-864}"
  local dir ts dest tmp newest file count
  local -a files=()

  [[ -f "$source" ]] || return 0
  case "$max" in
    ''|*[!0-9]*)
      max=864
      ;;
  esac
  (( max > 0 )) || return 0

  dir="$(snapshot_history_dir "$label")"
  mkdir -p "$dir" || return 1
  newest="$(ls -1t "$dir"/*.tsv 2>/dev/null | head -n 1 || true)"
  if [[ -n "$newest" ]] && cmp -s "$source" "$newest"; then
    return 0
  fi

  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  dest="$dir/$ts.tsv"
  if [[ -e "$dest" ]]; then
    dest="$dir/$ts.$$.tsv"
  fi
  tmp="$(mktemp "$dir/.${ts}.XXXXXX")" || return 1
  if ! cp "$source" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if ! python3 -c 'import os, sys; fd = os.open(sys.argv[1], os.O_RDONLY); os.fsync(fd); os.close(fd)' "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if ! mv "$tmp" "$dest"; then
    rm -f "$tmp"
    return 1
  fi

  while IFS= read -r file; do
    [[ -n "$file" ]] && files+=("$file")
  done < <(ls -1t "$dir"/*.tsv 2>/dev/null || true)

  count=0
  for file in "${files[@]}"; do
    count=$((count + 1))
    if (( count > max )); then
      rm -f "$file"
    fi
  done
}

list_snapshot_history() {
  local label="${1:-codex-cockpit}"
  local dir max="${2:-40}"
  local count=0 file

  dir="$(snapshot_history_dir "$label")"
  if [[ ! -d "$dir" ]]; then
    echo "no snapshot history: $dir" >&2
    return 1
  fi

  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    printf '%s\n' "$file"
    count=$((count + 1))
    (( count >= max )) && break
  done < <(ls -1t "$dir"/*.tsv 2>/dev/null || true)
  return 0
}

count_snapshot_history() {
  local label="${1:-codex-cockpit}"
  local dir
  dir="$(snapshot_history_dir "$label")"
  if [[ ! -e "$dir" && ! -L "$dir" ]]; then
    printf '0\n'
    return 0
  fi
  [[ -d "$dir" ]] || return 1
  find "$dir" -maxdepth 1 -type f -name '*.tsv' | wc -l | tr -d ' '
}

portable_stat_value() {
  local bsd_format="$1"
  local gnu_format="$2"
  local path="$3"
  local value

  if value="$(stat -f "$bsd_format" -- "$path" 2>/dev/null)" &&
    [[ "$value" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$value"
    return 0
  fi
  if value="$(stat -c "$gnu_format" -- "$path" 2>/dev/null)" &&
    [[ "$value" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$value"
    return 0
  fi
  return 1
}

file_age_seconds() {
  local file="$1"
  local now mtime
  [[ -f "$file" ]] || return 1
  now="$(date +%s)"
  mtime="$(portable_stat_value %m %Y "$file" 2>/dev/null || true)"
  [[ "$mtime" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$((now - mtime))"
}

human_age() {
  local seconds="$1"
  if (( seconds < 60 )); then
    printf '%ss' "$seconds"
  elif (( seconds < 3600 )); then
    printf '%sm%02ss' "$((seconds / 60))" "$((seconds % 60))"
  else
    printf '%sh%02sm' "$((seconds / 3600))" "$(((seconds % 3600) / 60))"
  fi
}

manifest_value_for() {
  local manifest="$1"
  local wanted_session="$2"
  local wanted_pane="$3"
  local wanted_field="$4"
  local session pane dir title command

  [[ -f "$manifest" ]] || return 0

  while IFS=$'\t' read -r session pane dir title command || [[ -n "${session:-}" ]]; do
    [[ -n "${session:-}" && "${session:0:1}" != "#" ]] || continue
    [[ "$session" == "$wanted_session" && "$pane" == "$wanted_pane" ]] || continue
    case "$wanted_field" in
      dir)
        printf '%s\n' "$dir"
        ;;
      title)
        printf '%s\n' "$title"
        ;;
      command)
        printf '%s\n' "$command"
        ;;
    esac
    return 0
  done < "$manifest"
}

fallback_title_for_path() {
  local path="$1"
  local name

  name="${path##*/}"
  [[ -n "$name" ]] || name="shell"
  printf '%s\n' "$name"
}

apply_agent_manifest_metadata() {
  local manifest="${1:-}"
  local session pane dir title command target kind

  [[ -n "$manifest" && -f "$manifest" ]] || return 0

  while IFS=$'\t' read -r session pane dir title command || [[ -n "${session:-}" ]]; do
    [[ -n "${session:-}" && "${session:0:1}" != "#" ]] || continue
    target="$session:1.$pane"
    kind="$(agent_kind_for_command "$command")"
    "$TMUX_BIN" set-option -pt "$target" @tt_base_title "$title" 2>/dev/null || true
    "$TMUX_BIN" set-option -pt "$target" @tt_agent_command "$command" 2>/dev/null || true
    "$TMUX_BIN" set-option -pt "$target" @tt_agent_kind "$kind" 2>/dev/null || true
    set_pane_git_label "$target" "$dir"
  done < "$manifest"
}

write_agent_cockpit_state() {
  local output="${1:-}"
  local quiet="${2:-}"
  local seed tmp panes session profile window pane window_panes dir start_command current_command live_title base_title seed_title seed_command command kind
  local rows=0

  [[ -n "$output" ]] || output="$(agent_cockpit_state_file)"
  seed="$(agent_cockpit_manifest)"
  if [[ "$seed" == "$output" ]]; then
    seed="$(agent_cockpit_seed_manifest)"
  fi

  mkdir -p "$(dirname "$output")"
  tmp="$output.$$"
  panes="$tmp.panes"
  printf '# session\tpane\tdir\ttitle\tcommand\n' > "$tmp"
  if ! "$TMUX_BIN" list-panes -a -F '#{session_name}	#{@tt_profile}	#{window_index}	#{pane_index}	#{window_panes}	#{pane_current_path}	#{pane_start_command}	#{pane_current_command}	#{pane_title}	#{@tt_base_title}' >"$panes" 2>/dev/null; then
    rm -f "$tmp" "$panes"
    printf 'tt snapshot failed: could not list tmux panes\n' >&2
    return 1
  fi

  while IFS=$'\t' read -r session profile window pane window_panes dir start_command current_command live_title base_title || [[ -n "${session:-}" ]]; do
    [[ -n "${session:-}" ]] || continue
    [[ "$session" != ttm-* ]] || continue
    [[ "$profile" != "ops" ]] || continue
    [[ "$profile" != "mobile" ]] || continue
    [[ "$profile" == "studio" || "$window_panes" == "6" ]] || continue

    seed_title="$(manifest_value_for "$seed" "$session" "$pane" title)"
    seed_command="$(manifest_value_for "$seed" "$session" "$pane" command)"

    if [[ -n "$base_title" ]]; then
      title="$base_title"
    elif [[ -z "$seed_command" && "$current_command" == "zsh" && -n "$live_title" && "$live_title" != "zsh" ]]; then
      title="$live_title"
    elif [[ -n "$seed_title" ]]; then
      title="$seed_title"
    elif [[ -n "$live_title" ]]; then
      title="$live_title"
    else
      title="$(fallback_title_for_path "$dir")"
    fi

    command="$(clean_agent_command "$start_command")"
    if [[ -z "$command" && "$current_command" != "zsh" && "$current_command" != "fish" && "$current_command" != "bash" ]]; then
      command="$seed_command"
    fi
    kind="$(agent_kind_for_command "$command")"

    printf '%s\t%s\t%s\t%s\t%s\n' "$session" "$pane" "$dir" "$title" "$command" >> "$tmp"
    rows=$((rows + 1))
    "$TMUX_BIN" set-option -pt "$session:1.$pane" @tt_base_title "$title" 2>/dev/null || true
    "$TMUX_BIN" set-option -pt "$session:1.$pane" @tt_agent_command "$command" 2>/dev/null || true
    "$TMUX_BIN" set-option -pt "$session:1.$pane" @tt_agent_kind "$kind" 2>/dev/null || true
    set_pane_git_label "$session:1.$pane" "$dir"
  done <"$panes"
  rm -f "$panes"

  if (( rows == 0 )); then
    rm -f "$tmp"
    if [[ "$quiet" != "--quiet" ]]; then
      printf 'tt snapshot skipped: no live agent cockpit panes\n' >&2
    fi
    return 0
  fi

  mv "$tmp" "$output"
  record_snapshot_history "$output" "agent-cockpit"
  if [[ "$quiet" != "--quiet" ]]; then
    printf 'tt snapshot saved: %s\n' "$output" >&2
  fi
}

write_codex_cockpit_snapshot() {
  local output="${1:-}"
  local quiet="${2:-}"
  local writer status attempts delay attempt=1

  [[ -n "$output" ]] || output="$(codex_cockpit_snapshot_file)"
  mkdir -p "$(dirname "$output")"

  writer="$SCRIPT_DIR/tt-codex-snapshot-writer"
  if [[ ! -x "$writer" ]]; then
    printf 'tt codex snapshot failed: missing writer %s\n' "$writer" >&2
    return 1
  fi

  attempts="${TT_CODEX_SNAPSHOT_LOCK_RETRY_ATTEMPTS:-5}"
  delay="${TT_CODEX_SNAPSHOT_LOCK_RETRY_DELAY_SECONDS:-1}"
  case "$attempts" in ''|*[!0-9]*) attempts=5 ;; esac
  case "$delay" in ''|*[!0-9.]*) delay=1 ;; esac
  (( attempts > 0 )) || attempts=1

  while (( attempt <= attempts )); do
    if TT_TMUX_BIN="$TMUX_BIN" TT_LOGIN_SHELL="$(default_login_shell)" "$writer" "$output"; then
      status=0
    else
      status=$?
    fi
    (( status == 75 && attempt < attempts )) || break
    sleep "$delay"
    attempt=$((attempt + 1))
  done

  if (( status == 75 )); then
    if [[ "$quiet" != "--quiet" ]]; then
      printf 'tt codex snapshot failed: writer remained busy after %s attempts\n' "$attempts" >&2
    fi
    return 75
  fi
  if (( status != 0 )); then
    return "$status"
  fi

  if [[ "$quiet" != "--quiet" ]]; then
    printf 'tt codex snapshot saved: %s\n' "$output" >&2
  fi
  refresh_agent_window_state
}

autosave_snapshot_cycle() {
  local writer="$SCRIPT_DIR/tt-codex-snapshot-writer"

  if [[ ! -x "$writer" ]]; then
    printf 'tt autosave failed: missing executable writer %s\n' "$writer" >&2
    return 1
  fi
  write_agent_cockpit_state "$(agent_cockpit_state_file)" --quiet || return
  write_codex_cockpit_snapshot "$(codex_cockpit_snapshot_file)" --quiet
}

show_codex_snapshot() {
  local snapshot="${1:-}"
  [[ -n "$snapshot" ]] || snapshot="$(codex_cockpit_snapshot_file)"
  if [[ ! -f "$snapshot" ]]; then
    echo "codex snapshot not found: $snapshot" >&2
    return 1
  fi
  sed -n '1,120p' "$snapshot"
}

restore_preview() {
  local snapshot="${1:-}"
  [[ -n "$snapshot" ]] || snapshot="$(codex_cockpit_snapshot_file)"
  if [[ ! -f "$snapshot" ]]; then
    echo "codex snapshot not found: $snapshot" >&2
    return 1
  fi

  awk -F '\t' '
    BEGIN {
      printf "%-16s %-7s %-10s %-28s %-38s %s\n", "target", "kind", "status", "title", "cwd", "restore"
      printf "%-16s %-7s %-10s %-28s %-38s %s\n", "------", "----", "------", "-----", "---", "-------"
    }
    $1 !~ /^#/ && ($2 == "codex" || $2 == "claude") {
      title = $4
      cwd = $3
      if (length(title) > 27) title = substr(title, 1, 24) "..."
      if (length(cwd) > 37) cwd = "..." substr(cwd, length(cwd) - 33)
      printf "%-16s %-7s %-10s %-28s %-38s %s\n", $1, $2, $7, title, cwd, $8
    }
  ' "$snapshot"
}

popup_view() {
  local view="${1:-snapshot}"
  local tmp status=0

  tmp="$(mktemp "${TMPDIR:-/tmp}/tt-popup.XXXXXX")"
  case "$view" in
    snapshot|codex-snapshot)
      show_codex_snapshot > "$tmp" 2>&1 || status=$?
      ;;
    preview|restore-preview)
      restore_preview > "$tmp" 2>&1 || status=$?
      ;;
    history|snapshot-history)
      list_snapshot_history > "$tmp" 2>&1 || status=$?
      ;;
    status)
      status_report > "$tmp" 2>&1 || status=$?
      ;;
    doctor)
      doctor_tmux --fix > "$tmp" 2>&1 || status=$?
      ;;
    *)
      printf 'usage: tt popup [snapshot|restore-preview|snapshot-history|status|doctor]\n' > "$tmp"
      status=2
      ;;
  esac

  if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
    LESS= less -SR "$tmp"
  else
    cat "$tmp"
  fi
  rm -f "$tmp"
  return "$status"
}

status_report() {
  local snapshot agent_snapshot timer="stopped" autosave="off"
  local snapshot_age agent_age history_count history_max success_age="missing" identity
  local panes codex claude exact unresolved shell waiting spinning menu_left menu_right static_status mouse copy_modes mobile_mode

  snapshot="$(codex_cockpit_snapshot_file)"
  agent_snapshot="$(agent_cockpit_state_file)"
  history_max="${TT_SNAPSHOT_HISTORY_MAX:-864}"

  identity="$(codex_snapshot_timer_read_state 2>/dev/null || true)"
  if [[ -n "$identity" ]]; then
    codex_snapshot_timer_success_fresh "$identity" || true
    if [[ "$TT_TIMER_SUCCESS_AGE" =~ ^[0-9]+$ ]]; then
      success_age="$(human_age "$TT_TIMER_SUCCESS_AGE") ago"
    fi
  fi
  if [[ -n "$identity" ]] && codex_snapshot_timer_identity_valid "$identity"; then
    TT_TIMER_PID="${identity%%$'\t'*}"
    timer="running pid=$TT_TIMER_PID"
    if codex_snapshot_timer_success_fresh "$identity" && agent_autosave_hooks_healthy; then
      autosave="on"
    else
      autosave="degraded"
    fi
  elif agent_autosave_hooks_present || codex_snapshot_timer_desired_token >/dev/null 2>&1 ||
    [[ -e "$(codex_cockpit_timer_pid_file)" ]]; then
    autosave="degraded"
  fi

  if [[ -f "$snapshot" ]]; then
    snapshot_age="$(file_age_seconds "$snapshot" 2>/dev/null || true)"
    [[ -n "$snapshot_age" ]] && snapshot_age="$(human_age "$snapshot_age") ago" || snapshot_age="unknown"
    panes="$(awk -F '\t' '$1 !~ /^#/ {n++} END {print n+0}' "$snapshot")"
    codex="$(awk -F '\t' '$1 !~ /^#/ && $2 == "codex" {n++} END {print n+0}' "$snapshot")"
    claude="$(awk -F '\t' '$1 !~ /^#/ && $2 == "claude" {n++} END {print n+0}' "$snapshot")"
    shell="$(awk -F '\t' '$1 !~ /^#/ && $2 == "shell" {n++} END {print n+0}' "$snapshot")"
    exact="$(awk -F '\t' '$1 !~ /^#/ && $7 == "exact" {n++} END {print n+0}' "$snapshot")"
    unresolved="$(awk -F '\t' '$1 !~ /^#/ && $7 == "unresolved" {n++} END {print n+0}' "$snapshot")"
    waiting="$(awk -F '\t' '$1 !~ /^#/ && ($2 == "codex" || $2 == "claude") && $4 !~ /^[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏⠂]/ {n++} END {print n+0}' "$snapshot")"
    spinning="$(awk -F '\t' '$1 !~ /^#/ && ($2 == "codex" || $2 == "claude") && $4 ~ /^[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏⠂]/ {n++} END {print n+0}' "$snapshot")"
  else
    snapshot_age="missing"
    panes=0 codex=0 claude=0 shell=0 exact=0 unresolved=0 waiting=0 spinning=0
  fi

  if [[ -f "$agent_snapshot" ]]; then
    agent_age="$(file_age_seconds "$agent_snapshot" 2>/dev/null || true)"
    [[ -n "$agent_age" ]] && agent_age="$(human_age "$agent_age") ago" || agent_age="unknown"
  else
    agent_age="missing"
  fi

  history_count="$(count_snapshot_history codex-cockpit)"
  if "$TMUX_BIN" list-keys -T root MouseDown1StatusRight 2>/dev/null | grep -q 'codex-snapshot'; then
    menu_left="bound"
  else
    menu_left="missing"
  fi
  if "$TMUX_BIN" list-keys -T root MouseDown3StatusRight 2>/dev/null | grep -q 'display-menu'; then
    menu_right="bound"
  else
    menu_right="missing"
  fi
  if enforce_static_tmux_status --quiet; then
    static_status="ok"
  else
    static_status="shell-backed format found"
  fi
  mouse="$("$TMUX_BIN" show -gqv mouse 2>/dev/null || printf 'unknown')"
  copy_modes="$("$TMUX_BIN" list-panes -a -F '#{pane_in_mode}' 2>/dev/null |
    awk '$1 == "1" {n++} END {print n+0}' || true)"
  [[ -n "$copy_modes" ]] || copy_modes=0
  mobile_mode="direct pane attach"

  printf 'autosave: %s\n' "$autosave"
  printf 'timer: %s\n' "$timer"
  printf 'last success: %s\n' "$success_age"
  printf 'snapshot: %s (%s)\n' "$snapshot" "$snapshot_age"
  printf 'agent snapshot: %s (%s)\n' "$agent_snapshot" "$agent_age"
  printf 'history: %s/%s codex-cockpit files\n' "$history_count" "$history_max"
  printf 'agents: %s panes, %s codex, %s claude, %s shell\n' "$panes" "$codex" "$claude" "$shell"
  printf 'restore: %s exact, %s unresolved\n' "$exact" "$unresolved"
  printf 'work state: %s waiting, %s spinning\n' "$waiting" "$spinning"
  printf 'menu: left=%s right=%s\n' "$menu_left" "$menu_right"
  printf 'status: %s\n' "$static_status"
  printf 'mouse: %s, copy-mode panes: %s\n' "$mouse" "$copy_modes"
  printf 'mobile: %s\n' "$mobile_mode"
}

doctor_tmux() {
  local mode="${1:---fix}"

  case "$mode" in
    --check|check)
      status_report
      return
      ;;
    --fix|fix|'')
      ;;
    *)
      echo "usage: tt doctor [--fix|--check]" >&2
      return 2
      ;;
  esac

  printf 'repair: mouse on\n'
  "$TMUX_BIN" set -g mouse on

  printf 'repair: clear legacy shell status widgets\n'
  clear_legacy_shell_status_widgets

  printf 'repair: restore static tab/status formats\n'
  set_agent_window_status_formats

  printf 'repair: install CX SAVE menu\n'
  install_agent_status_menu

  printf 'repair: sync pane notes\n'
  sync_pane_notes all

  printf 'repair: sync pane markers\n'
  sync_pane_markers all

  clear_stale_agent_attention_pane_styles

  sync_mosh_attention_panes --quiet

  printf 'repair: install autosave hooks/timer\n'
  install_agent_autosave_hooks

  printf 'repair: refresh snapshots\n'
  write_agent_cockpit_state "$(agent_cockpit_state_file)" --quiet
  write_codex_cockpit_snapshot "$(codex_cockpit_snapshot_file)" --quiet

  printf '\n'
  status_report
}

codex_restore_matches() {
  local mode="${1:-preview}"
  local selector="${2:-}"
  local snapshot="${3:-}"

  [[ -n "$snapshot" ]] || snapshot="$(codex_cockpit_snapshot_file)"
  [[ -f "$snapshot" ]] || { echo "codex snapshot not found: $snapshot" >&2; return 1; }

  awk -F '\t' -v mode="$mode" -v selector="$selector" '
    $1 ~ /^#/ || !($2 == "codex" || $2 == "claude") { next }
    mode == "all" { print; next }
    mode == "pane" && $1 == selector { print; next }
    mode == "window" && index($1, selector ".") == 1 { print; next }
    mode == "session" && index($1, selector ":") == 1 { print; next }
  ' "$snapshot"
}

codex_restore_execute() {
  local mode="${1:-preview}"
  local selector="${2:-}"
  local snapshot="${3:-}"
  local execute="${4:-}"
  local target kind cwd title current_command session_id status restore
  local matched=0 restored=0 missing=0

  if [[ "$selector" == "--execute" ]]; then
    execute="--execute"
    selector=""
  fi
  if [[ "$snapshot" == "--execute" ]]; then
    execute="--execute"
    snapshot=""
  fi
  if [[ "$mode" == "all" && -n "$selector" && -z "$snapshot" ]]; then
    snapshot="$selector"
    selector=""
  fi

  case "$mode" in
    preview)
      restore_preview "$selector"
      return
      ;;
    all)
      ;;
    pane|window|session)
      [[ -n "$selector" ]] || { echo "usage: tt codex-restore $mode <target>" >&2; return 2; }
      ;;
    *)
      echo "usage: tt codex-restore [preview|all|pane <target>|window <session:window>|session <session>] [snapshot] [--execute]" >&2
      return 2
      ;;
  esac

  if [[ "$execute" != "--execute" ]]; then
    echo "dry run; add --execute to respawn matching panes" >&2
    while IFS=$'\t' read -r target kind cwd title current_command session_id status restore || [[ -n "${target:-}" ]]; do
      [[ -n "${target:-}" ]] || continue
      matched=$((matched + 1))
      printf '%s\t%s\t%s\t%s\n' "$target" "$kind" "$status" "$restore"
    done < <(codex_restore_matches "$mode" "$selector" "$snapshot")
    if (( matched == 0 )); then
      echo "no matching Codex/Claude panes" >&2
      return 1
    fi
    return 0
  fi

  while IFS=$'\t' read -r target kind cwd title current_command session_id status restore || [[ -n "${target:-}" ]]; do
    [[ -n "${target:-}" ]] || continue
    matched=$((matched + 1))
    printf '%s\t%s\t%s\t%s\n' "$target" "$kind" "$status" "$restore"
    if "$TMUX_BIN" list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null | grep -Fxq "$target"; then
      "$TMUX_BIN" respawn-pane -k -t "$target" "$(command_with_shell_fallback "$restore")"
      restored=$((restored + 1))
    else
      printf 'missing pane: %s\n' "$target" >&2
      missing=$((missing + 1))
    fi
  done < <(codex_restore_matches "$mode" "$selector" "$snapshot")

  "$TMUX_BIN" set -g status-position top
  set_agent_window_status_formats
  apply_studio_pane_titles "$selector"
  if (( matched == 0 )); then
    echo "no matching Codex/Claude panes" >&2
    return 1
  fi
  printf 'tt restored %s pane(s), missing %s\n' "$restored" "$missing" >&2
}

refresh_agent_window_state() {
  local snapshot tmp window state

  snapshot="$(codex_cockpit_snapshot_file)"
  tmp="$(mktemp "${TMPDIR:-/tmp}/tt-window-state.XXXXXX")"
  if [[ -f "$snapshot" ]]; then
    "$TMUX_BIN" list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}	#{window_id}' 2>/dev/null |
      awk -F '\t' -v snapshot="$snapshot" '
        FNR == NR {
          if ($1 !~ /^#/ && ($2 == "codex" || $2 == "claude") && $4 !~ /^[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏⠂]/) ready[$1] = 1
          next
        }
        {
          windows[$2] = 1
          if (ready[$1]) state[$2] = "attention"
        }
        END {
          for (window in windows) {
            print window "\t" (state[window] ? state[window] : "shell")
          }
        }' "$snapshot" - > "$tmp"
  else
    "$TMUX_BIN" list-panes -a -F '#{window_id}	#{pane_title}	#{@tt_agent_kind}' 2>/dev/null |
      awk -F '\t' '
      {
        window = $1
        title = $2
        kind = $3
        windows[window] = 1
        if (kind == "CODEX" || kind == "CLAUDE") {
          if (title !~ /^[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏⠂]/) state[window] = "attention"
        }
      }
      END {
        for (window in windows) {
          print window "\t" (state[window] ? state[window] : "shell")
        }
      }' > "$tmp"
  fi

  while IFS=$'\t' read -r window state || [[ -n "${window:-}" ]]; do
    [[ -n "${window:-}" && -n "${state:-}" ]] || continue
    "$TMUX_BIN" set-window-option -t "$window" -q @tt_window_agent_state "$state" 2>/dev/null || true
  done < "$tmp"
  rm -f "$tmp"
}

codex_snapshot_timer_loop() {
  local token="${1:-}"
  local expected_server_pid="${2:-}"
  local expected_uid="${3:-}"
  local success_epoch="${4:-}"
  local max_age="${5:-}"
  local interval="${TT_CODEX_SNAPSHOT_INTERVAL:-300}"
  local minimum="${TT_CODEX_SNAPSHOT_INTERVAL_MIN:-30}"
  local stop_requested=0 failed=0 sleeper=""

  [[ "$token" =~ ^[A-Za-z0-9._-]+$ ]] || return 2
  [[ "$expected_server_pid" =~ ^[0-9]+$ ]] || return 2
  [[ "$expected_uid" =~ ^[0-9]+$ ]] || return 2
  [[ "$success_epoch" =~ ^[0-9]+$ ]] || return 2
  [[ "$max_age" =~ ^[0-9]+$ ]] || return 2
  [[ "$(id -u)" == "$expected_uid" ]] || return 2

  case "$interval" in
    ''|*[!0-9]*) interval=300 ;;
  esac
  case "$minimum" in
    ''|*[!0-9]*) minimum=30 ;;
  esac
  if (( interval < minimum )); then
    interval="$minimum"
  fi

  TT_TIMER_LOOP_TOKEN="$token"
  TT_TIMER_LOOP_SERVER_PID="$expected_server_pid"
  TT_TIMER_LOOP_UID="$expected_uid"
  trap 'stop_requested=1; [[ -z "${sleeper:-}" ]] || kill "$sleeper" 2>/dev/null || true' TERM INT
  trap ':' HUP
  trap 'codex_snapshot_timer_cleanup "$TT_TIMER_LOOP_TOKEN" "$TT_TIMER_LOOP_SERVER_PID" "$TT_TIMER_LOOP_UID"' EXIT

  codex_snapshot_timer_server_matches "$expected_server_pid" || return 1
  [[ "$(codex_snapshot_timer_desired_token 2>/dev/null || true)" == "$token" ]] || return 1
  codex_snapshot_timer_write_state "$$" "$expected_server_pid" "$expected_uid" "$token" "$success_epoch" "$max_age" || return 1
  codex_snapshot_timer_log "start pid=$$ server=$expected_server_pid token=$token"

  while (( stop_requested == 0 )); do
    if ! codex_snapshot_timer_server_matches "$expected_server_pid"; then
      codex_snapshot_timer_log "stop pid=$$ reason=server-mismatch"
      break
    fi
    if [[ "$(codex_snapshot_timer_desired_token 2>/dev/null || true)" != "$token" ]]; then
      codex_snapshot_timer_log "stop pid=$$ reason=generation-changed"
      break
    fi
    sleep "$interval" &
    sleeper=$!
    wait "$sleeper" 2>/dev/null || true
    sleeper=""
    (( stop_requested == 0 )) || break
    if ! codex_snapshot_timer_server_matches "$expected_server_pid"; then
      codex_snapshot_timer_log "stop pid=$$ reason=server-mismatch"
      break
    fi
    if [[ "$(codex_snapshot_timer_desired_token 2>/dev/null || true)" != "$token" ]]; then
      codex_snapshot_timer_log "stop pid=$$ reason=generation-changed"
      break
    fi
    if autosave_snapshot_cycle; then
      success_epoch="$(date +%s)"
      if ! codex_snapshot_timer_write_state "$$" "$expected_server_pid" "$expected_uid" "$token" "$success_epoch" "$max_age"; then
        codex_snapshot_timer_log "cycle-failed pid=$$ reason=state-write"
        failed=1
        continue
      fi
      if (( failed != 0 )); then
        codex_snapshot_timer_log "recovered pid=$$"
      fi
      failed=0
    else
      codex_snapshot_timer_log "cycle-failed pid=$$ reason=snapshot"
      failed=1
    fi
  done
}

tt_self_command() {
  if [[ -x "$HOME/bin/tt" ]]; then
    shell_quote "$HOME/bin/tt"
  else
    shell_quote "$SCRIPT_DIR/tt"
  fi
}

enforce_static_tmux_status() {
  local quiet="${1:-}"
  local opt value failed=0
  for opt in status-left status-right window-status-format window-status-current-format; do
    value="$("$TMUX_BIN" show -gqv "$opt" 2>/dev/null || true)"
    if [[ "$value" == *'#('* ]]; then
      failed=1
      [[ "$quiet" == "--quiet" ]] || printf 'shell-backed status format found in %s\n' "$opt" >&2
    fi
  done
  return "$failed"
}

clear_legacy_shell_status_widgets() {
  "$TMUX_BIN" set -gu @agent_attention_segment 2>/dev/null || true
  "$TMUX_BIN" set -gu @agent_attention_state 2>/dev/null || true
  "$TMUX_BIN" set -gu @hn_ticker 2>/dev/null || true
  "$TMUX_BIN" set -gu @hn_ticker_cache 2>/dev/null || true
  "$TMUX_BIN" set -gu @hn_ticker_last 2>/dev/null || true
}

is_agent_attention_pane_style() {
  local style="${1:-}" active_style="${2:-}"

  case "$style|$active_style" in
    "fg=default,bg=#241d12|fg=default,bg=#2f2517") return 0 ;;
    "fg=default,bg=#2b1720|fg=default,bg=#361b27") return 0 ;;
    *) return 1 ;;
  esac
}

clear_stale_agent_attention_pane_styles() {
  local target marker style active_style cleared=0

  while IFS= read -r target; do
    [[ -n "$target" ]] || continue
    marker="$("$TMUX_BIN" show-options -pt "$target" -qv @tt_marker 2>/dev/null || true)"
    [[ -z "$marker" ]] || continue

    style="$("$TMUX_BIN" show-options -pt "$target" -qv window-style 2>/dev/null || true)"
    active_style="$("$TMUX_BIN" show-options -pt "$target" -qv window-active-style 2>/dev/null || true)"
    if is_agent_attention_pane_style "$style" "$active_style"; then
      "$TMUX_BIN" set-option -pt "$target" -qu window-style 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" -qu window-active-style 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" -qu @agent_pane_badge 2>/dev/null || true
      cleared=$((cleared + 1))
    fi
  done < <("$TMUX_BIN" list-panes -a -F '#{pane_id}' 2>/dev/null || true)

  printf 'repair: cleared %s stale agent attention pane style(s)\n' "$cleared"
}

reset_agent_attention_pane() {
  local target="${1:-${TMUX_PANE:-}}"
  local marker style active_style badge tty

  [[ -n "$target" ]] || return 0

  marker="$("$TMUX_BIN" show-options -pt "$target" -qv @tt_marker 2>/dev/null || true)"
  style="$("$TMUX_BIN" show-options -pt "$target" -qv window-style 2>/dev/null || true)"
  active_style="$("$TMUX_BIN" show-options -pt "$target" -qv window-active-style 2>/dev/null || true)"
  badge="$("$TMUX_BIN" show-options -pt "$target" -qv @agent_pane_badge 2>/dev/null || true)"

  if [[ -n "$marker" ]]; then
    return 0
  fi
  if [[ -z "$badge" ]] && ! is_agent_attention_pane_style "$style" "$active_style"; then
    return 0
  fi

  "$TMUX_BIN" set-option -pt "$target" -qu @agent_pane_badge 2>/dev/null || true
  "$TMUX_BIN" set-option -pt "$target" -qu window-style 2>/dev/null || true
  "$TMUX_BIN" set-option -pt "$target" -qu window-active-style 2>/dev/null || true

  tty="$("$TMUX_BIN" display-message -p -t "$target" '#{pane_tty}' 2>/dev/null || true)"
  if [[ -n "$tty" && -w "$tty" ]]; then
    printf '\033]11;#1a1b26\007\033]12;#c0caf5\007' >"$tty" 2>/dev/null || true
  fi
}

mosh_target_for_pane() {
  local target="$1"
  local pane_pid child command remote

  pane_pid="$("$TMUX_BIN" display-message -p -t "$target" '#{pane_pid}' 2>/dev/null || true)"
  [[ -n "$pane_pid" ]] || return 1

  while IFS= read -r child; do
    command="$(ps -ww -o command= -p "$child" 2>/dev/null || true)"
    [[ "$command" == *mosh-client* && "$command" == *" -- "* ]] || continue
    remote="${command##* -- }"
    remote="${remote%% | *}"
    remote="${remote%% *}"
    [[ -n "$remote" ]] || continue
    printf '%s\n' "$remote"
    return 0
  done < <(pgrep -P "$pane_pid" 2>/dev/null || true)

  return 1
}

remote_agent_attention_state() {
  local remote="$1"

  ssh -o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=15 -o ServerAliveCountMax=1 "$remote" '
    if ! command -v tmux >/dev/null 2>&1 || ! tmux ls >/dev/null 2>&1; then
      printf "reset\n"
      exit 0
    fi
    state=reset
    for pane in $(tmux list-panes -a -F "#{pane_id}" 2>/dev/null); do
      badge="$(tmux show-options -pt "$pane" -qv @agent_pane_badge 2>/dev/null || true)"
      case "$badge" in
        *APPROVE*) printf "approve\n"; exit 0 ;;
        *WAIT*) state=waiting ;;
      esac
    done
    printf "%s\n" "$state"
  ' 2>/dev/null | sed -n '1p'
}

apply_mosh_attention_state() {
  local target="$1" state="$2"
  local marker style active_style

  marker="$("$TMUX_BIN" show-options -pt "$target" -qv @tt_marker 2>/dev/null || true)"
  [[ -z "$marker" ]] || return 0

  case "$state" in
    approve)
      "$TMUX_BIN" set-option -pt "$target" window-style "fg=default,bg=#2b1720" 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" window-active-style "fg=default,bg=#361b27" 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" -qu @agent_pane_badge 2>/dev/null || true
      ;;
    waiting)
      "$TMUX_BIN" set-option -pt "$target" window-style "fg=default,bg=#241d12" 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" window-active-style "fg=default,bg=#2f2517" 2>/dev/null || true
      "$TMUX_BIN" set-option -pt "$target" -qu @agent_pane_badge 2>/dev/null || true
      ;;
    reset|active|idle|clear|'')
      style="$("$TMUX_BIN" show-options -pt "$target" -qv window-style 2>/dev/null || true)"
      active_style="$("$TMUX_BIN" show-options -pt "$target" -qv window-active-style 2>/dev/null || true)"
      if is_agent_attention_pane_style "$style" "$active_style"; then
        "$TMUX_BIN" set-option -pt "$target" -qu window-style 2>/dev/null || true
        "$TMUX_BIN" set-option -pt "$target" -qu window-active-style 2>/dev/null || true
      fi
      "$TMUX_BIN" set-option -pt "$target" -qu @agent_pane_badge 2>/dev/null || true
      ;;
  esac
}

sync_mosh_attention_panes() {
  local quiet="${1:-}"
  local target command remote state count=0

  while IFS=$'\t' read -r target command; do
    [[ "$command" == "mosh-client" ]] || continue
    remote="$(mosh_target_for_pane "$target")" || continue
    state="$(remote_agent_attention_state "$remote")"
    [[ -n "$state" ]] || continue
    apply_mosh_attention_state "$target" "$state"
    count=$((count + 1))
    [[ "$quiet" == "--quiet" ]] || printf 'mosh-attn: %s -> %s (%s)\n' "$target" "$remote" "$state"
  done < <("$TMUX_BIN" list-panes -a -F '#{pane_id}	#{pane_current_command}' 2>/dev/null || true)

  [[ "$quiet" == "--quiet" ]] || printf 'mosh-attn: synced %s pane(s)\n' "$count"
}

show_pane_menu() {
  local target="${1:-${TMUX_PANE:-}}"
  local x="${2:-P}"
  local y="${3:-P}"
  local client="${4:-}"
  local self tmux_cmd
  local -a client_args=()

  [[ -n "$target" ]] || return 0
  self="$(tt_self_command)"
  tmux_cmd="$(shell_quote "$TMUX_BIN")"
  [[ -n "$client" ]] && client_args=(-c "$client")

  "$TMUX_BIN" display-menu "${client_args[@]}" -T "Pane #{pane_index}" -t "$target" -x "$x" -y "$y" \
    "Edit note" e "display-popup -t '#{pane_id}' -T 'note: #{session_name}:#{window_index}.#{pane_index}' -x '#{pane_left}' -y '#{pane_top}' -w 84 -h 24 -E '$self note edit #{pane_id}'" \
    "Show note" v "display-popup -t '#{pane_id}' -T 'note: #{session_name}:#{window_index}.#{pane_index}' -x '#{pane_left}' -y '#{pane_top}' -w 72 -h 16 -E '$self note show #{pane_id} | LESS= less -SR'" \
    "Replace with quick note" n "display-popup -t '#{pane_id}' -T 'quick note: #{session_name}:#{window_index}.#{pane_index}' -x '#{pane_left}' -y '#{pane_top}' -w 64 -h 10 -E '$self note prompt #{pane_id}'" \
    "Clear note" c "run-shell -b '$self note clear #{pane_id} && $tmux_cmd display-message \"pane note cleared\"'" \
    "" "" "" \
    "Marker default" 0 "run-shell -b '$self marker set #{pane_id} default && $tmux_cmd display-message \"pane marker default\"'" \
    "Marker amber" 1 "run-shell -b '$self marker set #{pane_id} amber && $tmux_cmd display-message \"pane marker amber\"'" \
    "Marker green" 2 "run-shell -b '$self marker set #{pane_id} green && $tmux_cmd display-message \"pane marker green\"'" \
    "Marker blue" 3 "run-shell -b '$self marker set #{pane_id} blue && $tmux_cmd display-message \"pane marker blue\"'" \
    "Dim pane" 4 "run-shell -b '$self marker set #{pane_id} dim && $tmux_cmd display-message \"pane dimmed\"'" \
    "" "" "" \
    "Sync pane" s "run-shell -b '$self note sync #{pane_id} && $tmux_cmd display-message \"pane note synced\"'" \
    "Sync all notes" a "run-shell -b '$self note sync all && $tmux_cmd display-message \"pane notes synced\"'" \
    "" "" "" \
    "Split horizontal" h "split-window -h -c '#{pane_current_path}'" \
    "Split vertical" V "split-window -v -c '#{pane_current_path}'" \
    "#{?#{>:#{window_panes},1},,-}Swap Up" u "swap-pane -U" \
    "#{?#{>:#{window_panes},1},,-}Swap Down" d "swap-pane -D" \
    "#{?pane_marked_set,,-}Swap Marked" S "swap-pane" \
    "#{?pane_marked,Unmark,Mark}" m "select-pane -m" \
    "#{?window_zoomed_flag,Unzoom,Zoom}" z "resize-pane -Z" \
    "Respawn" R "respawn-pane -k" \
    "Kill" X "kill-pane" 2>/dev/null || true
}

install_agent_status_menu() {
  local self tmux_cmd mouse_passthrough_expr
  self="$(tt_self_command)"
  tmux_cmd="$(shell_quote "$TMUX_BIN")"
  mouse_passthrough_expr='#{||:#{==:#{pane_current_command},mosh-client},#{==:#{pane_current_command},ssh}}'

  "$TMUX_BIN" bind-key N display-popup -t "#{pane_id}" -T "note: #{session_name}:#{window_index}.#{pane_index}" -x "#{pane_left}" -y "#{pane_top}" -w 84 -h 24 -E "$self note edit #{pane_id}" 2>/dev/null || true
  "$TMUX_BIN" bind-key -T root MouseDown3Pane if-shell -F "$mouse_passthrough_expr" "select-pane -t = \\; send-keys -M" "run-shell -b '$self pane-menu #{pane_id} #{mouse_x} #{mouse_y} #{client_name}'" 2>/dev/null || true

  "$TMUX_BIN" bind-key -T root MouseDown1StatusRight run-shell -b "$self codex-snapshot --quiet && $tmux_cmd display-message 'codex snapshot saved'" 2>/dev/null || true
  "$TMUX_BIN" bind-key -T root MouseDown3StatusRight display-menu -T "CX SAVE" -x M -y W \
    "Save now" s "run-shell -b '$self codex-snapshot --quiet && $tmux_cmd display-message \"codex snapshot saved\"'" \
    "Show snapshot" v "display-popup -w 95% -h 80% -E '$self popup snapshot'" \
    "Restore preview" p "display-popup -w 95% -h 80% -E '$self popup restore-preview'" \
    "Snapshot history" h "display-popup -w 95% -h 80% -E '$self popup snapshot-history'" \
    "Status" t "display-popup -w 95% -h 80% -E '$self popup status'" \
    "Doctor" d "display-popup -w 95% -h 80% -E '$self popup doctor'" \
    "Mobile pane picker" m "display-popup -w 95% -h 80% -E '$self mobile'" \
    "" "" "" \
    "Autosave on" o "run-shell -b '$self autosave on && $tmux_cmd display-message \"codex autosave on\"'" \
    "Autosave off" f "run-shell -b '$self autosave off && $tmux_cmd display-message \"codex autosave off\"'" 2>/dev/null || true

  "$TMUX_BIN" set-hook -g "after-select-pane[92]" "run-shell -b '$self attention-reset #{pane_id}'" 2>/dev/null || true
  "$TMUX_BIN" set-hook -g "after-select-window[92]" "run-shell -b '$self attention-reset #{pane_id}'" 2>/dev/null || true
}

set_agent_autosave_hooks() {
  local self="$1"

  "$TMUX_BIN" set-hook -g "after-new-session[90]" "run-shell -b '$self snapshot --quiet'" &&
    "$TMUX_BIN" set-hook -g "after-new-window[90]" "run-shell -b '$self snapshot --quiet'" &&
    "$TMUX_BIN" set-hook -g "after-split-window[90]" "run-shell -b '$self snapshot --quiet'" &&
    "$TMUX_BIN" set-hook -g "after-kill-pane[90]" "run-shell -b '$self snapshot --quiet'" &&
    "$TMUX_BIN" set-hook -g "pane-exited[90]" "run-shell -b '$self snapshot --quiet'" &&
    "$TMUX_BIN" set-hook -g "after-new-session[91]" "run-shell -b '$self codex-snapshot --quiet'" &&
    "$TMUX_BIN" set-hook -g "after-new-window[91]" "run-shell -b '$self codex-snapshot --quiet'" &&
    "$TMUX_BIN" set-hook -g "after-split-window[91]" "run-shell -b '$self codex-snapshot --quiet'" &&
    "$TMUX_BIN" set-hook -g "after-kill-pane[91]" "run-shell -b '$self codex-snapshot --quiet'" &&
    "$TMUX_BIN" set-hook -g "pane-exited[91]" "run-shell -b '$self codex-snapshot --quiet'"
}

unset_agent_autosave_hooks() {
  "$TMUX_BIN" set-hook -gu "after-new-session[90]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-new-window[90]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-split-window[90]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-kill-pane[90]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "pane-exited[90]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-new-session[91]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-new-window[91]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-split-window[91]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-kill-pane[91]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "pane-exited[91]" 2>/dev/null || true
}

agent_autosave_hooks_present() {
  local hook
  for hook in after-new-session after-new-window after-split-window after-kill-pane pane-exited; do
    if "$TMUX_BIN" show-hooks -g "$hook" 2>/dev/null |
      grep -q '\[9[01]\].*run-shell.*snapshot --quiet'; then
      return 0
    fi
  done
  return 1
}

agent_autosave_hooks_healthy() {
  local hook hooks
  for hook in after-new-session after-new-window after-split-window after-kill-pane pane-exited; do
    hooks="$("$TMUX_BIN" show-hooks -g "$hook" 2>/dev/null || true)"
    printf '%s\n' "$hooks" | grep -q '\[90\].*run-shell.* snapshot --quiet' || return 1
    printf '%s\n' "$hooks" | grep -q '\[91\].*run-shell.* codex-snapshot --quiet' || return 1
  done
}

install_agent_autosave_hooks() {
  local self stopped_identity="" identity success_epoch max_age hooks_were_healthy=0 started_new=0
  self="$(tt_self_command)"

  [[ -x "$SCRIPT_DIR/tt-codex-snapshot-writer" ]] || {
    printf 'tt autosave failed: missing executable writer %s\n' "$SCRIPT_DIR/tt-codex-snapshot-writer" >&2
    return 1
  }
  autosave_snapshot_cycle || return
  success_epoch="$(date +%s)"
  max_age="$(codex_snapshot_timer_max_age)"
  agent_autosave_hooks_healthy && hooks_were_healthy=1

  if ! codex_snapshot_timer_lock_acquire; then
    echo "tt: timed out waiting for autosave timer control lock" >&2
    return 1
  fi
  identity="$(codex_snapshot_timer_read_state 2>/dev/null || true)"
  if [[ -n "$identity" ]] && codex_snapshot_timer_identity_valid "$identity"; then
    codex_snapshot_timer_rewrite_success "$identity" "$success_epoch" "$max_age" || {
      codex_snapshot_timer_lock_release
      echo "tt: autosave was not enabled; timer state refresh failed" >&2
      return 1
    }
  elif ! start_codex_snapshot_timer_locked "$success_epoch" "$max_age"; then
    codex_snapshot_timer_lock_release
    echo "tt: autosave was not enabled; timer failed health checks" >&2
    return 1
  else
    started_new=1
  fi
  if ! set_agent_autosave_hooks "$self"; then
    (( hooks_were_healthy != 0 )) || unset_agent_autosave_hooks
    if (( started_new != 0 )); then
      stopped_identity="$(stop_codex_snapshot_timer_locked 2>/dev/null || true)"
    fi
    codex_snapshot_timer_lock_release
    if [[ -n "$stopped_identity" ]]; then
      codex_snapshot_timer_stop_identity "$stopped_identity"
      codex_snapshot_timer_remove_identity_state "$stopped_identity"
    fi
    echo "tt: autosave was not enabled; timer or hooks failed health checks" >&2
    return 1
  fi
  codex_snapshot_timer_lock_release

  install_agent_status_menu
  clear_legacy_shell_status_widgets
  set_agent_window_status_formats
  sync_pane_markers all
  refresh_agent_window_state
  enforce_static_tmux_status --quiet || true
}

clear_agent_autosave_hooks() {
  local stopped_identity=""

  if ! codex_snapshot_timer_lock_acquire; then
    echo "tt: timed out waiting for autosave timer control lock" >&2
    return 1
  fi
  unset_agent_autosave_hooks
  stopped_identity="$(stop_codex_snapshot_timer_locked 2>/dev/null || true)"
  codex_snapshot_timer_lock_release
  if [[ -n "$stopped_identity" ]]; then
    codex_snapshot_timer_stop_identity "$stopped_identity"
    codex_snapshot_timer_remove_identity_state "$stopped_identity"
  fi
  install_agent_status_menu

  # Remove the unindexed hooks from early versions of this script if they are still present.
  "$TMUX_BIN" set-hook -gu "after-new-session[0]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-new-window[0]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-split-window[0]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "after-kill-pane[0]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "pane-exited[0]" 2>/dev/null || true
  "$TMUX_BIN" set-hook -gu "window-layout-changed[0]" 2>/dev/null || true
}

codex_snapshot_timer_file_uid() {
  portable_stat_value %u %u "$1"
}

codex_snapshot_timer_file_size() {
  portable_stat_value %z %s "$1"
}

codex_snapshot_timer_log() {
  local message="$1"
  local log max size tmp
  log="$(codex_cockpit_timer_log_file)"
  max="${TT_CODEX_SNAPSHOT_TIMER_LOG_MAX_BYTES:-65536}"
  case "$max" in
    ''|*[!0-9]*) max=65536 ;;
  esac
  mkdir -p "$(dirname "$log")" 2>/dev/null || return 0
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$message" >>"$log" 2>/dev/null || return 0
  size="$(codex_snapshot_timer_file_size "$log" 2>/dev/null || printf '0')"
  if [[ "$size" =~ ^[0-9]+$ ]] && (( size > max )); then
    tmp="$(mktemp "$(dirname "$log")/.timer-log.XXXXXX" 2>/dev/null || true)"
    if [[ -n "$tmp" ]]; then
      tail -c "$((max / 2))" "$log" >"$tmp" 2>/dev/null || true
      chmod 600 "$tmp" 2>/dev/null || true
      mv -f "$tmp" "$log" 2>/dev/null || rm -f "$tmp"
    fi
  fi
}

codex_snapshot_timer_read_state() {
  local state_file="${1:-$(codex_cockpit_timer_pid_file)}"
  local version pid server_pid uid token success_epoch max_age extra

  [[ -f "$state_file" && ! -L "$state_file" ]] || return 1
  [[ "$(codex_snapshot_timer_file_uid "$state_file" 2>/dev/null || true)" == "$(id -u)" ]] || return 1
  IFS=$'\t' read -r version pid server_pid uid token success_epoch max_age extra <"$state_file" || return 1
  [[ "$version" == "v1" && "$pid" =~ ^[0-9]+$ && "$server_pid" =~ ^[0-9]+$ &&
    "$uid" =~ ^[0-9]+$ && "$token" =~ ^[A-Za-z0-9._-]+$ &&
    "$success_epoch" =~ ^[0-9]+$ && "$max_age" =~ ^[0-9]+$ && -z "${extra:-}" ]] || return 1
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$pid" "$server_pid" "$uid" "$token" "$success_epoch" "$max_age"
}

codex_snapshot_timer_write_state() {
  local pid="$1"
  local server_pid="$2"
  local uid="$3"
  local token="$4"
  local success_epoch="$5"
  local max_age="$6"
  local state_file dir tmp

  state_file="$(codex_cockpit_timer_pid_file)"
  dir="$(dirname "$state_file")"
  mkdir -p "$dir" || return 1
  tmp="$(mktemp "$dir/.timer-state.XXXXXX")" || return 1
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  if ! printf 'v1\t%s\t%s\t%s\t%s\t%s\t%s\n' "$pid" "$server_pid" "$uid" "$token" "$success_epoch" "$max_age" >"$tmp" ||
    ! mv -f "$tmp" "$state_file"; then
    rm -f "$tmp"
    return 1
  fi
}

codex_snapshot_timer_max_age() {
  local interval="${TT_CODEX_SNAPSHOT_INTERVAL:-300}"
  local minimum="${TT_CODEX_SNAPSHOT_INTERVAL_MIN:-30}"
  local timeout="${TT_SNAPSHOT_TOTAL_TIMEOUT_SECONDS:-30}"
  case "$interval" in ''|*[!0-9]*) interval=300 ;; esac
  case "$minimum" in ''|*[!0-9]*) minimum=30 ;; esac
  case "$timeout" in ''|*[!0-9]*) timeout=30 ;; esac
  (( interval >= minimum )) || interval="$minimum"
  printf '%s\n' "$((interval * 2 + timeout))"
}

codex_snapshot_timer_success_fresh() {
  local identity="$1"
  local pid server_pid uid token success_epoch max_age extra now
  TT_TIMER_SUCCESS_AGE=""
  IFS=$'\t' read -r pid server_pid uid token success_epoch max_age extra <<<"$identity"
  [[ "$success_epoch" =~ ^[0-9]+$ && "$max_age" =~ ^[0-9]+$ ]] || return 1
  now="$(date +%s)"
  TT_TIMER_SUCCESS_AGE=$((now - success_epoch))
  (( TT_TIMER_SUCCESS_AGE >= 0 && TT_TIMER_SUCCESS_AGE <= max_age ))
}

codex_snapshot_timer_rewrite_success() {
  local identity="$1"
  local success_epoch="$2"
  local max_age="$3"
  local pid server_pid uid token ignored current
  IFS=$'\t' read -r pid server_pid uid token ignored <<<"$identity"
  current="$(codex_snapshot_timer_read_state 2>/dev/null || true)"
  [[ "$current" == "$identity" ]] || return 1
  codex_snapshot_timer_write_state "$pid" "$server_pid" "$uid" "$token" "$success_epoch" "$max_age"
}

codex_snapshot_timer_server_pid() {
  local pid
  pid="$("$TMUX_BIN" display-message -p '#{pid}' 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$pid"
}

codex_snapshot_timer_server_matches() {
  local expected="$1"
  [[ "$(codex_snapshot_timer_server_pid 2>/dev/null || true)" == "$expected" ]]
}

codex_snapshot_timer_desired_token() {
  local token
  token="$("$TMUX_BIN" show-options -gqv @tt_codex_snapshot_timer_token 2>/dev/null || true)"
  [[ "$token" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  printf '%s\n' "$token"
}

codex_snapshot_timer_process_uid() {
  ps -p "$1" -o uid= 2>/dev/null | tr -d '[:space:]'
}

codex_snapshot_timer_process_command() {
  ps -p "$1" -o command= 2>/dev/null
}

codex_snapshot_timer_has_server_ancestor() {
  local pid="$1"
  local server_pid="$2"
  local current="$pid"
  local parent
  local depth=0

  while [[ "$current" =~ ^[0-9]+$ ]] && (( current > 1 && depth < 64 )); do
    parent="$(ps -p "$current" -o ppid= 2>/dev/null | tr -d '[:space:]')"
    [[ "$parent" =~ ^[0-9]+$ ]] || return 1
    [[ "$parent" == "$server_pid" ]] && return 0
    [[ "$parent" != "$current" ]] || return 1
    current="$parent"
    depth=$((depth + 1))
  done
  return 1
}

codex_snapshot_timer_identity_valid() {
  local identity="$1"
  local pid server_pid uid token success_epoch max_age extra command desired current_server

  IFS=$'\t' read -r pid server_pid uid token success_epoch max_age extra <<<"$identity"
  [[ "$pid" =~ ^[0-9]+$ && "$server_pid" =~ ^[0-9]+$ && "$uid" =~ ^[0-9]+$ &&
    "$token" =~ ^[A-Za-z0-9._-]+$ && "$success_epoch" =~ ^[0-9]+$ &&
    "$max_age" =~ ^[0-9]+$ && -z "${extra:-}" ]] || return 1
  [[ "$uid" == "$(id -u)" ]] || return 1
  current_server="$(codex_snapshot_timer_server_pid 2>/dev/null || true)"
  [[ "$server_pid" == "$current_server" ]] || return 1
  desired="$(codex_snapshot_timer_desired_token 2>/dev/null || true)"
  [[ "$token" == "$desired" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ "$(codex_snapshot_timer_process_uid "$pid" 2>/dev/null || true)" == "$uid" ]] || return 1
  command="$(codex_snapshot_timer_process_command "$pid" 2>/dev/null || true)"
  [[ "$command" == *" codex-snapshot-loop $token $server_pid $uid"* ]] || return 1
  codex_snapshot_timer_has_server_ancestor "$pid" "$server_pid"
}

codex_snapshot_timer_health() {
  local identity
  TT_TIMER_PID=""
  identity="$(codex_snapshot_timer_read_state 2>/dev/null || true)"
  [[ -n "$identity" ]] || return 1
  codex_snapshot_timer_identity_valid "$identity" || return 1
  codex_snapshot_timer_success_fresh "$identity" || return 1
  TT_TIMER_PID="${identity%%$'\t'*}"
}

codex_snapshot_timer_lock_acquire() {
  local lock owner attempt owner_pid owner_uid owner_time now
  lock="$(codex_cockpit_timer_lock_dir)"
  mkdir -p "$(dirname "$lock")" || return 1
  attempt=0
  while (( attempt < 50 )); do
    if mkdir "$lock" 2>/dev/null; then
      printf '%s\t%s\t%s\n' "$$" "$(id -u)" "$(date +%s)" >"$lock/owner" || {
        rmdir "$lock" 2>/dev/null || true
        return 1
      }
      TT_TIMER_CONTROL_LOCK="$lock"
      return 0
    fi
    if [[ -d "$lock" && ! -L "$lock" &&
      "$(codex_snapshot_timer_file_uid "$lock" 2>/dev/null || true)" == "$(id -u)" ]]; then
      owner="$lock/owner"
      owner_pid="" owner_uid="" owner_time=""
      if [[ -f "$owner" && ! -L "$owner" ]]; then
        IFS=$'\t' read -r owner_pid owner_uid owner_time <"$owner" || true
      fi
      now="$(date +%s)"
      if [[ "$owner_uid" == "$(id -u)" && "$owner_pid" =~ ^[0-9]+$ &&
        "$owner_time" =~ ^[0-9]+$ ]] && kill -0 "$owner_pid" 2>/dev/null &&
        (( now - owner_time < 15 )); then
        :
      elif [[ "$owner_time" =~ ^[0-9]+$ ]] && (( now - owner_time >= 5 )); then
        rm -f "$owner" 2>/dev/null || true
        rmdir "$lock" 2>/dev/null || true
        continue
      elif (( attempt >= 10 )); then
        rm -f "$owner" 2>/dev/null || true
        rmdir "$lock" 2>/dev/null || true
        continue
      fi
    fi
    sleep 0.1
    attempt=$((attempt + 1))
  done
  return 1
}

codex_snapshot_timer_lock_release() {
  local lock="${TT_TIMER_CONTROL_LOCK:-}"
  [[ -n "$lock" ]] || return 0
  if [[ -d "$lock" && ! -L "$lock" &&
    "$(codex_snapshot_timer_file_uid "$lock" 2>/dev/null || true)" == "$(id -u)" ]]; then
    rm -f "$lock/owner" 2>/dev/null || true
    rmdir "$lock" 2>/dev/null || true
  fi
  TT_TIMER_CONTROL_LOCK=""
}

codex_snapshot_timer_launch_command() {
  local token="$1"
  local server_pid="$2"
  local uid="$3"
  local success_epoch="$4"
  local max_age="$5"
  local self command state_home

  self="$(tt_self_command)"
  state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  command="exec env"
  command+=" HOME=$(shell_quote "$HOME")"
  command+=" XDG_STATE_HOME=$(shell_quote "$state_home")"
  command+=" TT_TMUX_BIN=$(shell_quote "$TMUX_BIN")"
  command+=" TT_CODEX_SNAPSHOT_INTERVAL=$(shell_quote "${TT_CODEX_SNAPSHOT_INTERVAL:-300}")"
  command+=" TT_CODEX_SNAPSHOT_INTERVAL_MIN=$(shell_quote "${TT_CODEX_SNAPSHOT_INTERVAL_MIN:-30}")"
  command+=" TT_CODEX_SNAPSHOT_TIMER_LOG_MAX_BYTES=$(shell_quote "${TT_CODEX_SNAPSHOT_TIMER_LOG_MAX_BYTES:-65536}")"
  command+=" TT_SNAPSHOT_HISTORY_MAX=$(shell_quote "${TT_SNAPSHOT_HISTORY_MAX:-864}")"
  command+=" TT_SNAPSHOT_COMMAND_TIMEOUT_SECONDS=$(shell_quote "${TT_SNAPSHOT_COMMAND_TIMEOUT_SECONDS:-5}")"
  command+=" TT_SNAPSHOT_TOTAL_TIMEOUT_SECONDS=$(shell_quote "${TT_SNAPSHOT_TOTAL_TIMEOUT_SECONDS:-30}")"
  command+=" TT_CODEX_SNAPSHOT_LOCK_RETRY_ATTEMPTS=$(shell_quote "${TT_CODEX_SNAPSHOT_LOCK_RETRY_ATTEMPTS:-5}")"
  command+=" TT_CODEX_SNAPSHOT_LOCK_RETRY_DELAY_SECONDS=$(shell_quote "${TT_CODEX_SNAPSHOT_LOCK_RETRY_DELAY_SECONDS:-1}")"
  command+=" $self codex-snapshot-loop $(shell_quote "$token") $server_pid $uid $success_epoch $max_age"
  printf '%s\n' "$command"
}

start_codex_snapshot_timer_locked() {
  local success_epoch="$1"
  local max_age="$2"
  local state_file server_pid uid token command attempt identity

  if codex_snapshot_timer_health; then
    return 0
  fi

  state_file="$(codex_cockpit_timer_pid_file)"
  server_pid="$(codex_snapshot_timer_server_pid)" || return 1
  uid="$(id -u)"
  token="v1-$(date +%s)-$$-${RANDOM:-0}-${server_pid}"
  "$TMUX_BIN" set-option -gq @tt_codex_snapshot_timer_token "$token" || return 1
  command="$(codex_snapshot_timer_launch_command "$token" "$server_pid" "$uid" "$success_epoch" "$max_age")"
  if ! "$TMUX_BIN" run-shell -b "$command"; then
    codex_snapshot_timer_unset_token_if_matches "$token" 2>/dev/null || true
    return 1
  fi

  attempt=0
  while (( attempt < 50 )); do
    identity="$(codex_snapshot_timer_read_state 2>/dev/null || true)"
    if [[ -n "$identity" ]] && codex_snapshot_timer_identity_valid "$identity"; then
      return 0
    fi
    sleep 0.1
    attempt=$((attempt + 1))
  done
  codex_snapshot_timer_unset_token_if_matches "$token" 2>/dev/null || true
  codex_snapshot_timer_log "start-failed server=$server_pid token=$token"
  identity="$(codex_snapshot_timer_read_state 2>/dev/null || true)"
  if [[ -n "$identity" ]] && [[ "$(printf '%s\n' "$identity" | cut -f4)" == "$token" ]]; then
    rm -f "$state_file"
    codex_snapshot_timer_stop_identity "$identity"
  fi
  return 1
}

stop_codex_snapshot_timer_locked() {
  local identity="" pid server_pid uid token rest
  identity="$(codex_snapshot_timer_read_state 2>/dev/null || true)"
  if [[ -n "$identity" ]]; then
    IFS=$'\t' read -r pid server_pid uid token rest <<<"$identity"
    codex_snapshot_timer_unset_token_if_matches "$token" 2>/dev/null || true
  else
    "$TMUX_BIN" set-option -gu @tt_codex_snapshot_timer_token 2>/dev/null || true
  fi
  if [[ -z "$identity" ]]; then
    # Legacy pid-only records are retired without signalling an unproven process.
    if [[ -f "$(codex_cockpit_timer_pid_file)" && ! -L "$(codex_cockpit_timer_pid_file)" &&
      "$(codex_snapshot_timer_file_uid "$(codex_cockpit_timer_pid_file)" 2>/dev/null || true)" == "$(id -u)" ]]; then
      rm -f "$(codex_cockpit_timer_pid_file)"
    fi
    return 0
  fi
  printf '%s\n' "$identity"
}

codex_snapshot_timer_unset_token_if_matches() {
  local expected="$1"
  local current
  expected="${expected%%$'\t'*}"
  current="$(codex_snapshot_timer_desired_token 2>/dev/null || true)"
  [[ -n "$expected" && "$current" == "$expected" ]] || return 0
  "$TMUX_BIN" set-option -gu @tt_codex_snapshot_timer_token
}

codex_snapshot_timer_stop_identity() {
  local identity="$1"
  local pid server_pid uid token success_epoch max_age extra attempt current command

  IFS=$'\t' read -r pid server_pid uid token success_epoch max_age extra <<<"$identity"
  [[ "$pid" =~ ^[0-9]+$ && "$server_pid" =~ ^[0-9]+$ && "$uid" == "$(id -u)" &&
    "$token" =~ ^[A-Za-z0-9._-]+$ && "$success_epoch" =~ ^[0-9]+$ &&
    "$max_age" =~ ^[0-9]+$ && -z "${extra:-}" ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  [[ "$(codex_snapshot_timer_process_uid "$pid" 2>/dev/null || true)" == "$uid" ]] || return 0
  command="$(codex_snapshot_timer_process_command "$pid" 2>/dev/null || true)"
  [[ "$command" == *" codex-snapshot-loop $token $server_pid $uid"* ]] || return 0
  codex_snapshot_timer_has_server_ancestor "$pid" "$server_pid" || return 0
  kill -TERM "$pid" 2>/dev/null || return 0
  attempt=0
  while (( attempt < 30 )); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.1
    attempt=$((attempt + 1))
  done
  current="$(codex_snapshot_timer_process_command "$pid" 2>/dev/null || true)"
  if [[ "$(codex_snapshot_timer_process_uid "$pid" 2>/dev/null || true)" == "$uid" &&
    "$current" == *" codex-snapshot-loop $token $server_pid $uid"* ]] &&
    codex_snapshot_timer_has_server_ancestor "$pid" "$server_pid"; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
}

codex_snapshot_timer_remove_identity_state() {
  local expected="$1"
  local identity

  if codex_snapshot_timer_lock_acquire; then
    identity="$(codex_snapshot_timer_read_state 2>/dev/null || true)"
    if codex_snapshot_timer_same_owner "$identity" "$expected"; then
      rm -f "$(codex_cockpit_timer_pid_file)"
    fi
    codex_snapshot_timer_lock_release
  fi
}

codex_snapshot_timer_same_owner() {
  local first="$1" second="$2"
  local fpid fserver fuid ftoken ignored spid sserver suid stoken
  IFS=$'\t' read -r fpid fserver fuid ftoken ignored <<<"$first"
  IFS=$'\t' read -r spid sserver suid stoken ignored <<<"$second"
  [[ "$fpid" == "$spid" && "$fserver" == "$sserver" && "$fuid" == "$suid" && "$ftoken" == "$stoken" ]]
}

codex_snapshot_timer_cleanup() {
  local token="$1"
  local server_pid="$2"
  local uid="$3"
  local identity expected
  expected="$$"$'\t'"$server_pid"$'\t'"$uid"$'\t'"$token"

  if codex_snapshot_timer_lock_acquire; then
    identity="$(codex_snapshot_timer_read_state 2>/dev/null || true)"
    if codex_snapshot_timer_same_owner "$identity" "$expected"; then
      rm -f "$(codex_cockpit_timer_pid_file)"
    fi
    codex_snapshot_timer_unset_token_if_matches "$token" 2>/dev/null || true
    codex_snapshot_timer_lock_release
  fi
}

tmux_server_running() {
  "$TMUX_BIN" list-sessions >/dev/null 2>&1
}

set_recovery_session_indices() {
  local session="$1"
  local first_window_id="$2"
  local first_window_index

  # `base-index` and `pane-base-index` are window options. Keep them local to
  # the recovered session, then move the initial window only when needed.
  # Existing live sessions retain their indexing and layout.
  "$TMUX_BIN" set-option -t "$session" base-index 1
  "$TMUX_BIN" set-option -t "$session" pane-base-index 1
  first_window_index="$("$TMUX_BIN" list-windows -t "$session" -F '#{window_id}	#{window_index}' 2>/dev/null |
    awk -F $'\t' -v wanted="$first_window_id" '$1 == wanted { print $2; exit }')"
  if [[ "$first_window_index" != "1" ]]; then
    "$TMUX_BIN" move-window -s "$first_window_id" -t "$session:1"
  fi
}

recovery_pane_target() {
  local session="$1"
  local logical_window="$2"
  local logical_pane="$3"
  local window_id

  window_id="$("$TMUX_BIN" list-windows -t "$session" -F '#{window_index}	#{window_id}' 2>/dev/null |
    awk -F $'\t' -v wanted="$logical_window" '$1 == wanted { print $2; exit }')"
  [[ -n "$window_id" ]] || return 1

  "$TMUX_BIN" list-panes -t "$window_id" -F '#{pane_index}	#{pane_id}' 2>/dev/null |
    sort -n -k1,1 |
    awk -F $'\t' -v wanted="$logical_pane" 'NR == wanted { print $2; exit }'
}

recovery_snapshot_pane_target() {
  local target="$1"
  local session="${target%%:*}"
  local coordinates="${target#*:}"
  local logical_window="${coordinates%%.*}"
  local logical_pane="${coordinates#*.}"

  [[ "$target" == *:*.* ]] || return 1
  recovery_pane_target "$session" "$logical_window" "$logical_pane"
}

require_recovery_session_absent() {
  local session="$1"

  if "$TMUX_BIN" has-session -t "$session" 2>/dev/null; then
    echo "tt: session '$session' already exists; refusing recovery without replacing it" >&2
    echo "tt: use 'tt codex-restore' for a targeted pane or window restore" >&2
    return 1
  fi
}

require_recovery_manifest_sessions_absent() {
  local manifest="$1"
  local session pane dir title command
  local sessions=" "

  while IFS=$'\t' read -r session pane dir title command || [[ -n "${session:-}" ]]; do
    [[ -n "${session:-}" && "${session:0:1}" != "#" ]] || continue
    [[ "$sessions" == *" $session "* ]] && continue
    sessions="$sessions$session "
    require_recovery_session_absent "$session" || return 1
  done < "$manifest"
}

finish_recovery_setup() {
  local server_was_running="$1"

  # Existing servers may contain unrelated operator work. Do not rewrite their
  # global options, hooks, or snapshots while adding a recovered session.
  if [[ "$server_was_running" != "1" ]]; then
    apply_recovery_theme
    install_agent_autosave_hooks
  fi
}

create_agent_cockpit_sessions() {
  local manifest="$1"
  local preserve_server="${2:-}"
  local recovery_session="${3:-}"
  local session pane dir title command
  local skip_autosave=""
  local sessions=" "

  if [[ "$preserve_server" == "--preserve-server" ]]; then
    skip_autosave="--no-autosave"
  fi

  while IFS=$'\t' read -r session pane dir title command || [[ -n "${session:-}" ]]; do
    [[ -n "${session:-}" && "${session:0:1}" != "#" ]] || continue
    if [[ "$sessions" != *" $session "* ]]; then
      create_studio_detached "$session" "$dir" "$skip_autosave" "$preserve_server" "$recovery_session"
      sessions="$sessions$session "
    fi
  done < "$manifest"
}

restore_agent_cockpit_layouts() {
  local manifest="$1"
  local session pane dir title command
  local sessions=" "

  while IFS=$'\t' read -r session pane dir title command || [[ -n "${session:-}" ]]; do
    [[ -n "${session:-}" && "${session:0:1}" != "#" ]] || continue
    [[ "$sessions" == *" $session "* ]] && continue
    sessions="$sessions$session "
    restore_studio_layout "$session" --preserve-server
  done < "$manifest"
}

launch_agent_cockpit_panes() {
  local manifest="$1"
  local session pane dir title command target kind

  while IFS=$'\t' read -r session pane dir title command || [[ -n "${session:-}" ]]; do
    [[ -n "${session:-}" && "${session:0:1}" != "#" ]] || continue
    target="$(recovery_pane_target "$session" 1 "$pane" 2>/dev/null || true)"
    if [[ -z "$target" ]]; then
      echo "tt: missing recovery pane $session:1.$pane" >&2
      continue
    fi
    kind="$(agent_kind_for_command "$command")"
    "$TMUX_BIN" set-option -pt "$target" @tt_base_title "$title" 2>/dev/null || true
    "$TMUX_BIN" set-option -pt "$target" @tt_agent_command "$command" 2>/dev/null || true
    "$TMUX_BIN" set-option -pt "$target" @tt_agent_kind "$kind" 2>/dev/null || true
    set_pane_git_label "$target" "$dir"
    "$TMUX_BIN" select-pane -t "$target" -T "$title" 2>/dev/null || true

    if [[ -n "${command:-}" ]]; then
      "$TMUX_BIN" respawn-pane -k -t "$target" -c "$dir" "$(agent_pane_command "$command")"
    else
      "$TMUX_BIN" respawn-pane -k -t "$target" -c "$dir" "$(default_login_shell_command)"
    fi
  done < "$manifest"
}

refresh_agent_pane_colors() {
  local session pane dir start_command base_title saved_command command kind count
  count=0

  while IFS=$'\t' read -r session pane dir start_command base_title saved_command || [[ -n "${session:-}" ]]; do
    [[ -n "${session:-}" ]] || continue
    [[ "$session" != ttm-* ]] || continue

    command="$(clean_agent_command "$start_command")"
    if [[ -z "$command" ]]; then
      command="$(clean_agent_command "$saved_command")"
    fi
    kind="$(agent_kind_for_command "$command")"
    case "$kind" in
      CODEX|CLAUDE)
        ;;
      *)
        continue
        ;;
    esac

    "$TMUX_BIN" set-option -pt "$pane" @tt_agent_command "$command" 2>/dev/null || true
    "$TMUX_BIN" set-option -pt "$pane" @tt_agent_kind "$kind" 2>/dev/null || true
    if [[ -n "$base_title" ]]; then
      "$TMUX_BIN" set-option -pt "$pane" @tt_base_title "$base_title" 2>/dev/null || true
      "$TMUX_BIN" select-pane -t "$pane" -T "$base_title" 2>/dev/null || true
    fi
    set_pane_git_label "$pane" "$dir"

    "$TMUX_BIN" respawn-pane -k -t "$pane" -c "$dir" "$(agent_pane_command "$command")"
    count=$((count + 1))
  done < <("$TMUX_BIN" list-panes -a -F '#{session_name}	#{pane_id}	#{pane_current_path}	#{pane_start_command}	#{@tt_base_title}	#{@tt_agent_command}' 2>/dev/null || true)

  write_agent_cockpit_state "$(agent_cockpit_state_file)" --quiet
  restore_studio_layout
  printf 'tt refreshed %s agent panes\n' "$count" >&2
}

recover_agent_cockpit() {
  local manifest="${1:-}"
  local attach_session="${2:-factory2}"
  local server_was_running=0
  local preserve_server=""

  if [[ -n "${TMUX:-}" ]]; then
    echo "tt recover must be run outside tmux; it refuses to replace live sessions" >&2
    exit 2
  fi

  wsl_bridge_ensure_for_entry
  if [[ -z "$manifest" || "$manifest" == "--default" ]]; then
    manifest="$(agent_cockpit_manifest)"
  fi
  [[ -f "$manifest" ]] || { echo "agent cockpit manifest not found: $manifest" >&2; exit 2; }
  manifest_has_entries "$manifest" || { echo "agent cockpit manifest has no sessions: $manifest" >&2; exit 2; }
  require_recovery_manifest_sessions_absent "$manifest" || exit 2

  tmux_server_running && server_was_running=1
  if [[ "$server_was_running" == "1" ]]; then
    preserve_server="--preserve-server"
  fi
  create_agent_cockpit_sessions "$manifest" "$preserve_server" --recovery-session
  finish_recovery_setup "$server_was_running"
  launch_agent_cockpit_panes "$manifest"
  restore_agent_cockpit_layouts "$manifest"
  if [[ "$server_was_running" != "1" ]]; then
    write_agent_cockpit_state "$(agent_cockpit_state_file)" --quiet
  fi

  wsl_bridge_ensure_for_entry
  if [[ -n "${TMUX:-}" ]]; then
    exec "$TMUX_BIN" switch-client -t "$attach_session"
  fi

  exec "$TMUX_BIN" attach -t "$attach_session"
}

snapshot_has_session() {
  local snapshot="$1"
  local session="${2:-cockpit}"

  [[ -f "$snapshot" ]] || return 1
  awk -F '\t' -v prefix="$session:" '$1 !~ /^#/ && index($1, prefix) == 1 { found=1 } END { exit found ? 0 : 1 }' "$snapshot"
}

snapshot_has_recoverable_session() {
  local snapshot="$1"
  local session="${2:-cockpit}"

  [[ -f "$snapshot" ]] || return 1
  awk -F '\t' -v prefix="$session:" '$1 !~ /^#/ && index($1, prefix) == 1 && $2 == "codex" && $7 == "exact" { found=1 } END { exit found ? 0 : 1 }' "$snapshot"
}

latest_cockpit_snapshot() {
  local requested="${1:-}"
  local session="${2:-cockpit}"
  local snapshot history_dir

  if [[ -n "$requested" && "$requested" != "--default" ]]; then
    [[ -f "$requested" ]] || { echo "codex snapshot not found: $requested" >&2; return 1; }
    snapshot_has_recoverable_session "$requested" "$session" || { echo "codex snapshot has no recoverable $session sessions: $requested" >&2; return 1; }
    printf '%s\n' "$requested"
    return 0
  fi

  snapshot="$(codex_cockpit_snapshot_file)"
  if snapshot_has_recoverable_session "$snapshot" "$session"; then
    printf '%s\n' "$snapshot"
    return 0
  fi

  history_dir="$(snapshot_history_dir codex-cockpit)"
  while IFS= read -r snapshot; do
    [[ -n "$snapshot" ]] || continue
    if snapshot_has_recoverable_session "$snapshot" "$session"; then
      printf '%s\n' "$snapshot"
      return 0
    fi
  done < <(find "$history_dir" -maxdepth 1 -type f -name '*.tsv' -print 2>/dev/null | sort -r)

  echo "no CX snapshot found for $session" >&2
  return 1
}

restore_cockpit_snapshot() {
  local snapshot="$1"
  local session="${2:-cockpit}"
  local mode="${3:-}"
  local target restore_target kind cwd title current_command session_id row_status restore shell_command restored=0

  while IFS=$'\t' read -r target kind cwd title current_command session_id row_status restore || [[ -n "${target:-}" ]]; do
    [[ -n "${target:-}" && "${target:0:1}" != "#" ]] || continue
    [[ "$target" == "$session:"* ]] || continue

    restore_target="$(recovery_snapshot_pane_target "$target" 2>/dev/null || true)"
    if [[ -z "$restore_target" ]]; then
      echo "tt: missing recovery pane $target" >&2
      continue
    fi
    shell_command="cd $(shell_quote "$cwd") && exec $(default_login_shell_command)"
    "$TMUX_BIN" select-pane -t "$restore_target" -T "$title" 2>/dev/null || true
    "$TMUX_BIN" respawn-pane -k -t "$restore_target" "$shell_command" 2>/dev/null || true
  done < "$snapshot"

  while IFS=$'\t' read -r target kind cwd title current_command session_id row_status restore || [[ -n "${target:-}" ]]; do
    [[ -n "${target:-}" && "${target:0:1}" != "#" ]] || continue
    [[ "$target" == "$session:"* ]] || continue
    [[ "$kind" == "codex" && "$row_status" == "exact" && -n "$restore" ]] || continue

    restore_target="$(recovery_snapshot_pane_target "$target" 2>/dev/null || true)"
    if [[ -z "$restore_target" ]]; then
      echo "tt: missing recovery pane $target" >&2
      continue
    fi
    "$TMUX_BIN" respawn-pane -k -t "$restore_target" -c "$cwd" "$(agent_pane_command "codex resume --no-alt-screen $session_id")" 2>/dev/null || true
    restored=$((restored + 1))
  done < "$snapshot"

  restore_studio_layout "$session" "$mode"
  apply_studio_pane_titles "$session"
  printf 'tt restored %s exact Codex pane(s)\n' "$restored" >&2
}

recover_cockpit() {
  local snapshot="${1:-}"
  local session="${2:-cockpit}"
  local server_was_running=0
  local preserve_server=""

  if [[ -n "${TMUX:-}" ]]; then
    echo "tt recover must be run outside tmux; it refuses to replace a live session" >&2
    exit 2
  fi

  wsl_bridge_ensure_for_entry
  snapshot="$(latest_cockpit_snapshot "$snapshot" "$session")" || exit 2
  printf 'tt recovering %s from %s\n' "$session" "$snapshot" >&2

  require_recovery_session_absent "$session" || exit 2
  if [[ "$session" == "cockpit" ]]; then
    # create_ops_detached historically reclaims an idle "ops" session. Recovery
    # must not claim or delete any existing session, even an apparently idle one.
    require_recovery_session_absent "ops" || exit 2
  fi
  tmux_server_running && server_was_running=1
  if [[ "$server_was_running" == "1" ]]; then
    preserve_server="--preserve-server"
  fi
  create_ops_detached "$session" "$HOME" --no-shell-upgrade "$preserve_server" --recovery-session
  finish_recovery_setup "$server_was_running"
  restore_cockpit_snapshot "$snapshot" "$session" --preserve-server

  wsl_bridge_ensure_for_entry
  exec "$TMUX_BIN" attach -t "$session"
}

reset_to_profile() {
  local profile="$1"
  local session="${2:-}"

  wsl_bridge_release_server_mount
  kill_server force

  case "$profile" in
    ai|studio)
      create_studio "${session:-studio}"
      ;;
    shell|plain)
      create_plain "${session:-main}"
      ;;
    mobile|phone)
      create_mobile "${session:-mobile}"
      ;;
    *)
      echo "unknown reset profile: $profile" >&2
      exit 2
      ;;
  esac
}

list_sessions() {
  "$TMUX_BIN" list-sessions -F '#S' 2>/dev/null || true
}

session_summary() {
  local session="$1"
  local pane_count profile window_count
  profile="$("$TMUX_BIN" show-options -t "$session" -qv @tt_profile 2>/dev/null || true)"
  if [[ -n "$profile" ]]; then
    printf '%s' "$profile"
    return 0
  fi

  pane_count="$("$TMUX_BIN" list-panes -t "$session" 2>/dev/null | wc -l | tr -d ' ')"
  window_count="$("$TMUX_BIN" list-windows -t "$session" 2>/dev/null | wc -l | tr -d ' ')"

  if [[ "$pane_count" == "6" && "$window_count" == "1" ]]; then
    printf 'studio'
  else
    printf 'plain'
  fi
}

profile_label() {
  case "$1" in
    studio)
      printf 'ai'
      ;;
    plain)
      printf 'shell'
      ;;
    mobile)
      printf 'mobile'
      ;;
    *)
      printf '%s' "$1"
      ;;
  esac
}

choose_with_fzf() {
  command -v fzf >/dev/null 2>&1 || return 1
  printf '%s\n' "$@" | fzf --prompt='tt > ' --height=40% --layout=reverse --border
}

choose_with_select() {
  local options=("$@")
  local choice
  PS3="tt> "

  select choice in "${options[@]}"; do
    [[ -n "${choice:-}" ]] || continue
    printf '%s\n' "$choice"
    return 0
  done
}

choose_option() {
  local options=("$@")
  local selected

  if selected="$(choose_with_fzf "${options[@]}")"; then
    printf '%s\n' "$selected"
    return 0
  fi

  choose_with_select "${options[@]}"
}

prompt_session_name() {
  local prompt="${1:-session name}"
  local default_name="${2:-}"
  local value

  if [[ -n "$default_name" ]]; then
    printf '%s [%s]: ' "$prompt" "$default_name" >&2
    read -r value
    [[ "$value" == "--" ]] && value=""
    printf '%s\n' "${value:-$default_name}"
  else
    printf '%s: ' "$prompt" >&2
    read -r value
    printf '%s\n' "$value"
  fi
}

run_menu() {
  local session selection summary cockpit_option
  local -a options=()

  cockpit_option="new     [cockpit] $(cockpit_topology_label) cockpit"
  while IFS= read -r session; do
    [[ -n "$session" ]] || continue
    summary="$(session_summary "$session")"
    options+=("attach  [$(profile_label "$summary")]  $session")
  done < <(list_sessions)

  options+=("new     [ai]     agent cockpit (3x2)")
  options+=("$cockpit_option")
  options+=("new     [shell]  normal tmux session")
  options+=("new     [mobile] phone-sized tmux session")
  options+=("reset   [ai]     kill server + fresh agent cockpit")
  options+=("reset   [shell]  kill server + fresh shell session")
  options+=("reset   [mobile] kill server + fresh phone session")
  options+=("restore [layout] unzoom windows + retile 6-pane sessions")
  options+=("restore [preview] Codex/Claude restore map")
  options+=("recover [cockpit] rebuild CX-saved cockpit")
  options+=("recover [agents] rebuild saved agent cockpit")
  options+=("snapshot [agents] save live agent cockpit")
  options+=("snapshot [codex]  save Codex/Claude restore map")
  options+=("snapshot [history] list capped snapshots")
  options+=("autosave [on]    keep agent snapshot warm")
  options+=("autosave [off]   disable agent snapshot hooks")
  options+=("refresh [agents] respawn agents with color env")
  options+=("sync    [pane]   refresh branch/worktree label")
  options+=("title   [pane]   set current pane title")
  options+=("colorfix [theme]  reapply tmux colors/env")
  options+=("titles  [on]     show pane title bars")
  options+=("titles  [off]    hide pane title bars")
  options+=("kill    [all]    stop tmux server")

  selection="$(choose_option "${options[@]}")"

  case "$selection" in
    attach*)
      attach_or_switch "${selection##*  }"
      ;;
    "new     [ai]     agent cockpit (3x2)")
      session="$(prompt_session_name "ai session" "studio")"
      [[ -n "$session" ]] || exit 1
      create_studio "$session"
      ;;
    "$cockpit_option")
      session="$(prompt_session_name "cockpit session" "cockpit")"
      [[ -n "$session" ]] || exit 1
      create_ops "$session"
      ;;
    "new     [shell]  normal tmux session")
      session="$(prompt_session_name "shell session")"
      [[ -n "$session" ]] || exit 1
      create_plain "$session"
      ;;
    "new     [mobile] phone-sized tmux session")
      session="$(prompt_session_name "mobile session" "mobile")"
      [[ -n "$session" ]] || exit 1
      create_mobile "$session"
      ;;
    "reset   [ai]     kill server + fresh agent cockpit")
      session="$(prompt_session_name "fresh ai session" "studio")"
      [[ -n "$session" ]] || exit 1
      reset_to_profile ai "$session"
      ;;
    "reset   [shell]  kill server + fresh shell session")
      session="$(prompt_session_name "fresh shell session" "main")"
      [[ -n "$session" ]] || exit 1
      reset_to_profile shell "$session"
      ;;
    "reset   [mobile] kill server + fresh phone session")
      session="$(prompt_session_name "fresh mobile session" "mobile")"
      [[ -n "$session" ]] || exit 1
      reset_to_profile mobile "$session"
      ;;
    "restore [layout] unzoom windows + retile 6-pane sessions")
      restore_studio_layout
      ;;
    "restore [preview] Codex/Claude restore map")
      restore_preview
      ;;
    "recover [cockpit] rebuild CX-saved cockpit")
      recover_cockpit
      ;;
    "recover [agents] rebuild saved agent cockpit")
      recover_agent_cockpit
      ;;
    "snapshot [agents] save live agent cockpit")
      write_agent_cockpit_state
      ;;
    "snapshot [codex]  save Codex/Claude restore map")
      write_codex_cockpit_snapshot
      ;;
    "snapshot [history] list capped snapshots")
      list_snapshot_history
      ;;
    "autosave [on]    keep agent snapshot warm")
      install_agent_autosave_hooks
      write_agent_cockpit_state
      write_codex_cockpit_snapshot "$(codex_cockpit_snapshot_file)" --quiet
      ;;
    "autosave [off]   disable agent snapshot hooks")
      clear_agent_autosave_hooks
      ;;
    "refresh [agents] respawn agents with color env")
      refresh_agent_pane_colors
      ;;
    "sync    [pane]   refresh branch/worktree label")
      sync_agent_pane_context "${TMUX_PANE:-all}"
      ;;
    "title   [pane]   set current pane title")
      title="$(prompt_session_name "pane title")"
      [[ -n "$title" ]] || exit 1
      set_agent_pane_title "$title"
      ;;
    "colorfix [theme]  reapply tmux colors/env")
      apply_recovery_theme
      install_agent_autosave_hooks
      ;;
    "titles  [on]     show pane title bars")
      apply_agent_manifest_metadata "$(agent_cockpit_manifest)"
      apply_studio_pane_titles "${TMUX_PANE:-}"
      ;;
    "titles  [off]    hide pane title bars")
      clear_studio_pane_titles "${TMUX_PANE:-}"
      ;;
    "kill    [all]    stop tmux server")
      kill_server
      ;;
    *)
      echo "unknown selection: $selection" >&2
      exit 1
      ;;
  esac
}

case "${1:-}" in
  "")
    run_menu
    ;;
  ai|studio)
    create_studio "${2:-studio}"
    ;;
  ops|cockpit)
    create_ops "${2:-cockpit}"
    ;;
  upgrade-ops-shells)
    upgrade_ops_shells "${2:-cockpit}"
    ;;
  shell|plain)
    if [[ -n "${2:-}" ]]; then
      create_plain "$2"
    else
  session="$(prompt_session_name "shell session")"
      [[ -n "$session" ]] || exit 1
      create_plain "$session"
    fi
    ;;
  mobile|phone)
    if [[ -n "${2:-}" ]]; then
      create_mobile "$2"
    elif target="$(mobile_choose_pane_target)"; then
      attach_mobile_target "$target"
    else
      status=$?
      if [[ "$status" == "1" ]]; then
        create_mobile "mobile"
      fi
      exit "$status"
    fi
    ;;
  reset)
    profile="${2:-ai}"
    case "$profile" in
      ai|studio)
        reset_to_profile ai "${3:-studio}"
        ;;
      shell|plain)
        reset_to_profile shell "${3:-main}"
        ;;
      mobile|phone)
        reset_to_profile mobile "${3:-mobile}"
        ;;
      *)
        echo "usage: tt reset [ai|shell|mobile] [session]" >&2
        exit 2
        ;;
    esac
    ;;
  restore)
    restore_studio_layout "${2:-}"
    ;;
  restore-preview)
    restore_preview "${2:-}"
    ;;
  recover)
    case "${2:-cockpit}" in
      cockpit|ops|--default)
        recover_cockpit "${3:-}" "cockpit"
        ;;
      agents|agent|factory|factory2)
        recover_agent_cockpit "${3:-}" "${4:-factory2}"
        ;;
      *)
        echo "usage: tt recover [cockpit [snapshot]|agents [manifest] [attach-session]]" >&2
        exit 2
        ;;
    esac
    ;;
  snapshot|backup|save)
    if [[ "${2:-}" == "--quiet" ]]; then
      write_agent_cockpit_state "" --quiet
    else
      write_agent_cockpit_state "${2:-}" "${3:-}"
    fi
    ;;
  codex-snapshot|cx-snapshot)
    if [[ "${2:-}" == "--quiet" ]]; then
      write_codex_cockpit_snapshot "" --quiet
    else
      write_codex_cockpit_snapshot "${2:-}" "${3:-}"
    fi
    ;;
  codex-snapshot-show|cx-snapshot-show)
    show_codex_snapshot "${2:-}"
    ;;
  snapshot-history)
    list_snapshot_history "${2:-codex-cockpit}" "${3:-40}"
    ;;
  status)
    status_report
    ;;
  doctor)
    doctor_tmux "${2:---fix}"
    ;;
  popup)
    popup_view "${2:-snapshot}"
    ;;
  codex-restore|cx-restore)
    codex_restore_execute "${2:-preview}" "${3:-}" "${4:-}" "${5:-}"
    ;;
  codex-snapshot-loop)
    codex_snapshot_timer_loop "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}"
    ;;
  mosh-attn)
    sync_mosh_attention_panes "${2:-}"
    ;;
  wsl-bridge)
    case "${2:-ensure}" in
      ensure)
        wsl_bridge_ensure
        ;;
      *)
        echo "usage: tt wsl-bridge ensure" >&2
        exit 2
        ;;
    esac
    ;;
  pane-menu)
    show_pane_menu "${2:-${TMUX_PANE:-}}" "${3:-P}" "${4:-P}" "${5:-}"
    ;;
  autosave)
    case "${2:-on}" in
      on)
        install_agent_autosave_hooks
        ;;
      off)
        clear_agent_autosave_hooks
        ;;
      *)
        echo "usage: tt autosave [on|off]" >&2
        exit 2
        ;;
    esac
    ;;
  refresh)
    case "${2:-agents}" in
      agents|agent|colors|color)
        refresh_agent_pane_colors
        ;;
      *)
        echo "usage: tt refresh [agents]" >&2
        exit 2
        ;;
    esac
    ;;
  sync)
    sync_agent_pane_context "${2:-${TMUX_PANE:-all}}"
    ;;
  note)
    case "${2:-list}" in
      set)
        target="${3:-${TMUX_PANE:-}}"
        shift 3 || true
        set_pane_note "$target" "$@"
        ;;
      clear)
        clear_pane_note "${3:-${TMUX_PANE:-}}"
        ;;
      show)
        show_pane_note "${3:-${TMUX_PANE:-}}"
        ;;
      edit)
        edit_pane_note "${3:-${TMUX_PANE:-}}"
        ;;
      prompt)
        prompt_pane_note "${3:-${TMUX_PANE:-}}"
        ;;
      sync)
        sync_pane_notes "${3:-all}"
        ;;
      list)
        list_pane_notes
        ;;
      *)
        echo "usage: tt note [set <pane> <note>|clear <pane>|show <pane>|edit <pane>|prompt <pane>|sync [pane|all]|list]" >&2
        exit 2
        ;;
    esac
    ;;
  marker)
    case "${2:-list}" in
      set)
        set_pane_marker "${3:-${TMUX_PANE:-}}" "${4:-default}"
        ;;
      clear|default)
        set_pane_marker "${3:-${TMUX_PANE:-}}" default
        ;;
      sync)
        sync_pane_markers "${3:-all}"
        ;;
      list)
        list_pane_markers
        ;;
      *)
        echo "usage: tt marker [set <pane> default|amber|green|blue|dim|clear <pane>|sync [pane|all]|list]" >&2
        exit 2
        ;;
    esac
    ;;
  title)
    if [[ -n "${3:-}" ]]; then
      target="$2"
      shift 2
      set_agent_pane_title "$target" "$@"
    else
      set_agent_pane_title "${2:-}"
    fi
    ;;
  colorfix)
    apply_recovery_theme
    install_agent_autosave_hooks
    ;;
  status-audit)
    enforce_static_tmux_status
    ;;
  attention-reset)
    reset_agent_attention_pane "${2:-${TMUX_PANE:-}}"
    ;;
  titles)
    case "${2:-on}" in
      on)
        apply_agent_manifest_metadata "$(agent_cockpit_manifest)"
        apply_studio_pane_titles "${3:-}"
        ;;
      off)
        clear_studio_pane_titles "${3:-}"
        ;;
      *)
        echo "usage: tt titles [on|off] [target]" >&2
        exit 2
        ;;
    esac
    ;;
  kill)
    kill_server
    ;;
  attach)
    [[ -n "${2:-}" ]] || { echo "usage: tt attach <session>" >&2; exit 2; }
    attach_or_switch "$2"
    ;;
  ls)
    list_sessions
    ;;
  *)
    if "$TMUX_BIN" has-session -t "$1" 2>/dev/null; then
      attach_or_switch "$1"
    else
      echo "usage: tt [ai [session]|ops [session]|shell [session]|mobile [session]|reset [ai|shell|mobile] [session]|restore [target]|restore-preview [snapshot]|recover [manifest] [attach-session]|snapshot [file] [--quiet]|codex-snapshot [file] [--quiet]|codex-snapshot-show [snapshot]|snapshot-history [codex-cockpit|agent-cockpit] [limit]|status|doctor [--fix|--check]|popup [snapshot|restore-preview|snapshot-history|status|doctor]|codex-restore [preview|all|pane <target>|window <session:window>] [snapshot] [--execute]|autosave [on|off]|refresh [agents]|sync [target|all]|note [set|clear|show|edit|prompt|sync|list]|marker [set|clear|sync|list]|title [target] <short-title>|colorfix|status-audit|titles [on|off] [target]|wsl-bridge ensure|kill|attach <session>|ls]" >&2
      exit 2
    fi
    ;;
esac
