#!/usr/bin/env bash
set -euo pipefail

state="${1:-reset}"
case "$state" in
  waiting) style='fg=default,bg=#241d12'; active='fg=default,bg=#2f2517' ;;
  permission|approve) state=approve; style='fg=default,bg=#2b1720'; active='fg=default,bg=#361b27' ;;
  reset|active|idle|clear) state=reset; style=; active= ;;
  *) printf 'usage: agent-attn-set [waiting|permission|reset] [codex|claude]\n' >&2; exit 2 ;;
esac

# Hooks without their own pane must not discover or modify a default server.
[[ -n "${TMUX:-}" && "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0
socket="${TMUX%,*}"
server="${socket##*,}"
socket="${socket%,*}"
[[ "$server" =~ ^[0-9]+$ && "$socket" == /* && -S "$socket" && -O "$socket" ]] || exit 0
tmux_command=(tmux -N -S "$socket")
pane="$TMUX_PANE"

# The hook process must descend from the target pane, not merely inherit its ID.
pane_pid="$("${tmux_command[@]}" display-message -p -t "$pane" '#{pid}|#{pane_id}|#{pane_pid}|#{pane_dead}' 2>/dev/null)" || exit 0
IFS='|' read -r actual_server actual_pane pane_pid dead <<<"$pane_pid"
[[ "$actual_server" == "$server" && "$actual_pane" == "$pane" &&
   "$pane_pid" =~ ^[0-9]+$ && "$dead" == 0 ]] || exit 0
ancestor="$$"
parents=
if [[ ! -r "/proc/$$/stat" ]]; then
  parents="$(ps -axo pid=,ppid= 2>/dev/null)" || exit 0
fi
for ((depth=0; depth<128 && ancestor>1 && ancestor!=pane_pid; depth++)); do
  parent=
  if [[ -r "/proc/$ancestor/stat" ]]; then
    IFS= read -r process_stat <"/proc/$ancestor/stat" || exit 0
    process_stat="${process_stat##*) }"
    read -r _ parent _ <<<"$process_stat"
  else
    while read -r candidate candidate_parent; do
      if [[ "$candidate" == "$ancestor" ]]; then parent="$candidate_parent"; break; fi
    done <<<"$parents"
  fi
  [[ "$parent" =~ ^[0-9]+$ && "$parent" != "$ancestor" ]] || exit 0
  ancestor="$parent"
done
[[ "$ancestor" == "$pane_pid" ]] || exit 0

format='#{pid}|#{pane_id}|#{pane_pid}|#{@tt_marker}|#{window-style}|#{window-active-style}'
details="$("${tmux_command[@]}" display-message -p -t "$pane" "$format" 2>/dev/null)" || exit 0
IFS='|' read -r actual_server actual_pane actual_pid marker old_style old_active extra <<<"$details"
[[ "$actual_server" == "$server" && "$actual_pane" == "$pane" &&
   "$actual_pid" == "$pane_pid" && -z "$extra" ]] || exit 0
# Explicit user markers and custom styles/titles are not owned by this hook.
[[ -z "$marker" ]] || exit 0
# No -A: an inherited/global value is not proof that this hook owns the pane.
old_state="$("${tmux_command[@]}" show-option -pt "$pane" -qv @agent_attention_state 2>/dev/null)" || exit 0
case "$old_state" in waiting|approve|'') ;; *) exit 0 ;; esac
if [[ "$state" == "$old_state" && "$style" == "$old_style" && "$active" == "$old_active" ]]; then
  exit 0
fi
attention_style() {
  [[ "$1|$2" == 'fg=default,bg=#241d12|fg=default,bg=#2f2517' ||
     "$1|$2" == 'fg=default,bg=#2b1720|fg=default,bg=#361b27' ]]
}

commands=
add_option() {
  local option="$1" value="${2:-}"
  # Saved styles are data, never tmux command syntax.
  [[ "$value" != *[!a-zA-Z0-9#=,.\ _-]* ]] || return 1
  if [[ -n "$value" ]]; then
    commands+="set-option -pt $pane $option '$value'; "
  else
    commands+="set-option -pqu -t $pane $option; "
  fi
}

if [[ "$state" == reset ]]; then
  [[ -n "$old_state" ]] || exit 0
  if attention_style "$old_style" "$old_active"; then
    add_option window-style
    add_option window-active-style
  fi
  add_option @agent_attention_state
else
  if [[ -z "$old_state" ]]; then
    local_style="$("${tmux_command[@]}" show-option -pt "$pane" -qv window-style 2>/dev/null)" || exit 0
    local_active="$("${tmux_command[@]}" show-option -pt "$pane" -qv window-active-style 2>/dev/null)" || exit 0
    # Do not take ownership of existing explicit styling.
    [[ -z "$local_style" && -z "$local_active" ]] || exit 0
  elif ! attention_style "$old_style" "$old_active"; then
    exit 0
  fi
  add_option window-style "$style"
  add_option window-active-style "$active"
  add_option @agent_attention_state "$state"
fi

# Recheck the target inside tmux's command queue before applying pane-only options.
guard="#{&&:#{==:#{pid},$server},#{&&:#{==:#{pane_id},$pane},#{&&:#{==:#{pane_pid},$pane_pid},#{==:#{@tt_marker},}}}}"
[[ "$old_style$old_active" != *[!a-zA-Z0-9#=,.\ _-]* ]] || exit 0
old_style="${old_style//,/#,}"
old_active="${old_active//,/#,}"
guard="#{&&:$guard,#{&&:#{==:#{window-style},$old_style},#{==:#{window-active-style},$old_active}}}"
"${tmux_command[@]}" if-shell -F -t "$pane" "$guard" "$commands" >/dev/null 2>&1 || true
